
@model EscuelaCopalchi.UI.Models.AsignarRolViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Asignar rol";

    bool rolUnico =
        string.Equals(Model.NombreRol, "Director",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(Model.NombreRol, "Administrador",
            StringComparison.OrdinalIgnoreCase);
}

<main>

    <!-- ENCABEZADO -->
    <section class="roles-header">
        <div class="container">

            <div class="roles-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "Roles")">Roles</a>
                <i class="bi bi-chevron-right"></i>
                <span>Asignar rol</span>
            </div>

            <h1 class="roles-title">
                <i class="bi bi-person-plus me-2"></i>
                Asignar rol
            </h1>

            <p class="roles-subtitle">
                Asigna el rol seleccionado a los usuarios del sistema.
            </p>

        </div>
    </section>

    <!-- CONTENIDO -->
    <section class="container pb-5">

        <div class="assign-card">

            <!-- MENSAJES -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["Exito"]
                </div>
            }

            @Html.ValidationSummary(
                false, "",
                new { @class = "text-danger" })

            <!-- ROL SELECCIONADO -->
            <div class="selected-role">

                <div class="role-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <span>Rol seleccionado</span>

                    <h2>@Model.NombreRol</h2>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.DescripcionRol)
                            ? "Sin descripción."
                            : Model.DescripcionRol)
                    </p>
                </div>

            </div>

            <!-- ADVERTENCIA PARA ROLES ÚNICOS -->
            @if (rolUnico)
            {
                <div class="alert alert-info small">
                    <i class="bi bi-info-circle me-1"></i>
                    Este rol solo puede tener un usuario activo.
                    Para asignarlo a otra persona, primero debe
                    cambiar el rol del usuario actual.
                </div>
            }

            <!-- BUSCADOR -->
            <div class="search-box mb-3">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="buscarUsuario"
                       class="form-control"
                       placeholder="Buscar usuario..." />

            </div>

            <!-- FORMULARIO -->
            @using (Html.BeginForm(
                "Asignar",
                "Roles",
                FormMethod.Post,
                new { id = "formAsignar" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IdRol)

                <div class="user-list" id="listaUsuarios">

                    @if (Model.Usuarios != null &&
                         Model.Usuarios.Count > 0)
                    {
                        for (int i = 0; i < Model.Usuarios.Count; i++)
                        {
                            var usuario = Model.Usuarios[i];

                            <label class="user-item">

                                @Html.HiddenFor(
                                    m => m.Usuarios[i].IdUsuario)

                                <div class="user-info">

                                    <div class="user-avatar">
                                        @(string.Join("",
                                            (usuario.NombreCompleto ?? "")
                                            .Split(
                                                new[] { ' ' },
                                                StringSplitOptions.RemoveEmptyEntries)
                                            .Take(2)
                                            .Select(p =>
                                                p.Substring(0, 1).ToUpper())
                                        ))
                                    </div>

                                    <div class="user-details">

                                        <strong>
                                            @usuario.NombreCompleto
                                        </strong>

                                        <small>
                                            @usuario.Correo
                                        </small>

                                    </div>

                                </div>

                                @Html.CheckBoxFor(
                                    m => m.Usuarios[i].Seleccionado,
                                    new
                                    {
                                        @class = "form-check-input usuario-check"
                                    })

                            </label>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">

                            <i class="bi bi-info-circle me-1"></i>

                            No existen usuarios activos registrados.

                        </div>
                    }

                </div>

                <!-- BOTONES -->
                <div class="form-actions">

                    <a href="@Url.Action("Index", "Roles")"
                       class="btn btn-light">
                        Cancelar
                    </a>

                    <button type="submit"
                            id="btnGuardar"
                            class="btn btn-cop-primary"
                            @(Model.Usuarios == null || Model.Usuarios.Count == 0 ? "disabled=\"disabled\"" : "")>

                        <i class="bi bi-person-check me-1"></i>
                        Guardar asignación

                    </button>

                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .roles-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .roles-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .roles-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .roles-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .roles-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .assign-card {
            max-width: 800px;
            margin: auto;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 24px;
        }

        .selected-role {
            display: flex;
            gap: 13px;
            align-items: center;
            padding: 15px;
            background: #f8fafc;
            border: 1px solid #edf0f3;
            border-radius: 9px;
            margin-bottom: 22px;
        }

        .role-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .selected-role span {
            color: var(--cop-muted);
            font-size: .75rem;
        }

        .selected-role h2 {
            color: var(--cop-primary);
            font-size: 1rem;
            margin: 2px 0;
        }

        .selected-role p {
            color: var(--cop-muted);
            font-size: .82rem;
            margin: 0;
        }

        .search-box {
            position: relative;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .user-list {
            max-height: 450px;
            overflow-y: auto;
        }

        .user-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px;
            border-bottom: 1px solid #edf0f3;
            cursor: pointer;
            gap: 12px;
        }

            .user-item:hover {
                background: #f8fafc;
            }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .user-details {
            min-width: 0;
        }

            .user-details strong,
            .user-details small {
                display: block;
                overflow-wrap: anywhere;
            }

            .user-details strong {
                color: #133C55;
                font-size: .88rem;
            }

            .user-details small {
                color: var(--cop-muted);
                font-size: .76rem;
            }

        .usuario-check {
            cursor: pointer;
            flex-shrink: 0;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
            padding-top: 20px;
            border-top: 1px solid #edf0f3;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

            .btn-cop-primary:disabled {
                opacity: .65;
                cursor: not-allowed;
            }
    </style>

}


@section scripts {

    <script>

    document.addEventListener("DOMContentLoaded", function () {

        const buscador =
            document.getElementById("buscarUsuario");

        const usuarios =
            document.querySelectorAll(".user-item");

        const checks =
            document.querySelectorAll(".usuario-check");

        const formulario =
            document.getElementById("formAsignar");

        const botonGuardar =
            document.getElementById("btnGuardar");

        const esRolUnico =
            @(rolUnico ? "true" : "false");


        // =====================================
        // BUSCAR USUARIOS
        // =====================================

        if (buscador) {

            buscador.addEventListener("input", function () {

                const texto = this.value
                    .toLowerCase()
                    .trim();

                usuarios.forEach(function (usuario) {

                    const contenido =
                        usuario.innerText.toLowerCase();

                    usuario.style.display =
                        contenido.includes(texto)
                            ? ""
                            : "none";

                });

            });

        }


        // =====================================
        // VALIDAR ROLES ÚNICOS
        // =====================================

        if (esRolUnico) {

            checks.forEach(function (check) {

                check.addEventListener("change", function () {

                    if (this.checked) {

                        checks.forEach(function (otro) {

                            if (otro !== check) {
                                otro.checked = false;
                            }

                        });

                    }

                });

            });

        }


        // =====================================
        // GUARDAR ASIGNACIÓN
        // =====================================

        if (formulario) {

            formulario.addEventListener("submit", function (e) {

                const seleccionados =
                    Array.from(checks)
                        .filter(function (check) {
                            return check.checked;
                        });

                if (seleccionados.length === 0) {

                    e.preventDefault();

                    alert(
                        "Debe seleccionar al menos un usuario."
                    );

                    return;
                }

                if (esRolUnico &&
                    seleccionados.length > 1) {

                    e.preventDefault();

                    alert(
                        "Este rol solo puede tener un usuario activo."
                    );

                    return;
                }

                if (botonGuardar) {

                    botonGuardar.disabled = true;

                    botonGuardar.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2"></span>' +
                        'Guardando...';

                }

            });

        }

    });

    </script>

}