@model IEnumerable<EscuelaCopalchi.UI.Models.Rol>

@{
    ViewBag.Title = "Roles";
}

<main>


    <section class="roles-header">
        <div class="container">

            <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center gap-3">

                <div>
                    <h1 class="roles-title">
                        <i class="bi bi-shield-lock me-2"></i>
                        Gestión de roles
                    </h1>

                    <p class="roles-subtitle">
                        Administra roles, asignaciones y niveles
                        de acceso del sistema.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">

                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-outline-secondary cop-back-btn">
                        <i class="bi bi-arrow-left me-1"></i>
                        Atrás
                    </a>

                    <a href="@Url.Action("Crear", "Roles")"
                       class="btn btn-cop-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Nuevo rol
                    </a>

                </div>

            </div>

        </div>
    </section>



    <section class="container pb-5">

        @* MENSAJES *@
        @if (TempData["Exito"] != null || TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-2"></i>
                @(TempData["Exito"] ?? TempData["Success"])

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }


        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-shield"></i>
                    </div>

                    <div>
                        <span>Roles registrados</span>
                        <h2>@Model.Count()</h2>
                    </div>

                </div>
            </div>


            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <span>Roles activos</span>
                        <h2>@Model.Count(r => r.Estado)</h2>
                    </div>

                </div>
            </div>


            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon summary-icon-warning">
                        <i class="bi bi-shield-x"></i>
                    </div>

                    <div>
                        <span>Roles inactivos</span>
                        <h2>@Model.Count(r => !r.Estado)</h2>
                    </div>

                </div>
            </div>

        </div>


        <div class="roles-card">

            <div class="roles-toolbar">

                <div>
                    <h2>Roles del sistema</h2>
                    <p>Consulta y administra los roles registrados.</p>
                </div>

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="buscarRol"
                           class="form-control"
                           placeholder="Buscar rol..." />

                </div>

            </div>


            <div class="table-responsive">

                <table class="table roles-table align-middle"
                       id="tablaRoles">

                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var rol in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="role-info">

                                            <div class="role-icon">
                                                <i class="bi bi-shield-check"></i>
                                            </div>

                                            <strong>@rol.Nombre</strong>

                                        </div>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(rol.Descripcion))
                                        {
                                            <span class="text-muted">
                                                Sin descripción
                                            </span>
                                        }
                                        else
                                        {
                                            @rol.Descripcion
                                        }
                                    </td>

                                    <td>

                                        @if (rol.Estado)
                                        {
                                            <span class="status status-ok">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status status-inactive">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a href="@Url.Action("Editar", "Roles",
                                                 new { id = rol.IdRol })"
                                           class="btn btn-action"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a href="@Url.Action("Asignar", "Roles",
                                                 new { id = rol.IdRol })"
                                           class="btn btn-action"
                                           title="Asignar usuarios">

                                            <i class="bi bi-person-plus"></i>

                                        </a>

                                        <a href="@Url.Action("Permisos", "Roles",
                                                 new { id = rol.IdRol })"
                                           class="btn btn-action"
                                           title="Permisos">

                                            <i class="bi bi-key"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center py-4 text-muted">

                                    <i class="bi bi-info-circle me-1"></i>
                                    No existen roles registrados.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }


        .roles-header {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 24px 0 18px;
            margin-bottom: 0;
        }

        .roles-title {
            color: #133C55;
            font-size: 1.65rem;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .roles-subtitle {
            color: #6c757d;
            font-size: .88rem;
            margin: 0;
        }

        .cop-back-btn {
            border-radius: 6px;
            padding: 7px 14px;
            font-size: .88rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .btn-cop-primary {
            background: #133C55;
            border-color: #133C55;
            color: white;
            border-radius: 6px;
            padding: 7px 14px;
            font-size: .88rem;
        }

            .btn-cop-primary:hover {
                background: #386FA4;
                border-color: #386FA4;
                color: white;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .summary-card {
            height: 100%;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .summary-icon-warning {
            background: #fff3cd;
            color: #856404;
        }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.4rem;
        }

        .roles-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .roles-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 22px;
        }

            .roles-toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .roles-toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .search-box {
            position: relative;
            width: 260px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .roles-table {
            margin: 0;
        }

            .roles-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .roles-table td {
                padding: 15px 17px;
                font-size: .9rem;
                border-color: #edf0f3;
            }

        .role-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .role-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-inactive {
            background: #e9ecef;
            color: #6c757d;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            padding: 5px 9px;
        }

            .btn-action:hover {
                background: #e6f1fb;
                color: var(--cop-primary);
            }

        @@media (max-width: 768px) {

            .roles-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                width: 100%;
            }
        }

        /* Diseño institucional compartido */
        .cop-back-btn { border-radius: 9px; padding: .55rem 1rem; font-weight: 600; background: #fff; white-space: nowrap; }
        .cop-back-btn:hover { background: #edf3f8; color: #133C55; border-color: #386FA4; }
        .roles-header .roles-title i { color: #386FA4; }
        .roles-header { box-shadow: 0 2px 12px rgba(19,60,85,.035); }
        .assign-card, .permissions-card, .roles-card, .form-card { box-shadow: 0 5px 20px rgba(19,60,85,.055); }
        @@media (max-width: 576px) { .cop-back-btn { width: auto; } }

        .cop-topline { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:12px; }
        .cop-topline-note { color:#7b8794; font-size:.78rem; font-weight:600; letter-spacing:.04em; }
    </style>
}


@section scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const buscador = document.getElementById("buscarRol");

            buscador.addEventListener("keyup", function () {

                const texto = this.value.toLowerCase();

                const filas =
                    document.querySelectorAll("#tablaRoles tbody tr");

                filas.forEach(function (fila) {

                    const contenido =
                        fila.innerText.toLowerCase();

                    fila.style.display =
                        contenido.includes(texto) ? "" : "none";

                });

            });

        });

    </script>
}