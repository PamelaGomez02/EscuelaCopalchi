            }

            .permission-item:hover {
                background: #f7faff;
            }

            .permission-item:has(.permiso-check:checked) {
                background: #f7fbff;
            }

        .permission-info {
            min-width: 0;
        }

            .permission-info strong {
                overflow-wrap: anywhere;
            }

            .permission-info strong {
                display: block;
                color: #344054;
                font-size: .88rem;
            }

            .permission-info span {
                display: block;
                color: var(--cop-muted);
