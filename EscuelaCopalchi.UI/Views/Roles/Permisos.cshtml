            }

            .permissions-summary p {
                color: var(--cop-muted);
                font-size: .82rem;
                margin: 3px 0 0;
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e3e8ee;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .empty-permissions {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            color: var(--cop-muted);
        }

        @@media (max-width: 768px) {

            .permissions-toolbar {
                flex-direction: column;
                align-items: stretch;
            }
        }

        /* Diseño institucional compartido */
        .cop-back-btn {
            border-radius: 9px;
            padding: .55rem 1rem;
            font-weight: 600;
            background: #fff;
            white-space: nowrap;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                color: #133C55;
                border-color: #386FA4;
            }

        .roles-header .roles-title i {
            color: #386FA4;
        }

        .roles-header {
            box-shadow: 0 2px 12px rgba(19,60,85,.035);
        }

        .assign-card, .permissions-card, .roles-card, .form-card {
            box-shadow: 0 5px 20px rgba(19,60,85,.055);
        }

        @@media (max-width: 576px) {
            .cop-back-btn {
                width: auto;
            }
        }

        .cop-header-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 10px;
        }

            .cop-header-nav .roles-breadcrumb {
                margin: 0;
                flex-wrap: wrap;
            }

        @@media (max-width: 576px) {
            .cop-header-nav {
                align-items: flex-start;
            }
        }

        .permissions-layout {
            display: grid;
            grid-template-columns: minmax(0,1fr) 275px;
            gap: 22px;
            align-items: start;
        }

        .permissions-main {
            min-width: 0;
        }

        .permissions-side {
            position: sticky;
            top: 24px;
        }

        .save-panel {
            background: white;
            border: 1px solid #dfe7ef;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 8px 25px rgba(19,60,85,.06);
        }

        .save-panel-icon {
            width: 43px;
            height: 43px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            color: #386FA4;
            background: #e6f1fb;
            margin-bottom: 12px;
            font-size: 1.25rem;
        }

        .save-panel h3 {
            color: #133C55;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .save-panel p {
            font-size: .85rem;
            color: #667585;
            line-height: 1.5;
        }

        .selection-stat {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 12px 0;
            border-top: 1px solid #e7ecf1;
            border-bottom: 1px solid #e7ecf1;
            font-size: .83rem;
            color: #5d6b78;
        }

            .selection-stat strong {
                font-size: 1.15rem;
                color: #133C55;
            }

        .save-state {
            font-size: .8rem;
            color: #54765c;
            margin: 15px 0;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .save-state.pending {
                color: #94621d;
            }

            .save-state.saving {
                color: #386FA4;
            }

        .module-card {
            box-shadow: 0 2px 12px rgba(19,60,85,.035);
        }

        .module-header {
            border-left: 4px solid #386FA4;
        }

        .module-toggle {
            flex-shrink: 0;
        }

        .permission-info strong {
            text-transform: lowercase;
        }

            .permission-info strong::first-letter {
                text-transform: uppercase;
            }

        .permission-list.is-collapsed {
            display: none;
        }

        .permission-item .form-switch {
            flex-shrink: 0;
            margin: 0;
            padding-left: 2.9em;
        }

        .permission-item .form-check-input {
            margin-left: -2.9em;
        }

        @@media (max-width: 991px) {
            .permissions-layout {
                grid-template-columns: minmax(0,1fr);
            }

            .permissions-side {
                position: sticky;
                bottom: 10px;
                top: auto;
                z-index: 10;
            }

            .save-panel {
                padding: 12px 15px;
            }

                .save-panel-icon, .save-panel h3, .save-panel p, .selection-stat, .save-panel > a {
                    display: none;
                }

            .save-state {
                margin: 0 0 7px;
            }
        }

        @@media (max-width: 576px) {
            .permission-item {
                padding: 12px;
                gap: 12px;
            }

            .permissions-toolbar {
                padding: 14px;
            }

                .permissions-toolbar .d-flex {
                    flex-wrap: wrap;
                }
        }

        /* Panel de permisos: vista compacta, accesible y adaptable */
        .permissions-card {
            box-shadow: none;
        }

        .permissions-toolbar, .selected-role, .module-card, .save-panel {
            border-radius: 12px;
        }

        .permissions-toolbar {
            align-items: flex-start;
        }

        .toolbar-actions {
            justify-content: flex-end;
        }

        .permission-search-wrap {
            background: #fff;
            padding: 15px 18px;
            border: 1px solid #e3e8ee;
            border-radius: 12px;
        }

            .permission-search-wrap .form-label {
                font-size: .83rem;
                color: #133c55;
            }

            .permission-search-wrap .input-group-text {
                color: #386fa4;
                border-color: #dbe4ed;
            }

            .permission-search-wrap .form-control {
                border-color: #dbe4ed;
                min-width: 0;
            }

            .permission-search-wrap small {
                display: block;
                margin-top: 8px;
                font-size: .77rem;
            }

        .module-card {
            transition: border-color .18s,box-shadow .18s;
        }

            .module-card:hover {
                border-color: #c9d9e7;
            }

        .module-header {
            background: #fff;
            padding: 14px 16px;
        }

        .module-heading {
            flex: 1;
            min-width: 0;
        }

            .module-heading h4 {
                font-weight: 700;
            }

        .module-counter {
            font-size: .75rem;
            font-weight: 700;
            color: #386fa4;
            background: #eaf3fb;
            padding: 5px 9px;
            border-radius: 99px;
            white-space: nowrap;
        }

        .module-toggle {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border-color: #dce5ee;
        }

        .permission-item {
            transition: background .15s;
        }

            .permission-item[hidden], .module-card[hidden] {
                display: none !important;
            }

        .permission-list.is-collapsed {
            display: none;
        }

        .save-panel {
            border-top: 3px solid #386fa4;
        }

        .permissions-summary {
            background: #f8fafc;
            border-color: #e2e9ef;
        }

        @@media (max-width: 767px) {
            .toolbar-actions {
                justify-content: flex-start;
            }

            .module-counter {
                font-size: .7rem;
            }
        }
    </style>
}


@section scripts {
    <script>
            document.addEventListener('DOMContentLoaded', function () {
                var form = document.getElementById('formPermisos');
                if (!form) return;
                var checks = Array.prototype.slice.call(form.querySelectorAll('.permiso-check'));
                var cards = Array.prototype.slice.call(form.querySelectorAll('.module-card'));
                var count = document.getElementById('contadorPermisos');
                var state = document.getElementById('estadoGuardado');
                var submit = document.getElementById('guardarPermisosLateral');
                var search = document.getElementById('buscarPermiso');
                var searchResult = document.getElementById('resultadoBusqueda');
                var original = checks.map(function (x) { return x.checked; });

                function setExpanded(card, expanded) {
                    var list = card.querySelector('.permission-list');
                    var button = card.querySelector('.module-toggle');
                    list.classList.toggle('is-collapsed', !expanded);
                    button.setAttribute('aria-expanded', String(expanded));
                    button.setAttribute('aria-label', expanded ? 'Contraer módulo' : 'Expandir módulo');
                    button.innerHTML = expanded ? '<i class="bi bi-chevron-up"></i>' : '<i class="bi bi-chevron-down"></i>';
                }
                function refresh() {
                    var selected = checks.filter(function (x) { return x.checked; }).length;
                    count.textContent = selected + ' / ' + checks.length;
                    var changed = checks.some(function (x, i) { return x.checked !== original[i]; });
                    state.className = 'save-state' + (changed ? ' pending' : '');
                    state.innerHTML = changed
                        ? '<i class="bi bi-pencil-square"></i> Cambios sin guardar'
                        : '<i class="bi bi-check-circle"></i> Sin cambios pendientes';
                    cards.forEach(function (card) {
                        var own = Array.prototype.slice.call(card.querySelectorAll('.permiso-check'));
                        card.querySelector('.module-counter').textContent = own.filter(function (x) { return x.checked; }).length + ' / ' + own.length;
                    });
                }
                function filter() {
                    var term = search.value.trim().toLocaleLowerCase();
                    var visible = 0;
                    cards.forEach(function (card) {
                        var moduleMatches = (card.getAttribute('data-module') || '').toLocaleLowerCase().indexOf(term) >= 0;
                        var items = Array.prototype.slice.call(card.querySelectorAll('.permission-item'));
                        var matches = 0;
                        items.forEach(function (item) {
                            var matchesItem = !term || moduleMatches || (item.getAttribute('data-search') || '').toLocaleLowerCase().indexOf(term) >= 0;
                            item.hidden = !matchesItem;
                            if (matchesItem) matches++;
                        });
                        card.hidden = matches === 0;
                        if (matches) visible++;
                        if (term) setExpanded(card, matches > 0);
                        else setExpanded(card, false);
                    });
                    searchResult.textContent = term ? (visible ? visible + ' módulo(s) con resultados.' : 'No se encontraron coincidencias.') : 'Los módulos están contraídos para facilitar la navegación.';
                }
                cards.forEach(function (card) {
                    card.querySelector('.module-toggle').addEventListener('click', function () {
                        setExpanded(card, card.querySelector('.permission-list').classList.contains('is-collapsed'));
                    });
                });
                checks.forEach(function (x) { x.addEventListener('change', refresh); });
                document.getElementById('expandirTodos').addEventListener('click', function () {
                    cards.forEach(function (card) { if (!card.hidden) setExpanded(card, true); });
                });
                document.getElementById('contraerTodos').addEventListener('click', function () {
                    cards.forEach(function (card) { setExpanded(card, false); });
                });
                document.getElementById('seleccionarTodos').addEventListener('click', function () {
                    checks.forEach(function (x) { x.checked = true; }); refresh();
                });
                document.getElementById('quitarTodos').addEventListener('click', function () {
                    if (!window.confirm('¿Deseas desactivar todos los permisos de este rol? Los cambios se aplicarán al guardar.')) return;
                    checks.forEach(function (x) { x.checked = false; }); refresh();
                });
                search.addEventListener('input', filter);
                document.getElementById('limpiarBusqueda').addEventListener('click', function () { search.value = ''; filter(); search.focus(); });
                form.addEventListener('submit', function () {
                    state.className = 'save-state saving';
                    state.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando en el servidor...';
                    submit.disabled = true;
                    submit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Guardando...';
                });
                refresh();
                filter();
            });
    </script>
}
