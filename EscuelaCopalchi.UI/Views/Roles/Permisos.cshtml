@model EscuelaCopalchi.UI.Models.RolPermisosViewModel
@using System
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Permisos del rol";
    Func<string, string> moduloVisible = m =>
    {
        var s = (m ?? "").Trim();
        if (s.Equals("Notas", StringComparison.OrdinalIgnoreCase) || s.Equals("Gestión de notas", StringComparison.OrdinalIgnoreCase)) return "Gestión de Notas";
        if (s.Equals("Reportes", StringComparison.OrdinalIgnoreCase) || s.Equals("Reportes académicos", StringComparison.OrdinalIgnoreCase)) return "Reportes Académicos";
        return s;
    };
    var permisos = Model.Permisos ?? new List<EscuelaCopalchi.UI.Models.PermisoViewModel>();
    var modulos = permisos.Select(p => moduloVisible(p.Modulo)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    var etiquetas = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"VER_MI_MONITOREO","Consultar mis grupos"}, {"VER_MONITOREO_GENERAL","Consultar todos los grupos"},
        {"GESTIONAR_SEGUIMIENTO_MONITOREO","Registrar y actualizar seguimientos"},
        {"VER_MIS_NOTAS","Consultar notas de mis grupos"}, {"VER_NOTAS_GENERAL","Consultar notas de todos los grupos"},
        {"VER_TODAS_NOTAS","Consultar todas las notas (solo lectura)"},
        {"VER_MI_ASISTENCIA","Consultar asistencia de mis grupos"}, {"VER_ASISTENCIA_GENERAL","Consultar asistencia de todos los grupos"},
        {"VER_MIS_INDICADORES","Consultar indicadores de mis grupos"}, {"VER_INDICADORES_GENERALES","Consultar indicadores de todos los grupos"},
        {"VER_MI_AUDITORIA","Consultar mis movimientos"}, {"VER_AUDITORIA","Consultar auditoría general"}
    };
    var alcances = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase) {
        {"Monitoreo Académico",new[]{"VER_MI_MONITOREO","VER_MONITOREO_GENERAL"}},
        {"Asistencia",new[]{"VER_MI_ASISTENCIA","VER_ASISTENCIA_GENERAL"}},
        {"Gestión de Notas",new[]{"VER_MIS_NOTAS","VER_NOTAS_GENERAL"}},
        {"Indicadores académicos",new[]{"VER_MIS_INDICADORES","VER_INDICADORES_GENERALES"}},
        {"Auditoría",new[]{"VER_MI_AUDITORIA","VER_AUDITORIA"}}
    };
}
<main class="container py-4 permisos-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div><h1 class="h3 fw-bold mb-1"><i class="bi bi-shield-check me-2"></i>Permisos del rol</h1><p class="text-muted mb-0">Configura el acceso de <strong>@Model.NombreRol</strong> por módulo.</p></div>
        <a href="@Url.Action("Index", "Roles")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>
    @if (TempData["Exito"] != null || TempData["Success"] != null)
    {<div class="alert alert-success">@(TempData["Exito"] ?? TempData["Success"])</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @using (Html.BeginForm("Permisos", "Roles", FormMethod.Post, new { id = "formPermisos" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdRol)
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <label for="buscarPermiso" class="form-label fw-semibold">Buscar módulo o permiso</label>
                        <input type="search" class="form-control" id="buscarPermiso" placeholder="Por ejemplo: asistencia, editar, notas..." autocomplete="off" />
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="expandirTodos">Expandir</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="contraerTodos">Contraer</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="seleccionarTodos">Seleccionar todos</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="quitarTodos">Limpiar selección</button>
                        </div>
                    </div>
                </div>
                @foreach (var modulo in modulos)
                {
                    var items = permisos.Select((p, i) => new { Permiso = p, Index = i }).Where(x => string.Equals(moduloVisible(x.Permiso.Modulo), modulo, StringComparison.OrdinalIgnoreCase)).ToList();
                    string[] par;
                    bool tieneAlcance = alcances.TryGetValue(modulo, out par) && items.Any(x => par.Contains(x.Permiso.Nombre, StringComparer.OrdinalIgnoreCase));
                    <section class="card border-0 shadow-sm mb-3 modulo-card" data-modulo="@modulo">
                        <div class="card-header bg-white d-flex align-items-center gap-2 py-3">
                            <button type="button" class="btn btn-link text-decoration-none text-start p-0 flex-grow-1 modulo-toggle" aria-expanded="false">
                                <i class="bi bi-chevron-right me-2"></i><strong>@modulo</strong>
                            </button>
                            <span class="badge text-bg-light contador-modulo">0 / @items.Count</span><span class="estado-modulo estado-ninguno" aria-live="polite">Sin acceso</span>
                            <label class="module-master" title="Activar o desactivar todos los permisos del módulo"><input type="checkbox" class="seleccionar-modulo" aria-label="Seleccionar todos los permisos de @modulo" /><span class="master-track"></span><span class="master-caption">Todo el módulo</span></label>
                        </div>
                        <div class="card-body modulo-contenido d-none">
                            @if (tieneAlcance)
                            {
                                <div class="alcance-panel mb-3 p-3 rounded-3">
                                    <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-people-fill"></i><strong>¿A qué información puede acceder?</strong></div>
                                    <p class="text-muted small mb-3">Elige una sola opción de consulta para este módulo.</p>
                                    <select class="selector-alcance visually-hidden" data-propio="@par[0]" data-general="@par[1]" aria-label="Alcance de consulta de @modulo" tabindex="-1">
                                        <option value="ninguno">Sin acceso</option>
                                        <option value="propio">Mis grupos o registros</option>
                                        <option value="general">Todos los grupos o registros</option>
                                    </select>
                                    <div class="scope-options" role="group" aria-label="Alcance de @modulo">
                                        <button type="button" class="scope-option" data-value="ninguno" aria-pressed="false"><i class="bi bi-lock"></i><span><strong>Sin acceso</strong><small>No puede consultar</small></span></button>
                                        <button type="button" class="scope-option" data-value="propio" aria-pressed="false"><i class="bi bi-person-check"></i><span><strong>Acceso propio</strong><small>Solo sus grupos o registros</small></span></button>
                                        <button type="button" class="scope-option" data-value="general" aria-pressed="false"><i class="bi bi-people"></i><span><strong>Acceso general</strong><small>Todos los grupos o registros</small></span></button>
                                    </div>
                                </div>
                            }
                            @foreach (var x in items)
                            {
                                var p = x.Permiso;
                                var esAlcance = tieneAlcance && par.Contains(p.Nombre, StringComparer.OrdinalIgnoreCase);
                                var nombre = etiquetas.ContainsKey(p.Nombre) ? etiquetas[p.Nombre] : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.Nombre.Replace("_", " ").ToLowerInvariant());
                                <div class="permiso-item @(esAlcance ? "permiso-alcance" : "")" data-busqueda="@((nombre + " " + p.Nombre + " " + p.Descripcion).ToLowerInvariant())" data-codigo="@p.Nombre">
                                    @Html.HiddenFor(m => m.Permisos[x.Index].IdPermiso)
                                    <div class="flex-grow-1"><label for="Permisos_@(x.Index)__Seleccionado" class="fw-semibold d-block mb-1">@nombre</label><small class="text-muted">@p.Descripcion</small></div>
                                    <div class="permission-switch">
                                        @Html.CheckBoxFor(m => m.Permisos[x.Index].Seleccionado, new { @class = "permiso-check" })
                                        <button type="button" class="permission-toggle" role="switch" aria-checked="false" aria-label="Cambiar permiso: @nombre">
                                            <span class="switch-track" aria-hidden="true"></span>
                                            <span class="switch-status">Sin acceso</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
                @if (!modulos.Any())
                {<div class="alert alert-info">No hay permisos activos disponibles.</div>}
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm panel-guardar">
                    <div class="card-body">
                        <h2 class="h6 fw-bold">Configuración de @Model.NombreRol</h2>
                        <p class="text-muted small">Los permisos solo se aplicarán al guardar.</p>
                        <div class="d-flex justify-content-between py-3 border-top border-bottom"><span>Seleccionados</span><strong id="contadorPermisos">0</strong></div>
                        <p class="small mt-3" id="estadoGuardado" role="status">Sin cambios pendientes</p>
                        <button type="submit" id="guardarPermisos" class="btn btn-primary w-100 py-2"><i class="bi bi-check2-circle me-2"></i>Guardar cambios</button>
                        <a href="@Url.Action("Index", "Roles")" id="cancelarPermisos" class="btn btn-outline-secondary w-100 mt-2 py-2"><i class="bi bi-x-circle me-2"></i>Cancelar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</main>
@section styles {
    <style>
        .permisos-page h1, .permisos-page .modulo-toggle {
            color: #133c55
        }

        .permisos-page .card {
            border-radius: 12px;
            overflow: hidden
        }

        .permisos-page .modulo-toggle {
            font-size: .96rem
        }

            .permisos-page .modulo-toggle:hover {
                color: #386fa4
            }

        .permisos-page .permiso-item {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 13px 3px;
            border-bottom: 1px solid #edf1f5
        }

            .permisos-page .permiso-item:last-child {
                border-bottom: 0
            }

            .permisos-page .permiso-item label {
                cursor: pointer;
                font-size: .9rem
            }

            .permisos-page .permiso-item .permiso-check {
                position: absolute !important;
                width: 1px !important;
                height: 1px !important;
                opacity: 0 !important;
                pointer-events: none
            }

        .permisos-page .permiso-alcance {
            display: none
        }

        .permisos-page .alcance-panel {
            background: #f1f6fb
        }

        .permisos-page .panel-guardar {
            position: sticky;
            top: 80px
        }

        .permisos-page .btn-primary {
            background: #133c55;
            border-color: #133c55
        }

            .permisos-page .btn-primary:hover {
                background: #386fa4;
                border-color: #386fa4
            }

        .permisos-page .modulo-card[hidden], .permisos-page .permiso-item[hidden] {
            display: none !important
        }

        @@media(max-width:991px) {
            .permisos-page .panel-guardar {
                position: static
            }
        }
        /* Interruptores modernos */
        .permisos-page .permission-switch {
            display: flex;
            align-items: center;
            flex-shrink: 0;
            min-width: 143px;
            justify-content: flex-end;
            position: relative
        }

        .permisos-page .permission-toggle {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            border: 0;
            background: transparent;
            padding: 7px 2px;
            cursor: pointer;
            color: inherit
        }

            .permisos-page .permission-toggle:focus-visible {
                outline: 3px solid #8eb9df;
                outline-offset: 3px;
                border-radius: 8px
            }

        .permisos-page .module-master input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0
        }

        .permisos-page .switch-track, .permisos-page .master-track {
            position: relative;
            display: inline-block;
            flex-shrink: 0;
            width: 46px;
            height: 26px;
            border-radius: 30px;
            background: #cbd5e1;
            transition: background .2s;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,.06)
        }

            .permisos-page .switch-track::after, .permisos-page .master-track::after {
                content: "";
                position: absolute;
                top: 3px;
                left: 3px;
                width: 20px;
                height: 20px;
                background: white;
                border-radius: 50%;
                box-shadow: 0 1px 4px #0002;
                transition: transform .2s
            }

        .permisos-page .permission-toggle[aria-checked="true"] .switch-track, .permisos-page .module-master input:checked + .master-track {
            background: #177b66
        }

            .permisos-page .permission-toggle[aria-checked="true"] .switch-track::after, .permisos-page .module-master input:checked + .master-track::after {
                transform: translateX(20px)
            }

        .permisos-page .module-master input:focus-visible + .master-track {
            outline: 3px solid #8eb9df;
            outline-offset: 3px
        }

        .permisos-page .switch-status {
            font-size: .79rem;
            font-weight: 700;
            color: #64748b;
            min-width: 69px
        }

        .permisos-page .permission-toggle[aria-checked="true"] .switch-status {
            color: #14735f
        }

        .permisos-page .module-master {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            position: relative
        }

            .permisos-page .module-master .master-track {
                width: 38px;
                height: 22px
            }

                .permisos-page .module-master .master-track::after {
                    width: 16px;
                    height: 16px
                }

            .permisos-page .module-master input:checked + .master-track::after {
                transform: translateX(16px)
            }

        .permisos-page .master-caption {
            font-size: .75rem;
            color: #52677c;
            font-weight: 600
        }
        /* Estado parcial: amarillo, con raya en el centro del selector */
        .permisos-page .module-master input:indeterminate + .master-track {
            background: #e5a329
        }

            .permisos-page .module-master input:indeterminate + .master-track::after {
                transform: translateX(8px)
            }

        .permisos-page .estado-modulo {
            font-size: .72rem;
            font-weight: 700;
            padding: 5px 9px;
            border-radius: 999px;
            white-space: nowrap
        }

        .permisos-page .estado-completo {
            background: #e4f5ee;
            color: #146c52
        }

        .permisos-page .estado-parcial {
            background: #fff1c9;
            color: #8b5900
        }

        .permisos-page .estado-ninguno {
            background: #eef1f5;
            color: #637083
        }

        .permisos-page .modulo-card.acceso-parcial > .card-header {
            background: #fffbef !important;
            border-left: 4px solid #e5a329
        }

        .permisos-page .modulo-card.acceso-completo > .card-header {
            border-left: 4px solid #177b66
        }

        .permisos-page .modulo-card.acceso-ninguno > .card-header {
            border-left: 4px solid #cbd5e1
        }

        @@media(max-width:575px) {
            .permisos-page .estado-modulo {
                font-size: .65rem;
                padding: 4px 6px
            }

            .permisos-page .master-caption {
                display: none
            }
        }
        /* Selector de alcance tipo tarjetas */
        .permisos-page .alcance-panel {
            background: #f4f8fc;
            border: 1px solid #dce8f2
        }

        .permisos-page .scope-options {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 9px
        }

        .permisos-page .scope-option {
            border: 1.5px solid #d5e0e9;
            background: #fff;
            border-radius: 11px;
            padding: 13px 10px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 9px;
            text-align: left;
            color: #334155;
            transition: background .15s,border-color .15s,box-shadow .15s;
            min-height: 108px
        }

            .permisos-page .scope-option i {
                font-size: 1.3rem;
                color: #627b92
            }

            .permisos-page .scope-option strong {
                font-size: .85rem;
                display: block
            }

            .permisos-page .scope-option small {
                font-size: .73rem;
                color: #64748b;
                display: block;
                line-height: 1.35;
                margin-top: 3px
            }

            .permisos-page .scope-option:hover {
                border-color: #386fa4;
                background: #f7fbff
            }

            .permisos-page .scope-option.active {
                border-color: #386fa4;
                background: #eaf3fb;
                box-shadow: 0 0 0 1px #386fa4
            }

                .permisos-page .scope-option.active i, .permisos-page .scope-option.active strong {
                    color: #133c55
                }

            .permisos-page .scope-option:focus-visible {
                outline: 3px solid #8eb9df;
                outline-offset: 2px
            }

        @@media(max-width:575px) {
            .permisos-page .scope-options {
                grid-template-columns: 1fr
            }

            .permisos-page .scope-option {
                min-height: auto;
                flex-direction: row;
                align-items: center
            }

            .permisos-page .master-caption {
                display: none
            }

            .permisos-page .permission-switch {
                min-width: 110px
            }

            .permisos-page .switch-status {
                min-width: 50px
            }
        }
    </style>
}
@section scripts {
    <script>
document.addEventListener('DOMContentLoaded',function(){
         var form=document.getElementById('formPermisos');if(!form)return;
         var cards=Array.from(form.querySelectorAll('.modulo-card'));
         var checks=Array.from(form.querySelectorAll('.permiso-check'));
         var original=checks.map(function(x){return x.checked});
         var search=document.getElementById('buscarPermiso');
         function own(card){return Array.from(card.querySelectorAll('.permiso-check'))}
         function byCode(card,code){var row=Array.from(card.querySelectorAll('.permiso-item')).find(function(x){return x.dataset.codigo===code});return row?row.querySelector('.permiso-check'):null}
         function syncScope(card){var sel=card.querySelector('.selector-alcance');if(!sel)return;var ownCheck=byCode(card,sel.dataset.propio),allCheck=byCode(card,sel.dataset.general);if(!ownCheck||!allCheck)return;sel.value=allCheck.checked?'general':ownCheck.checked?'propio':'ninguno';card.querySelectorAll('.scope-option').forEach(function(b){var active=b.dataset.value===sel.value;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))})}
         function applyScope(card){var sel=card.querySelector('.selector-alcance');if(!sel)return;var a=byCode(card,sel.dataset.propio),b=byCode(card,sel.dataset.general);if(a)a.checked=sel.value==='propio';if(b)b.checked=sel.value==='general';refresh()}
         function refresh(){
          checks.forEach(function(c){var status=c.closest('.permission-switch');if(status){var btn=status.querySelector('.permission-toggle');if(btn)btn.setAttribute('aria-checked',String(c.checked));var txt=status.querySelector('.switch-status');if(txt)txt.textContent=c.checked?'Permitido':'Sin acceso'}});var count=checks.filter(function(x){return x.checked}).length;
          document.getElementById('contadorPermisos').textContent=count+' / '+checks.length;
          var changed=checks.some(function(x,i){return x.checked!==original[i]});
          document.getElementById('estadoGuardado').textContent=changed?'Cambios sin guardar':'Sin cambios pendientes';
          cards.forEach(function(card){
           var xs=own(card),n=xs.filter(function(x){return x.checked}).length;
           var scope=card.querySelector('.selector-alcance');
           // Los dos permisos de alcance son excluyentes; el máximo efectivo es total - 1.
           var max=xs.length-(scope?1:0);
           var full=max>0&&n>=max;
           var partial=n>0&&!full;
           card.querySelector('.contador-modulo').textContent=n+' / '+max;
           var master=card.querySelector('.seleccionar-modulo');
           master.checked=full;
           master.indeterminate=partial;
           master.setAttribute('aria-label',full?'Acceso completo a '+card.dataset.modulo:partial?'Acceso parcial a '+card.dataset.modulo:'Sin acceso a '+card.dataset.modulo);
           var badge=card.querySelector('.estado-modulo');
           badge.textContent=full?'Acceso completo':partial?'Acceso parcial':'Sin acceso';
           badge.classList.remove('estado-completo','estado-parcial','estado-ninguno');
           badge.classList.add(full?'estado-completo':partial?'estado-parcial':'estado-ninguno');
           card.classList.remove('acceso-completo','acceso-parcial','acceso-ninguno');
           card.classList.add(full?'acceso-completo':partial?'acceso-parcial':'acceso-ninguno');
           syncScope(card);
          });
         }
         function expand(card,on){card.querySelector('.modulo-contenido').classList.toggle('d-none',!on);var btn=card.querySelector('.modulo-toggle');btn.setAttribute('aria-expanded',String(on));btn.querySelector('i').className=on?'bi bi-chevron-down me-2':'bi bi-chevron-right me-2'}
         cards.forEach(function(card){
          card.querySelector('.modulo-toggle').addEventListener('click',function(){expand(card,card.querySelector('.modulo-contenido').classList.contains('d-none'))});
          card.querySelector('.seleccionar-modulo').addEventListener('change',function(e){var activate=e.target.checked;own(card).forEach(function(c){c.checked=activate});var sel=card.querySelector('.selector-alcance');if(sel&&activate){var a=byCode(card,sel.dataset.propio),b=byCode(card,sel.dataset.general);if(a)a.checked=false;if(b)b.checked=true}refresh()});
          var sel=card.querySelector('.selector-alcance');if(sel){sel.addEventListener('change',function(){applyScope(card)});card.querySelectorAll('.scope-option').forEach(function(btn){btn.addEventListener('click',function(){sel.value=btn.dataset.value;applyScope(card)})})}
         });
         checks.forEach(function(c){
          c.addEventListener('change',refresh);
          var wrapper=c.closest('.permission-switch');
          var toggle=wrapper?wrapper.querySelector('.permission-toggle'):null;
          if(toggle)toggle.addEventListener('click',function(){
           c.checked=!c.checked;
           c.dispatchEvent(new Event('change',{bubbles:true}));
          });
         });
         document.getElementById('expandirTodos').addEventListener('click',function(){cards.filter(function(c){return !c.hidden}).forEach(function(c){expand(c,true)})});
         document.getElementById('contraerTodos').addEventListener('click',function(){cards.forEach(function(c){expand(c,false)})});
         document.getElementById('seleccionarTodos').addEventListener('click',function(){checks.forEach(function(c){c.checked=true});cards.forEach(function(c){var sel=c.querySelector('.selector-alcance');if(sel){var a=byCode(c,sel.dataset.propio);if(a)a.checked=false}});refresh()});
         document.getElementById('quitarTodos').addEventListener('click',function(){if(!confirm('¿Quitar todos los permisos de este rol? Los cambios se aplicarán al guardar.'))return;checks.forEach(function(c){c.checked=false});refresh()});
         search.addEventListener('input',function(){var q=search.value.trim().toLocaleLowerCase();cards.forEach(function(card){var match=(card.dataset.modulo||'').toLocaleLowerCase().includes(q),visible=0;Array.from(card.querySelectorAll('.permiso-item')).forEach(function(row){var yes=!q||match||(row.dataset.busqueda||'').toLocaleLowerCase().includes(q);row.hidden=!yes;if(yes)visible++});card.hidden=!!q&&!visible; if(q&&visible)expand(card,true);else if(!q)expand(card,false)})});
         var cancel=document.getElementById('cancelarPermisos');if(cancel)cancel.addEventListener('click',function(e){if(checks.some(function(c,i){return c.checked!==original[i]})&&!confirm('Hay cambios sin guardar. ¿Deseas cancelar y salir?'))e.preventDefault()});
                 form.addEventListener('submit',function(){var btn=document.getElementById('guardarPermisos');btn.disabled=true;btn.textContent='Guardando...'});
         refresh();
});
    </script>
}
