@model EscuelaCopalchi.UI.Models.RolPermisosViewModel

@{
    ViewBag.Title = "Permisos del rol";
}

<main>


    <section class="roles-header">
        <div class="container">

            <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center gap-3">

                <div>
                    <h1 class="roles-title">
                        <i class="bi bi-key me-2"></i>
                        Permisos del rol
                    </h1>

                    <p class="roles-subtitle">
                        Define las funcionalidades a las que
                        tendrá acceso este rol.
                    </p>
                </div>

                <a href="@Url.Action("Index", "Roles")"
                   class="btn btn-outline-secondary cop-back-btn">
                    <i class="bi bi-arrow-left me-1"></i>
                    Atrás
                </a>

            </div>

        </div>
    </section>



    <section class="container pb-5">

        @if (TempData["Exito"] != null || TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2" role="status"><i class="bi bi-check-circle-fill"></i><span>@(TempData["Exito"] ?? TempData["Success"])</span></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]</div>
        }
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="permissions-card">

            <div class="selected-role">

                <div class="role-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <span>Configurando permisos para</span>

                    <h2>@Model.NombreRol</h2>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.DescripcionRol)
                            ? "Sin descripción."
                            : Model.DescripcionRol)
                    </p>
                </div>

            </div>


            @using (Html.BeginForm("Permisos", "Roles", FormMethod.Post, new { id = "formPermisos" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdRol)

                <div class="permissions-layout">
                    <div class="permissions-main">
                        <div class="permissions-toolbar">

                            <div>
                                <h3>Permisos disponibles</h3>
                                <p>
                                    Selecciona las funciones permitidas para
                                    @Model.NombreRol.
                                </p>
                            </div>

                            <div class="d-flex gap-2 flex-wrap toolbar-actions">

                                <button type="button" id="expandirTodos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrows-expand me-1"></i> Expandir</button>
                                <button type="button" id="contraerTodos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrows-collapse me-1"></i> Contraer</button>
                                <button type="button"
                                        id="seleccionarTodos"
                                        class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-check2-square me-1"></i>
                                    Seleccionar todos
                                </button>

                                <button type="button"
                                        id="quitarTodos"
                                        class="btn btn-sm btn-outline-secondary">
                                    Limpiar
                                </button>

                            </div>

                        </div>


                        <div class="permission-search-wrap mb-3">
                            <label for="buscarPermiso" class="form-label mb-1 fw-semibold">Buscar módulo o permiso</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                <input id="buscarPermiso" type="search" class="form-control" placeholder="Ej. Traslados, asistencia, editar..." autocomplete="off" />
                                <button id="limpiarBusqueda" type="button" class="btn btn-outline-secondary">Limpiar búsqueda</button>
                            </div>
                            <small id="resultadoBusqueda" class="text-muted" aria-live="polite">Los módulos están contraídos para facilitar la navegación.</small>
                        </div>
                        @if (Model.Permisos != null && Model.Permisos.Count > 0)
                        {
                            var modulos = Model.Permisos
                                .Select(p => p.Modulo)
                                .Distinct()
                                .ToList();

                            foreach (var modulo in modulos)
                            {
                                <div class="module-card" data-module="@modulo">

                                    <div class="module-header">

                                        <div class="module-icon">
                                            <i class="bi bi-grid"></i>
                                        </div>

                                        <div class="module-heading">
                                            <h4>@modulo</h4>

                                            <small>
                                                Configura el acceso a este módulo.
                                            </small>
                                        </div>
                                        <span class="module-counter ms-auto" aria-live="polite"></span>
                                        <button type="button" class="module-toggle btn btn-sm btn-outline-secondary" aria-expanded="false" aria-label="Expandir módulo"><i class="bi bi-chevron-down"></i></button>
                                    </div>


                                    <div class="permission-list is-collapsed">

                                        @for (int i = 0; i < Model.Permisos.Count; i++)
                                        {
                                            if (Model.Permisos[i].Modulo == modulo)
                                            {
                                                <label class="permission-item">

                                                    @Html.HiddenFor(
                                                        m => m.Permisos[i].IdPermiso
                                                    )

                                                    <div class="permission-info">

                                                        <strong>
                                                            @Model.Permisos[i].Nombre.Replace("_", " ")
                                                        </strong>

                                                        <span>
                                                            @Model.Permisos[i].Descripcion
                                                        </span>

                                                    </div>


                                                    <div class="form-check form-switch">

                                                        @Html.CheckBoxFor(
                                                            m => m.Permisos[i].Seleccionado,
                                                            new
                                                            {
                                                                @class =
                                                                    "form-check-input permiso-check"
                                                            }
                                                        )

                                                    </div>

                                                </label>
                                            }
                                        }

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-permissions">

                                <i class="bi bi-info-circle"></i>

                                <p>
                                    No existen permisos activos registrados.
                                </p>

                            </div>
                        }


                        <div class="permissions-summary">

                            <i class="bi bi-info-circle"></i>

                            <div>
                                <strong>Control de acceso</strong>

                                <p>
                                    Los usuarios que tengan este rol solamente
                                    podrán acceder a las funcionalidades
                                    seleccionadas.
                                </p>
                            </div>

                        </div>


                    </div>
                    <aside class="permissions-side" aria-label="Acciones de permisos">
                        <div class="save-panel">
                            <div class="save-panel-icon"><i class="bi bi-shield-lock"></i></div>
                            <h3>Configuración del rol</h3>
                            <p>Activa únicamente los accesos que necesita <strong>@Model.NombreRol</strong>.</p>
                            <div class="selection-stat"><span>Permisos seleccionados</span><strong id="contadorPermisos" aria-live="polite">0</strong></div>
                            <div class="save-state" id="estadoGuardado" role="status" aria-live="polite"><i class="bi bi-check-circle"></i> Sin cambios pendientes</div>
                            <button type="submit" id="guardarPermisosLateral" class="btn btn-cop-primary w-100"><i class="bi bi-save me-1"></i> Guardar cambios</button>
                            <a href="@Url.Action("Index", "Roles")" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
                        </div>
                    </aside>
                </div>

            }

        </div>

    </section>

</main>


@section styles {

