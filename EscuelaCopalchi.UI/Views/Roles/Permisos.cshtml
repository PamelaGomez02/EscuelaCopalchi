@model EscuelaCopalchi.UI.Models.RolPermisosViewModel

@{
    ViewBag.Title = "Permisos del rol";
}

<main>

    <section class="roles-header">
        <div class="container">

            <div class="roles-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "Roles")">Roles</a>
                <i class="bi bi-chevron-right"></i>

                <span>Permisos</span>
            </div>

            <h1 class="roles-title">
                <i class="bi bi-key me-2"></i>
                Permisos del rol
            </h1>

            <p class="roles-subtitle">
                Define las funcionalidades a las que tendrá acceso este rol.
            </p>

        </div>
    </section>


    <section class="container pb-5">

        <div class="permissions-card">

            <div class="selected-role">

                <div class="role-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <span>Configurando permisos para</span>

                    <h2>@Model.NombreRol</h2>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.DescripcionRol)
                            ? "Sin descripción."
                            : Model.DescripcionRol)
                    </p>
                </div>

            </div>


            @using (Html.BeginForm("Permisos", "Roles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdRol)

                <div class="permissions-toolbar">

                    <div>
                        <h3>Permisos disponibles</h3>
                        <p>
                            Selecciona las funciones permitidas para
                            @Model.NombreRol.
                        </p>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="button"
                                id="seleccionarTodos"
                                class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-check2-square me-1"></i>
                            Seleccionar todos
                        </button>

                        <button type="button"
                                id="quitarTodos"
                                class="btn btn-sm btn-outline-secondary">
                            Limpiar
                        </button>

                    </div>

                </div>


                if (Model.Permisos != null && Model.Permisos.Count > 0)
                {
                    var modulos = Model.Permisos
                        .Select(p => p.Modulo)
                        .Distinct()
                        .ToList();

                    foreach (var modulo in modulos)
                    {
                        <div class="module-card">

                            <div class="module-header">

                                <div class="module-icon">
                                    <i class="bi bi-grid"></i>
                                </div>

                                <div>
                                    <h4>@modulo</h4>

                                    <small>
                                        Configura el acceso a este módulo.
                                    </small>
                                </div>

                            </div>


                            <div class="permission-list">

                                @for (int i = 0; i < Model.Permisos.Count; i++)
                                {
                                    if (Model.Permisos[i].Modulo == modulo)
                                    {
                                        <div class="permission-item">

                                            @Html.HiddenFor(
                                                m => m.Permisos[i].IdPermiso
                                            )

                                            <div class="permission-info">

                                                <strong>
                                                    @Model.Permisos[i].Nombre
                                                </strong>

                                                <span>
                                                    @Model.Permisos[i].Descripcion
                                                </span>

                                            </div>


                                            <div class="form-check form-switch">

                                                @Html.CheckBoxFor(
                                                    m => m.Permisos[i].Seleccionado,
                                                    new
                                                    {
                                                        @class =
                                                            "form-check-input permiso-check"
                                                    }
                                                )

                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-permissions">

                        <i class="bi bi-info-circle"></i>

                        <p>
                            No existen permisos activos registrados.
                        </p>

                    </div>
                }


                <div class="permissions-summary">

                    <i class="bi bi-info-circle"></i>

                    <div>
                        <strong>Control de acceso</strong>

                        <p>
                            Los usuarios que tengan este rol solamente
                            podrán acceder a las funcionalidades
                            seleccionadas.
                        </p>
                    </div>

                </div>


                <div class="form-actions">

                    <a href="@Url.Action("Index", "Roles")"
                       class="btn btn-light">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar permisos

                    </button>

                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .roles-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .roles-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .roles-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .roles-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .roles-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .permissions-card {
            max-width: 900px;
            margin: auto;
        }

        .selected-role {
            display: flex;
            gap: 13px;
            align-items: center;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 20px;
        }

        .role-icon {
            width: 46px;
            height: 46px;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }

        .selected-role span {
            color: var(--cop-muted);
            font-size: .75rem;
        }

        .selected-role h2 {
            color: var(--cop-primary);
            font-size: 1.05rem;
            margin: 2px 0;
        }

        .selected-role p {
            color: var(--cop-muted);
            font-size: .82rem;
            margin: 0;
        }

        .permissions-toolbar {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

            .permissions-toolbar h3 {
                color: var(--cop-primary);
                font-size: 1rem;
                margin: 0 0 3px;
            }

            .permissions-toolbar p {
                color: var(--cop-muted);
                font-size: .82rem;
                margin: 0;
            }

        .module-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 15px;
        }

        .module-header {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 15px 18px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

        .module-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .module-header h4 {
            color: var(--cop-primary);
            font-size: .95rem;
            margin: 0;
        }

        .module-header small {
            color: var(--cop-muted);
            font-size: .75rem;
        }

        .permission-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 15px 18px;
            border-bottom: 1px solid #edf0f3;
        }

            .permission-item:last-child {
                border-bottom: none;
            }

        .permission-info strong {
            display: block;
            color: #344054;
            font-size: .88rem;
        }

        .permission-info span {
            display: block;
            color: var(--cop-muted);
            font-size: .78rem;
            margin-top: 2px;
        }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.25em;
            cursor: pointer;
        }

            .form-switch .form-check-input:checked {
                background-color: var(--cop-secondary);
                border-color: var(--cop-secondary);
            }

        .permissions-summary {
            display: flex;
            gap: 12px;
            padding: 15px;
            margin-top: 20px;
            background: #f3f8fd;
            border: 1px solid #d7e8f5;
            border-radius: 9px;
        }

            .permissions-summary i {
                color: var(--cop-secondary);
                font-size: 1.2rem;
            }

            .permissions-summary strong {
                color: var(--cop-primary);
                display: block;
                font-size: .9rem;
            }

            .permissions-summary p {
                color: var(--cop-muted);
                font-size: .82rem;
                margin: 3px 0 0;
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e3e8ee;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .empty-permissions {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            color: var(--cop-muted);
        }

        @@media (max-width: 768px) {

            .permissions-toolbar {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
}


@section scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const seleccionar =
                document.getElementById("seleccionarTodos");

            const limpiar =
                document.getElementById("quitarTodos");

            const checks =
                document.querySelectorAll(".permiso-check");


            seleccionar.addEventListener("click", function () {

                checks.forEach(function (check) {
                    check.checked = true;
                });

            });


            limpiar.addEventListener("click", function () {

                checks.forEach(function (check) {
                    check.checked = false;
                });

            });

        });

    </script>
}