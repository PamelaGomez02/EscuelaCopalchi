                font-size: 1rem;
                margin: 0 0 3px;
            }

            .permissions-toolbar p {
                color: var(--cop-muted);
                font-size: .82rem;
                margin: 0;
            }

        .module-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 15px;
        }

        .module-header {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 15px 18px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

        .module-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .module-header h4 {
            color: var(--cop-primary);
