            margin: 0;
        }

        .module-header small {
            color: var(--cop-muted);
            font-size: .75rem;
        }

        .permission-item {
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 11px 16px;
            border-bottom: 1px solid #edf0f3;
        }

