@model EscuelaCopalchi.UI.Models.Rol

@{
    ViewBag.Title = "Editar rol";
}

<main>


    <section class="roles-header">
        <div class="container">

            <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center gap-3">

                <div>
                    <h1 class="roles-title">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar rol
                    </h1>

                    <p class="roles-subtitle">
                        Actualiza la información del rol seleccionado.
                    </p>
                </div>

                <a href="@Url.Action("Index", "Roles")"
                   class="btn btn-outline-secondary cop-back-btn">
                    <i class="bi bi-arrow-left me-1"></i>
                    Atrás
                </a>

            </div>

        </div>
    </section>



    <section class="container pb-5">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]
            </div>
        }


        <div class="form-card">

            @using (Html.BeginForm("Editar", "Roles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IdRol)


                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombre del rol
                        </label>

                        @Html.TextBoxFor(
                            m => m.Nombre,
                            new { @class = "form-control" }
                        )

                        @Html.ValidationMessageFor(
                            m => m.Nombre,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Estado
                        </label>

                        @Html.DropDownListFor(
                            m => m.Estado,
                            new List<SelectListItem>
                            {
                                new SelectListItem
                                {
                                    Text = "Activo",
                                    Value = "true"
                                },
                                new SelectListItem
                                {
                                    Text = "Inactivo",
                                    Value = "false"
                                }
                            },
                            new { @class = "form-select" }
                        )

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Descripción
                        </label>

                        @Html.TextAreaFor(
                            m => m.Descripcion,
                            new
                            {
                                @class = "form-control",
                                rows = "4"
                            }
                        )

                        @Html.ValidationMessageFor(
                            m => m.Descripcion,
                            "",
                            new { @class = "text-danger small" }
                        )

                    </div>

                </div>


                <div class="form-actions">

                    <button type="button"
                            class="btn btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEliminar">

                        <i class="bi bi-trash me-1"></i>
                        Eliminar rol

                    </button>


                    <div class="ms-auto d-flex gap-2">

                        <a href="@Url.Action("Index", "Roles")"
                           class="btn btn-light">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-cop-primary">

                            <i class="bi bi-save me-1"></i>
                            Guardar cambios

                        </button>

                    </div>

                </div>
            }

        </div>

    </section>

</main>


<div class="modal fade"
     id="modalEliminar"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Eliminar rol
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="warning-box">

                    <i class="bi bi-exclamation-triangle"></i>

                    <div>

                        <strong>
                            ¿Deseas eliminar el rol @Model.Nombre?
                        </strong>

                        <p>
                            Si existen usuarios activos asociados al rol,
                            el sistema no permitirá eliminarlo.
                        </p>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>


                @using (Html.BeginForm(
                    "Eliminar",
                    "Roles",
                    FormMethod.Post,
                    new { style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.IdRol" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Eliminar

                    </button>
                }

            </div>

        </div>

    </div>

</div>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }


        .roles-header {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 24px 0 18px;
            margin-bottom: 0;
        }

        .roles-title {
            color: #133C55;
            font-size: 1.65rem;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .roles-subtitle {
            color: #6c757d;
            font-size: .88rem;
            margin: 0;
        }

        .cop-back-btn {
            border-radius: 6px;
            padding: 7px 14px;
            font-size: .88rem;
            font-weight: 500;
            background: #fff;
            white-space: nowrap;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                color: #133C55;
                border-color: #386FA4;
            }


        .form-card {
            max-width: 850px;
            margin: auto;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .form-label {
            color: #344054;
            font-size: .9rem;
            font-weight: 600;
        }

        .form-actions {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #edf0f3;
            display: flex;
            align-items: center;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .warning-box {
            display: flex;
            gap: 12px;
            padding: 14px;
            background: #fff3cd;
            color: #856404;
            border-radius: 9px;
        }

            .warning-box p {
                font-size: .84rem;
                margin: 4px 0 0;
            }

        /* Diseño institucional compartido */
        .cop-back-btn { border-radius: 9px; padding: .55rem 1rem; font-weight: 600; background: #fff; white-space: nowrap; }
        .cop-back-btn:hover { background: #edf3f8; color: #133C55; border-color: #386FA4; }
        .roles-header .roles-title i { color: #386FA4; }
        .roles-header { box-shadow: 0 2px 12px rgba(19,60,85,.035); }
        .assign-card, .permissions-card, .roles-card, .form-card { box-shadow: 0 5px 20px rgba(19,60,85,.055); }
        @@media (max-width: 576px) { .cop-back-btn { width: auto; } }

        .cop-topline { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:12px; }
        .cop-topline-note { color:#7b8794; font-size:.78rem; font-weight:600; letter-spacing:.04em; }
    </style>
}