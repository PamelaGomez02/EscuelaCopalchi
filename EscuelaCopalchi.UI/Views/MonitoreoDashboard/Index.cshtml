@model EscuelaCopalchi.UI.Models.MonitoreoNuevo.MonitoreoDashboardVM
@using System.Linq
@using System.Globalization
@{
    ViewBag.Title = "Monitoreo Académico";
    var lider = Model.Mejores.FirstOrDefault();
    var grupoLider = Model.RankingGrupos.FirstOrDefault();
    var menor = Model.Menores.FirstOrDefault();
    var trimestreActual = Model.Trimestre == 0 ? "Vista anual" : "Trimestre " + Model.Trimestre;
    var indicador = (Request.QueryString["indicador"] ?? "").ToLowerInvariant();
    var paginaIndicador = 1;
    int.TryParse(Request.QueryString["paginaIndicador"], out paginaIndicador);
    paginaIndicador = Math.Max(1, paginaIndicador);
    var resultadosIndicador = Model.Estudiantes.AsEnumerable();
    if (indicador == "bajo") { resultadosIndicador = resultadosIndicador.Where(x => x.Promedio < 65); }
    if (indicador == "critico") { resultadosIndicador = resultadosIndicador.Where(x => x.Promedio < 50); }
    if (indicador == "promedio" || indicador == "evaluados") { resultadosIndicador = resultadosIndicador.OrderByDescending(x => x.Promedio); }
    if (indicador == "bajo" || indicador == "critico") { resultadosIndicador = resultadosIndicador.OrderBy(x => x.Promedio); }
    var totalIndicador = resultadosIndicador.Count();
    var paginasIndicador = Math.Max(1, (int)Math.Ceiling(totalIndicador / 10.0));
    paginaIndicador = Math.Min(paginaIndicador, paginasIndicador);
    var filasIndicador = resultadosIndicador.Skip((paginaIndicador - 1) * 10).Take(10).ToList();
    var tituloIndicador = indicador == "bajo" ? "Estudiantes con rendimiento bajo" : indicador == "critico" ? "Estudiantes con rendimiento crítico" : indicador == "evaluados" ? "Estudiantes evaluados" : "Rendimiento académico individual";
}
