                <a class="ma-btn ma-btn-excel" href="@Url.Action("ExportarExcel", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo })"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                <a class="ma-btn ma-btn-pdf" href="@Url.Action("ExportarPdf", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo })"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            </div>
        </div>
    </header>
    <form class="ma-card ma-filters" method="get" action="@Url.Action("Index")">
        <div>
            <label for="ma-anio">Año lectivo</label><select id="ma-anio" name="anio">
                @foreach (var a in Model.Anios)
                {
                    if (a == Model.Anio)
                    {
                        <option value="@a" selected="selected">@a</option>
 }
                    else
                    {
                        <option value="@a">@a</option>
}
                }
            </select>
        </div>
        <div>
            <label for="ma-trim">Periodo de análisis</label><select id="ma-trim" name="trimestre">
                @if (Model.Trimestre == 0)
                {
                    <option value="0" selected="selected">Año completo</option>
 }
                else
                {
                    <option value="0">Año completo</option>
}
                @for (int t = 1; t <= 3; t++)
                {
                    if (t == Model.Trimestre)
                    {
                        <option value="@t" selected="selected">Trimestre @t</option>
 }
                    else
                    {
                        <option value="@t">Trimestre @t</option>
}
                }
            </select>
        </div>
        <div>
            <label for="ma-grupo">Grupo académico</label><select id="ma-grupo" name="grupo">
                @if (Model.IdGrupo == 0)
                {
                    <option value="0" selected="selected">Todos los grupos</option>
 }
                else
                {
                    <option value="0">Todos los grupos</option>
}
                @foreach (var g in Model.Grupos)
                {
                    if (g.IdGrupo == Model.IdGrupo)
                    {
                        <option value="@g.IdGrupo" selected="selected">@g.Nombre</option>
 }
                    else
                    {
                        <option value="@g.IdGrupo">@g.Nombre</option>
}
                }
            </select>
        </div>
        <button type="submit" class="ma-btn ma-btn-primary"><i class="bi bi-funnel"></i> Aplicar filtros</button>
    </form>
    <div class="ma-kpis" aria-label="Indicadores académicos interactivos">
        <a class="ma-card ma-kpi ma-kpi-link" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = "promedio" })#ma-desglose"><div class="ma-icon"><i class="bi bi-mortarboard"></i></div><small>Promedio académico</small><strong>@(Model.PromedioGeneral.HasValue ? Model.PromedioGeneral.Value.ToString("N2") : "—")</strong><span class="ma-note">Ver estudiantes y sus promedios <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-link" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = "evaluados" })#ma-desglose"><div class="ma-icon"><i class="bi bi-people"></i></div><small>Estudiantes evaluados</small><strong>@Model.TotalEvaluados</strong><span class="ma-note">Ver listado de evaluados <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-risk ma-kpi-link" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = "bajo" })#ma-desglose"><div class="ma-icon"><i class="bi bi-exclamation-triangle"></i></div><small>Rendimiento bajo</small><strong>@Model.EnRiesgo</strong><span class="ma-note">Ver estudiantes con promedio inferior a 65 <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-alert ma-kpi-link" href="@Url.Action("Seguimiento", new { anio = Model.Anio, grupo = Model.IdGrupo })"><div class="ma-icon"><i class="bi bi-clipboard2-pulse"></i></div><small>Casos en seguimiento</small><strong>@Model.SeguimientosAbiertos</strong><span class="ma-note">Consultar intervenciones <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-link" href="#ma-asistencia-info"><div class="ma-icon"><i class="bi bi-calendar-check"></i></div><small>Asistencia registrada</small><strong>@(Model.Asistencia.HasValue ? Model.Asistencia.Value.ToString("N1") + "%" : "—")</strong><span class="ma-note">Ver información del indicador <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-link" href="#ma-grupos"><div class="ma-icon"><i class="bi bi-diagram-3"></i></div><small>Grupos evaluados</small><strong>@Model.RankingGrupos.Count</strong><span class="ma-note">Ver comparación entre grupos <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-alert ma-kpi-link" href="#ma-alertas-info"><div class="ma-icon"><i class="bi bi-bell"></i></div><small>Alertas pendientes</small><strong>@Model.AlertasPendientes</strong><span class="ma-note">Ver información de alertas <i class="bi bi-arrow-right"></i></span></a>
        <a class="ma-card ma-kpi ma-kpi-risk ma-kpi-link" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = "critico" })#ma-desglose"><div class="ma-icon"><i class="bi bi-heart-pulse"></i></div><small>Rendimiento crítico</small><strong>@Model.Criticos</strong><span class="ma-note">Ver estudiantes con promedio inferior a 50 <i class="bi bi-arrow-right"></i></span></a>
    </div>
    @if (new[] { "bajo", "critico", "promedio", "evaluados" }.Contains(indicador))
    {
        <section class="ma-card ma-drilldown" id="ma-desglose" tabindex="-1">
            <div class="ma-card-title"><div><h3><i class="bi bi-filter-circle"></i> @tituloIndicador</h3><p class="ma-note">@totalIndicador estudiantes · @trimestreActual · Año @Model.Anio · Paginación de 10 registros</p></div><a class="ma-btn" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo })"><i class="bi bi-x-lg"></i> Cerrar filtro</a></div>
            <div class="ma-scroll">
                <table>
                    <thead><tr><th>Estudiante</th><th>Grupo</th><th>Materias</th><th class="num">Promedio</th><th>Situación</th><th>Acción</th></tr></thead>
                    <tbody>
                        @foreach (var e in filasIndicador)
                        {
                            <tr><td>@e.Nombre</td><td>@e.Grupo</td><td>@e.Materias</td><td class="num">@e.Promedio.ToString("N2")</td><td><span class="ma-tag @(e.Promedio < 50 ? "danger" : e.Promedio < 65 ? "warn" : "ok")">@e.Estado</span></td><td><a class="link" href="@Url.Action("Detalle", new { id = e.IdEstudiante, grupo = e.IdGrupo, anio = Model.Anio })">Ver ficha <i class="bi bi-arrow-right"></i></a></td></tr>
                        }
                        @if (!filasIndicador.Any())
                        {
                            <tr><td colspan="6" class="ma-empty">No hay estudiantes que cumplan esta condición en el periodo seleccionado.</td></tr>
}
                    </tbody>
                </table>
            </div>
            <div class="ma-pages">
                @if (paginaIndicador > 1)
                {<a class="ma-btn" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = indicador, paginaIndicador = paginaIndicador - 1 })#ma-desglose">Anterior</a>}
                <span>Página @paginaIndicador de @paginasIndicador</span>
                @if (paginaIndicador < paginasIndicador)
                {<a class="ma-btn" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, indicador = indicador, paginaIndicador = paginaIndicador + 1 })#ma-desglose">Siguiente</a>}
            </div>
        </section>
    }
    <div class="ma-indicator-notes">
        <section class="ma-card ma-indicator-note" id="ma-asistencia-info"><h3><i class="bi bi-calendar-check"></i> Asistencia registrada</h3><p>Porcentaje anual de asistencia del alcance seleccionado: <strong>@(Model.Asistencia.HasValue ? Model.Asistencia.Value.ToString("N1") + "%" : "Sin registros")</strong>. Este panel muestra el resumen existente; el desglose por estudiante requiere una consulta adicional de asistencia.</p></section>
        <section class="ma-card ma-indicator-note" id="ma-alertas-info"><h3><i class="bi bi-bell"></i> Alertas académicas pendientes</h3><p>Alertas sin atender: <strong>@Model.AlertasPendientes</strong>. El indicador procede de la tabla de alertas. Para consultar cada alerta individual necesitaremos incorporar su listado al repositorio.</p></section>
    </div>
    <div class="ma-section"><div><h2><i class="bi bi-award"></i> Reconocimientos académicos</h2><p>Estudiantes y grupos con mejores resultados del periodo seleccionado</p></div></div>
    <div class="ma-highlight">
        <div class="ma-card"><div class="ma-highlight-icon"><i class="bi bi-trophy"></i></div><div><h3>Estudiante con mejor promedio</h3><strong>@(lider == null ? "Sin información" : lider.Nombre)</strong><p>@(lider == null ? "" : lider.Grupo + " · " + lider.Promedio.ToString("N2") + " puntos")</p></div></div>
        <div class="ma-card"><div class="ma-highlight-icon"><i class="bi bi-stars"></i></div><div><h3>Grupo con mejor rendimiento</h3><strong>@(grupoLider == null ? "Sin información" : grupoLider.Grupo)</strong><p>@(grupoLider == null ? "" : grupoLider.Promedio.ToString("N2") + " puntos · " + grupoLider.Estudiantes + " estudiantes evaluados")</p></div></div>
    </div>
    <div class="ma-split">
        <div class="ma-card">
            <div class="ma-card-title"><h3><i class="bi bi-trophy"></i> Top 10 · Mejores promedios</h3><span>Excelencia</span></div><div class="ma-scroll">
                <table>
                    <thead><tr><th>Posición</th><th>Estudiante</th><th>Grupo</th><th class="num">Promedio</th></tr></thead>
                    <tbody>
                        @{ int posicion = 0; }
                        @foreach (var e in Model.Mejores)
                        {
                            posicion++;
                            <tr><td><span class="ma-rank @(posicion == 1 ? "first" : "")">@posicion</span></td><td><a class="link" href="@Url.Action("Detalle", new { id = e.IdEstudiante, grupo = e.IdGrupo, anio = Model.Anio })">@e.Nombre</a></td><td>@e.Grupo</td><td class="num">@e.Promedio.ToString("N2")</td></tr>
                        }
                        @if (!Model.Mejores.Any())
                        {
                            <tr><td colspan="4" class="ma-empty">No hay calificaciones disponibles.</td></tr>
}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="ma-card">
            <div class="ma-card-title"><h3><i class="bi bi-shield-exclamation"></i> Atención prioritaria</h3><span>Menores promedios</span></div><div class="ma-scroll">
                <table>
                    <thead><tr><th>Estudiante</th><th>Grupo</th><th class="num">Promedio</th><th>Situación</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Menores)
                        {
                            <tr><td><a class="link" href="@Url.Action("Detalle", new { id = e.IdEstudiante, grupo = e.IdGrupo, anio = Model.Anio })">@e.Nombre</a></td><td>@e.Grupo</td><td class="num">@e.Promedio.ToString("N2")</td><td><span class="ma-tag @(e.Promedio < 50 ? "danger" : e.Promedio < 65 ? "warn" : "ok")">@e.Estado</span></td></tr>
                        }
                        @if (!Model.Menores.Any())
                        {
                            <tr><td colspan="4" class="ma-empty">No hay calificaciones disponibles.</td></tr>
}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="ma-section"><div><h2><i class="bi bi-bar-chart-line"></i> Análisis del rendimiento</h2><p>Gráficos dinámicos de grupos, materias y evolución entre trimestres</p></div></div>
    <div class="ma-split">
        <div class="ma-card" id="ma-grupos">
            <div class="ma-card-title"><h3>Comparación entre grupos</h3><span>Promedio de 0 a 100</span></div><div class="ma-chart">
                <canvas id="ma-chart-grupos" role="img" aria-label="Promedios por grupo"></canvas><div class="ma-fallback" id="ma-fallback-grupos">
                    @foreach (var g in Model.RankingGrupos)
                    {<div><div class="ma-note"><span>@g.Grupo</span><b>@g.Promedio.ToString("N2")</b></div><div class="ma-bar"><span style="width:@(g.Promedio.ToString(CultureInfo.InvariantCulture))%"></span></div></div>}
                </div>
            </div>
        </div>
        <div class="ma-card">
            <div class="ma-card-title"><h3>Rendimiento por asignatura</h3><span>Promedio de 0 a 100</span></div><div class="ma-chart">
                <canvas id="ma-chart-materias" role="img" aria-label="Promedios por materia"></canvas><div class="ma-fallback" id="ma-fallback-materias">
                    @foreach (var m in Model.RankingMaterias)
                    {<div><div class="ma-note"><span>@m.Materia</span><b>@m.Promedio.ToString("N2")</b></div><div class="ma-bar"><span style="width:@(m.Promedio.ToString(CultureInfo.InvariantCulture))%"></span></div></div>}
                </div>
            </div>
        </div>
    </div>
    <div class="ma-card" style="margin-top:15px">
        <div class="ma-card-title"><h3><i class="bi bi-activity"></i> Evolución del año lectivo</h3><span>Comparación trimestral</span></div><div class="ma-chart">
            <canvas id="ma-chart-evolucion" role="img" aria-label="Evolución trimestral"></canvas><div class="ma-fallback" id="ma-fallback-evolucion">
                @foreach (var t in Model.Evolucion)
                {<div><div class="ma-note"><span>Trimestre @t.Trimestre</span><b>@t.Promedio.ToString("N2")</b></div><div class="ma-bar"><span style="width:@(t.Promedio.ToString(CultureInfo.InvariantCulture))%"></span></div></div>}
            </div>
        </div>
    </div>
    <div class="ma-shortcut"><div><strong><i class="bi bi-clipboard2-check"></i> Seguimiento de estudiantes</strong><p>Consulta las intervenciones registradas y accede a las fichas de seguimiento individual.</p></div><a class="ma-btn ma-btn-primary" href="@Url.Action("Seguimiento", new { anio = Model.Anio, grupo = Model.IdGrupo })">Abrir seguimiento <i class="bi bi-arrow-right"></i></a></div>
    <div class="ma-section"><div><h2><i class="bi bi-search"></i> Consulta individual</h2><p>Listado de estudiantes con calificaciones, ordenado y paginado de 10 en 10</p></div></div>
    <div class="ma-card">
        <form class="ma-search" method="get" action="@Url.Action("Index")">
            <input type="hidden" name="anio" value="@Model.Anio" /><input type="hidden" name="trimestre" value="@Model.Trimestre" /><input type="hidden" name="grupo" value="@Model.IdGrupo" />
            <div><label for="ma-buscar">Buscar estudiante</label><input id="ma-buscar" name="buscar" value="@Model.Buscar" placeholder="Nombre del estudiante" /></div>
            <div>
                <label for="ma-estado">Estado académico</label><select id="ma-estado" name="estado">
                    @if (string.IsNullOrEmpty(Model.Estado))
                    {
                        <option value="" selected="selected">Todos los estados</option>
 }
                    else
                    {
                        <option value="">Todos los estados</option>
}
                    @foreach (var est in new[] { "Crítico", "En riesgo", "Satisfactorio" })
                    {
                        if (Model.Estado == est)
                        {
                            <option value="@est" selected="selected">@est</option>
 }
                        else
                        {
                            <option value="@est">@est</option>
}
                    }
                </select>
            </div>
            <button class="ma-btn ma-btn-primary" type="submit"><i class="bi bi-search"></i> Buscar</button>
        </form>
        <div class="ma-scroll">
            <table>
                <thead><tr><th>Estudiante</th><th>Grupo</th><th>Materias</th><th class="num">Promedio</th><th>Estado</th><th>Ficha</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Listado)
                    {
                        <tr><td>@e.Nombre</td><td>@e.Grupo</td><td>@e.Materias</td><td class="num">@e.Promedio.ToString("N2")</td><td><span class="ma-tag @(e.Promedio < 50 ? "danger" : e.Promedio < 65 ? "warn" : "ok")">@e.Estado</span></td><td><a class="link" href="@Url.Action("Detalle", new { id = e.IdEstudiante, grupo = e.IdGrupo, anio = Model.Anio })">Ver detalle <i class="bi bi-arrow-right"></i></a></td></tr>
                    }
                    @if (!Model.Listado.Any())
                    {
                        <tr><td colspan="6" class="ma-empty">No se encontraron estudiantes con los filtros seleccionados.</td></tr>
}
                </tbody>
            </table>
        </div>
        <div class="ma-pages">
            @if (Model.Pagina > 1)
            {<a class="ma-btn" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, buscar = Model.Buscar, estado = Model.Estado, pagina = Model.Pagina - 1 })">Anterior</a>}
            <span>Página @Model.Pagina de @Model.TotalPaginas</span>
            @if (Model.Pagina < Model.TotalPaginas)
            {<a class="ma-btn" href="@Url.Action("Index", new { anio = Model.Anio, trimestre = Model.Trimestre, grupo = Model.IdGrupo, buscar = Model.Buscar, estado = Model.Estado, pagina = Model.Pagina + 1 })">Siguiente</a>}
        </div>
    </div>
    <p class="ma-footer">Los promedios se calculan con las evaluaciones activas y calificaciones disponibles. Los trimestres sin notas no se consideran como cero. Los indicadores de asistencia corresponden al año completo. Los umbrales de riesgo son orientativos y deben validarse con la normativa institucional.</p>
</div>
@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
(function () {
    var grupos = @Html.Raw(Json.Encode(Model.RankingGrupos.Select(x => new { nombre = x.Grupo, promedio = x.Promedio, cantidad = x.Estudiantes })));
    var materias = @Html.Raw(Json.Encode(Model.RankingMaterias.Select(x => new { nombre = x.Materia, promedio = x.Promedio, cantidad = x.Estudiantes })));
    var evolucion = @Html.Raw(Json.Encode(Model.Evolucion.Select(x => new { trimestre = x.Trimestre, promedio = x.Promedio, cantidad = x.Estudiantes })));
    if (typeof Chart === 'undefined') {
        ['grupos','materias','evolucion'].forEach(function (n) { var c = document.getElementById('ma-chart-' + n); if (c) c.style.display='none'; var f=document.getElementById('ma-fallback-'+n); if(f)f.style.display='block'; });
        return;
    }
    Chart.defaults.font.family = 'Arial, sans-serif';
    Chart.defaults.color = '#668198';
    var base = { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { backgroundColor: '#173e5d', padding: 11 } }, scales: { y: { beginAtZero: true, max: 100, grid: { color: '#eaf0f5' } }, x: { grid: { display: false } } } };
    function make(id, type, labels, data, color) {
        var canvas = document.getElementById(id);
        if (!canvas || !labels.length) { if(canvas)canvas.style.display='none'; return; }
        new Chart(canvas, { type: type, data: { labels: labels, datasets: [{ label: 'Promedio', data: data, backgroundColor: color, borderColor: '#237cae', borderWidth: type === 'line' ? 3 : 0, borderRadius: type === 'bar' ? 5 : 0, fill: type === 'line', tension: .3, pointRadius: 5 }] }, options: base });
    }
    make('ma-chart-grupos','bar',grupos.map(function(x){return x.nombre;}),grupos.map(function(x){return x.promedio;}),'#3188b8');
    make('ma-chart-materias','bar',materias.map(function(x){return x.nombre;}),materias.map(function(x){return x.promedio;}),'#65a9c9');
    make('ma-chart-evolucion','line',['I trimestre','II trimestre','III trimestre'],[1,2,3].map(function(t){var x=evolucion.find(function(z){return z.trimestre===t;});return x?x.promedio:null;}),'rgba(47,142,185,.14)');
})();
    </script>
}
