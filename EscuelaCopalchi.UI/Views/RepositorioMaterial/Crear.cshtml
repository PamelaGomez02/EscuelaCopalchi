
@model EscuelaCopalchi.UI.Models.RepositorioMaterialViewModel

@{
    ViewBag.Title = "Cargar material";

    bool puedeCargarMaterial =
        Convert.ToBoolean(ViewBag.PuedeCargarMaterial ?? false);

    bool puedeCargarInstitucional =
        Convert.ToBoolean(
            ViewBag.PuedeCargarDocumentoInstitucional ?? false);
}

<div class="container py-4">


    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">

        <div>
            <h2 class="repo-title">
                <i class="bi bi-cloud-arrow-up me-2"></i>
                Cargar material
            </h2>

            <p class="text-muted mb-0">
                Agrega material didáctico o documentos institucionales
                al repositorio.
            </p>
        </div>

        <a href="@Url.Action("Index", "RepositorioMaterial")"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al repositorio
        </a>

    </div>


    <div class="form-card">

        <!-- INFORMACIÓN -->
        <div class="mb-4">

            <h5>
                <i class="bi bi-file-earmark-plus me-2"></i>
                Nuevo material
            </h5>

            <p class="text-muted mb-0">
                Completá la información del material y seleccioná
                el archivo que deseas cargar.
            </p>

        </div>

        <!-- PERMISOS DISPONIBLES -->
        @if (puedeCargarMaterial || puedeCargarInstitucional)
        {
            <div class="alert alert-info">

                <i class="bi bi-info-circle me-2"></i>

                Podés cargar:

                @if (puedeCargarMaterial)
                {
                    <strong>Material didáctico</strong>
                }

                @if (puedeCargarMaterial && puedeCargarInstitucional)
                {
                    <span> y </span>
                }

                @if (puedeCargarInstitucional)
                {
                    <strong>Documentos institucionales</strong>
                }

            </div>
        }

        <!-- FORMATOS -->
        <div class="repo-formatos mb-4">

            <div class="d-flex align-items-start gap-2">

                <i class="bi bi-paperclip"></i>

                <div>
                    <strong>Formatos permitidos</strong>

                    <p class="mb-1">
                        PDF, Word, Excel, PowerPoint e imágenes
                        JPG, JPEG y PNG.
                    </p>

                    <small class="text-muted">
                        Tamaño máximo por archivo: 50 MB.
                    </small>
                </div>

            </div>

        </div>

        <!-- FORMULARIO -->
        @using (Html.BeginForm(
            "Crear",
            "RepositorioMaterial",
            FormMethod.Post,
            new
            {
                enctype = "multipart/form-data",
                id = "formCrearMaterial"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger mb-3" })

            @Html.Partial("_Formulario", Model)
        }

    </div>



</div>

@section styles {

    <style>

        body {
            background: #f4f7fa;
        }

        .repo-title {
            color: #133c55;
            font-weight: 700;
        }

        .form-card {
            max-width: 950px;
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .repo-formatos {
            background: #f8fafc;
            border: 1px solid #e3e8ee;
            border-radius: 8px;
            padding: 15px;
            color: #334155;
        }

            .repo-formatos i {
                color: #133c55;
                font-size: 20px;
            }

        .upload-box {
            border: 2px dashed #cad5df;
            border-radius: 10px;
            padding: 24px;
            text-align: center;
            background: #fafcfd;
        }

        .btn-cop-primary {
            background: #133c55;
            color: white;
            border-color: #133c55;
        }

            .btn-cop-primary:hover {
                background: #386fa4;
                color: white;
                border-color: #386fa4;
            }

        .form-label {
            color: #334155;
            font-weight: 600;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #386fa4;
            box-shadow: 0 0 0 0.2rem rgba(56, 111, 164, 0.15);
        }

        @@media (max-width: 768px) {

            .form-card {
                padding: 18px;
            }
        }


        .upload-box {
            border: 2px dashed #91afc8;
            border-radius: 12px;
            background: #f4f9fd;
            padding: 32px 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .upload-box:hover,
            .upload-box:focus-visible,
            .upload-box.drag-over {
                border-color: #133c55;
                background: #e8f2fa;
                box-shadow: 0 0 0 3px rgba(19, 60, 85, 0.08);
            }

        .upload-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto;
            border-radius: 50%;
            background: #e1edf7;
            color: #133c55;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .upload-button {
            padding: 11px 25px;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 3px 8px rgba(19, 60, 85, 0.15);
        }

            .upload-button:hover {
                transform: translateY(-1px);
            }

        .upload-input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            overflow: hidden;
        }

    </style>
}
