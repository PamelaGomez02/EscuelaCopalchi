
@model EscuelaCopalchi.UI.Models.RepositorioMaterialViewModel

@{
    ViewBag.Title = "Editar material";
}

<div class="container py-4">


    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">

        <div>
            <h2 class="repo-title">
                <i class="bi bi-cloud-arrow-up me-2"></i>
                Cargar material
            </h2>

            <p class="text-muted mb-0">
                Agrega material didáctico o documentos institucionales
                al repositorio.
            </p>
        </div>

        <a href="@Url.Action("Index", "RepositorioMaterial")"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al repositorio
        </a>

    </div>

    <div class="form-card">

        <!-- INFORMACIÓN DEL MATERIAL -->
        <div class="mb-4">

            <h5 class="mb-3">
                <i class="bi bi-file-earmark-text me-2"></i>
                Información del material
            </h5>

            <div class="alert alert-info">

                <div class="mb-2">
                    <strong>Material:</strong>
                    @Model.Titulo
                </div>

                <div class="mb-2">
                    <strong>Tipo:</strong>
                    @Model.TipoMaterial
                </div>

                <div>
                    <strong>Archivo actual:</strong>

                    @if (!string.IsNullOrWhiteSpace(Model.NombreArchivo))
                    {
                        string extensionActual =
                            System.IO.Path.GetExtension(
                                Model.NombreArchivo
                            ).ToLowerInvariant();

                        if (extensionActual == ".jpg" ||
                            extensionActual == ".jpeg" ||
                            extensionActual == ".png")
                        {
                            <div class="mt-3 mb-4">

                                <h6>
                                    <i class="bi bi-eye me-1"></i>
                                    Vista previa del archivo actual
                                </h6>

                                <div class="upload-box">

                                    <img src="@Url.Action(
                        "VistaPrevia",
                        "RepositorioMaterial",
                        new { id = Model.IdMaterial })"
                                         alt="Vista previa de @Model.Titulo"
                                         class="img-fluid rounded"
                                         style="max-height:350px; object-fit:contain;" />

                                </div>

                            </div>
                        }
                        else if (extensionActual == ".pdf")
                        {
                            <div class="mt-3 mb-4">

                                <h6>
                                    <i class="bi bi-eye me-1"></i>
                                    Vista previa del documento actual
                                </h6>

                                <iframe src="@Url.Action(
                    "VistaPrevia",
                    "RepositorioMaterial",
                    new { id = Model.IdMaterial })"
                                        title="Vista previa del PDF"
                                        style="width:100%; height:450px; border:1px solid #dee2e6; border-radius:8px;">
                                </iframe>

                            </div>
                        }
                    }




                </div>

                <div class="small mt-2">
                    <i class="bi bi-info-circle me-1"></i>
                    Si no seleccionás otro archivo, se conservará el actual.
                </div>

            </div>
        </div>

        <!-- FORMULARIO -->
        @using (Html.BeginForm(
            "Editar",
            "RepositorioMaterial",
            FormMethod.Post,
            new { enctype = "multipart/form-data", id = "formEditarMaterial" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.IdMaterial)

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "alert alert-danger" })

            @Html.Partial("_Formulario", Model)
        }

    </div>

</div>

@section styles {

    <style>

        body {
            background: #f4f7fa;
        }

        .repo-title {
            color: #133c55;
            font-weight: 700;
        }

        .form-card {
            max-width: 950px;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .upload-box {
            border: 2px dashed #cad5df;
            border-radius: 10px;
            padding: 24px;
            text-align: center;
            background: #fafcfd;
        }

        .btn-cop-primary {
            background: #133c55;
            color: white;
            border-color: #133c55;
        }

            .btn-cop-primary:hover {
                background: #386fa4;
                color: white;
                border-color: #386fa4;
            }

        .form-label {
            color: #334155;
            font-weight: 600;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #386fa4;
            box-shadow: 0 0 0 0.2rem rgba(56, 111, 164, 0.15);
        }


        .upload-box {
            border: 2px dashed #91afc8;
            border-radius: 12px;
            background: #f4f9fd;
            padding: 32px 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .upload-box:hover,
            .upload-box:focus-visible,
            .upload-box.drag-over {
                border-color: #133c55;
                background: #e8f2fa;
                box-shadow: 0 0 0 3px rgba(19, 60, 85, 0.08);
            }

        .upload-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto;
            border-radius: 50%;
            background: #e1edf7;
            color: #133c55;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .upload-button {
            padding: 11px 25px;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 3px 8px rgba(19, 60, 85, 0.15);
        }

            .upload-button:hover {
                transform: translateY(-1px);
            }

        .upload-input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            overflow: hidden;
        }

    </style>
}
