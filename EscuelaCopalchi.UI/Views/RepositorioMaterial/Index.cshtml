
@model List<EscuelaCopalchi.UI.Models.RepositorioMaterialViewModel>

@using System
@using System.Linq

@{
    ViewBag.Title = "Repositorio de material";

    var materiales = Model ??
        new List<EscuelaCopalchi.UI.Models.RepositorioMaterialViewModel>();

    bool puedeCargarMaterial =
        Convert.ToBoolean(ViewBag.PuedeCargarMaterial ?? false);

    bool puedeCargarDocumentoInstitucional =
        Convert.ToBoolean(
            ViewBag.PuedeCargarDocumentoInstitucional ?? false);

    string busqueda = Convert.ToString(ViewBag.Busqueda ?? "");
    string categoria = Convert.ToString(ViewBag.Categoria ?? "");
    string tipo = Convert.ToString(ViewBag.Tipo ?? "");
    string grado = Convert.ToString(ViewBag.Grado ?? "");

    string[] categorias = {
        "Matemáticas",
        "Español",
        "Ciencias",
        "Estudios Sociales",
        "Inglés",
        "Institucional"
    };

    string[] tipos = {
        "Material didáctico",
        "Documento institucional",
        ".pdf",
        ".doc",
        ".docx",
        ".ppt",
        ".pptx",
        ".xls",
        ".xlsx",
        ".jpg",
        ".jpeg",
        ".png"
    };

    string[] grados = {
        "No aplica",
        "Primer grado",
        "Segundo grado",
        "Tercer grado",
        "Cuarto grado",
        "Quinto grado",
        "Sexto grado"
    };
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between
                align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h2 class="repo-title">
                <i class="bi bi-folder2-open"></i>
                Repositorio de material
            </h2>

            <p class="text-muted mb-0">
                Consulta, clasifica y administra material didáctico
                y documentos institucionales.
            </p>
        </div>

        @if (puedeCargarMaterial || puedeCargarDocumentoInstitucional)
        {
            <a class="btn btn-cop-primary"
               href="@Url.Action("Crear", "RepositorioMaterial")">

                <i class="bi bi-cloud-arrow-up me-1"></i>
                Cargar material
            </a>
        }
    </div>

    <!-- MENSAJES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- TARJETAS DE RESUMEN -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="repo-card p-3 h-100">

                <div class="d-flex align-items-center gap-3">

                    <div class="repo-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Materiales didácticos
                        </div>

                        <h3 class="mb-0">
                            @materiales.Count(x =>
                                x.TipoMaterial == "Material didáctico")
                        </h3>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="repo-card p-3 h-100">

                <div class="d-flex align-items-center gap-3">

                    <div class="repo-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Documentos institucionales
                        </div>

                        <h3 class="mb-0">
                            @materiales.Count(x =>
                                x.TipoMaterial == "Documento institucional")
                        </h3>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="repo-card p-3 h-100">

                <div class="d-flex align-items-center gap-3">

                    <div class="repo-icon">
                        <i class="bi bi-collection"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Total de materiales
                        </div>

                        <h3 class="mb-0">
                            @materiales.Count
                        </h3>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="repo-card">

        <div class="p-3 border-bottom">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2 mb-3">

                <h5 class="mb-0">
                    <i class="bi bi-folder me-1"></i>
                    Material disponible
                </h5>

                <span class="text-muted small">
                    @materiales.Count resultado(s)
                </span>
            </div>

            <!-- FORMULARIO DE FILTROS -->
            <form method="get"
                  action="@Url.Action("Index", "RepositorioMaterial")"
                  class="row g-2">

                <!-- BUSCAR -->
                <div class="col-md-3">

                    <input type="text"
                           class="form-control"
                           name="busqueda"
                           value="@busqueda"
                           placeholder="Buscar material..." />

                </div>

                <!-- CATEGORÍA -->
                <div class="col-md-3">

                    <select name="categoria" class="form-select">

                        <option value="">
                            Todas las categorías
                        </option>

                        @foreach (var c in categorias)
                        {
                            <option value="@c"
                                    selected="@(categoria == c ? "selected" : null)">
                                @c
                            </option>
                        }

                    </select>
                </div>

                <!-- TIPO -->
                <div class="col-md-2">

                    <select name="tipo" class="form-select">

                        <option value="">
                            Todos los tipos
                        </option>

                        @foreach (var t in tipos)
                        {
                            <option value="@t"
                                    selected="@(tipo == t ? "selected" : null)">
                                @t
                            </option>
                        }

                    </select>
                </div>

                <!-- GRADO -->
                <div class="col-md-2">

                    <select name="grado" class="form-select">

                        <option value="">
                            Todos los grados
                        </option>

                        @foreach (var g in grados)
                        {
                            <option value="@g"
                                    selected="@(grado == g ? "selected" : null)">
                                @g
                            </option>
                        }

                    </select>
                </div>

                <!-- BOTONES -->
                <div class="col-md-2">

                    <button class="btn btn-cop-primary w-100"
                            type="submit">

                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>

                </div>

                <div class="col-12">

                    <a class="small text-decoration-none"
                       href="@Url.Action("Index", "RepositorioMaterial")">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Limpiar filtros
                    </a>

                </div>

            </form>
        </div>

        <!-- TABLA DE MATERIALES -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Material</th>
                        <th>Categoría</th>
                        <th>Grado</th>
                        <th>Formato</th>
                        <th>Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var m in materiales)
                    {
                        <tr>

                            <!-- MATERIAL -->
                            <td>

                                <div class="d-flex align-items-center gap-2">

                                    <div class="repo-file-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>

                                    <div>
                                        <strong>@m.Titulo</strong>

                                        <div class="small text-muted">
                                            @m.TipoMaterial
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <!-- CATEGORÍA -->
                            <td>
                                @(!string.IsNullOrWhiteSpace(m.Categoria)
                                    ? m.Categoria
                                    : "Sin categoría")
                            </td>

                            <!-- GRADO -->
                            <td>
                                @(!string.IsNullOrWhiteSpace(m.Grado)
                                    ? m.Grado
                                    : "No aplica")
                            </td>

                            <!-- FORMATO -->
                            <td>

                                <span class="badge bg-light text-dark border">

                                    @(string.IsNullOrWhiteSpace(m.Tipo)
                                        ? "-"
                                        : m.Tipo.ToUpperInvariant())

                                </span>

                            </td>

                            <!-- FECHA -->
                            <td>
                                @m.FechaCarga.ToString("dd/MM/yyyy")
                            </td>

                            <!-- ACCIONES -->
                            <td class="text-center text-nowrap">

                                <!-- VER -->
                                <a class="btn btn-sm btn-outline-primary"
                                   title="Ver detalle"
                                   aria-label="Ver detalle"
                                   href="@Url.Action(
                                       "Detalle",
                                       "RepositorioMaterial",
                                       new { id = m.IdMaterial })">

                                    <i class="bi bi-eye"></i>
                                </a>

                                <!-- DESCARGAR -->
                                @if (m.PuedeDescargar &&
                                     !string.IsNullOrWhiteSpace(m.NombreArchivo))
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       title="Descargar"
                                       aria-label="Descargar"
                                       href="@Url.Action(
                                           "Descargar",
                                           "RepositorioMaterial",
                                           new { id = m.IdMaterial })">

                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                                <!-- EDITAR -->
                                @if (m.PuedeEditar)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       title="Editar"
                                       aria-label="Editar"
                                       href="@Url.Action(
                                           "Editar",
                                           "RepositorioMaterial",
                                           new { id = m.IdMaterial })">

                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }

                                <!-- ELIMINAR -->
                                @if (m.PuedeEliminar)
                                {
                                    using (Html.BeginForm(
                                        "Eliminar",
                                        "RepositorioMaterial",
                                        new { id = m.IdMaterial },
                                        FormMethod.Post,
                                        new
                                        {
                                            @class = "d-inline",
                                            onsubmit = "return confirm('¿Está seguro de eliminar este material?');"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-sm btn-outline-danger"
                                                type="submit"
                                                title="Eliminar"
                                                aria-label="Eliminar">

                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                }

                            </td>
                        </tr>
                    }

                    <!-- SIN RESULTADOS -->
                    @if (!materiales.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center py-5">

                                <i class="bi bi-folder-x repo-empty-icon"></i>

                                <h6 class="mt-3">
                                    No se encontraron materiales
                                </h6>

                                <p class="text-muted mb-0">
                                    Probá cambiando los filtros de búsqueda.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

    </div>
</div>

@section styles {

    <style>

        body {
            background: #f4f7fa;
        }

        .repo-title {
            color: #133c55;
            font-weight: 700;
        }

        .repo-card {
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .repo-icon {
            background: #e8f0f7;
            color: #133c55;
            border-radius: 10px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
        }

        .repo-file-icon {
            background: #edf3f8;
            color: #133c55;
            border-radius: 8px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .btn-cop-primary {
            background: #133c55;
            color: white;
            border-color: #133c55;
        }

            .btn-cop-primary:hover {
                background: #386fa4;
                color: white;
                border-color: #386fa4;
            }

        .repo-card .table th {
            color: #334155;
            font-weight: 600;
            font-size: 14px;
        }

        .repo-card .table td {
            font-size: 14px;
        }

        .repo-empty-icon {
            font-size: 42px;
            color: #9ca3af;
        }

        .repo-card .btn-sm {
            margin: 2px;
        }
    </style>
}
