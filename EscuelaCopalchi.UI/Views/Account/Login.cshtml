@model EscuelaCopalchi.UI.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión - Aula Virtual Copalchí</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; font-family: 'Segoe UI', Arial, sans-serif; background: #eaf4fc; }
        .login-layout { display: grid; grid-template-columns: 60% 40%; min-height: 100vh; }
        .photo-panel { position: relative; background: url('@Url.Content("~/Content/Images/escuela-copalchi.png")') center center / cover no-repeat; overflow: hidden; }
        .photo-panel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,36,59,.03) 45%, rgba(8,36,59,.72) 100%); }
        .photo-caption { position: absolute; z-index: 1; bottom: 48px; left: 7%; right: 7%; color: #fff; }
        .photo-caption h2 { font-weight: 750; font-size: clamp(24px, 2.5vw, 40px); margin-bottom: 8px; }
        .photo-caption p { margin: 0; font-size: 16px; opacity: .95; }
        .photo-caption { border-left: 4px solid #78b6ef; padding-left: 20px; }
        .form-panel { position: relative; z-index: 2; margin-left: -38px; border-radius: 9% 0 0 9% / 50% 0 0 50%; display: flex; align-items: center; justify-content: center; padding: 45px clamp(25px, 4vw, 80px) 45px clamp(55px, 5vw, 100px); background: linear-gradient(135deg, #F0F8FF 0%, #DCEEFF 100%); }
        .form-content { width: 100%; max-width: 430px; }
        .crest { display: block; width: 112px; height: 138px; object-fit: contain; margin: 0 auto 18px; }
        .login-title { font-size: clamp(25px, 2.2vw, 34px); font-weight: 750; color: #133C55; text-align: center; margin-bottom: 8px; }
        .login-subtitle { text-align: center; color: #60758a; margin-bottom: 15px; }
        .login-accent { width: 54px; height: 3px; border-radius: 4px; background: #133C55; margin: 0 auto 35px; }
        .form-label { color: #133C55; font-weight: 600; font-size: 14px; }
        .form-control { border-radius: 10px; border: 1px solid #d5dfe7; padding: 12px 14px; min-height: 49px; }
        .form-control:focus { border-color: #386FA4; box-shadow: 0 0 0 .2rem rgba(56,111,164,.14); }
        .password-wrap { position: relative; }
        .password-wrap .form-control { padding-right: 54px; }
        .toggle-password { position: absolute; right: 6px; top: 5px; width: 40px; height: 39px; border: 0; background: transparent; color: #567085; }
        .btn-login { width: 100%; min-height: 51px; border: 0; border-radius: 10px; background: #133C55; color: white; font-weight: 650; transition: background .2s; }
        .btn-login:hover { background: #386FA4; color: white; }
        .login-footer { text-align: center; color: #82909c; font-size: 12px; margin-top: 38px; }
        .field-validation-error { display: block; margin-top: 5px; }
        @@media (max-width: 800px) {
            .login-layout { display: flex; flex-direction: column; }
            .photo-panel { min-height: 185px; background-position: center 65%; }
            .photo-caption { bottom: 20px; }
            .photo-caption h2 { font-size: 22px; }
            .photo-caption p { font-size: 13px; }
            .form-panel { flex: 1; margin-left: 0; border-radius: 0; padding: 35px 24px; }
            .crest { width: 85px; height: 105px; }
        }
    </style>
</head>
<body>
    <main class="login-layout">
        <section class="photo-panel" aria-label="Fotografía del Centro Educativo Copalchí">
            <div class="photo-caption">
                <h2>Centro Educativo Copalchí</h2>
                <p>Un espacio para aprender, enseñar y crecer.</p>
            </div>
        </section>
        <section class="form-panel">
            <div class="form-content">
                <img class="crest" src="@Url.Content("~/Content/Images/escudo-copalchi.png")" alt="Escudo del Centro Educativo Copalchí" />
                <h1 class="login-title">Aula Virtual Copalchí</h1>
                <p class="login-subtitle">Ingrese sus credenciales para continuar</p>
                <div class="login-accent" aria-hidden="true"></div>
                @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { autocomplete = "on" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Correo, "Correo institucional", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", placeholder = "usuario@copalchi.ed.cr", autocomplete = "username", required = "required" })
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-4">
                        @Html.LabelFor(m => m.Contrasena, "Contraseña", new { @class = "form-label" })
                        <div class="password-wrap">
                            @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", placeholder = "Ingrese su contraseña", autocomplete = "current-password", required = "required" })
                            <button type="button" class="toggle-password" id="mostrarClave" aria-label="Mostrar contraseña" aria-pressed="false"><i class="bi bi-eye"></i></button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                    </div>
                    <button type="submit" class="btn btn-login"><i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión</button>
                }
                <div class="login-footer">© @DateTime.Now.Year - Aula Virtual Copalchí</div>
            </div>
        </section>
    </main>
    <script>
                document.getElementById('mostrarClave').addEventListener('click', function () {
                    var campo = document.getElementById('Contrasena');
                    var visible = campo.type === 'text';
                    campo.type = visible ? 'password' : 'text';
                    this.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
                    this.setAttribute('aria-pressed', String(!visible));
                    this.querySelector('i').className = visible ? 'bi bi-eye' : 'bi bi-eye-slash';
                });
    </script>
</body>
</html>
