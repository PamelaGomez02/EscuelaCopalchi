
@model EscuelaCopalchi.UI.Models.LoginViewModel

@{
    Layout = null;
    ViewBag.Title = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión - Aula Virtual Copalchí</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient( 180deg, #133C55 0%, #386FA4 100% );
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .cop-login-wrapper {
            width: 100%;
            max-width: 520px;
            padding: 20px;
        }

        .cop-login-brand {
            text-align: center;
            color: #ffffff;
            margin-bottom: 26px;
        }

            .cop-login-brand i {
                display: block;
                font-size: 44px;
                margin-bottom: 12px;
            }

            .cop-login-brand h1 {
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .cop-login-brand p {
                color: #dce8f2;
                font-size: 15px;
                margin: 0;
            }

        .cop-login-card {
            background: white;
            border-radius: 14px;
            padding: 40px;
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #133C55;
        }

        .form-control {
            min-height: 48px;
            border-radius: 8px;
            border: 1px solid #dfe4ea;
        }

            .form-control:focus {
                border-color: #59A5D8;
                box-shadow: 0 0 0 3px rgba(89,165,216,.2);
            }

        .cop-btn-login {
            width: 100%;
            min-height: 49px;
            background: #133C55;
            border: 1px solid #133C55;
            color: white;
            font-weight: 600;
            border-radius: 8px;
        }

            .cop-btn-login:hover {
                background: #386FA4;
                color: white;
            }

        .cop-login-footer {
            text-align: center;
            color: #dce8f2;
            font-size: 12px;
            margin-top: 22px;
        }

        .cop-login-note {
            text-align: center;
            color: #6c757d;
            font-size: 13px;
            margin-top: 18px;
        }

        @@media (max-width: 576px) {
            .cop-login-card {
                padding: 28px 22px;
            }

            .cop-login-brand h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <div class="cop-login-wrapper">

        <div class="cop-login-brand">
            <i class="bi bi-mortarboard"></i>

            <h1>Aula Virtual Copalchí</h1>

            <p>Ingresa con tu cuenta institucional</p>
        </div>

        <div class="cop-login-card">

            @using (Html.BeginForm(
                "Login",
                "Account",
                new { returnUrl = ViewBag.ReturnUrl },
                FormMethod.Post,
                new { id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true, "",
                    new { @class = "alert alert-danger" })

                <div class="mb-3">
                    <label for="Correo" class="form-label">
                        Correo institucional
                    </label>

                    @Html.TextBoxFor(
                        m => m.Correo,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "nombre@copalchi.edu",
                            autocomplete = "username",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Correo,
                        "",
                        new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label for="Contrasena" class="form-label">
                        Contraseña
                    </label>

                    @Html.PasswordFor(
                        m => m.Contrasena,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese su contraseña",
                            autocomplete = "current-password",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Contrasena,
                        "",
                        new { @class = "text-danger small" })
                </div>

                <button type="submit"
                        class="btn cop-btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Ingresar
                </button>
            }

            <div class="cop-login-note">
                ¿No tienes una cuenta?
                Solicita acceso al administrador.
            </div>

        </div>

        <div class="cop-login-footer">
            &copy; @DateTime.Now.Year - Escuela Copalchí
        </div>

    </div>

</body>
</html>
