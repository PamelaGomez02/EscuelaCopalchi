@{
    ViewBag.Title = "Auditoría del sistema";
}

<main>

    <!-- ENCABEZADO -->
    <section class="audit-header">

        <div class="container">

            <div class="audit-breadcrumb">

                <a href="@Url.Action("Index", "Home")">
                    Inicio
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Auditoría del sistema</span>

            </div>


            <h1 class="audit-title">

                <i class="bi bi-journal-check me-2"></i>
                Auditoría del sistema

            </h1>


            <p class="audit-subtitle">
                Consulta la bitácora de acciones críticas realizadas en el sistema.
            </p>

        </div>

    </section>


    <!-- CONTENIDO -->
    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-list-check"></i>
                    </div>

                    <div>
                        <span>Eventos registrados</span>
                        <h2>128</h2>
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div>
                        <span>Eventos de hoy</span>
                        <h2>12</h2>
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>
                        <span>Usuarios con actividad</span>
                        <h2>7</h2>
                    </div>

                </div>

            </div>

        </div>


        <!-- CONTENEDOR PRINCIPAL -->
        <div class="audit-card">

            <!-- TOOLBAR -->
            <div class="audit-toolbar">

                <div>

                    <h2>
                        Registro de actividad
                    </h2>

                    <p>
                        Consulta las acciones realizadas por los usuarios del sistema.
                    </p>

                </div>


                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar evento..." />

                </div>

            </div>


            <!-- FILTROS -->
            <div class="audit-filters">

                <div>

                    <label class="filter-label">
                        Módulo
                    </label>

                    <select class="form-select">

                        <option selected>
                            Todos los módulos
                        </option>

                        <option>Roles</option>
                        <option>Usuarios</option>
                        <option>Estudiantes</option>
                        <option>Gestión académica</option>
                        <option>Planes de estudio</option>
                        <option>Material didáctico</option>
                        <option>Asistencia</option>
                        <option>Gestión de notas</option>
                        <option>Monitoreo académico</option>
                        <option>Inventario de limpieza</option>
                        <option>Inventario de cocina</option>

                    </select>

                </div>


                <div>

                    <label class="filter-label">
                        Usuario
                    </label>

                    <select class="form-select">

                        <option selected>
                            Todos los usuarios
                        </option>

                        <option>Administrador</option>
                        <option>Director</option>
                        <option>Docente</option>
                        <option>Comité de apoyo</option>

                    </select>

                </div>


                <div>

                    <label class="filter-label">
                        Fecha
                    </label>

                    <input type="date"
                           class="form-control" />

                </div>

            </div>


            <!-- TABLA -->
            <div class="table-responsive">

                <table class="table audit-table align-middle">

                    <thead>

                        <tr>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Módulo</th>
                            <th>Fecha</th>
                            <th class="text-end">Acciones</th>
                        </tr>

                    </thead>


                    <tbody>

                        <!-- EVENTO 1 -->
                        <tr>

                            <td>

                                <div class="user-info">

                                    <div class="user-avatar">
                                        AA
                                    </div>

                                    <div>

                                        <strong>
                                            ana.admin
                                        </strong>

                                        <small>
                                            Administrador
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>
                                Creó un rol
                            </td>


                            <td>

                                <span class="module-badge">
                                    Roles
                                </span>

                            </td>


                            <td>

                                <div class="date-info">
                                    <strong>Hoy</strong>
                                    <small>9:12 a.m.</small>
                                </div>

                            </td>


                            <td class="text-end">

                                <a href="@Url.Action("Detalle", "AuditoriaSistema", new { id = 1 })"
                                   class="btn btn-action"
                                   title="Ver detalle">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>


                        <!-- EVENTO 2 -->
                        <tr>

                            <td>

                                <div class="user-info">

                                    <div class="user-avatar">
                                        DC
                                    </div>

                                    <div>

                                        <strong>
                                            director.copalchi
                                        </strong>

                                        <small>
                                            Director
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>
                                Aprobó un plan de estudio
                            </td>


                            <td>

                                <span class="module-badge">
                                    Planes de estudio
                                </span>

                            </td>


                            <td>

                                <div class="date-info">
                                    <strong>Ayer</strong>
                                    <small>3:40 p.m.</small>
                                </div>

                            </td>


                            <td class="text-end">

                                <a href="@Url.Action("Detalle", "AuditoriaSistema", new { id = 2 })"
                                   class="btn btn-action"
                                   title="Ver detalle">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>


                        <!-- EVENTO 3 -->
                        <tr>

                            <td>

                                <div class="user-info">

                                    <div class="user-avatar">
                                        AA
                                    </div>

                                    <div>

                                        <strong>
                                            ana.admin
                                        </strong>

                                        <small>
                                            Administrador
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>
                                Restableció contraseña
                            </td>


                            <td>

                                <span class="module-badge">
                                    Usuarios
                                </span>

                            </td>


                            <td>

                                <div class="date-info">
                                    <strong>04/08/2026</strong>
                                    <small>11:05 a.m.</small>
                                </div>

                            </td>


                            <td class="text-end">

                                <a href="@Url.Action("Detalle", "AuditoriaSistema", new { id = 3 })"
                                   class="btn btn-action"
                                   title="Ver detalle">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>


                        <!-- EVENTO 4 -->
                        <tr>

                            <td>

                                <div class="user-info">

                                    <div class="user-avatar">
                                        DM
                                    </div>

                                    <div>

                                        <strong>
                                            docente.maria
                                        </strong>

                                        <small>
                                            Docente
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>
                                Modificó una asistencia
                            </td>


                            <td>

                                <span class="module-badge">
                                    Asistencia
                                </span>

                            </td>


                            <td>

                                <div class="date-info">
                                    <strong>04/08/2026</strong>
                                    <small>8:30 a.m.</small>
                                </div>

                            </td>


                            <td class="text-end">

                                <a href="@Url.Action("Detalle", "AuditoriaSistema", new { id = 4 })"
                                   class="btn btn-action"
                                   title="Ver detalle">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }


        body {
            background: var(--cop-page-bg);
        }


        /* ENCABEZADO */

        .audit-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }


        .audit-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }


            .audit-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }


                .audit-breadcrumb a:hover {
                    text-decoration: underline;
                }


        .audit-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }


        .audit-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }


        /* RESUMEN */

        .summary-card {
            height: 100%;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }


        .summary-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }


        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }


        .summary-card h2 {
            color: var(--cop-primary);
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
        }


        /* CONTENEDOR */

        .audit-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }


        /* TOOLBAR */

        .audit-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 22px;
        }


            .audit-toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                font-weight: 600;
                margin-bottom: 4px;
            }


            .audit-toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }


        /* BUSCADOR */

        .search-box {
            position: relative;
            width: 260px;
        }


            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }


            .search-box input {
                padding-left: 34px;
            }


        /* FILTROS */

        .audit-filters {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding: 15px 22px;
            background: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }


        .filter-label {
            display: block;
            color: #53616d;
            font-size: .78rem;
            font-weight: 600;
            margin-bottom: 5px;
        }


        /* TABLA */

        .audit-table {
            margin: 0;
        }


            .audit-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
                font-weight: 600;
            }


            .audit-table td {
                padding: 15px 17px;
                font-size: .9rem;
                border-color: #edf0f3;
            }


            .audit-table tbody tr:hover {
                background: #fafcfd;
            }


        /* USUARIO */

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .user-avatar {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
            font-weight: 700;
        }


        .user-info strong {
            display: block;
            color: #212529;
            font-size: .88rem;
        }


        .user-info small {
            display: block;
            color: var(--cop-muted);
            font-size: .75rem;
        }


        /* MÓDULO */

        .module-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            font-size: .77rem;
            font-weight: 600;
        }


        /* FECHA */

        .date-info strong,
        .date-info small {
            display: block;
        }


        .date-info strong {
            color: #343a40;
            font-size: .85rem;
            font-weight: 500;
        }


        .date-info small {
            color: var(--cop-muted);
            font-size: .75rem;
        }


        /* ACCIONES */

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            padding: 5px 9px;
        }


            .btn-action:hover {
                background: #e6f1fb;
                border-color: var(--cop-accent);
                color: var(--cop-primary);
            }


        /* INPUTS */

        .form-control,
        .form-select {
            border-color: #dfe4e8;
        }


            .form-control:focus,
            .form-select:focus {
                border-color: var(--cop-accent);
                box-shadow: 0 0 0 .2rem rgba(89, 165, 216, .15);
            }


        /* RESPONSIVE */

        @@media (max-width: 768px) {

            .audit-toolbar {
                flex-direction: column;
                align-items: stretch;
            }


            .search-box {
                width: 100%;
            }


            .audit-filters {
                grid-template-columns: 1fr;
            }
        }
    </style>

}