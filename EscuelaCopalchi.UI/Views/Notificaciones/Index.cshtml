
@using System
@using System.Linq
@using System.Collections.Generic
@model IEnumerable<EscuelaCopalchi.UI.Models.Notificaciones.Notificacion>

@{
    ViewBag.Title = "Notificaciones";

    var notificaciones = Model == null
        ? new List<EscuelaCopalchi.UI.Models.Notificaciones.Notificacion>()
        : Model.OrderByDescending(x => x.Fecha)
               .ThenByDescending(x => x.IdNotificacion)
               .ToList();

    var tipos = notificaciones
        .Select(x => x.Tipo)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<main class="not-page">

    <section class="not-header">
        <div class="container">

            <div class="not-heading">
                <div>
                    <h1>
                        <i class="bi bi-bell"></i>
                        Notificaciones
                    </h1>
                    <p>
                        Consulta y administra los avisos y novedades
                        de los diferentes módulos del sistema.
                    </p>
                </div>

                <a href="@Url.Action("Configuracion", "Notificaciones")"
                   class="btn not-config-btn">
                    <i class="bi bi-gear me-1"></i>
                    Configuración
                </a>
            </div>

        </div>
    </section>

    <section class="container pb-5">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="not-card">

            <div class="not-toolbar">
                <div>
                    <h2>Centro de notificaciones</h2>
                    <p>
                        Selecciona una notificación para consultar
                        su información completa.
                    </p>
                </div>

                <div class="not-search">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           id="notBuscar"
                           class="form-control"
                           placeholder="Buscar notificaciones..."
                           aria-label="Buscar notificaciones" />
                </div>
            </div>

            <div class="not-filters">

                <div class="not-filter-group">
                    <label for="notTipo">Tipo</label>
                    <select id="notTipo" class="form-select">
                        <option value="">Todos los tipos</option>
                        @foreach (var tipo in tipos)
                        {
                            <option value="@tipo">@tipo.Replace("_", " ")</option>
                        }
                    </select>
                </div>

                <div class="not-filter-group">
                    <label for="notEstado">Estado</label>
                    <select id="notEstado" class="form-select">
                        <option value="">Todas</option>
                        <option value="no-leida">Sin leer</option>
                        <option value="leida">Leídas</option>
                    </select>
                </div>

                <div class="not-filter-group">
                    <label for="notFecha">Fecha</label>
                    <input type="date"
                           id="notFecha"
                           class="form-control" />
                </div>

                <button type="button"
                        id="notLimpiar"
                        class="btn not-clear-btn">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Limpiar
                </button>

            </div>

            <form id="notFormEliminar"
                  method="post"
                  action="@Url.Action("EliminarSeleccionadas", "Notificaciones")">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ids"
                       id="notIdsEliminar" />

                <div class="not-actions">
                    <label class="not-select-all">
                        <input type="checkbox" id="notSeleccionarTodo" />
                        Seleccionar visibles
                    </label>

                    <button type="submit"
                            id="notEliminarSeleccionadas"
                            class="btn not-delete-selected"
                            disabled>
                        <i class="bi bi-trash3 me-1"></i>
                        Eliminar seleccionadas
                    </button>
                </div>

            </form>

            <div id="notLista" class="not-list">

                @foreach (var n in notificaciones)
                {
                    var tipo = (n.Tipo ?? "").ToUpperInvariant();
                    var icono = "bi-bell";
                    var clase = "general";

                    if (tipo.Contains("RIESGO") || tipo.Contains("SEGUIMIENTO"))
                    {
                        icono = "bi-mortarboard";
                        clase = "academico";
                    }
                    else if (tipo.Contains("PLAN"))
                    {
                        icono = "bi-journal-text";
                        clase = "planes";
                    }
                    else if (tipo.Contains("CALIFIC") || tipo.Contains("NOTAS"))
                    {
                        icono = "bi-clipboard-check";
                        clase = "academico";
                    }
                    else if (tipo.Contains("MATERIAL"))
                    {
                        icono = "bi-folder2-open";
                        clase = "materiales";
                    }
                    else if (tipo.Contains("SEGURIDAD"))
                    {
                        icono = "bi-shield-lock";
                        clase = "seguridad";
                    }
                    else if (tipo.Contains("ESTUDIANTE") || tipo.Contains("GRUPO"))
                    {
                        icono = "bi-people";
                        clase = "planes";
                    }

                    var urlDetalle = Url.Action(
                        "Detalle",
                        "Notificaciones",
                        new { id = n.IdNotificacion });

                    <article class="not-item @(n.Leida ? "" : "unread")"
                             data-id="@n.IdNotificacion"
                             data-tipo="@n.Tipo"
                             data-estado="@(n.Leida ? "leida" : "no-leida")"
                             data-fecha="@n.Fecha.ToString("yyyy-MM-dd")"
                             data-texto="@((n.Titulo ?? "") + " " + (n.Mensaje ?? "") + " " + (n.Tipo ?? ""))">

                        <div class="not-item-check">
                            <input type="checkbox"
                                   class="not-check"
                                   value="@n.IdNotificacion"
                                   aria-label="Seleccionar notificación" />
                        </div>

                        <a class="not-item-link"
                           href="@urlDetalle">

                            <div class="not-icon @clase">
                                <i class="bi @icono"></i>
                            </div>

                            <div class="not-content">

                                <div class="not-item-heading">
                                    <h3>@n.Titulo</h3>

                                    @if (!n.Leida)
                                    {
                                        <span class="not-unread-label">
                                            <span class="not-dot"></span>
                                            Nueva
                                        </span>
                                    }
                                </div>

                                <p>@n.Mensaje</p>

                                <div class="not-meta">
                                    <span class="not-type">
                                        @((n.Tipo ?? "General").Replace("_", " "))
                                    </span>

                                    <span>
                                        <i class="bi bi-clock"></i>
                                        @n.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                            </div>

                            <span class="not-chevron">
                                <i class="bi bi-chevron-right"></i>
                            </span>

                        </a>

                        <form method="post"
                              class="not-single-delete"
                              action="@Url.Action("Eliminar", "Notificaciones")">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@n.IdNotificacion" />

                            <button type="submit"
                                    class="not-trash"
                                    title="Eliminar notificación"
                                    aria-label="Eliminar notificación">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>

                    </article>
                }

            </div>

            <div id="notVacio" class="not-empty" style="display:none;">
                <i class="bi bi-inbox"></i>
                <h3>No hay notificaciones</h3>
                <p>
                    No se encontraron notificaciones con los filtros seleccionados.
                </p>
            </div>

            <div class="not-pagination">
                <span id="notInfoPagina"></span>

                <nav aria-label="Paginación de notificaciones">
                    <ul id="notPaginas" class="pagination mb-0"></ul>
                </nav>
            </div>

        </div>
    </section>

</main>

<script>
document.addEventListener("DOMContentLoaded", function () {

        const buscar = document.getElementById("notBuscar");
        const tipo = document.getElementById("notTipo");
        const estado = document.getElementById("notEstado");
        const fecha = document.getElementById("notFecha");
        const limpiar = document.getElementById("notLimpiar");

        const items = Array.from(
            document.querySelectorAll(".not-item")
        );

        const vacio = document.getElementById("notVacio");
        const paginas = document.getElementById("notPaginas");
        const info = document.getElementById("notInfoPagina");

        const seleccionarTodo =
            document.getElementById("notSeleccionarTodo");

        const eliminarSeleccionadas =
            document.getElementById("notEliminarSeleccionadas");

        const formEliminar =
            document.getElementById("notFormEliminar");

        const idsEliminar =
            document.getElementById("notIdsEliminar");

        const porPagina = 10;
        let paginaActual = 1;
        let filtrados = [];

        function normalizar(texto) {
            return (texto || "")
                .toLocaleLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function actualizarSeleccion() {
            const checks = document.querySelectorAll(
                ".not-check:checked"
            );

            eliminarSeleccionadas.disabled =
                checks.length === 0;

            const visibles = items.filter(
                x => x.style.display !== "none"
            );

            seleccionarTodo.checked =
                visibles.length > 0 &&
                visibles.every(x =>
                    x.querySelector(".not-check").checked
                );
        }

        function crearBoton(texto, destino, activo, deshabilitado) {
            const li = document.createElement("li");
            li.className = "page-item" +
                (activo ? " active" : "") +
                (deshabilitado ? " disabled" : "");

            const boton = document.createElement("button");
            boton.type = "button";
            boton.className = "page-link";
            boton.textContent = texto;
            boton.disabled = deshabilitado;

            boton.addEventListener("click", function () {
                paginaActual = destino;
                mostrarPagina();
            });

            li.appendChild(boton);
            paginas.appendChild(li);
        }

        function mostrarPagina() {
            const total = filtrados.length;
            const totalPaginas = Math.max(
                1, Math.ceil(total / porPagina)
            );

            paginaActual = Math.min(
                Math.max(1, paginaActual),
                totalPaginas
            );

            items.forEach(x => x.style.display = "none");

            const inicio = (paginaActual - 1) * porPagina;
            const fin = Math.min(inicio + porPagina, total);

            filtrados.slice(inicio, fin).forEach(x => {
                x.style.display = "";
            });

            vacio.style.display = total === 0 ? "" : "none";

            info.textContent = total === 0
                ? "Sin resultados"
                : "Mostrando " + (inicio + 1) +
                  "–" + fin + " de " + total;

            paginas.innerHTML = "";

            if (totalPaginas > 1) {
                crearBoton("‹", paginaActual - 1,
                    false, paginaActual === 1);

                for (let p = 1; p <= totalPaginas; p++) {
                    crearBoton(
                        String(p),
                        p,
                        p === paginaActual,
                        false
                    );
                }

                crearBoton("›", paginaActual + 1,
                    false, paginaActual === totalPaginas);
            }

            actualizarSeleccion();
        }

        function aplicarFiltros() {
            const texto = normalizar(buscar.value);

            filtrados = items.filter(function (item) {
                const coincideTexto =
                    normalizar(item.dataset.texto).includes(texto);

                const coincideTipo =
                    !tipo.value ||
                    item.dataset.tipo === tipo.value;

                const coincideEstado =
                    !estado.value ||
                    item.dataset.estado === estado.value;

                const coincideFecha =
                    !fecha.value ||
                    item.dataset.fecha === fecha.value;

                return coincideTexto &&
                       coincideTipo &&
                       coincideEstado &&
                       coincideFecha;
            });

            paginaActual = 1;
            mostrarPagina();
        }

        [buscar, tipo, estado, fecha].forEach(control => {
            control.addEventListener(
                control === buscar ? "input" : "change",
                aplicarFiltros
            );
        });

        limpiar.addEventListener("click", function () {
            buscar.value = "";
            tipo.value = "";
            estado.value = "";
            fecha.value = "";
            aplicarFiltros();
        });

        items.forEach(item => {
            item.querySelector(".not-check")
                .addEventListener("change", actualizarSeleccion);
        });

        seleccionarTodo.addEventListener("change", function () {
            items.filter(x => x.style.display !== "none")
                .forEach(x => {
                    x.querySelector(".not-check").checked =
                        seleccionarTodo.checked;
                });

            actualizarSeleccion();
        });

        document.querySelectorAll(".not-single-delete")
            .forEach(form => {
                form.addEventListener("submit", function (e) {
                    if (!confirm(
                        "¿Deseas eliminar esta notificación? " +
                        "Esta acción no se puede deshacer."
                    )) {
                        e.preventDefault();
                    }
                });
            });

        formEliminar.addEventListener("submit", function (e) {
            const seleccionados = Array.from(
                document.querySelectorAll(".not-check:checked")
            ).map(x => x.value);

            if (seleccionados.length === 0) {
                e.preventDefault();
                return;
            }

            if (!confirm(
                "¿Eliminar " + seleccionados.length +
                " notificación(es) seleccionada(s)?"
            )) {
                e.preventDefault();
                return;
            }

            idsEliminar.value = seleccionados.join(",");
        });

        aplicarFiltros();
});
</script>

@section styles {
    <style>
        body {
            background: #f4f7fa;
        }

        .not-header {
            background: #fff;
            border-bottom: 1px solid #e4eaf0;
            padding: 28px 0;
            margin-bottom: 28px;
        }

        .not-breadcrumb {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 15px;
            font-size: .82rem;
            color: #64748b;
        }

            .not-breadcrumb a {
                color: #386fa4;
                text-decoration: none;
            }

        .not-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

            .not-heading h1 {
                font-size: 1.75rem;
                font-weight: 700;
                color: #133c55;
                margin-bottom: 7px;
            }

                .not-heading h1 i {
                    color: #386fa4;
                    margin-right: 8px;
                }

            .not-heading p {
                color: #64748b;
                margin: 0;
                font-size: .9rem;
            }

        .not-config-btn {
            border: 1px solid #cbd8e5;
            color: #254f72;
            background: white;
            white-space: nowrap;
        }

            .not-config-btn:hover {
                background: #edf4fa;
                color: #133c55;
            }

        .not-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 14px rgba(20, 48, 75, .035);
        }

        .not-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 23px 25px;
        }

            .not-toolbar h2 {
                color: #133c55;
                font-size: 1.13rem;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .not-toolbar p {
                color: #718096;
                font-size: .83rem;
                margin: 0;
            }

        .not-search {
            position: relative;
            width: 290px;
            flex-shrink: 0;
        }

            .not-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: #8492a6;
            }

            .not-search input {
                padding-left: 38px;
                border-color: #dfe6ee;
            }

        .not-filters {
            display: flex;
            align-items: end;
            flex-wrap: wrap;
            gap: 14px;
            padding: 16px 25px;
            background: #f8fafc;
            border-top: 1px solid #edf1f5;
            border-bottom: 1px solid #edf1f5;
        }

        .not-filter-group {
            flex: 1;
            min-width: 160px;
        }

            .not-filter-group label {
                display: block;
                font-size: .78rem;
                font-weight: 600;
                color: #536779;
                margin-bottom: 6px;
            }

        .not-clear-btn {
            border: 1px solid #d9e2ec;
            background: #fff;
            color: #526579;
        }

        .not-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 25px;
            border-bottom: 1px solid #edf1f5;
        }

        .not-select-all {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .83rem;
            color: #536779;
            cursor: pointer;
        }

        .not-delete-selected {
            border: 1px solid #f1d0d0;
            color: #b42332;
            background: #fff;
            font-size: .82rem;
        }

            .not-delete-selected:hover:not(:disabled) {
                background: #fff0f1;
                color: #a51d2b;
            }

        .not-item {
            display: flex;
            align-items: center;
            padding: 0 22px;
            border-bottom: 1px solid #edf1f5;
            transition: background .15s;
        }

            .not-item:last-child {
                border-bottom: none;
            }

            .not-item:hover {
                background: #f8fbfe;
            }

            .not-item.unread {
                background: #f2f7fc;
            }

                .not-item.unread:hover {
                    background: #eaf3fb;
                }

        .not-item-check {
            padding-right: 15px;
        }

        .not-item-link {
            display: flex;
            align-items: center;
            flex: 1;
            min-width: 0;
            gap: 15px;
            padding: 19px 0;
            text-decoration: none;
            color: inherit;
        }

            .not-item-link:hover {
                text-decoration: none;
            }

        .not-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 43px;
            height: 43px;
            border-radius: 10px;
            background: #e8f0f8;
            color: #386fa4;
            font-size: 1.15rem;
        }

            .not-icon.academico {
                background: #fff0e8;
                color: #bb6631;
            }

            .not-icon.planes {
                background: #edf0fc;
                color: #5867a8;
            }

            .not-icon.materiales {
                background: #e9f6f0;
                color: #277d56;
            }

            .not-icon.seguridad {
                background: #fcecec;
                color: #b23b45;
            }

        .not-content {
            flex: 1;
            min-width: 0;
        }

        .not-item-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

            .not-item-heading h3 {
                color: #1d3c55;
                font-size: .93rem;
                font-weight: 600;
                margin: 0;
            }

        .not-item.unread h3 {
            font-weight: 700;
        }

        .not-content p {
            color: #64748b;
            font-size: .83rem;
            margin: 6px 0 9px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .not-unread-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .71rem;
            font-weight: 600;
            color: #276a9e;
        }

        .not-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #387bb2;
        }

        .not-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: center;
            color: #8190a0;
            font-size: .74rem;
        }

        .not-type {
            background: #eef2f6;
            color: #516579;
            border-radius: 5px;
            padding: 3px 8px;
        }

        .not-chevron {
            color: #9caabb;
            padding: 0 4px;
        }

        .not-trash {
            border: none;
            background: transparent;
            color: #9aa6b3;
            padding: 9px;
            border-radius: 7px;
        }

            .not-trash:hover {
                background: #fcecee;
                color: #c03544;
            }

        .not-empty {
            text-align: center;
            padding: 55px 20px;
            color: #8290a0;
        }

            .not-empty > i {
                display: block;
                font-size: 2.6rem;
                margin-bottom: 13px;
            }

            .not-empty h3 {
                color: #536779;
                font-size: 1.05rem;
            }

        .not-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 17px 25px;
            border-top: 1px solid #edf1f5;
            font-size: .8rem;
            color: #718096;
        }

            .not-pagination .page-link {
                color: #386fa4;
            }

            .not-pagination .active .page-link {
                background: #386fa4;
                border-color: #386fa4;
                color: #fff;
            }

        @@media (max-width: 768px) {
            .not-heading, .not-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .not-search {
                width: 100%;
            }

            .not-filters {
                flex-direction: column;
            }

            .not-filter-group {
                width: 100%;
            }

            .not-item {
                padding: 0 12px;
            }

            .not-item-link {
                gap: 10px;
            }

            .not-icon {
                width: 36px;
                height: 36px;
            }

            .not-chevron {
                display: none;
            }

            .not-actions {
                padding: 12px;
            }

            .not-pagination {
                padding: 15px;
            }
        }
    </style>
}
