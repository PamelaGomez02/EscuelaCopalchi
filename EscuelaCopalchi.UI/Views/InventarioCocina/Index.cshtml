@model EscuelaCopalchi.UI.Models.InventarioCocinaIndexViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
 ViewBag.Title="Inventario de Cocina";
 var productos=Model==null?new List<EscuelaCopalchi.UI.Models.InventarioCocinaProductoViewModel>():Model.Productos;
 var estados=ViewBag.EstadosPorProducto as Dictionary<int,string> ?? new Dictionary<int,string>();
 Func<int,string> estadoDe=id=>estados.ContainsKey(id)?estados[id]:"DISPONIBLE";
 bool crear=Convert.ToBoolean(ViewBag.PuedeCrear??false),editar=Convert.ToBoolean(ViewBag.PuedeEditar??false),movimiento=Convert.ToBoolean(ViewBag.PuedeMovimiento??false),historial=Convert.ToBoolean(ViewBag.PuedeVerMovimientos??false),reportes=Convert.ToBoolean(ViewBag.PuedeReportes??false);
 var vencidos=productos.Count(x=>estadoDe(x.IdProducto)=="VENCIDO"||estadoDe(x.IdProducto)=="CON_VENCIDOS");
 var proximos=productos.Count(x=>estadoDe(x.IdProducto)=="PROXIMO_A_VENCER");
 var agotados=productos.Count(x=>estadoDe(x.IdProducto)=="AGOTADO");
 var bajos=productos.Count(x=>x.StockActual>0&&x.StockActual<=x.StockMinimo);
}
@Html.Partial("_Estilos")
<div class="container py-4">
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="repo-title"><i class="bi bi-basket2 me-2"></i>Inventario de Cocina</h2><p class="text-muted mb-0">Control de alimentos, existencias, lotes y fechas de vencimiento.</p></div><div class="d-flex gap-2"><a href="@Url.Action("Index","Home")" class="btn btn-outline-secondary">Atrás</a>@if(crear){<a href="@Url.Action("Crear")" class="btn btn-cop-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo producto</a>}</div></div>
 @if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
 @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
 <div class="row g-3 mb-4">
 @foreach(var k in new[]{new{Titulo="Productos",Cantidad=productos.Count,Icono="box-seam"},new{Titulo="Con lotes vencidos",Cantidad=vencidos,Icono="exclamation-octagon"},new{Titulo="Próximos a vencer",Cantidad=proximos,Icono="calendar-event"},new{Titulo="Agotados",Cantidad=agotados,Icono="x-circle"},new{Titulo="Stock bajo",Cantidad=bajos,Icono="exclamation-triangle"}}){<div class="col-6 col-lg"><div class="repo-card p-3 h-100"><div class="text-muted small"><i class="bi bi-@k.Icono me-1"></i>@k.Titulo</div><h3 class="mb-0 mt-2">@k.Cantidad</h3></div></div>}
 </div>
 <div class="repo-card p-3 mb-4"><h5 class="repo-section-title"><i class="bi bi-search me-2"></i>Buscar productos</h5>@using(Html.BeginForm("Index","InventarioCocina",FormMethod.Get,new{@class="row g-3 align-items-end"})){<div class="col-md-4"><label class="form-label">Nombre o categoría</label><input class="form-control" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar alimento" /></div><div class="col-md-3"><label class="form-label">Categoría</label><input class="form-control" name="categoria" value="@ViewBag.Categoria" placeholder="Todas" /></div><div class="col-md-3"><label class="form-label">Estado</label><select class="form-select" name="estado"><option value="">Todos</option>@foreach(var s in new[]{"DISPONIBLE","STOCK_BAJO","PROXIMO_A_VENCER","VENCIDO","CON_VENCIDOS","AGOTADO"}){<option value="@s" selected="@(Convert.ToString(ViewBag.EstadoFiltro)==s?"selected":null)">@s.Replace("_"," ")</option>}</select></div><div class="col-md-2"><button class="btn btn-cop-primary w-100">Buscar</button></div>}</div>
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h5 class="repo-section-title mb-0">Productos de cocina</h5><div class="d-flex gap-2 flex-wrap">@if(movimiento){<a class="btn btn-sm btn-outline-primary" href="@Url.Action("RegistrarMovimiento")">Registrar movimiento</a>}@if(historial){<a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Movimientos")">Historial</a>}@if(reportes){<a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Reportes")">Reportes</a>}</div></div>
 <div class="repo-card"><div class="table-responsive"><table id="ic-table" class="table table-hover align-middle mb-0"><thead><tr><th>Producto</th><th>Categoría</th><th>Existencias</th><th>Mínimo</th><th>Próximo vencimiento</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
 @foreach(var x in productos){var e=estadoDe(x.IdProducto);var clase=e=="VENCIDO"||e=="CON_VENCIDOS"?"bg-danger":e=="PROXIMO_A_VENCER"||e=="STOCK_BAJO"?"bg-warning text-dark":e=="AGOTADO"?"bg-secondary":"bg-success";<tr><td><strong>@x.Nombre</strong><div class="small text-muted">@x.UnidadMedida</div></td><td>@x.Categoria</td><td>@x.StockActual @x.UnidadMedida</td><td>@x.StockMinimo</td><td>@(x.FechaVencimiento.HasValue?x.FechaVencimiento.Value.ToString("dd/MM/yyyy"):"Sin fecha próxima")</td><td><span class="badge @clase">@e.Replace("_"," ")</span></td><td class="text-end"><div class="d-flex justify-content-end flex-wrap gap-1"><a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Detalle",new{id=x.IdProducto})">Detalle</a>@if(editar){<a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar",new{id=x.IdProducto})">Editar</a>}@if(movimiento){<a class="btn btn-sm btn-cop-primary" href="@Url.Action("RegistrarMovimiento",new{id=x.IdProducto})">Movimiento</a>}</div></td></tr>}
 @if(!productos.Any()){<tr><td colspan="7" class="text-center text-muted py-5">No se encontraron productos de cocina.</td></tr>}
 </tbody></table></div></div>
 @Html.Partial("_Paginacion")
 <p class="text-muted small mt-3">Los estados reflejan el lote y sus fechas. Para revisar lotes vencidos y disponibles por separado, abrí Detalle.</p>
</div>