@model EscuelaCopalchi.UI.Models.InventarioCocinaProductoViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@{
 ViewBag.Title="Detalle de producto de cocina";
 var lotes=ViewBag.Lotes as List<EscuelaCopalchi.UI.Models.InventarioCocinaLoteViewModel> ?? new List<EscuelaCopalchi.UI.Models.InventarioCocinaLoteViewModel>();
 var estados=ViewBag.EstadosPorProducto as Dictionary<int,string> ?? new Dictionary<int,string>();
 var estado=estados.ContainsKey(Model.IdProducto)?estados[Model.IdProducto]:"DISPONIBLE";
 bool editar=Convert.ToBoolean(ViewBag.PuedeEditar??false),movimiento=Convert.ToBoolean(ViewBag.PuedeMovimiento??false);
}
@Html.Partial("_Estilos")
<div class="container py-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="repo-title"><i class="bi bi-basket2 me-2"></i>@Model.Nombre</h2><p class="text-muted">Detalle de alimento y lotes registrados.</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Volver al inventario</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="repo-card p-4 h-100"><h5 class="repo-section-title">Información del producto</h5><dl class="row mb-0"><dt class="col-sm-4 py-2">Categoría</dt><dd class="col-sm-8 py-2">@Model.Categoria</dd><dt class="col-sm-4 py-2">Descripción</dt><dd class="col-sm-8 py-2">@(string.IsNullOrWhiteSpace(Model.Descripcion)?"Sin descripción":Model.Descripcion)</dd><dt class="col-sm-4 py-2">Unidad</dt><dd class="col-sm-8 py-2">@Model.UnidadMedida</dd><dt class="col-sm-4 py-2">Próximo vencimiento utilizable</dt><dd class="col-sm-8 py-2">@(Model.FechaVencimiento.HasValue?Model.FechaVencimiento.Value.ToString("dd/MM/yyyy"):"No registrado")</dd></dl></div></div><div class="col-lg-4"><div class="repo-card p-4 h-100"><h5 class="repo-section-title">Existencias</h5><h2>@Model.StockActual <small class="fs-6">@Model.UnidadMedida</small></h2><p class="text-muted">Stock mínimo: @Model.StockMinimo</p><div class="alert alert-info">Estado: <strong>@estado.Replace("_"," ")</strong></div><div class="d-grid gap-2">@if(editar){<a class="btn btn-outline-primary" href="@Url.Action("Editar",new{id=Model.IdProducto})">Editar producto</a>}@if(movimiento){<a class="btn btn-cop-primary" href="@Url.Action("RegistrarMovimiento",new{id=Model.IdProducto})">Registrar movimiento</a>}</div></div></div></div>
<div class="repo-card mt-4"><div class="p-3 border-bottom"><h5 class="repo-section-title mb-0">Lotes y vencimientos</h5></div><div class="table-responsive"><table id="ic-table" class="table table-hover mb-0 align-middle"><thead><tr><th>Lote</th><th>Ingreso</th><th>Proveedor</th><th>Disponible</th><th>Vencimiento</th><th>Estado</th></tr></thead><tbody>@foreach(var l in lotes){var e=l.EstadoLote;var color=e=="VENCIDO"?"bg-danger":e=="PROXIMO_A_VENCER"?"bg-warning text-dark":e=="AGOTADO"?"bg-secondary":"bg-success";<tr><td>#@l.IdLote</td><td>@l.FechaIngreso.ToString("dd/MM/yyyy")</td><td>@(l.Proveedor??"—")</td><td>@l.Cantidad @Model.UnidadMedida</td><td>@(l.FechaVencimiento.HasValue?l.FechaVencimiento.Value.ToString("dd/MM/yyyy"):"Sin fecha")</td><td><span class="badge @color">@e.Replace("_"," ")</span></td></tr>}@if(!lotes.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No hay lotes registrados.</td></tr>}</tbody></table></div></div>@Html.Partial("_Paginacion")</div>