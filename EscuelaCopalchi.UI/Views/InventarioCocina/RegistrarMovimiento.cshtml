@model EscuelaCopalchi.UI.Models.InventarioCocinaMovimientoViewModel
@using System
@using System.Collections.Generic
@using System.Web.Mvc
@{ViewBag.Title="Registrar movimiento de cocina";var productos=ViewBag.Productos as IEnumerable<SelectListItem> ?? new List<SelectListItem>();}
@Html.Partial("_Estilos")
<div class="container py-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="repo-title"><i class="bi bi-arrow-left-right me-2"></i>Registrar movimiento</h2><p class="text-muted">Entradas por lote y salidas por vencimiento (FEFO).</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Volver al inventario</a></div><div class="form-card"><h5 class="repo-section-title">Datos del movimiento</h5>@using(Html.BeginForm("RegistrarMovimiento","InventarioCocina",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="text-danger"})
<div class="row g-3"><div class="col-md-6"><label class="form-label">Producto *</label>@Html.DropDownListFor(m=>m.IdProducto,productos,"Seleccione un producto",new{@class="form-select",required="required"})</div><div class="col-md-6"><label class="form-label">Tipo *</label>@Html.DropDownListFor(m=>m.Tipo,new[]{new SelectListItem{Text="Entrada",Value="ENTRADA"},new SelectListItem{Text="Salida",Value="SALIDA"}},new{@class="form-select",id="Tipo"})</div><div class="col-md-6"><label class="form-label">Cantidad *</label>@Html.TextBoxFor(m=>m.Cantidad,new{@class="form-control",type="number",min="1",required="required"})</div><div class="col-md-6" id="fecha-grupo"><label class="form-label">Fecha de vencimiento del lote</label>@Html.TextBoxFor(m=>m.FechaVencimiento,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})@Html.ValidationMessageFor(m=>m.FechaVencimiento,"",new{@class="text-danger small"})</div><div class="col-md-6" id="proveedor-grupo"><label class="form-label">Proveedor</label>@Html.TextBoxFor(m=>m.Proveedor,new{@class="form-control",maxlength="150"})</div><div class="col-12"><label class="form-label">Motivo u observaciones</label>@Html.TextAreaFor(m=>m.Motivo,3,0,new{@class="form-control",maxlength="500"})</div></div>
<div class="alert alert-info mt-4" id="ayuda-movimiento">Las entradas crean un lote nuevo. Para alimentos perecederos, indicá su vencimiento.</div><div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancelar</a><button class="btn btn-cop-primary" type="submit">Guardar movimiento</button></div>}</div></div>
<script>(function(){var tipo=document.getElementById('Tipo'),fecha=document.getElementById('fecha-grupo'),proveedor=document.getElementById('proveedor-grupo'),ayuda=document.getElementById('ayuda-movimiento');function update(){var entrada=tipo.value==='ENTRADA';fecha.style.display=entrada?'':'none';proveedor.style.display=entrada?'':'none';ayuda.textContent=entrada?'Las entradas crean un lote nuevo. Indicá el vencimiento si el alimento es perecedero.':'Las salidas descuentan primero lotes no vencidos con fecha más próxima. No se pueden consumir lotes vencidos.'}if(tipo){tipo.addEventListener('change',update);update()}})();</script>