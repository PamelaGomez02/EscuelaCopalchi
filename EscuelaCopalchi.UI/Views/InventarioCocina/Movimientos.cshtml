@model List<EscuelaCopalchi.UI.Models.InventarioCocinaMovimientoViewModel>
@using System
@using System.Linq
@{ViewBag.Title="Movimientos de cocina";bool puede=Convert.ToBoolean(ViewBag.PuedeMovimiento??false);}
@Html.Partial("_Estilos")
<div class="container py-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="repo-title"><i class="bi bi-clock-history me-2"></i>Historial de movimientos</h2><p class="text-muted">Entradas y salidas de productos de cocina.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Atrás</a>@if(puede){<a class="btn btn-cop-primary" href="@Url.Action("RegistrarMovimiento")">Nuevo movimiento</a>}</div></div>@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
<div class="repo-card"><div class="table-responsive"><table id="ic-table" class="table table-hover align-middle mb-0"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Proveedor</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@x.NombreProducto</strong></td><td>@if(x.Tipo=="ENTRADA"){<span class="badge bg-success">Entrada</span>}else{<span class="badge bg-warning text-dark">Salida</span>}</td><td>@x.Cantidad</td><td>@x.Proveedor</td><td>@x.Responsable</td><td>@x.Motivo</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-5">No hay movimientos registrados.</td></tr>}</tbody></table></div></div>@Html.Partial("_Paginacion")</div>