<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3" id="ic-pagination"><span class="text-muted small" id="ic-status"></span><div class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-sm btn-outline-secondary" id="ic-prev">Anterior</button><span id="ic-number" class="small"></span><button type="button" class="btn btn-sm btn-outline-secondary" id="ic-next">Siguiente</button></div></div>
<script>
(function(){function ready(){var host=document.getElementById('ic-pagination'),table=document.getElementById('ic-table');if(!host||!table||!table.tBodies.length)return;var rows=Array.prototype.slice.call(table.tBodies[0].rows).filter(function(r){return !r.querySelector('td[colspan]')});if(!rows.length){host.hidden=true;return}var page=1,n=10,prev=document.getElementById('ic-prev'),next=document.getElementById('ic-next');function render(){var pages=Math.ceil(rows.length/n);page=Math.max(1,Math.min(page,pages));rows.forEach(function(r,i){r.style.display=i>=(page-1)*n&&i<page*n?'':'none'});document.getElementById('ic-status').textContent='Mostrando '+((page-1)*n+1)+'–'+Math.min(page*n,rows.length)+' de '+rows.length;document.getElementById('ic-number').textContent=page+' / '+pages;prev.disabled=page===1;next.disabled=page===pages}prev.addEventListener('click',function(){page--;render()});next.addEventListener('click',function(){page++;render()});render()}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready()})();
</script>