@model EscuelaCopalchi.UI.Models.InventarioReporteViewModel
@using System
@using System.Linq
@{ViewBag.Title="Reportes de cocina";}
@Html.Partial("_Estilos")
<div class="container py-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="repo-title"><i class="bi bi-bar-chart me-2"></i>Reportes de cocina</h2><p class="text-muted">Entradas, salidas y saldos por período.</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Volver</a></div>
<div class="repo-card p-4 mb-4"><h5 class="repo-section-title">Seleccionar período</h5>@using(Html.BeginForm("Reportes","InventarioCocina",FormMethod.Get,new{@class="row g-3 align-items-end"})){<div class="col-md-4"><label class="form-label">Año</label><input class="form-control" type="number" name="anio" min="2000" max="9998" value="@Model.Anio" required /></div><div class="col-md-4"><label class="form-label">Mes</label><select class="form-select" name="mes">@for(int i=1;i<=12;i++){<option value="@i" selected="@(Model.Mes==i?"selected":null)">@(new DateTime(2026,i,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))</option>}</select></div><div class="col-md-4"><button class="btn btn-cop-primary w-100">Consultar reporte</button></div>}</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h5 class="repo-section-title mb-0">Resultados del período</h5><div class="d-flex gap-2"><a class="btn btn-success" href="@Url.Action("ExportarExcel",new{anio=Model.Anio,mes=Model.Mes})">Exportar Excel</a><a class="btn btn-outline-secondary" href="@Url.Action("ExportarCsv",new{anio=Model.Anio,mes=Model.Mes})">Exportar CSV</a></div></div>
<div class="repo-card"><div class="table-responsive"><table id="ic-table" class="table table-hover align-middle mb-0"><thead><tr><th>Producto</th><th>Unidad</th><th>Entradas</th><th>Salidas</th><th>Saldo final</th></tr></thead><tbody>@foreach(var x in Model.Filas){<tr><td><strong>@x.Nombre</strong></td><td>@x.Unidad</td><td>@x.Entradas</td><td>@x.Salidas</td><td>@x.SaldoFinal</td></tr>}@if(!Model.Filas.Any()){<tr><td colspan="5" class="text-center text-muted py-5">No hay productos para este período.</td></tr>}</tbody></table></div></div>@Html.Partial("_Paginacion")<p class="text-muted small mt-3">El saldo histórico se reconstruye desde los movimientos. Las cantidades de distintas unidades no deben interpretarse como una misma magnitud.</p></div>