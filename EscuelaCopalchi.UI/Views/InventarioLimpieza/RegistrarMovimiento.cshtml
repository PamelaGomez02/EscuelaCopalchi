@model EscuelaCopalchi.UI.Models.InventarioMovimientoViewModel
@using System.Collections.Generic
@{ ViewBag.Title="Registrar movimiento"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3"><div><h2 class="repo-title"><i class="bi bi-arrow-left-right me-2"></i>Registrar movimiento</h2><p class="text-muted mb-0">Registrá entradas y salidas de productos de limpieza.</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Volver al inventario</a></div><div class="form-card"><h5 class="repo-section-title"><i class="bi bi-clipboard-plus me-2"></i>Datos del movimiento</h5>@using(Html.BeginForm("RegistrarMovimiento","InventarioLimpieza",FormMethod.Post)){@Html.AntiForgeryToken() @Html.ValidationSummary(false,"",new{@class="text-danger"})<div class="row g-3"><div class="col-md-6"><label class="form-label">Producto *</label>@Html.DropDownListFor(m=>m.IdProducto,(IEnumerable<SelectListItem>)ViewBag.Productos,"Seleccione un producto",new{@class="form-select",required="required"})</div><div class="col-md-6"><label class="form-label">Tipo de movimiento *</label>@Html.DropDownListFor(m=>m.Tipo,new[]{new SelectListItem{Text="Entrada",Value="ENTRADA"},new SelectListItem{Text="Salida",Value="SALIDA"}},new{@class="form-select"})</div><div class="col-md-6"><label class="form-label">Cantidad *</label>@Html.TextBoxFor(m=>m.Cantidad,new{@class="form-control",type="number",min="1",required="required"})</div><div class="col-md-6"><label class="form-label">Proveedor (si aplica)</label>@Html.TextBoxFor(m=>m.Proveedor,new{@class="form-control",maxlength="150"})</div><div class="col-12"><label class="form-label">Motivo u observaciones</label>@Html.TextAreaFor(m=>m.Motivo,3,0,new{@class="form-control",maxlength="500"})</div></div><div class="alert alert-info mt-4"><i class="bi bi-info-circle me-2"></i>Las salidas no pueden superar las existencias disponibles.</div><div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancelar</a><button class="btn btn-cop-primary" type="submit"><i class="bi bi-check-circle me-1"></i>Guardar movimiento</button></div>}</div></div>
<style>
body{background:#f4f7fa}.repo-title{color:#133c55;font-weight:700}.repo-card,.form-card{background:#fff;border:1px solid #e3e8ee;border-radius:10px;overflow:hidden}.form-card{padding:28px}.repo-icon{background:#e8f0f7;color:#133c55;border-radius:10px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:23px}.repo-section-title{color:#133c55;font-weight:650}.btn-cop-primary{background:#133c55;color:#fff;border-color:#133c55}.btn-cop-primary:hover{background:#386fa4;border-color:#386fa4;color:#fff}.repo-card .table th{color:#334155;font-weight:600;font-size:14px;background:#f8fafc}.repo-card .table td{font-size:14px;vertical-align:middle}.repo-card .btn-sm{margin:2px}.repo-card .table td,.repo-card .table th{padding:13px 14px}.form-label{font-weight:500;color:#334155}.form-control:focus,.form-select:focus{border-color:#386fa4;box-shadow:0 0 0 .2rem rgba(56,111,164,.13)}.repo-page-btn{min-width:36px}.repo-page-btn.active{background:#133c55;color:#fff;border-color:#133c55}@@media(max-width:767px){.form-card{padding:18px}.repo-card .table td,.repo-card .table th{padding:10px}}
</style>
