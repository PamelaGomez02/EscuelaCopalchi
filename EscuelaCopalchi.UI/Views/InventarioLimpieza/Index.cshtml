@model List<EscuelaCopalchi.UI.Models.InventarioProductoViewModel>
@using System
@using System.Linq
@{
 ViewBag.Title = "Inventario de Limpieza e Higiene";
 var productos = Model ?? new List<EscuelaCopalchi.UI.Models.InventarioProductoViewModel>();
 bool crear = Convert.ToBoolean(ViewBag.PuedeCrear ?? false);
 bool editar = Convert.ToBoolean(ViewBag.PuedeEditar ?? false);
 bool movimiento = Convert.ToBoolean(ViewBag.PuedeMovimiento ?? false);
 bool historial = Convert.ToBoolean(ViewBag.PuedeVerMovimientos ?? false);
 bool reportes = Convert.ToBoolean(ViewBag.PuedeReportes ?? false);
}
<div class="container py-4">
 <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3"><div><h2 class="repo-title"><i class="bi bi-bucket me-2"></i>Inventario de Limpieza e Higiene</h2><p class="text-muted mb-0">Consulta y administra productos, existencias y movimientos de limpieza.</p></div><div class="d-flex align-items-center flex-wrap gap-2"><a class="btn btn-outline-secondary" href="@Url.Action("Index","Home")"><i class="bi bi-arrow-left me-1"></i>Atrás</a>@if(crear){<a class="btn btn-cop-primary" href="@Url.Action("Crear")"><i class="bi bi-plus-circle me-1"></i>Nuevo producto</a>}</div></div>
 @if(TempData["Success"] != null){<div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
 @if(TempData["Error"] != null){<div class="alert alert-danger">@TempData["Error"]</div>}
 <div class="row g-3 mb-4"><div class="col-md-4"><div class="repo-card p-3 h-100"><div class="d-flex align-items-center gap-3"><div class="repo-icon"><i class="bi bi-box-seam"></i></div><div><div class="text-muted small">Productos registrados</div><h3 class="mb-0">@productos.Count</h3></div></div></div></div><div class="col-md-4"><div class="repo-card p-3 h-100"><div class="d-flex align-items-center gap-3"><div class="repo-icon"><i class="bi bi-exclamation-triangle"></i></div><div><div class="text-muted small">Productos con stock bajo</div><h3 class="mb-0">@productos.Count(x => x.StockBajo)</h3></div></div></div></div><div class="col-md-4"><div class="repo-card p-3 h-100"><div class="d-flex align-items-center gap-3"><div class="repo-icon"><i class="bi bi-check-circle"></i></div><div><div class="text-muted small">Stock normal</div><h3 class="mb-0">@productos.Count(x => !x.StockBajo)</h3></div></div></div></div></div>
 <div class="repo-card p-3 mb-4"><h5 class="repo-section-title"><i class="bi bi-search me-2"></i>Buscar productos</h5>@using(Html.BeginForm("Index","InventarioLimpieza",FormMethod.Get,new{@class="row g-3 align-items-end"})){<div class="col-md-6"><label class="form-label">Buscar por nombre</label><input class="form-control" name="busqueda" value="@ViewBag.Busqueda" placeholder="Nombre o descripción" /></div><div class="col-md-4"><label class="form-label">Categoría</label><input class="form-control" name="categoria" value="@ViewBag.Categoria" placeholder="Todas las categorías" /></div><div class="col-md-2"><button class="btn btn-cop-primary w-100" type="submit"><i class="bi bi-search me-1"></i>Buscar</button></div>}</div>
 <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3"><h5 class="repo-section-title mb-0"><i class="bi bi-list-ul me-2"></i>Productos de limpieza</h5><div class="d-flex gap-2 flex-wrap">@if(movimiento){<a class="btn btn-outline-primary btn-sm" href="@Url.Action("RegistrarMovimiento")"><i class="bi bi-arrow-left-right me-1"></i>Registrar movimiento</a>}@if(historial){<a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Movimientos")"><i class="bi bi-clock-history me-1"></i>Historial</a>}@if(reportes){<a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Reportes")"><i class="bi bi-bar-chart me-1"></i>Reportes</a>}</div></div>
 <div class="repo-card overflow-hidden"><div class="p-3 border-bottom d-flex justify-content-between align-items-center"><strong><i class="bi bi-box-seam me-2"></i>Listado de productos</strong><span class="text-muted small">@productos.Count resultado(s)</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Producto</th><th>Categoría</th><th>Existencias</th><th>Mínimo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var x in productos){<tr><td><strong>@x.Nombre</strong><div class="text-muted small">@x.UnidadMedida</div></td><td>@x.Categoria</td><td>@x.StockActual @x.UnidadMedida</td><td>@x.StockMinimo</td><td>@if(x.StockBajo){<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Stock bajo</span>}else{<span class="badge bg-success">Disponible</span>}</td><td class="text-end"><div class="d-flex justify-content-end gap-1 flex-wrap"><a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Detalle",new{id=x.IdProducto})"><i class="bi bi-eye"></i> Detalle</a>@if(editar){<a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar",new{id=x.IdProducto})"><i class="bi bi-pencil"></i> Editar</a>}@if(movimiento){<a class="btn btn-sm btn-cop-primary" href="@Url.Action("RegistrarMovimiento",new{id=x.IdProducto})"><i class="bi bi-arrow-left-right"></i> Movimiento</a>}</div></td></tr>}@if(!productos.Any()){<tr><td colspan="6" class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No se encontraron productos de limpieza.</td></tr>}</tbody></table></div></div>
</div>

<style>
body{background:#f4f7fa}.repo-title{color:#133c55;font-weight:700}.repo-card,.form-card{background:#fff;border:1px solid #e3e8ee;border-radius:10px;overflow:hidden}.form-card{padding:28px}.repo-icon{background:#e8f0f7;color:#133c55;border-radius:10px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:23px}.repo-section-title{color:#133c55;font-weight:650}.btn-cop-primary{background:#133c55;color:#fff;border-color:#133c55}.btn-cop-primary:hover{background:#386fa4;border-color:#386fa4;color:#fff}.repo-card .table th{color:#334155;font-weight:600;font-size:14px;background:#f8fafc}.repo-card .table td{font-size:14px;vertical-align:middle}.repo-card .btn-sm{margin:2px}.repo-card .table td,.repo-card .table th{padding:13px 14px}.form-label{font-weight:500;color:#334155}.form-control:focus,.form-select:focus{border-color:#386fa4;box-shadow:0 0 0 .2rem rgba(56,111,164,.13)}.repo-page-btn{min-width:36px}.repo-page-btn.active{background:#133c55;color:#fff;border-color:#133c55}@@media(max-width:767px){.form-card{padding:18px}.repo-card .table td,.repo-card .table th{padding:10px}}
</style>

<div class="container pb-4"><div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2" id="inv-pagination"><span class="text-muted small" id="inv-page-status"></span><div class="d-flex align-items-center gap-2"><span class="small text-muted">10 registros por página</span><button type="button" class="btn btn-sm btn-outline-secondary" id="inv-prev">Anterior</button><span class="small" id="inv-page-number"></span><button type="button" class="btn btn-sm btn-outline-secondary" id="inv-next">Siguiente</button></div></div></div>
<script>
(function(){function ready(){var host=document.getElementById('inv-pagination');if(!host)return;var table=document.querySelector('.repo-card table')||document.querySelector('table');if(!table||!table.tBodies.length){host.style.display='none';return;}var rows=Array.prototype.slice.call(table.tBodies[0].rows).filter(function(r){return !r.querySelector('td[colspan]');});if(!rows.length){host.style.display='none';return;}var prev=document.getElementById('inv-prev'),next=document.getElementById('inv-next'),status=document.getElementById('inv-page-status'),number=document.getElementById('inv-page-number'),page=1;function render(){var n=10,pages=Math.ceil(rows.length/n);page=Math.max(1,Math.min(page,pages));rows.forEach(function(r,i){r.style.display=(i>=(page-1)*n&&i<page*n)?'':'none';});status.textContent='Mostrando '+((page-1)*n+1)+'–'+Math.min(page*n,rows.length)+' de '+rows.length+' registros';number.textContent=page+' / '+pages;prev.disabled=page===1;next.disabled=page===pages;}prev.addEventListener('click',function(){page--;render();});next.addEventListener('click',function(){page++;render();});render();}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready();})();
</script>