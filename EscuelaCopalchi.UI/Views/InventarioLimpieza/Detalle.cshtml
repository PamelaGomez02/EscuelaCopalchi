@model EscuelaCopalchi.UI.Models.InventarioProductoViewModel
@using System
@{ ViewBag.Title = "Detalle del producto"; bool editar=Convert.ToBoolean(ViewBag.PuedeEditar ?? false); bool movimiento=Convert.ToBoolean(ViewBag.PuedeMovimiento ?? false); }
<div class="container py-4"><div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3"><div><h2 class="repo-title"><i class="bi bi-box-seam me-2"></i>@Model.Nombre</h2><p class="text-muted mb-0">Detalle del producto de limpieza e higiene</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Volver al inventario</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="repo-card p-4 h-100"><h5 class="repo-section-title"><i class="bi bi-info-circle me-2"></i>Información del producto</h5><dl class="row mb-0"><dt class="col-sm-4 py-2">Categoría</dt><dd class="col-sm-8 py-2">@Model.Categoria</dd><dt class="col-sm-4 py-2">Descripción</dt><dd class="col-sm-8 py-2">@(string.IsNullOrWhiteSpace(Model.Descripcion)?"Sin descripción":Model.Descripcion)</dd><dt class="col-sm-4 py-2">Unidad</dt><dd class="col-sm-8 py-2">@Model.UnidadMedida</dd><dt class="col-sm-4 py-2">Vencimiento</dt><dd class="col-sm-8 py-2">@(Model.FechaVencimiento.HasValue?Model.FechaVencimiento.Value.ToString("dd/MM/yyyy"):"No registrado")</dd></dl></div></div><div class="col-lg-4"><div class="repo-card p-4"><h5 class="repo-section-title"><i class="bi bi-clipboard-data me-2"></i>Existencias</h5><div class="text-muted small">Stock actual</div><h2>@Model.StockActual <small class="fs-6">@Model.UnidadMedida</small></h2><p class="text-muted">Stock mínimo: <strong>@Model.StockMinimo</strong></p>@if(Model.StockBajo){<div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>Stock bajo o mínimo alcanzado.</div>}else{<div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>Stock disponible.</div>}<div class="d-grid gap-2">@if(editar){<a class="btn btn-outline-primary" href="@Url.Action("Editar",new{id=Model.IdProducto})"><i class="bi bi-pencil me-1"></i>Editar producto</a>}@if(movimiento){<a class="btn btn-cop-primary" href="@Url.Action("RegistrarMovimiento",new{id=Model.IdProducto})"><i class="bi bi-arrow-left-right me-1"></i>Registrar movimiento</a>}</div></div></div></div></div>
<style>
body{background:#f4f7fa}.repo-title{color:#133c55;font-weight:700}.repo-card,.form-card{background:#fff;border:1px solid #e3e8ee;border-radius:10px;overflow:hidden}.form-card{padding:28px}.repo-icon{background:#e8f0f7;color:#133c55;border-radius:10px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:23px}.repo-section-title{color:#133c55;font-weight:650}.btn-cop-primary{background:#133c55;color:#fff;border-color:#133c55}.btn-cop-primary:hover{background:#386fa4;border-color:#386fa4;color:#fff}.repo-card .table th{color:#334155;font-weight:600;font-size:14px;background:#f8fafc}.repo-card .table td{font-size:14px;vertical-align:middle}.repo-card .btn-sm{margin:2px}.repo-card .table td,.repo-card .table th{padding:13px 14px}.form-label{font-weight:500;color:#334155}.form-control:focus,.form-select:focus{border-color:#386fa4;box-shadow:0 0 0 .2rem rgba(56,111,164,.13)}.repo-page-btn{min-width:36px}.repo-page-btn.active{background:#133c55;color:#fff;border-color:#133c55}@@media(max-width:767px){.form-card{padding:18px}.repo-card .table td,.repo-card .table th{padding:10px}}
</style>
