@model EscuelaCopalchi.UI.Models.InventarioReporteViewModel
@using System.Linq
@{ViewBag.Title="Reportes de inventario";}
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3"><div><h2 class="repo-title"><i class="bi bi-bar-chart me-2"></i>Reportes de inventario</h2><p class="text-muted mb-0">Consumo mensual de productos de limpieza e higiene.</p></div><a class="btn btn-outline-secondary" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Volver</a></div><div class="repo-card p-4 mb-4"><h5 class="repo-section-title"><i class="bi bi-calendar3 me-2"></i>Seleccionar período</h5>@using(Html.BeginForm("Reportes","InventarioLimpieza",FormMethod.Get,new{@class="row g-3 align-items-end"})){<div class="col-md-4"><label class="form-label">Año</label><input class="form-control" type="number" name="anio" min="2000" max="9998" value="@Model.Anio" /></div><div class="col-md-4"><label class="form-label">Mes</label><select class="form-select" name="mes">@for(int i=1;i<=12;i++){<option value="@i" selected="@(Model.Mes==i ? "selected" : null)">@(new System.DateTime(2026,i,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))</option>}</select></div><div class="col-md-4"><button class="btn btn-cop-primary w-100"><i class="bi bi-search me-1"></i>Consultar reporte</button></div>}</div><div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h5 class="repo-section-title mb-0"><i class="bi bi-table me-2"></i>Resultados del período</h5><a class="btn btn-success" href="@Url.Action("ExportarExcel",new{anio=Model.Anio,mes=Model.Mes})"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Exportar Excel</a></div><div class="repo-card overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Producto</th><th>Unidad</th><th>Entradas</th><th>Salidas</th><th>Saldo final</th></tr></thead><tbody>@foreach(var x in Model.Filas){<tr><td><strong>@x.Nombre</strong></td><td>@x.Unidad</td><td>@x.Entradas</td><td>@x.Salidas</td><td>@x.SaldoFinal</td></tr>}@if(!Model.Filas.Any()){<tr><td colspan="5" class="text-center text-muted py-5">No hay productos para el período indicado.</td></tr>}</tbody></table></div></div><p class="text-muted small mt-3">El saldo histórico se reconstruye a partir de las existencias actuales y los movimientos posteriores al cierre.</p></div>
<style>
body{background:#f4f7fa}.repo-title{color:#133c55;font-weight:700}.repo-card,.form-card{background:#fff;border:1px solid #e3e8ee;border-radius:10px;overflow:hidden}.form-card{padding:28px}.repo-icon{background:#e8f0f7;color:#133c55;border-radius:10px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;font-size:23px}.repo-section-title{color:#133c55;font-weight:650}.btn-cop-primary{background:#133c55;color:#fff;border-color:#133c55}.btn-cop-primary:hover{background:#386fa4;border-color:#386fa4;color:#fff}.repo-card .table th{color:#334155;font-weight:600;font-size:14px;background:#f8fafc}.repo-card .table td{font-size:14px;vertical-align:middle}.repo-card .btn-sm{margin:2px}.repo-card .table td,.repo-card .table th{padding:13px 14px}.form-label{font-weight:500;color:#334155}.form-control:focus,.form-select:focus{border-color:#386fa4;box-shadow:0 0 0 .2rem rgba(56,111,164,.13)}.repo-page-btn{min-width:36px}.repo-page-btn.active{background:#133c55;color:#fff;border-color:#133c55}@@media(max-width:767px){.form-card{padding:18px}.repo-card .table td,.repo-card .table th{padding:10px}}
</style>

<div class="container pb-4"><div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2" id="inv-pagination"><span class="text-muted small" id="inv-page-status"></span><div class="d-flex align-items-center gap-2"><span class="small text-muted">10 registros por página</span><button type="button" class="btn btn-sm btn-outline-secondary" id="inv-prev">Anterior</button><span class="small" id="inv-page-number"></span><button type="button" class="btn btn-sm btn-outline-secondary" id="inv-next">Siguiente</button></div></div></div>
<script>
(function(){function ready(){var host=document.getElementById('inv-pagination');if(!host)return;var table=document.querySelector('.repo-card table')||document.querySelector('table');if(!table||!table.tBodies.length){host.style.display='none';return;}var rows=Array.prototype.slice.call(table.tBodies[0].rows).filter(function(r){return !r.querySelector('td[colspan]');});if(!rows.length){host.style.display='none';return;}var prev=document.getElementById('inv-prev'),next=document.getElementById('inv-next'),status=document.getElementById('inv-page-status'),number=document.getElementById('inv-page-number'),page=1;function render(){var n=10,pages=Math.ceil(rows.length/n);page=Math.max(1,Math.min(page,pages));rows.forEach(function(r,i){r.style.display=(i>=(page-1)*n&&i<page*n)?'':'none';});status.textContent='Mostrando '+((page-1)*n+1)+'–'+Math.min(page*n,rows.length)+' de '+rows.length+' registros';number.textContent=page+' / '+pages;prev.disabled=page===1;next.disabled=page===pages;}prev.addEventListener('click',function(){page--;render();});next.addEventListener('click',function(){page++;render();});render();}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready();})();
</script>