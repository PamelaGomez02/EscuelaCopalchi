<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Aula Virtual Copalchí</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("styles", required: false)

    <script>
                (function () {
                    try {
                        if (localStorage.getItem('copalchi_sidebar_expandido') === 'true') {
                            document.documentElement.classList.add('cop-sidebar-saved-open');
                        }
                    } catch (e) { }
                })();
    </script>
    <style>
        html, body {
            margin: 0;
        }

        html {
            scroll-padding-top: 70px;
        }

        body {
            padding-top: 60px !important;
        }

        .cop-navbar {
            background: #133C55;
            min-height: 60px;
            z-index: 1050;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
        }

            .cop-navbar .navbar-brand {
                color: white;
                font-weight: 700;
            }

            .cop-navbar .nav-link {
                color: rgba(255,255,255,.85);
            }

                .cop-navbar .nav-link:hover {
                    color: #91E5F6 !important;
                }

        .cop-nav-inner {
            max-width: none !important;
            padding-left: 22px !important;
            padding-right: 22px !important;
        }

        .dropdown-menu {
            border: 1px solid #e3e8ee;
            border-radius: 9px;
            box-shadow: 0 5px 18px rgba(0,0,0,.10);
        }

        .dropdown-item {
            padding: 9px 16px;
            font-size: 14px;
        }

            .dropdown-item:hover {
                background: #E6F1FB;
                color: #133C55;
            }

        .cop-user-menu {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .cop-user-button {
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            padding: 9px 13px;
            color: white;
        }

            .cop-user-button:hover, .cop-user-button:focus {
                background: rgba(255,255,255,.12);
                color: white;
            }

        .cop-user-dropdown {
            min-width: 230px;
            padding: 7px 0;
        }

            .cop-user-dropdown .dropdown-header {
                white-space: normal;
            }

            .cop-user-dropdown form {
                margin: 0;
            }

        .cop-notification-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            background: transparent;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 23px;
            cursor: pointer;
            transition: background-color .2s;
        }

            .cop-notification-button:hover, .cop-notification-button:focus {
                background: rgba(255,255,255,.12);
                color: #91E5F6;
            }

        .cop-notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: #dc3545;
            color: white;
            min-width: 19px;
            height: 19px;
            border-radius: 20px;
            padding: 0 4px;
            font-size: 10px;
            font-weight: 700;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #133C55;
            line-height: 1;
        }

        .cop-notification-menu {
            position: relative;
        }

        .cop-notification-dropdown {
            width: 400px;
            height: 450px;
            min-width: 240px;
            min-height: 200px;
            max-width: calc(100vw - 12px);
            max-height: calc(100vh - 70px);
            padding: 0;
            overflow: hidden;
            border-radius: 12px;
            border: 1px solid #dce5ee;
            box-shadow: 0 12px 35px rgba(0,0,0,.18);
            flex-direction: column;
        }

            .cop-notification-dropdown.show {
                display: flex;
            }

        .cop-notification-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            padding: 13px 15px;
            border-bottom: 1px solid #edf0f3;
            background: white;
            flex-shrink: 0;
        }

            .cop-notification-header strong {
                color: #133C55;
                font-size: 14px;
            }

        .cop-notification-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cop-notification-reset {
            border: none;
            background: #f1f5f9;
            color: #536575;
            border-radius: 6px;
            padding: 5px 8px;
            cursor: pointer;
        }

            .cop-notification-reset:hover {
                background: #dbeeff;
                color: #133C55;
            }

        .cop-notification-actions {
            padding: 8px 14px;
            text-align: right;
            border-bottom: 1px solid #edf0f3;
            flex-shrink: 0;
        }

        .cop-notification-list {
            flex: 1 1 auto;
            min-height: 0;
            max-height: none;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: #a8bdce #f1f5f9;
        }

        .cop-notification-item {
            padding: 13px 16px;
            border-bottom: 1px solid #edf0f3;
            transition: background-color .2s;
        }

            .cop-notification-item:hover {
                background: #e6f1fb;
            }

            .cop-notification-item.no-leida {
                background: #eef6ff;
                border-left: 3px solid #386FA4;
            }

            .cop-notification-item strong {
                display: block;
                color: #133C55;
                font-size: 14px;
            }

            .cop-notification-item p {
                margin: 4px 0;
                color: #536575;
                font-size: 13px;
                overflow-wrap: anywhere;
            }

            .cop-notification-item small {
                color: #778899;
            }

            .cop-notification-item .btn-link {
                color: #386FA4;
                font-size: 12px;
            }

        .cop-notification-footer {
            padding: 10px 14px 34px;
            text-align: center;
            background: #f8fafc;
            border-top: 1px solid #edf0f3;
            flex-shrink: 0;
        }

            .cop-notification-footer a {
                color: #386FA4;
                font-weight: 600;
                text-decoration: none;
                font-size: 13px;
            }

                .cop-notification-footer a:hover {
                    text-decoration: underline;
                }

        .cop-resize-hint {
            display: block;
            margin-top: 7px;
            color: #8896a5;
            font-size: 10px;
        }

        .cop-notification-resizer {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 24px;
            cursor: ns-resize;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            border: none;
            border-top: 1px solid #dce5ee;
            border-radius: 0 0 12px 12px;
            color: #64748b;
            padding: 0;
            touch-action: none;
            transition: background-color .2s;
        }

            .cop-notification-resizer:hover {
                background: #dbeeff;
                color: #133C55;
            }

            .cop-notification-resizer i {
                font-size: 18px;
                pointer-events: none;
            }

        .cop-page-layout {
            display: flex;
            align-items: stretch;
            width: 100%;
            min-height: calc(100vh - 60px);
        }

        .cop-sidebar {
            position: sticky;
            top: 60px;
            align-self: flex-start;
            width: 215px;
            flex: 0 0 215px;
            height: calc(100vh - 60px);
            padding: 12px 10px;
            overflow-y: auto;
            background: white;
            border-right: 1px solid #e5eaf0;
            transition: width .18s ease, flex-basis .18s ease;
        }

        .cop-sidebar-title {
            color: #748394;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .5px;
            padding: 12px;
            text-transform: uppercase;
        }

        .cop-sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            margin: 4px 0;
            border-radius: 8px;
            color: #334e68;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
        }

            .cop-sidebar-link:hover {
                background: #e6f1fb;
                color: #133C55;
            }

            .cop-sidebar-link.active {
                background: #dbeeff;
                color: #123c57;
                font-weight: 700;
                box-shadow: inset 3px 0 #2876aa;
            }

        .cop-sidebar-toggle {
            background: transparent;
            border: none;
            color: white;
            padding: 7px 10px;
            border-radius: 6px;
            margin-right: 8px;
        }

            .cop-sidebar-toggle:hover {
                background: rgba(255,255,255,.15);
            }

        .cop-sidebar.is-collapsed {
            width: 58px;
            flex-basis: 58px;
        }

            .cop-sidebar.is-collapsed .cop-sidebar-label, .cop-sidebar.is-collapsed .cop-sidebar-title, .cop-sidebar.is-collapsed .cop-sidebar-search {
                display: none;
            }

            .cop-sidebar.is-collapsed .cop-sidebar-link {
                justify-content: center;
                padding: 12px 4px;
            }
        /* Restaurar la preferencia antes de que se cargue JavaScript al final de la página. */
        .cop-sidebar-saved-open .cop-sidebar.is-collapsed {
            width: 215px;
            flex-basis: 215px;
        }

            .cop-sidebar-saved-open .cop-sidebar.is-collapsed .cop-sidebar-label, .cop-sidebar-saved-open .cop-sidebar.is-collapsed .cop-sidebar-title, .cop-sidebar-saved-open .cop-sidebar.is-collapsed .cop-sidebar-search {
                display: initial;
            }

            .cop-sidebar-saved-open .cop-sidebar.is-collapsed .cop-sidebar-link {
                justify-content: flex-start;
                padding: 10px 12px;
            }

        .cop-main-content {
            width: 0;
            flex: 1 1 0;
            min-width: 0;
            max-width: none !important;
            padding: 16px 20px;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: calc(100vh - 60px);
        }

            .cop-main-content > .container-fluid {
                max-width: none !important;
                width: 100%;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                flex: 1 0 auto;
            }

            .cop-main-content .container, .cop-main-content .container-lg, .cop-main-content .container-xl, .cop-main-content .container-xxl {
                max-width: none !important;
                width: 100%;
            }

            .cop-main-content .row {
                max-width: none;
            }

        .cop-top-search {
            position: relative;
            width: clamp(190px,24vw,350px);
            margin-right: 16px;
            flex-shrink: 0;
        }

            .cop-top-search input {
                width: 100%;
                height: 35px;
                border: 1px solid rgba(255,255,255,.3);
                border-radius: 7px;
                background: white;
                color: #173b54;
                padding: 6px 12px 6px 35px;
                font-size: 13px;
                outline: none;
            }

                .cop-top-search input:focus {
                    box-shadow: 0 0 0 2px rgba(130,190,230,.4);
                }

        .cop-search-icon {
            position: absolute;
            top: 8px;
            left: 11px;
            color: #6d8295;
            z-index: 1;
        }

        .cop-search-results {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            width: 100%;
            max-height: 360px;
            overflow-y: auto;
            background: white;
            border: 1px solid #dce5ee;
            box-shadow: 0 10px 28px rgba(0,0,0,.18);
            border-radius: 8px;
            z-index: 1100;
            padding: 6px;
        }

            .cop-search-results[hidden], .cop-search-results a[hidden] {
                display: none !important;
            }

            .cop-search-results a {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 9px 10px;
                border-radius: 6px;
                color: #23465d;
                text-decoration: none;
                font-size: 13px;
            }

                .cop-search-results a:hover {
                    background: #e6f1fb;
                }

            .cop-search-results .cop-sidebar-label {
                display: inline !important;
            }

            .cop-search-results .cop-sidebar-link {
                white-space: normal;
            }

        .cop-footer {
            color: #6c757d;
            font-size: .9rem;
            margin-top: auto;
            padding-top: 12px;
        }

        .cop-main-content > .container-fluid > hr {
            margin-top: auto;
        }

        @@media (max-width: 991px) {
            .cop-page-layout {
                display: block;
            }

            .cop-sidebar, .cop-sidebar-saved-open .cop-sidebar.is-collapsed {
                position: relative;
                top: auto;
                width: 100%;
                height: auto;
                flex-basis: auto;
                padding: 10px;
            }

                .cop-sidebar.is-collapsed, .cop-sidebar-saved-open .cop-sidebar.is-collapsed {
                    display: none;
                }

            .cop-main-content {
                width: 100%;
                padding: 12px;
            }

            .cop-user-menu {
                margin: 12px 0;
                justify-content: flex-start;
            }

            .cop-user-dropdown {
                min-width: 220px;
            }

            .cop-top-search {
                width: min(100%,340px);
                margin: 8px 0;
            }
        }

        @@media (max-width: 575px) {
            .cop-notification-dropdown {
                width: min(400px, calc(100vw - 24px)) !important;
                height: min(450px, calc(100dvh - 90px)) !important;
                min-width: 0;
            }

            .cop-resize-hint, .cop-notification-resizer {
                display: none;
            }

            .cop-notification-footer {
                padding-bottom: 12px;
            }
        }
    </style>
</head>
<body>
    @{
        string controladorActual = Convert.ToString(ViewContext.RouteData.Values["controller"]);
        bool mostrarMenuLateral = Request.IsAuthenticated
            && !string.Equals(controladorActual, "Home", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(controladorActual, "Account", StringComparison.OrdinalIgnoreCase);
    }

    <nav class="navbar navbar-expand-lg navbar-dark cop-navbar fixed-top">
        <div class="container-fluid cop-nav-inner">
            @if (mostrarMenuLateral)
            {
                <button type="button" class="cop-sidebar-toggle" id="copToggleSidebar"
                        aria-label="Mostrar u ocultar menú de módulos" aria-controls="copSidebar"
                        aria-expanded="false" title="Expandir menú lateral">
                    <i class="bi bi-list"></i>
                </button>
            }
            @Html.ActionLink("Escuela Copalchí", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarPrincipal" aria-controls="navbarPrincipal"
                    aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                @if (Request.IsAuthenticated)
                {
                    <div class="cop-top-search" id="copTopSearch">
                        <label for="copBuscarModulo" class="visually-hidden">Buscar módulo</label>
                        <i class="bi bi-search cop-search-icon"></i>
                        <input id="copBuscarModulo" type="search" autocomplete="off" placeholder="Buscar módulo..."
                               aria-label="Buscar módulo" aria-controls="copResultadosBusqueda" aria-expanded="false" />
                        <div id="copResultadosBusqueda" class="cop-search-results" hidden>
                            <a class="cop-search-link" href="@Url.Action("Index", "Home")" data-modulo="Inicio">
                                <i class="bi bi-house-door"></i>Inicio
                            </a>
                            @Html.Action("MenuLateral", "Home")
                        </div>
                    </div>
                    <div class="cop-user-menu">
                        <div class="dropdown cop-notification-menu">
                            <button type="button" class="cop-notification-button" id="notificacionesDropdown"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                    aria-expanded="false" aria-label="Abrir notificaciones">
                                <i id="iconoNotificaciones" class="bi bi-bell"></i>
                                <span id="contadorNotificaciones" class="cop-notification-badge"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end cop-notification-dropdown"
                                 id="copNotificationPanel" aria-labelledby="notificacionesDropdown">
                                <div class="cop-notification-header">
                                    <strong><i class="bi bi-bell me-2"></i>Notificaciones</strong>
                                    <div class="cop-notification-header-actions">
                                        <small id="textoPendientes" class="text-muted"></small>
                                        <button type="button" id="btnRestablecerNotificaciones"
                                                class="cop-notification-reset" title="Restablecer tamaño mediano"
                                                aria-label="Restablecer tamaño mediano">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="cop-notification-actions">
                                    <button type="button" id="btnMarcarTodas" class="btn btn-link btn-sm text-decoration-none">
                                        <i class="bi bi-check2-all me-1"></i>Marcar todas como leídas
                                    </button>
                                </div>
                                <div id="listaNotificacionesCampana" class="cop-notification-list">
                                    <div class="text-center text-muted p-4">Cargando notificaciones...</div>
                                </div>
                                <div class="cop-notification-footer">
                                    <a href="@Url.Action("Index", "Notificaciones")">
                                        Ver todas las notificaciones<i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <small class="cop-resize-hint">Arrastra la barra inferior para cambiar el tamaño</small>
                                </div>
                                <button type="button" id="copNotificationResizer" class="cop-notification-resizer"
                                        title="Arrastrar para cambiar el tamaño" aria-label="Cambiar tamaño del cuadro de notificaciones">
                                    <i class="bi bi-grip-horizontal"></i>
                                </button>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-outline-light dropdown-toggle cop-user-button" type="button"
                                    id="usuarioDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i>
                                @(Session["NombreUsuario"] ?? User.Identity.Name)
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end cop-user-dropdown" aria-labelledby="usuarioDropdown">
                                <li class="dropdown-header">
                                    <strong class="d-block text-dark">@(Session["NombreUsuario"] ?? User.Identity.Name)</strong>
                                    <span class="small text-muted"><i class="bi bi-shield-check me-1"></i>@(Session["RolUsuario"] ?? "Usuario")</span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("EditarPerfil", "Usuarios")">
                                        <i class="bi bi-person-gear me-2"></i>Editar mi perfil
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                        </button>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-light cop-user-button" href="@Url.Action("Login", "Account")">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                    </a>
                }
            </div>
        </div>
    </nav>

    @if (Request.IsAuthenticated)
    {
        <div id="tokenNotificaciones" style="display:none;">@Html.AntiForgeryToken()</div>
    }

    <div class="cop-page-layout">
        @if (mostrarMenuLateral)
        {
            <aside class="cop-sidebar is-collapsed" id="copSidebar" aria-label="Navegación de módulos">
                <div class="cop-sidebar-title"><i class="bi bi-grid me-2"></i>Módulos</div>
                <a class="cop-sidebar-link" data-modulo="Inicio" title="Inicio" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-door"></i><span class="cop-sidebar-label">Inicio</span>
                </a>
                @Html.Action("MenuLateral", "Home")
            </aside>
        }
        <main class="cop-main-content">
            <div class="container-fluid">
                <div class="cop-view-content">@RenderBody()</div>
                <hr />
                <footer class="cop-footer"><p>&copy; @DateTime.Now.Year - Aula Virtual Copalchí</p></footer>
            </div>
        </main>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

    <script>
        (function () {
            "use strict";
            const urlResumen = '@Url.Action("Resumen", "Notificaciones")';
            const urlMarcar = '@Url.Action("MarcarLeida", "Notificaciones")';
            const urlTodas = '@Url.Action("MarcarTodasLeidas", "Notificaciones")';
            const urlDetalle = '@Url.Action("Detalle", "Notificaciones")';
            const boton = document.getElementById("notificacionesDropdown");
            const contador = document.getElementById("contadorNotificaciones");
            const icono = document.getElementById("iconoNotificaciones");
            const lista = document.getElementById("listaNotificacionesCampana");
            const texto = document.getElementById("textoPendientes");
            const btnTodas = document.getElementById("btnMarcarTodas");
            if (!boton || !contador || !icono || !lista || !texto) return;
            const token = document.querySelector('#tokenNotificaciones input[name="__RequestVerificationToken"]');

            function elemento(etiqueta, clase, contenido) {
                const el = document.createElement(etiqueta);
                if (clase) el.className = clase;
                if (contenido != null) el.textContent = contenido;
                return el;
            }

            async function enviarPost(url, id) {
                if (!token) throw new Error("No se encontró el token de seguridad.");
                const datos = new URLSearchParams();
                datos.append("__RequestVerificationToken", token.value);
                if (id != null) datos.append("id", id);
                const respuesta = await fetch(url, {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json" },
                    body: datos.toString()
                });
                const contenido = await respuesta.text();
                if (!respuesta.ok) throw new Error("HTTP " + respuesta.status + " - " + contenido.substring(0, 250));
                let resultado;
                try { resultado = JSON.parse(contenido); }
                catch (error) { throw new Error("El servidor no devolvió un JSON válido."); }
                if (resultado.ok !== true) throw new Error(resultado.mensaje || "La base de datos no confirmó la actualización.");
                return resultado;
            }

            async function cargarNotificaciones() {
                try {
                    const respuesta = await fetch(urlResumen, {
                        credentials: "same-origin", cache: "no-store",
                        headers: { "Accept": "application/json" }
                    });
                    if (!respuesta.ok) throw new Error("HTTP " + respuesta.status);
                    const datos = await respuesta.json();
                    const pendientes = Number(datos.pendientes) || 0;
                    const items = Array.isArray(datos.notificaciones) ? datos.notificaciones : [];
                    contador.style.display = pendientes > 0 ? "flex" : "none";
                    contador.textContent = pendientes > 99 ? "99+" : pendientes;
                    icono.className = pendientes > 0 ? "bi bi-bell-fill" : "bi bi-bell";
                    texto.textContent = pendientes === 1 ? "1 sin leer" : pendientes + " sin leer";
                    if (btnTodas) btnTodas.disabled = pendientes === 0;
                    lista.replaceChildren();
                    if (!items.length) {
                        lista.appendChild(elemento("div", "text-center text-muted p-4", "No tienes notificaciones"));
                        return;
                    }
                    items.forEach(function (n) {
                        const item = elemento("div", "cop-notification-item" + (n.leida ? "" : " no-leida"));
                        item.style.cursor = "pointer";
                        item.setAttribute("role", "link");
                        item.setAttribute("tabindex", "0");
                        const abrirDetalle = function () {
                            window.location.href = urlDetalle + "?id=" + encodeURIComponent(n.id);
                        };
                        item.addEventListener("click", function (evento) {
                            if (evento.target.closest("button, a")) return;
                            abrirDetalle();
                        });
                        item.addEventListener("keydown", function (evento) {
                            if (evento.target !== item) return;
                            if (evento.key === "Enter") { evento.preventDefault(); abrirDetalle(); }
                        });
                        item.appendChild(elemento("strong", "", n.titulo || "Notificación"));
                        item.appendChild(elemento("p", "", n.mensaje || ""));
                        item.appendChild(elemento("small", "", (n.fecha || "") + (n.leida ? " · Leída" : " · Sin leer")));
                        if (!n.leida) {
                            const marcar = elemento("button", "btn btn-sm btn-link p-0 mt-2", "Marcar como leída");
                            marcar.type = "button";
                            marcar.addEventListener("click", async function (evento) {
                                evento.stopPropagation();
                                marcar.disabled = true;
                                try { await enviarPost(urlMarcar, n.id); await cargarNotificaciones(); }
                                catch (error) {
                                    marcar.disabled = false;
                                    alert("Error al marcar como leída: " + error.message);
                                    console.error(error);
                                }
                            });
                            item.appendChild(marcar);
                        }
                        lista.appendChild(item);
                    });
                } catch (error) {
                    console.error("Error al cargar notificaciones:", error);
                    lista.replaceChildren(elemento("div", "text-center text-danger p-4", "No se pudieron cargar las notificaciones."));
                }
            }

            if (btnTodas) {
                btnTodas.addEventListener("click", async function () {
                    btnTodas.disabled = true;
                    try { await enviarPost(urlTodas); await cargarNotificaciones(); }
                    catch (error) {
                        btnTodas.disabled = false;
                        alert("Error al marcar todas como leídas: " + error.message);
                        console.error(error);
                    }
                });
            }
            boton.addEventListener("show.bs.dropdown", cargarNotificaciones);
            cargarNotificaciones();
            setInterval(cargarNotificaciones, 60000);
        })();
    </script>

    <script>
                (function () {
                    "use strict";
                    const panel = document.getElementById("copNotificationPanel");
                    const resizer = document.getElementById("copNotificationResizer");
                    const reset = document.getElementById("btnRestablecerNotificaciones");
                    if (!panel || !resizer) return;
                    const ANCHO_INICIAL = 400, ALTO_INICIAL = 450;
                    const ANCHO_MINIMO = 240, ALTO_MINIMO = 200;
                    let arrastrando = false, cambiarAncho = false;
                    let inicioX = 0, inicioY = 0, anchoInicial = 0, altoInicial = 0;
                    function esMovil() { return window.matchMedia("(max-width: 575px)").matches; }
                    function ajustarTamano(ancho, alto) {
                        if (esMovil()) {
                            panel.style.removeProperty("width");
                            panel.style.removeProperty("height");
                            return;
                        }
                        const maxAncho = Math.max(0, window.innerWidth - 12);
                        const maxAlto = Math.max(0, window.innerHeight - 70);
                        ancho = Math.min(Math.max(ANCHO_MINIMO, ancho), maxAncho);
                        alto = Math.min(Math.max(ALTO_MINIMO, alto), maxAlto);
                        panel.style.width = ancho + "px";
                        panel.style.height = alto + "px";
                    }
                    ajustarTamano(ANCHO_INICIAL, ALTO_INICIAL);
                    resizer.addEventListener("pointerdown", function (evento) {
                        if (esMovil() || evento.button !== 0) return;
                        evento.preventDefault();
                        evento.stopPropagation();
                        arrastrando = true;
                        inicioX = evento.clientX;
                        inicioY = evento.clientY;
                        anchoInicial = panel.offsetWidth;
                        altoInicial = panel.offsetHeight;
                        const rect = resizer.getBoundingClientRect();
                        cambiarAncho = evento.clientX < rect.left + 65 || evento.clientX > rect.right - 65;
                        resizer.setPointerCapture(evento.pointerId);
                        document.body.style.userSelect = "none";
                    });
                    resizer.addEventListener("pointermove", function (evento) {
                        if (!arrastrando) return;
                        evento.preventDefault();
                        const diferenciaX = inicioX - evento.clientX;
                        const diferenciaY = evento.clientY - inicioY;
                        ajustarTamano(cambiarAncho ? anchoInicial + diferenciaX : anchoInicial, altoInicial + diferenciaY);
                    });
                    function terminarArrastre() {
                        if (!arrastrando) return;
                        arrastrando = false;
                        document.body.style.userSelect = "";
                    }
                    resizer.addEventListener("pointerup", terminarArrastre);
                    resizer.addEventListener("pointercancel", terminarArrastre);
                    resizer.addEventListener("lostpointercapture", terminarArrastre);
                    if (reset) {
                        reset.addEventListener("click", function (evento) {
                            evento.stopPropagation();
                            ajustarTamano(ANCHO_INICIAL, ALTO_INICIAL);
                        });
                    }
                    window.addEventListener("resize", function () {
                        ajustarTamano(panel.offsetWidth || ANCHO_INICIAL, panel.offsetHeight || ALTO_INICIAL);
                    });
                })();
    </script>

    <script>
                (function () {
                    "use strict";
                    const sidebar = document.getElementById("copSidebar");
                    const toggle = document.getElementById("copToggleSidebar");
                    if (!sidebar) return;
                    const STORAGE_KEY = "copalchi_sidebar_expandido";
                    function obtenerEstadoGuardado() {
                        try { return localStorage.getItem(STORAGE_KEY) === "true"; }
                        catch (error) { return false; }
                    }
                    function guardarEstado(expandido) {
                        try { localStorage.setItem(STORAGE_KEY, String(expandido)); }
                        catch (error) { console.warn("No se pudo guardar el estado del menú.", error); }
                    }
                    function establecerEstado(expandido) {
                        sidebar.classList.toggle("is-collapsed", !expandido);
                        if (toggle) {
                            toggle.setAttribute("aria-expanded", String(expandido));
                            toggle.setAttribute("title", expandido ? "Contraer menú lateral" : "Expandir menú lateral");
                        }
                    }
                    establecerEstado(obtenerEstadoGuardado());
                    document.documentElement.classList.remove("cop-sidebar-saved-open");
                    if (toggle) {
                        toggle.addEventListener("click", function () {
                            const nuevoEstado = sidebar.classList.contains("is-collapsed");
                            establecerEstado(nuevoEstado);
                            guardarEstado(nuevoEstado);
                        });
                    }
                    const path = window.location.pathname.replace(/\/+$/, "").toLowerCase();
                    const links = Array.from(sidebar.querySelectorAll("a.cop-sidebar-link"));
                    const matches = links.filter(function (a) {
                        let target = new URL(a.href, location.origin).pathname.replace(/\/+$/, "").toLowerCase();
                        if (target.endsWith("/index")) target = target.slice(0, -6);
                        return path === target || (target !== "/" && path.indexOf(target + "/") === 0);
                    });
                    if (matches.length) {
                        const active = matches[matches.length - 1];
                        active.classList.add("active");
                        active.setAttribute("aria-current", "page");
                    }
                })();
    </script>

    <script>
                (function () {
                    "use strict";
                    const wrapper = document.getElementById("copTopSearch");
                    const input = document.getElementById("copBuscarModulo");
                    const results = document.getElementById("copResultadosBusqueda");
                    if (!wrapper || !input || !results) return;
                    const links = Array.from(results.querySelectorAll("a[data-modulo]"));
                    function normalize(s) {
                        return (s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
                    }
                    function update() {
                        const query = normalize(input.value.trim());
                        links.forEach(function (link) {
                            const texto = link.getAttribute("data-modulo") || link.textContent;
                            link.hidden = !!query && !normalize(texto).includes(query);
                        });
                        results.hidden = false;
                        input.setAttribute("aria-expanded", "true");
                    }
                    input.addEventListener("focus", update);
                    input.addEventListener("input", update);
                    input.addEventListener("keydown", function (evento) {
                        if (evento.key === "Escape") {
                            results.hidden = true;
                            input.setAttribute("aria-expanded", "false");
                        }
                        if (evento.key === "Enter") {
                            const first = links.find(function (x) { return !x.hidden; });
                            if (first) { evento.preventDefault(); window.location.href = first.href; }
                        }
                    });
                    document.addEventListener("click", function (evento) {
                        if (!wrapper.contains(evento.target)) {
                            results.hidden = true;
                            input.setAttribute("aria-expanded", "false");
                        }
                    });
                })();
    </script>
</body>
