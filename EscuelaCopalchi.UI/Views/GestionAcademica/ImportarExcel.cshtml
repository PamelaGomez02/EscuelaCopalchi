@model EscuelaCopalchi.UI.Models.GestionAcademica.ImportacionViewModel
@using EscuelaCopalchi.UI.Logica.GestionAcademica
@{
    ViewBag.Title = "Importar asignaciones";
    string[] nombresDias = { "", "L", "K", "M", "J", "V", "S", "D" };
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Importar Excel</span>
            </div>

            <h1 class="academic-title">
                <i class="bi bi-file-earmark-excel me-2"></i>
                Importar asignaciones
            </h1>

            <p class="academic-subtitle">
                Carga grupos, aulas, docentes y horarios mediante un archivo Excel.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        @Html.Partial("_BarraUsuario")

        <div class="import-card">

            @if (!Model.HayVistaPrevia)
            {
                @* ===== Paso 1: seleccionar archivo ===== *@
                using (Html.BeginForm("VistaPreviaImportacion", "GestionAcademica", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="upload-zone">

                        <i class="bi bi-file-earmark-excel"></i>

                        <h2>Selecciona un archivo Excel</h2>

                        <p>
                            El archivo debe tener una fila de encabezados con estas columnas:
                        </p>

                        <div class="columns-list">
                            @foreach (var c in ImportacionExcelService.Encabezados)
                            {
                                <span>@c</span>
                            }
                        </div>

                        <input type="file"
                               name="archivo"
                               class="form-control"
                               accept=".xlsx"
                               required />

                        <small>
                            Formato permitido: .xlsx (máximo 5 MB). Obligatorias: Grupo, Periodo, Aula e Identificación docente.
                            Días: "Lunes a Viernes", "L-V" o "L,K,M,J,V". Horas: 07:00.
                        </small>

                        <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
                            <a href="@Url.Action("DescargarPlantilla")" class="btn btn-outline-success">
                                <i class="bi bi-download me-1"></i>
                                Descargar plantilla
                            </a>

                            <button type="submit" class="btn btn-cop-primary">
                                <i class="bi bi-eye me-1"></i>
                                Cargar y ver vista previa
                            </button>
                        </div>

                    </div>
                }

                <div class="form-actions">
                    <a href="@Url.Action("Index", "GestionAcademica")" class="btn btn-light">
                        Volver
                    </a>
                </div>
            }
            else
            {
                @* ===== Paso 2: vista previa ===== *@
                <div class="preview-section">

                    <div class="preview-header">

                        <div>
                            <h3>Vista previa · @Model.NombreArchivo</h3>
                            <p>Verifica los registros antes de procesar. Todavía no se ha guardado nada.</p>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <span class="status-ok">
                                @Model.Validas válidos
                            </span>

                            @if (Model.Duplicadas > 0)
                            {
                                <span class="status-dup">@Model.Duplicadas duplicados</span>
                            }

                            @if (Model.ConErrores > 0)
                            {
                                <span class="status-err">@Model.ConErrores con errores</span>
                            }
                        </div>

                    </div>


                    <div class="table-responsive">

                        <table class="table preview-table align-middle">

                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Grupo</th>
                                    <th>Período</th>
                                    <th>Aula</th>
                                    <th>Docente</th>
                                    <th>Horario</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var f in Model.Filas)
                                {
                                    <tr class="@(f.Valida ? "" : "row-invalid")">
                                        <td class="text-muted">@f.NumeroFila</td>
                                        <td>
                                            <strong>@f.Grupo</strong>
                                            <small class="d-block text-muted">@f.Nivel</small>
                                        </td>
                                        <td>@f.Periodo</td>
                                        <td>@f.Aula</td>
                                        <td>
                                            @(string.IsNullOrEmpty(f.NombreDocente) ? f.IdentificacionDocente : f.NombreDocente)
                                            @if (!string.IsNullOrEmpty(f.NombreDocente))
                                            {
                                                <small class="d-block text-muted">@f.IdentificacionDocente</small>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrEmpty(f.Dias))
                                            {
                                                <span>@(string.Join(" ", f.Dias.Split(',').Select(d => nombresDias[int.Parse(d)])))</span>
                                                <br />
                                            }
                                            else if (!string.IsNullOrEmpty(f.DiasTexto))
                                            {
                                                <span>@f.DiasTexto</span>
                                                <br />
                                            }
                                            @if (!string.IsNullOrEmpty(f.HoraInicio) || !string.IsNullOrEmpty(f.HoraFin))
                                            {
                                                <span>@f.HoraInicio – @f.HoraFin</span>
                                            }
                                        </td>
                                        <td>
                                            @if (f.Valida)
                                            {
                                                <span class="valid">
                                                    <i class="bi bi-check-circle"></i>
                                                    Válido
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="@(f.EsDuplicado ? "dup" : "invalid")">
                                                    <i class="bi @(f.EsDuplicado ? "bi-files" : "bi-x-circle")"></i>
                                                    @f.Estado
                                                </span>
                                                <ul class="error-list">
                                                    @foreach (var e in f.Errores)
                                                    {
                                                        <li>@e</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div class="form-actions">

                    @using (Html.BeginForm("CancelarImportacion", "GestionAcademica", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-light">
                            Cancelar importación
                        </button>
                    }

                    @using (Html.BeginForm("ConfirmarImportacion", "GestionAcademica", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-cop-primary" @(Model.Validas == 0 ? "disabled" : "")
                                onclick="return confirm('Se importarán @Model.Validas registros válidos. ¿Desea continuar?');">
                            <i class="bi bi-upload me-1"></i>
                            Importar @Model.Validas @(Model.Validas == 1 ? "registro válido" : "registros válidos")
                        </button>
                    }

                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .import-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 24px;
        }

        .upload-zone {
            border: 2px dashed #cad5df;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: #fafcfd;
        }

            .upload-zone > i {
                color: #198754;
                font-size: 2.2rem;
            }

            .upload-zone h2 {
                color: var(--cop-primary);
                font-size: 1.05rem;
                margin-top: 10px;
            }

            .upload-zone p,
            .upload-zone small {
                color: var(--cop-muted);
                font-size: .83rem;
            }

        .preview-section {
            border-top: 1px solid #edf0f3;
            margin-top: 25px;
            padding-top: 22px;
        }

        .preview-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

            .preview-header h3 {
                color: var(--cop-primary);
                font-size: 1.05rem;
            }

            .preview-header p {
                color: var(--cop-muted);
                font-size: .83rem;
            }

        .status-ok,
        .valid {
            color: #198754;
            font-weight: 600;
            font-size: .8rem;
        }

        .preview-table th {
            background: #f8fafc;
            color: #53616d;
            font-size: .8rem;
            text-transform: uppercase;
        }

        .form-actions {
            border-top: 1px solid #edf0f3;
            margin-top: 20px;
            padding-top: 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .columns-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            margin-bottom: 16px;
        }

            .columns-list span {
                background: #e6f1fb;
                color: var(--cop-primary);
                border-radius: 6px;
                padding: 3px 9px;
                font-size: .78rem;
                font-weight: 600;
            }

        .status-dup,
        .status-err {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-dup {
            background: #fff3cd;
            color: #856404;
        }

        .status-err {
            background: #f8d7da;
            color: #842029;
        }

        .row-invalid td {
            background: #fffafa;
        }

        .dup {
            color: #856404;
            font-weight: 600;
            font-size: .82rem;
        }

        .invalid {
            color: #b02a37;
            font-weight: 600;
            font-size: .82rem;
        }

        .error-list {
            margin: 4px 0 0;
            padding-left: 16px;
            font-size: .75rem;
            color: #6c757d;
        }
    </style>

}