@model EscuelaCopalchi.UI.Models.GestionAcademica.ImportacionViewModel
@using EscuelaCopalchi.UI.Logica.GestionAcademica
@{
    ViewBag.Title = "Importar asignaciones";
    string[] nombresDias = { "", "L", "K", "M", "J", "V", "S", "D" };
}

<main>

    <section class="academic-header">
    <div class="container">
        <div class="academic-heading-row">
            <div>
                <h1 class="academic-title">
                    <i class="bi bi-file-earmark-excel me-2"></i>
                    Importar asignaciones
                </h1>
                <p class="academic-subtitle">
                    Carga grupos, aulas, docentes y horarios mediante un archivo Excel.
                </p>
                <a href="~/Views/GestionAcademica/ImportarExcel.cshtml">~/Views/GestionAcademica/ImportarExcel.cshtml</a>
            </div>
            <div class="academic-heading-actions">
                <a href="@Url.Action("Index", "GestionAcademica")" class="academic-back-btn" aria-label="Regresar a Gestión académica"><i class="bi bi-arrow-left"></i> Atrás</a>
                
            </div>
        </div>
    </div>
</section>


    <section class="container pb-5">



        <div class="import-card">

            @if (!Model.HayVistaPrevia)
            {
                @* ===== Paso 1: seleccionar archivo ===== *@
                using (Html.BeginForm("VistaPreviaImportacion", "GestionAcademica", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="upload-zone">

                        <i class="bi bi-file-earmark-excel"></i>

                        <h2>Selecciona un archivo Excel</h2>

                        <p>
                            El archivo debe tener una fila de encabezados con estas columnas:
                        </p>

                        <div class="columns-list">
                            @foreach (var c in ImportacionExcelService.Encabezados)
                            {
                                <span>@c</span>
                            }
                        </div>

                        <input type="file"
                               name="archivo"
                               class="form-control"
                               accept=".xlsx"
                               required />

                        <small>
                            Formato permitido: .xlsx (máximo 5 MB). Obligatorias: Grupo, Periodo, Aula e Identificación docente.
                            Días: "Lunes a Viernes", "L-V" o "L,K,M,J,V". Horas: 07:00.
                        </small>

                        <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
                            <a href="@Url.Action("DescargarPlantilla")" class="btn btn-outline-success">
                                <i class="bi bi-download me-1"></i>
                                Descargar plantilla
                            </a>

                            <button type="submit" class="btn btn-cop-primary">
                                <i class="bi bi-eye me-1"></i>
                                Cargar y ver vista previa
                            </button>
                        </div>

                    </div>
                }

            
            }
            else
            {
                @* ===== Paso 2: vista previa ===== *@
                <div class="preview-section">

                    <div class="preview-header">

                        <div>
                            <h3>Vista previa · @Model.NombreArchivo</h3>
                            <p>Verifica los registros antes de procesar. Todavía no se ha guardado nada.</p>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <span class="status-ok">
                                @Model.Validas válidos
                            </span>

                            @if (Model.Duplicadas > 0)
                            {
                                <span class="status-dup">@Model.Duplicadas duplicados</span>
                            }

                            @if (Model.ConErrores > 0)
                            {
                                <span class="status-err">@Model.ConErrores con errores</span>
                            }
                        </div>

                    </div>


                    <div class="table-responsive">

                        <table class="table preview-table align-middle">

                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Grupo</th>
                                    <th>Período</th>
                                    <th>Aula</th>
                                    <th>Docente</th>
                                    <th>Horario</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var f in Model.Filas)
                                {
                                    <tr class="@(f.Valida ? "" : "row-invalid")">
                                        <td class="text-muted">@f.NumeroFila</td>
                                        <td>
                                            <strong>@f.Grupo</strong>
                                            <small class="d-block text-muted">@f.Nivel</small>
                                        </td>
                                        <td>@f.Periodo</td>
                                        <td>@f.Aula</td>
                                        <td>
                                            @(string.IsNullOrEmpty(f.NombreDocente) ? f.IdentificacionDocente : f.NombreDocente)
                                            @if (!string.IsNullOrEmpty(f.NombreDocente))
                                            {
                                                <small class="d-block text-muted">@f.IdentificacionDocente</small>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrEmpty(f.Dias))
                                            {
                                                <span>@(string.Join(" ", f.Dias.Split(',').Select(d => nombresDias[int.Parse(d)])))</span>
                                                <br />
                                            }
                                            else if (!string.IsNullOrEmpty(f.DiasTexto))
                                            {
                                                <span>@f.DiasTexto</span>
                                                <br />
                                            }
                                            @if (!string.IsNullOrEmpty(f.HoraInicio) || !string.IsNullOrEmpty(f.HoraFin))
                                            {
                                                <span>@f.HoraInicio – @f.HoraFin</span>
                                            }
                                        </td>
                                        <td>
                                            @if (f.Valida)
                                            {
                                                <span class="valid">
                                                    <i class="bi bi-check-circle"></i>
                                                    Válido
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="@(f.EsDuplicado ? "dup" : "invalid")">
                                                    <i class="bi @(f.EsDuplicado ? "bi-files" : "bi-x-circle")"></i>
                                                    @f.Estado
                                                </span>
                                                <ul class="error-list">
                                                    @foreach (var e in f.Errores)
                                                    {
                                                        <li>@e</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div class="form-actions">

                    @using (Html.BeginForm("CancelarImportacion", "GestionAcademica", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-light">
                            Cancelar importación
                        </button>
                    }

                    @using (Html.BeginForm("ConfirmarImportacion", "GestionAcademica", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-cop-primary" @(Model.Validas == 0 ? "disabled" : "")
                                onclick="return confirm('Se importarán @Model.Validas registros válidos. ¿Desea continuar?');">
                            <i class="bi bi-upload me-1"></i>
                            Importar @Model.Validas @(Model.Validas == 1 ? "registro válido" : "registros válidos")
                        </button>
                    }

                </div>
            }

        </div>

    </section>

</main>


<style>
.ga-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:15px 16px;background:#fff;border:1px solid #dce5ef;border-top:0;border-radius:0 0 9px 9px}
.ga-pagination-summary{color:#65768a;font-size:.82rem}
.ga-pagination-controls{display:flex;gap:5px;flex-wrap:wrap}
.ga-page-btn{border:1px solid #d6e1ed;background:#fff;color:#133c55;border-radius:6px;padding:6px 11px;font-size:.82rem;min-width:34px}
.ga-page-btn:hover:not(:disabled){background:#eaf2fa}
.ga-page-btn.active{background:#133c55;color:white;border-color:#133c55}
.ga-page-btn:disabled{opacity:.45;cursor:not-allowed}
</style>

<script>
(function () {
    'use strict';
    function iniciarPaginacion() {
        var tablas = document.querySelectorAll('table.academic-table, table.preview-table');
        Array.prototype.forEach.call(tablas, function (tabla, indice) {
            var cuerpo = tabla.tBodies.length ? tabla.tBodies[0] : null;
            if (!cuerpo) return;
            var filas = Array.prototype.slice.call(cuerpo.rows);
            // No paginar filas informativas, por ejemplo "Sin registros".
            if (!filas.length || (filas.length === 1 && filas[0].querySelector('td[colspan]'))) return;
            var porPagina = 10;
            var pagina = 1;
            var entrada = null;
            if (tabla.id === 'tablaAulas') entrada = document.getElementById('buscarAula');
            if (tabla.id === 'tablaEstudiantes') entrada = document.getElementById('buscarEstudiante');
            var panel = document.createElement('div');
            panel.className = 'ga-pagination';
            panel.setAttribute('aria-label', 'Paginación de registros');
            var resumen = document.createElement('span');
            resumen.className = 'ga-pagination-summary';
            var controles = document.createElement('div');
            controles.className = 'ga-pagination-controls';
            panel.appendChild(resumen);
            panel.appendChild(controles);
            var contenedor = tabla.closest('.table-responsive') || tabla;
            contenedor.parentNode.insertBefore(panel, contenedor.nextSibling);
            function boton(texto, destino, deshabilitado, actual) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'ga-page-btn' + (actual ? ' active' : '');
                b.textContent = texto;
                b.disabled = deshabilitado;
                if (actual) b.setAttribute('aria-current', 'page');
                b.addEventListener('click', function () { pagina = destino; pintar(); });
                controles.appendChild(b);
            }
            function pintar() {
                var texto = entrada ? entrada.value.toLocaleLowerCase().trim() : '';
                var filtradas = filas.filter(function (fila) {
                    return !texto || fila.textContent.toLocaleLowerCase().indexOf(texto) !== -1;
                });
                var total = filtradas.length;
                var paginas = Math.max(1, Math.ceil(total / porPagina));
                pagina = Math.min(Math.max(1, pagina), paginas);
                filas.forEach(function (fila) { fila.style.display = 'none'; });
                filtradas.slice((pagina - 1) * porPagina, pagina * porPagina).forEach(function (fila) {
                    fila.style.display = '';
                });
                var inicio = total ? (pagina - 1) * porPagina + 1 : 0;
                var fin = Math.min(pagina * porPagina, total);
                resumen.textContent = 'Mostrando ' + inicio + '–' + fin + ' de ' + total + ' registros';
                controles.textContent = '';
                if (paginas <= 1) return;
                boton('Anterior', pagina - 1, pagina === 1, false);
                var desde = Math.max(1, pagina - 2), hasta = Math.min(paginas, desde + 4);
                desde = Math.max(1, hasta - 4);
                for (var n = desde; n <= hasta; n++) boton(String(n), n, false, n === pagina);
                boton('Siguiente', pagina + 1, pagina === paginas, false);
            }
            if (entrada) entrada.addEventListener('input', function () { pagina = 1; pintar(); });
            pintar();
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciarPaginacion);
    else iniciarPaginacion();
})();
</script>

@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .import-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 24px;
        }

        .upload-zone {
            border: 2px dashed #cad5df;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: #fafcfd;
        }

            .upload-zone > i {
                color: #198754;
                font-size: 2.2rem;
            }

            .upload-zone h2 {
                color: var(--cop-primary);
                font-size: 1.05rem;
                margin-top: 10px;
            }

            .upload-zone p,
            .upload-zone small {
                color: var(--cop-muted);
                font-size: .83rem;
            }

        .preview-section {
            border-top: 1px solid #edf0f3;
            margin-top: 25px;
            padding-top: 22px;
        }

        .preview-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

            .preview-header h3 {
                color: var(--cop-primary);
                font-size: 1.05rem;
            }

            .preview-header p {
                color: var(--cop-muted);
                font-size: .83rem;
            }

        .status-ok,
        .valid {
            color: #198754;
            font-weight: 600;
            font-size: .8rem;
        }

        .preview-table th {
            background: #f8fafc;
            color: #53616d;
            font-size: .8rem;
            text-transform: uppercase;
        }

        .form-actions {
            border-top: 1px solid #edf0f3;
            margin-top: 20px;
            padding-top: 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .columns-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            margin-bottom: 16px;
        }

            .columns-list span {
                background: #e6f1fb;
                color: var(--cop-primary);
                border-radius: 6px;
                padding: 3px 9px;
                font-size: .78rem;
                font-weight: 600;
            }

        .status-dup,
        .status-err {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-dup {
            background: #fff3cd;
            color: #856404;
        }

        .status-err {
            background: #f8d7da;
            color: #842029;
        }

        .row-invalid td {
            background: #fffafa;
        }

        .dup {
            color: #856404;
            font-weight: 600;
            font-size: .82rem;
        }

        .invalid {
            color: #b02a37;
            font-weight: 600;
            font-size: .82rem;
        }

        .error-list {
            margin: 4px 0 0;
            padding-left: 16px;
            font-size: .75rem;
            color: #6c757d;
        }
    
        /* Diseño institucional uniforme: Usuarios / Roles / Estudiantes */
        .academic-header {
            background: transparent;
            border-bottom: 0;
            padding: 0;
            margin: 14px 0 24px;
        }
        .academic-header > .container {
            background: #fff;
            border-bottom: 1px solid #e2e8ef;
            padding: 22px 24px 24px;
        }
        .academic-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 14px;
        }
        .academic-topbar .academic-breadcrumb {
            margin: 0;
            flex-wrap: wrap;
        }
        .academic-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #fff;
            color: #386FA4;
            border: 1px solid #8795a4;
            border-radius: 7px;
            padding: 8px 14px;
            text-decoration: none;
            font-size: .88rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .academic-back-btn:hover, .academic-back-btn:focus {
            background: #f4f7fa;
            border-color: #133C55;
            color: #133C55;
        }
        .academic-header .academic-title {
            color: #133C55;
            font-size: 1.55rem;
            line-height: 1.3;
            margin-bottom: 5px;
        }
        .academic-header .academic-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
        }
        .academic-header .btn-cop-primary { border-radius: 6px; }
        .academic-card, .summary-card, .form-card, .filters-card, .import-card,
        .distribution-card { border-radius: 9px; }
        @@media (max-width: 575px) {
            .academic-header > .container { padding: 18px 16px; }
            .academic-header .academic-title { font-size: 1.32rem; }
            .academic-back-btn { padding: 7px 12px; }
        }

    </style>

}

<style>
