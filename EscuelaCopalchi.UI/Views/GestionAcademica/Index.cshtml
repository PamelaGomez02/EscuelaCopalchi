@model EscuelaCopalchi.UI.Models.GestionAcademica.GestionAcademicaIndexViewModel
@using EscuelaCopalchi.UI.Models.GestionAcademica
@{
    ViewBag.Title = "Gestión académica";
    var usuario = ViewBag.UsuarioActual as UsuarioSesion;
    // Las opciones sin permiso se muestran atenuadas (el permiso se asigna en Roles → Permisos)
    string sinGestion = usuario != null && !usuario.PuedeGestionar ? "option-disabled" : "";
    string sinMiGrupo = usuario != null && !usuario.PuedeVerMiGrupo ? "option-disabled" : "";
    string sinReportes = usuario != null && !usuario.PuedeVerReportes ? "option-disabled" : "";
}

<main>

    <section class="academic-header">
        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Gestión académica</span>
            </div>

            <h1 class="academic-title">
                <i class="bi bi-diagram-3 me-2"></i>
                Gestión académica
            </h1>

            <p class="academic-subtitle">
                Administración de aulas, grupos, estudiantes, docentes y distribución académica.
            </p>

        </div>
    </section>


    <section class="container pb-5">

        @Html.Partial("_BarraUsuario")

        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-door-open"></i>
                    </div>
                    <div>
                        <span>Aulas registradas</span>
                        <h2>@Model.Resumen.Aulas</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <span>Grupos activos</span>
                        <h2>@Model.Resumen.Grupos</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <div>
                        <span>Estudiantes asignados</span>
                        <h2>@Model.Resumen.EstudiantesAsignados</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div>
                        <span>Docentes asignados</span>
                        <h2>@Model.Resumen.DocentesAsignados</h2>
                    </div>
                </div>
            </div>

        </div>


        @* ===== Selección de usuario (temporal hasta que exista el login) ===== *@
        <div class="academic-card mb-4">

            <div class="academic-card-header">
                <div>
                    <h2><i class="bi bi-person-check me-2"></i>¿Con qué usuario desea trabajar?</h2>
                    <p>
                        Mientras el sistema no tenga inicio de sesión, seleccione un usuario. Solo aparecen los usuarios cuyo rol tiene
                        permisos de Gestión Académica (Roles → Permisos).
                    </p>
                </div>
            </div>

            <div class="p-4">
                @using (Html.BeginForm("CambiarUsuario", "GestionAcademica", FormMethod.Post, new { @class = "user-form" }))
                {
                    @Html.AntiForgeryToken()

                    <select name="idUsuario" class="form-select">
                        <option value="0">— Ninguno —</option>

                        @foreach (var grupoRol in Model.Usuarios.GroupBy(u => u.Rol))
                        {
                            <optgroup label="@grupoRol.Key">
                                @foreach (var u in grupoRol)
                                {
                                    <option value="@u.IdUsuario" @(usuario != null && usuario.IdUsuario == u.IdUsuario ? "selected" : "")>
                                        @u.NombreCompleto · @u.Identificacion
                                    </option>
                                }
                            </optgroup>
                        }
                    </select>

                    <button type="submit" class="btn btn-cop-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Usar este usuario
                    </button>
                }

                @if (!Model.Usuarios.Any() && ViewBag.ErrorCarga == null)
                {
                    <p class="text-muted small mt-3 mb-0">
                        No hay usuarios con permisos de Gestión Académica. Ejecute el script de Gestión Académica
                        (incluye usuarios de prueba) o asigne los permisos en Roles → Permisos.
                    </p>
                }
            </div>

        </div>


        <div class="academic-card">

            <div class="academic-card-header">
                <div>
                    <h2>Administración académica</h2>
                    <p>Selecciona la función que deseas administrar.</p>
                </div>
            </div>


            <div class="academic-grid">

                <a href="@Url.Action("Aulas", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-door-open"></i>
                    </div>

                    <div>
                        <strong>Aulas <em class="option-role">Director</em></strong>
                        <span>Crear aulas, definir capacidad y consultar su ocupación.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Docentes", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>

                    <div>
                        <strong>Grupos, horarios y docentes <em class="option-role">Director</em></strong>
                        <span>Crear grupos, definir aula y horario, y asignar el docente responsable.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Asignaciones", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div>
                        <strong>Asignación de estudiantes <em class="option-role">Director</em></strong>
                        <span>Asignar, trasladar o retirar estudiantes de los grupos.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Reportes", "GestionAcademica")"
                   class="academic-option @sinReportes">

                    <div class="option-icon">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                    </div>

                    <div>
                        <strong>Reportes de distribución <em class="option-role">Reportes</em></strong>
                        <span>Reportes por aula, grupo y docente. Exportar a Excel o PDF.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("ImportarExcel", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-file-earmark-excel"></i>
                    </div>

                    <div>
                        <strong>Importar asignaciones <em class="option-role">Director</em></strong>
                        <span>Cargar grupos y docentes desde Excel.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Bitacora", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>
                        <strong>Bitácora de cambios <em class="option-role">Director</em></strong>
                        <span>Historial de asignaciones, traslados e incidentes de notificación.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("MiGrupo", "GestionAcademica")"
                   class="academic-option @sinMiGrupo">

                    <div class="option-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <strong>Mis grupos <em class="option-role">Docente</em></strong>
                        <span>Consultar estudiantes, aula y horario de cada grupo a cargo.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Notificaciones", "GestionAcademica")"
                   class="academic-option">

                    <div class="option-icon">
                        <i class="bi bi-bell"></i>
                    </div>

                    <div>
                        <strong>Notificaciones</strong>
                        <span>Avisos de nuevos grupos, incorporaciones, retiros y cambios de aula.</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>


                <a href="@Url.Action("Distribucion", "GestionAcademica")"
                   class="academic-option @sinGestion">

                    <div class="option-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                    <div>
                        <strong>Distribución automática <em class="option-role">Director</em></strong>
                        <span>Generar propuestas según la capacidad de las aulas (maqueta).</span>
                    </div>

                    <i class="bi bi-chevron-right option-arrow"></i>
                </a>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .summary-card {
            height: 100%;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            color: var(--cop-primary);
            font-size: 1.4rem;
            font-weight: 700;
            margin: 0;
        }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .academic-card-header {
            padding: 22px;
            border-bottom: 1px solid #edf0f3;
        }

            .academic-card-header h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .academic-card-header p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .academic-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            padding: 18px;
            gap: 12px;
        }

        .academic-option {
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            border: 1px solid #e3e8ee;
            border-radius: 9px;
            padding: 16px 45px 16px 16px;
            text-decoration: none;
            transition: .15s ease;
        }

            .academic-option:hover {
                background: #f3f8fd;
                border-color: var(--cop-accent);
                transform: translateY(-1px);
            }

        .option-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 8px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .academic-option strong {
            display: block;
            color: var(--cop-primary);
            font-size: .9rem;
        }

        .academic-option span {
            display: block;
            color: var(--cop-muted);
            font-size: .77rem;
            margin-top: 2px;
        }

        .option-arrow {
            position: absolute;
            right: 16px;
            color: #9da8b2;
        }

        @@media(max-width:768px) {
            .academic-grid {
                grid-template-columns: 1fr;
            }
        }

        .user-form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

            .user-form .form-select {
                flex: 1;
                min-width: 240px;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .option-role {
            font-style: normal;
            font-weight: 600;
            font-size: .66rem;
            color: var(--cop-secondary);
            background: #e6f1fb;
            padding: 1px 7px;
            border-radius: 10px;
            margin-left: 6px;
            vertical-align: middle;
        }

        .option-disabled {
            opacity: .5;
        }
    </style>

}