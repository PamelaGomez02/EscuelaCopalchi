@section scripts {
    <script>
(function () {
            'use strict';

            function campo(id) { return document.getElementById(id); }

            function iniciarModal() {
                var modal = campo('modalGrupo');
                if (!modal) return;

                modal.addEventListener('show.bs.modal', function (ev) {
                    var boton = ev.relatedTarget;
                    var d = (boton && boton.dataset) || {};
                    var nuevo = !d.id;

                    campo('grupoTitulo').textContent = nuevo ? 'Nuevo grupo' : 'Editar grupo ' + (d.nombre || '');
                    campo('grupoId').value = nuevo ? '0' : d.id;
                    campo('grupoNombre').value = nuevo ? '' : (d.nombre || '');
                    campo('grupoNivel').value = nuevo ? '' : (d.nivel || '');
                    campo('grupoPeriodo').value = nuevo ? new Date().getFullYear() : (d.periodo || '');
                    campo('grupoAula').value = nuevo ? '0' : (d.aula || '0');
                    campo('grupoCupo').value = nuevo ? '' : (d.cupo || '');
                    campo('grupoDocente').value = nuevo ? '0' : (d.docente || '0');
                    campo('grupoInicio').value = nuevo ? '07:00' : (d.inicio || '');
                    campo('grupoFin').value = nuevo ? '12:00' : (d.fin || '');

                    var dias = nuevo ? ['1','2','3','4','5'] : (d.dias || '').split(',').map(function (x) { return x.trim(); });
                    document.querySelectorAll('.dia-check').forEach(function (c) {
                        c.checked = dias.indexOf(c.value) >= 0;
                    });
                });

                campo('grupoAula').addEventListener('change', function () {
                    var aula = campo('grupoAula');
                    var opcion = aula.options[aula.selectedIndex];
                    var capacidad = parseInt(opcion && opcion.dataset.capacidad, 10);
                    var cupo = campo('grupoCupo');
                    if (capacidad && (!cupo.value || parseInt(cupo.value, 10) > capacidad)) {
                        cupo.value = capacidad;
                    }
                });
            }

            function iniciarNotificaciones() {
                document.querySelectorAll('.ga-toast').forEach(function (toast) {
                    var cerrado = false;
                    function cerrar() {
                        if (cerrado || !toast.isConnected) return;
                        cerrado = true;
                        toast.classList.add('ga-toast-salida');
                        setTimeout(function () { if (toast.isConnected) toast.remove(); }, 250);
                    }
                    var btn = toast.querySelector('.ga-toast-close');
                    if (btn) btn.addEventListener('click', cerrar);
                    setTimeout(cerrar, 6000);
                });
            }

            function iniciarGuardado() {
                document.querySelectorAll('.ga-save-form').forEach(function (form) {
                    form.addEventListener('submit', function (ev) {
                        if (ev.defaultPrevented || !form.checkValidity()) return;
                        if (form.dataset.enviando === '1') { ev.preventDefault(); return; }
                        form.dataset.enviando = '1';
                        var btn = ev.submitter || form.querySelector('button[type="submit"]');
                        if (!btn) return;
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span><span>Guardando...</span>';
                        // El resultado se confirma tras la respuesta del servidor mediante TempData.
                    });
                });
            }

            function iniciarPaginacion() {
                document.querySelectorAll('table.academic-table, table.preview-table').forEach(function (tabla) {
                    var cuerpo = tabla.tBodies.length ? tabla.tBodies[0] : null;
                    if (!cuerpo) return;
                    var filas = Array.prototype.slice.call(cuerpo.rows);
                    if (!filas.length || (filas.length === 1 && filas[0].querySelector('td[colspan]'))) return;
                    var porPagina = 10, pagina = 1;
                    var entrada = tabla.id === 'tablaAulas' ? campo('buscarAula') :
                                  tabla.id === 'tablaEstudiantes' ? campo('buscarEstudiante') : null;
                    var panel = document.createElement('div');
                    panel.className = 'ga-pagination';
                    panel.setAttribute('aria-label', 'Paginación de registros');
                    var resumen = document.createElement('span');
                    resumen.className = 'ga-pagination-summary';
                    var controles = document.createElement('nav');
                    controles.className = 'ga-pagination-controls';
                    controles.setAttribute('aria-label', 'Páginas');
                    panel.appendChild(resumen);
                    panel.appendChild(controles);
                    var contenedor = tabla.closest('.table-responsive') || tabla;
                    contenedor.parentNode.insertBefore(panel, contenedor.nextSibling);

                    function boton(texto, destino, deshabilitado, actual, titulo) {
                        var b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'ga-page-btn' + (actual ? ' active' : '');
                        b.textContent = texto;
                        b.disabled = deshabilitado;
                        b.title = titulo;
                        if (actual) b.setAttribute('aria-current', 'page');
                        b.addEventListener('click', function () { pagina = destino; pintar(); });
                        controles.appendChild(b);
                    }
                    function pintar() {
                        var texto = entrada ? entrada.value.toLocaleLowerCase().trim() : '';
                        var filtradas = filas.filter(function (fila) {
                            return !texto || fila.textContent.toLocaleLowerCase().indexOf(texto) !== -1;
                        });
                        var total = filtradas.length;
                        var paginas = Math.max(1, Math.ceil(total / porPagina));
                        pagina = Math.min(Math.max(1, pagina), paginas);
                        filas.forEach(function (fila) { fila.style.display = 'none'; });
                        filtradas.slice((pagina - 1) * porPagina, pagina * porPagina).forEach(function (fila) { fila.style.display = ''; });
                        var inicio = total ? (pagina - 1) * porPagina + 1 : 0;
                        var fin = Math.min(pagina * porPagina, total);
                        resumen.textContent = 'Mostrando ' + inicio + '–' + fin + ' de ' + total + ' registros · Página ' + pagina + ' de ' + paginas;
                        controles.textContent = '';
                        panel.style.display = total <= porPagina ? 'none' : '';
                        if (paginas <= 1) return;
                        boton('«', 1, pagina === 1, false, 'Primera página');
                        boton('‹', pagina - 1, pagina === 1, false, 'Página anterior');
                        var desde = Math.max(1, pagina - 2), hasta = Math.min(paginas, desde + 4);
                        desde = Math.max(1, hasta - 4);
                        for (var n = desde; n <= hasta; n++) boton(String(n), n, false, n === pagina, 'Página ' + n);
                        boton('›', pagina + 1, pagina === paginas, false, 'Página siguiente');
                        boton('»', paginas, pagina === paginas, false, 'Última página');
                    }
                    if (entrada) entrada.addEventListener('input', function () { pagina = 1; pintar(); });
                    pintar();
                });
            }

            function iniciar() {
                iniciarModal();
                iniciarNotificaciones();
                iniciarGuardado();
                iniciarPaginacion();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
            else iniciar();
})();
    </script>
}
