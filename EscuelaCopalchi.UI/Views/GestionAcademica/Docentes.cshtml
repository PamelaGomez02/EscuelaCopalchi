@model EscuelaCopalchi.UI.Models.GestionAcademica.DocentesViewModel
@using System
@using System.Linq
@{
    ViewBag.Title = "Grupos, horarios y docentes";
    string[] nombresDias = { "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
    var mensajeExito = TempData["Exito"] ?? TempData["Success"];
    var mensajeError = TempData["Error"];
}

<main class="ga-docentes-page">
    @if (mensajeExito != null)
    {
        <div class="ga-toast ga-toast-success" role="status" aria-live="polite">
            <span class="ga-toast-icon"><i class="bi bi-check-circle-fill"></i></span>
            <div class="ga-toast-content"><strong>Cambios guardados</strong><span>@mensajeExito</span></div>
            <button type="button" class="ga-toast-close" aria-label="Cerrar notificación"><i class="bi bi-x-lg"></i></button>
        </div>
    }
    @if (mensajeError != null)
    {
        <div class="ga-toast ga-toast-error" role="alert">
            <span class="ga-toast-icon"><i class="bi bi-exclamation-circle-fill"></i></span>
            <div class="ga-toast-content"><strong>No se pudieron guardar los cambios</strong><span>@mensajeError</span></div>
            <button type="button" class="ga-toast-close" aria-label="Cerrar notificación"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <section class="academic-header">
        <div class="container">
            <div class="academic-heading-row">
                <div>
                    <h1 class="academic-title"><i class="bi bi-person-badge me-2"></i>Grupos, horarios y docentes</h1>
                    <p class="academic-subtitle">Crea grupos, define su aula y horario, y vincula al docente responsable.</p>
                </div>
                <div class="academic-heading-actions">
                    <a href="@Url.Action("Index", "GestionAcademica")" class="academic-back-btn"><i class="bi bi-arrow-left"></i> Atrás</a>
                    <button type="button" class="btn btn-cop-primary" data-bs-toggle="modal" data-bs-target="#modalGrupo" data-nuevo="1">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo grupo
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5">
        <div class="academic-card">
            <div class="toolbar">
                <div>
                    <h2>Grupos y docentes responsables</h2>
                    <p>Al asignar o cambiar el docente, el aula o el horario se notifica al docente y se registra en la bitácora.</p>
                </div>
                <form method="get" action="@Url.Action("Docentes", "GestionAcademica")">
                    <select name="periodo" class="form-select form-select-sm" aria-label="Filtrar por período" onchange="this.form.submit()">
                        <option value="0" @(Model.Periodo == 0 ? "selected" : "")>Todos los períodos</option>
                        @foreach (var p in Model.Periodos)
                        {
                            <option value="@p" @(Model.Periodo == p ? "selected" : "")>@p</option>
                        }
                    </select>
                </form>
            </div>

            @if (!Model.Grupos.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-collection"></i>
                    <strong>No hay grupos registrados</strong>
                    <span>Cree un grupo con el botón «Nuevo grupo» o impórtelos desde Excel.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table academic-table align-middle">
                        <thead>
                            <tr>
                                <th>Grupo</th>
                                <th>Aula</th>
                                <th>Horario</th>
                                <th>Docente responsable</th>
                                <th>Estudiantes</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.Grupos)
                            {
                                <tr>
                                    <td>
                                        <strong>@g.Nombre</strong>
                                        <small class="d-block text-muted">@g.Nivel @(string.IsNullOrEmpty(g.Nivel) ? "" : "·") @g.Periodo</small>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(g.Aula) ? "Sin aula" : g.Aula)</td>
                                    <td class="small">@g.Horario</td>
                                    <td>
                                        <select name="idDocente" form="formDocente@(g.IdGrupo)" class="form-select form-select-sm" aria-label="Docente del grupo @g.Nombre">
                                            <option value="0">— Sin docente —</option>
                                            @foreach (var d in Model.Docentes)
                                            {
                                                <option value="@d.IdDocente" @(d.IdDocente == g.IdDocente ? "selected" : "")>
                                                    @d.NombreCompleto (@d.TotalGrupos @(d.TotalGrupos == 1 ? "grupo" : "grupos"))
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td>@g.TotalEstudiantes / @g.Capacidad</td>
                                    <td class="text-end">
                                        <div class="ga-actions">
                                            @using (Html.BeginForm("AsignarDocente", "GestionAcademica", FormMethod.Post,
                                                new { id = "formDocente" + g.IdGrupo, @class = "ga-save-form" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idGrupo" value="@g.IdGrupo" />
                                                <input type="hidden" name="periodoFiltro" value="@Model.Periodo" />
                                                <button type="submit" class="btn btn-guardar-docente" title="Guardar asignación del docente">
                                                    <i class="bi bi-check2-circle"></i><span class="ga-btn-text">Guardar</span>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-action" title="Editar grupo" aria-label="Editar grupo @g.Nombre"
                                                    data-bs-toggle="modal" data-bs-target="#modalGrupo"
                                                    data-id="@g.IdGrupo"
                                                    data-nombre="@g.Nombre"
                                                    data-nivel="@g.Nivel"
                                                    data-periodo="@g.Periodo"
                                                    data-cupo="@g.Cupo"
                                                    data-aula="@g.IdAula"
                                                    data-docente="@g.IdDocente"
                                                    data-dias="@g.Dias"
                                                    data-inicio="@g.HoraInicio"
                                                    data-fin="@g.HoraFin">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (g.IdDocente > 0)
                                            {
                                                using (Html.BeginForm("AsignarDocente", "GestionAcademica", FormMethod.Post, new { @class = "ga-save-form" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idGrupo" value="@g.IdGrupo" />
                                                    <input type="hidden" name="idDocente" value="0" />
                                                    <input type="hidden" name="periodoFiltro" value="@Model.Periodo" />
                                                    <button type="submit" class="btn btn-action-danger" title="Quitar docente" aria-label="Quitar docente de @g.Nombre"
                                                            onclick="return confirm('¿Quitar el docente del grupo @g.Nombre?');">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @if (!Model.Docentes.Any())
        {
            <p class="text-muted small mt-3"><i class="bi bi-info-circle"></i> No hay docentes activos en la tabla DOCENTE. Ejecute el script de Gestión Académica o registre docentes.</p>
        }
    </section>
</main>

@* Modal para crear y editar grupos *@
<div class="modal fade" id="modalGrupo" tabindex="-1" aria-labelledby="grupoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ga-modal-content">
            @using (Html.BeginForm("GuardarGrupo", "GestionAcademica", FormMethod.Post, new { id = "formGuardarGrupo", @class = "ga-save-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="idGrupo" id="grupoId" value="0" />
                <input type="hidden" name="periodoFiltro" value="@Model.Periodo" />
                <div class="modal-header">
                    <h5 class="modal-title" id="grupoTitulo">Nuevo grupo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="grupoNombre" class="form-label">Nombre del grupo *</label>
                            <input name="nombre" id="grupoNombre" class="form-control" maxlength="20" placeholder="Ej. 3-A" required />
                        </div>
                        <div class="col-md-4">
                            <label for="grupoNivel" class="form-label">Nivel</label>
                            <input name="nivel" id="grupoNivel" class="form-control" maxlength="30" placeholder="Ej. Tercero" />
                        </div>
                        <div class="col-md-4">
                            <label for="grupoPeriodo" class="form-label">Período *</label>
                            <input name="periodo" id="grupoPeriodo" type="number" min="2000" max="2100" class="form-control" value="@DateTime.Today.Year" required />
                        </div>
                        <div class="col-md-4">
                            <label for="grupoAula" class="form-label">Aula</label>
                            <select name="idAula" id="grupoAula" class="form-select">
                                <option value="0">— Sin aula —</option>
                                @foreach (var a in Model.Aulas)
                                {
                                    <option value="@a.IdAula" data-capacidad="@a.Capacidad">@a.Nombre · capacidad @a.Capacidad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="grupoCupo" class="form-label">Cupo del grupo *</label>
                            <input name="cupo" id="grupoCupo" type="number" min="1" max="200" class="form-control" required />
                        </div>
                        <div class="col-md-5">
                            <label for="grupoDocente" class="form-label">Docente responsable</label>
                            <select name="idDocente" id="grupoDocente" class="form-select">
                                <option value="0">— Sin docente —</option>
                                @foreach (var d in Model.Docentes)
                                {
                                    <option value="@d.IdDocente">@d.NombreCompleto</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label d-block">Días de clase</label>
                            @for (int dia = 1; dia <= 7; dia++)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input dia-check" type="checkbox" name="dias" value="@dia" id="dia@(dia)" />
                                    <label class="form-check-label" for="dia@(dia)">@nombresDias[dia]</label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label for="grupoInicio" class="form-label">Hora de inicio</label>
                            <input type="time" name="horaInicio" id="grupoInicio" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="grupoFin" class="form-label">Hora final</label>
                            <input type="time" name="horaFin" id="grupoFin" class="form-control" />
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">El cupo no puede superar la capacidad del aula. Si el grupo ya tiene estudiantes, el aula nueva debe tener capacidad suficiente.</p>
                </div>
                <div class="modal-footer ga-modal-footer">
                    <button type="button" class="btn btn-outline-secondary ga-btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-guardar-grupo">
                        <i class="bi bi-check2-circle"></i><span class="ga-btn-text">Guardar grupo</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

