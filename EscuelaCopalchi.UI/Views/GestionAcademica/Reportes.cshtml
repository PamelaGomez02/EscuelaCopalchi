@{
    ViewBag.Title = "Reportes de distribución";
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Reportes</span>
            </div>

            <h1 class="academic-title">
                <i class="bi bi-file-earmark-bar-graph me-2"></i>
                Reportes de distribución
            </h1>

            <p class="academic-subtitle">
                Consulta la distribución académica por aula, grupo o docente.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <div class="filters-card">

            <div>

                <label class="form-label">Tipo de reporte</label>

                <select class="form-select">
                    <option>Por aula</option>
                    <option>Por grupo</option>
                    <option>Por docente</option>
                </select>

            </div>


            <div>

                <label class="form-label">Período</label>

                <select class="form-select">
                    <option>2026</option>
                </select>

            </div>


            <button class="btn btn-cop-primary">
                <i class="bi bi-search me-1"></i>
                Generar
            </button>

        </div>


        <div class="academic-card mt-4">

            <div class="toolbar">

                <div>
                    <h2>Resultados</h2>
                    <p>Distribución actual por aula.</p>
                </div>


                <div class="d-flex gap-2">

                    <button class="btn btn-outline-success">
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        Excel
                    </button>

                    <button class="btn btn-outline-danger">
                        <i class="bi bi-file-earmark-pdf me-1"></i>
                        PDF
                    </button>

                </div>

            </div>


            <div class="table-responsive">

                <table class="table academic-table">

                    <thead>
                        <tr>
                            <th>Aula</th>
                            <th>Grupo</th>
                            <th>Docente</th>
                            <th>Estudiantes</th>
                            <th>Capacidad</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Aula 1</td>
                            <td>1-A</td>
                            <td>María González</td>
                            <td>28</td>
                            <td>30</td>
                        </tr>

                        <tr>
                            <td>Aula 2</td>
                            <td>1-B</td>
                            <td>José Pérez</td>
                            <td>27</td>
                            <td>30</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .filters-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            align-items: end;
            gap: 12px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            padding: 22px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.1rem;
                margin-bottom: 4px;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .83rem;
                margin: 0;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                text-transform: uppercase;
                font-size: .8rem;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
            }

        @@media(max-width:768px) {
            .filters-card {
                grid-template-columns: 1fr;
            }
        }
    </style>

}