@model EscuelaCopalchi.UI.Models.GestionAcademica.ReportesViewModel
@{
    ViewBag.Title = "Reportes de distribución";
    var r = Model.Resultado;
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Reportes</span>
            </div>

            <h1 class="academic-title">
                <i class="bi bi-file-earmark-bar-graph me-2"></i>
                Reportes de distribución
            </h1>

            <p class="academic-subtitle">
                Consulta la distribución de estudiantes por aula, grupo o docente.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        @Html.Partial("_BarraUsuario")

        <form method="get" action="@Url.Action("Reportes")" class="filters-card">

            <div>

                <label class="form-label">Tipo de reporte</label>

                <select name="tipo" class="form-select">
                    <option value="AULA" @(Model.Tipo == "AULA" ? "selected" : "")>Por aula</option>
                    <option value="GRUPO" @(Model.Tipo == "GRUPO" ? "selected" : "")>Por grupo</option>
                    <option value="DOCENTE" @(Model.Tipo == "DOCENTE" ? "selected" : "")>Por docente</option>
                </select>

            </div>


            <div>

                <label class="form-label">Período</label>

                <select name="periodo" class="form-select">
                    <option value="0" @(Model.Periodo == 0 ? "selected" : "")>Todos</option>
                    @foreach (var p in Model.Periodos)
                    {
                        <option value="@p" @(Model.Periodo == p ? "selected" : "")>@p</option>
                    }
                </select>

            </div>


            <button type="submit" class="btn btn-cop-primary">
                <i class="bi bi-search me-1"></i>
                Generar
            </button>

        </form>


        <div class="academic-card mt-4">

            <div class="toolbar">

                <div>
                    <h2>@(r != null ? r.Titulo : "Resultados")</h2>
                    <p>@(r != null ? r.Subtitulo : "")</p>
                </div>

                @if (r != null && r.TieneDatos)
                {
                    <div class="d-flex gap-2">

                        <a class="btn btn-outline-success"
                           href="@Url.Action("ExportarReporte", new { tipo = Model.Tipo, periodo = Model.Periodo, formato = "excel" })">
                            <i class="bi bi-file-earmark-excel me-1"></i>
                            Excel
                        </a>

                        <a class="btn btn-outline-danger"
                           href="@Url.Action("ExportarReporte", new { tipo = Model.Tipo, periodo = Model.Periodo, formato = "pdf" })">
                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            PDF
                        </a>

                    </div>
                }

            </div>


            @if (r == null || !r.TieneDatos)
            {
                <div class="ga-empty">
                    <i class="bi bi-bar-chart"></i>
                    <strong>No hay información para mostrar</strong>
                    No existen grupos con asignaciones para el tipo de reporte y período seleccionados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table academic-table">

                        <thead>
                            <tr>
                                @foreach (var c in r.Columnas)
                                {
                                    <th>@c</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var fila in r.Filas)
                            {
                                <tr>
                                    @for (int i = 0; i < fila.Length; i++)
                                    {
                                        if (i == 0)
                                        {
                                            <td><strong>@fila[i]</strong></td>
                                        }
                                        else
                                        {
                                            <td>@fila[i]</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="@r.Columnas.Count" class="text-muted small">
                                    @r.Filas.Count @(r.Filas.Count == 1 ? "registro" : "registros")
                                </td>
                            </tr>
                        </tfoot>

                    </table>

                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .filters-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            align-items: end;
            gap: 12px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding: 22px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.1rem;
                margin-bottom: 4px;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .83rem;
                margin: 0;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                text-transform: uppercase;
                font-size: .8rem;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
            }

        @@media(max-width:768px) {
            .filters-card {
                grid-template-columns: 1fr;
            }
        }
    </style>

}