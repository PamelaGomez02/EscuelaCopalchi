@model List<EscuelaCopalchi.UI.Models.GestionAcademica.Aula>
@{
    ViewBag.Title = "Aulas";
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Aulas</span>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <h1 class="academic-title">
                        <i class="bi bi-door-open me-2"></i>
                        Aulas
                    </h1>

                    <p class="academic-subtitle">
                        Administra las aulas, su capacidad y consulta qué grupos las utilizan.
                    </p>
                </div>

                <button class="btn btn-cop-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalAula">

                    <i class="bi bi-plus-lg me-1"></i>
                    Nueva aula

                </button>

            </div>

        </div>

    </section>


    <section class="container pb-5">

        @Html.Partial("_BarraUsuario")

        <div class="academic-card">

            <div class="toolbar">

                <div>
                    <h2>Aulas registradas</h2>
                    <p>La capacidad limita cuántos estudiantes puede tener cada grupo que usa el aula. Los horarios se definen en cada grupo.</p>
                </div>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input class="form-control" id="buscarAula"
                           placeholder="Buscar aula..." />
                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-door-closed"></i>
                    <strong>No hay aulas registradas</strong>
                    Use el botón "Nueva aula" para registrar la primera.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table academic-table align-middle" id="tablaAulas">

                        <thead>
                            <tr>
                                <th>Aula</th>
                                <th>Capacidad</th>
                                <th>Grupos que la usan</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@a.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(a.Ubicacion))
                                        {
                                            <small class="d-block text-muted">@a.Ubicacion</small>
                                        }
                                    </td>

                                    <td>@a.Capacidad estudiantes</td>

                                    <td class="small">@(string.IsNullOrEmpty(a.Grupos) ? "Ninguno" : a.Grupos)</td>

                                    <td>
                                        @if (!a.Estado)
                                        {
                                            <span class="status status-off">Inactiva</span>
                                        }
                                        else if (a.Completa)
                                        {
                                            <span class="status status-danger">Completa</span>
                                        }
                                        else
                                        {
                                            <span class="status status-ok">Disponible</span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <button class="btn btn-action"
                                                title="Editar aula"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalAula"
                                                data-id="@a.IdAula"
                                                data-nombre="@a.Nombre"
                                                data-capacidad="@a.Capacidad"
                                                data-ubicacion="@a.Ubicacion"
                                                data-estado="@(a.Estado ? "true" : "false")">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>

</main>


<div class="modal fade"
     id="modalAula"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            @using (Html.BeginForm("GuardarAula", "GestionAcademica", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="idAula" id="aulaId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title" id="aulaTitulo">Registrar aula</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <label class="form-label">
                        Nombre del aula *
                    </label>

                    <input class="form-control mb-3" name="nombre" id="aulaNombre" maxlength="50" required
                           placeholder="Ej. Aula 3" />


                    <label class="form-label">
                        Capacidad máxima *
                    </label>

                    <input type="number" name="capacidad" id="aulaCapacidad" min="1" max="200" required
                           class="form-control mb-3"
                           placeholder="30" />


                    <label class="form-label">
                        Ubicación
                    </label>

                    <input class="form-control mb-3" name="ubicacion" id="aulaUbicacion" maxlength="150"
                           placeholder="Ej. Pabellón A, primer piso" />


                    <label class="form-label">
                        Estado
                    </label>

                    <select name="estado" id="aulaEstado" class="form-select">
                        <option value="true">Activa</option>
                        <option value="false">Inactiva</option>
                    </select>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-cop-primary">
                        Guardar aula
                    </button>

                </div>
            }

        </div>

    </div>

</div>

@section scripts {
    <script>
                // Object(...) devuelve el mismo elemento sin tipo, así Visual Studio no marca avisos de TypeScript
                function campo(id) {
                    return Object(document.getElementById(id));
                }

                campo('modalAula').addEventListener('show.bs.modal', function (ev) {
                    var boton = Object(ev).relatedTarget;
                    var d = (boton && boton.dataset) || {};
                    var nuevo = !d.id;

                    campo('aulaTitulo').textContent = nuevo ? 'Registrar aula' : 'Editar ' + d.nombre;
                    campo('aulaId').value = nuevo ? 0 : d.id;
                    campo('aulaNombre').value = nuevo ? '' : d.nombre;
                    campo('aulaCapacidad').value = nuevo ? '' : d.capacidad;
                    campo('aulaUbicacion').value = nuevo ? '' : d.ubicacion;
                    campo('aulaEstado').value = nuevo ? 'true' : d.estado;
                });

                var buscar = campo('buscarAula');
                if (buscar) {
                    buscar.addEventListener('input', function () {
                        var texto = buscar.value.toLowerCase();
                        document.querySelectorAll('#tablaAulas tbody tr').forEach(function (f) {
                            var fila = Object(f);
                            fila.style.display = fila.textContent.toLowerCase().indexOf(texto) >= 0 ? '' : 'none';
                        });
                    });
                }
    </script>
}

@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .search-box {
            position: relative;
            width: 260px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
                border-color: #edf0f3;
            }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-danger {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .status-off {
            background: #f1f3f5;
            color: #6c757d;
        }
    </style>

}