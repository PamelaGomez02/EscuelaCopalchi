@{
    ViewBag.Title = "Aulas y horarios";
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Aulas</span>
            </div>

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h1 class="academic-title">
                        <i class="bi bi-door-open me-2"></i>
                        Aulas y horarios
                    </h1>

                    <p class="academic-subtitle">
                        Administra las aulas, capacidad y horarios disponibles.
                    </p>
                </div>

                <button class="btn btn-cop-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalAula">

                    <i class="bi bi-plus-lg me-1"></i>
                    Nueva aula

                </button>

            </div>

        </div>

    </section>


    <section class="container pb-5">

        <div class="academic-card">

            <div class="toolbar">

                <div>
                    <h2>Aulas registradas</h2>
                    <p>Consulta la capacidad y horario de cada aula.</p>
                </div>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="Buscar aula..." />
                </div>

            </div>


            <div class="table-responsive">

                <table class="table academic-table align-middle">

                    <thead>
                        <tr>
                            <th>Aula</th>
                            <th>Capacidad</th>
                            <th>Horario</th>
                            <th>Ocupación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>
                                <strong>Aula 1</strong>
                            </td>

                            <td>30 estudiantes</td>

                            <td>7:00 a.m. – 12:00 m.d.</td>

                            <td>28 / 30</td>

                            <td>
                                <span class="status status-ok">
                                    Disponible
                                </span>
                            </td>

                            <td class="text-end">

                                <button class="btn btn-action"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAula">
                                    <i class="bi bi-pencil"></i>
                                </button>

                            </td>
                        </tr>


                        <tr>
                            <td>
                                <strong>Aula 2</strong>
                            </td>

                            <td>25 estudiantes</td>

                            <td>7:00 a.m. – 12:00 m.d.</td>

                            <td>25 / 25</td>

                            <td>
                                <span class="status status-danger">
                                    Completa
                                </span>
                            </td>

                            <td class="text-end">

                                <button class="btn btn-action"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAula">
                                    <i class="bi bi-pencil"></i>
                                </button>

                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


<div class="modal fade"
     id="modalAula"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Registrar aula</h5>
                <button class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <label class="form-label">
                    Nombre del aula *
                </label>

                <input class="form-control mb-3"
                       placeholder="Ej. Aula 3" />


                <label class="form-label">
                    Capacidad máxima *
                </label>

                <input type="number"
                       class="form-control mb-3"
                       placeholder="30" />


                <div class="row g-3">

                    <div class="col-6">
                        <label class="form-label">Hora inicio</label>
                        <input type="time"
                               class="form-control" />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Hora final</label>
                        <input type="time"
                               class="form-control" />
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-cop-primary">
                    Guardar aula
                </button>

            </div>

        </div>

    </div>

</div>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .search-box {
            position: relative;
            width: 260px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
                border-color: #edf0f3;
            }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-danger {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
        }
    </style>

}