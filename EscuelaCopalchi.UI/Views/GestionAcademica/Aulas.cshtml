@model List<EscuelaCopalchi.UI.Models.GestionAcademica.Aula>
@{
    ViewBag.Title = "Aulas";
}

<main>

    <section class="academic-header">
    <div class="container">
        <div class="academic-heading-row">
            <div>
                <h1 class="academic-title">
                        <i class="bi bi-door-open me-2"></i>
                        Aulas
                    </h1>
                <p class="academic-subtitle">
                        Administra las aulas, su capacidad y consulta qué grupos las utilizan.
                    </p>
            </div>
            <div class="academic-heading-actions">
                <a href="@Url.Action("Index", "GestionAcademica")" class="academic-back-btn" aria-label="Regresar a Gestión académica"><i class="bi bi-arrow-left"></i> Atrás</a>
                <button class="btn btn-cop-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalAula">

                    <i class="bi bi-plus-lg me-1"></i>
                    Nueva aula

                </button>
            </div>
        </div>
    </div>
</section>


    <section class="container pb-5">

 
        <div class="academic-card">

            <div class="toolbar">

                <div>
                    <h2>Aulas registradas</h2>
                    <p>La capacidad limita cuántos estudiantes puede tener cada grupo que usa el aula. Los horarios se definen en cada grupo.</p>
                </div>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input class="form-control" id="buscarAula"
                           placeholder="Buscar aula..." />
                </div>

            </div>

            @if (!Model.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-door-closed"></i>
                    <strong>No hay aulas registradas</strong>
                    Use el botón "Nueva aula" para registrar la primera.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table academic-table align-middle" id="tablaAulas">

                        <thead>
                            <tr>
                                <th>Aula</th>
                                <th>Capacidad</th>
                                <th>Grupos que la usan</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@a.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(a.Ubicacion))
                                        {
                                            <small class="d-block text-muted">@a.Ubicacion</small>
                                        }
                                    </td>

                                    <td>@a.Capacidad estudiantes</td>

                                    <td class="small">@(string.IsNullOrEmpty(a.Grupos) ? "Ninguno" : a.Grupos)</td>

                                    <td>
                                        @if (!a.Estado)
                                        {
                                            <span class="status status-off">Inactiva</span>
                                        }
                                        else if (a.Completa)
                                        {
                                            <span class="status status-danger">Completa</span>
                                        }
                                        else
                                        {
                                            <span class="status status-ok">Disponible</span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <button class="btn btn-action"
                                                title="Editar aula"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalAula"
                                                data-id="@a.IdAula"
                                                data-nombre="@a.Nombre"
                                                data-capacidad="@a.Capacidad"
                                                data-ubicacion="@a.Ubicacion"
                                                data-estado="@(a.Estado ? "true" : "false")">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>

</main>


<div class="modal fade"
     id="modalAula"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            @using (Html.BeginForm("GuardarAula", "GestionAcademica", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="idAula" id="aulaId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title" id="aulaTitulo">Registrar aula</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <label class="form-label">
                        Nombre del aula *
                    </label>

                    <input class="form-control mb-3" name="nombre" id="aulaNombre" maxlength="50" required
                           placeholder="Ej. Aula 3" />


                    <label class="form-label">
                        Capacidad máxima *
                    </label>

                    <input type="number" name="capacidad" id="aulaCapacidad" min="1" max="200" required
                           class="form-control mb-3"
                           placeholder="30" />


                    <label class="form-label">
                        Ubicación
                    </label>

                    <input class="form-control mb-3" name="ubicacion" id="aulaUbicacion" maxlength="150"
                           placeholder="Ej. Pabellón A, primer piso" />


                    <label class="form-label">
                        Estado
                    </label>

                    <select name="estado" id="aulaEstado" class="form-select">
                        <option value="true">Activa</option>
                        <option value="false">Inactiva</option>
                    </select>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-cop-primary">
                        Guardar aula
                    </button>

                </div>
            }

        </div>

    </div>

</div>

<style>
.ga-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:15px 16px;background:#fff;border:1px solid #dce5ef;border-top:0;border-radius:0 0 9px 9px}
.ga-pagination-summary{color:#65768a;font-size:.82rem}
.ga-pagination-controls{display:flex;gap:5px;flex-wrap:wrap}
.ga-page-btn{border:1px solid #d6e1ed;background:#fff;color:#133c55;border-radius:6px;padding:6px 11px;font-size:.82rem;min-width:34px}
.ga-page-btn:hover:not(:disabled){background:#eaf2fa}
.ga-page-btn.active{background:#133c55;color:white;border-color:#133c55}
.ga-page-btn:disabled{opacity:.45;cursor:not-allowed}
</style>

<script>
(function () {
    'use strict';
    function iniciarPaginacion() {
        var tablas = document.querySelectorAll('table.academic-table, table.preview-table');
        Array.prototype.forEach.call(tablas, function (tabla, indice) {
            var cuerpo = tabla.tBodies.length ? tabla.tBodies[0] : null;
            if (!cuerpo) return;
            var filas = Array.prototype.slice.call(cuerpo.rows);
            // No paginar filas informativas, por ejemplo "Sin registros".
            if (!filas.length || (filas.length === 1 && filas[0].querySelector('td[colspan]'))) return;
            var porPagina = 10;
            var pagina = 1;
            var entrada = null;
            if (tabla.id === 'tablaAulas') entrada = document.getElementById('buscarAula');
            if (tabla.id === 'tablaEstudiantes') entrada = document.getElementById('buscarEstudiante');
            var panel = document.createElement('div');
            panel.className = 'ga-pagination';
            panel.setAttribute('aria-label', 'Paginación de registros');
            var resumen = document.createElement('span');
            resumen.className = 'ga-pagination-summary';
            var controles = document.createElement('div');
            controles.className = 'ga-pagination-controls';
            panel.appendChild(resumen);
            panel.appendChild(controles);
            var contenedor = tabla.closest('.table-responsive') || tabla;
            contenedor.parentNode.insertBefore(panel, contenedor.nextSibling);
            function boton(texto, destino, deshabilitado, actual) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'ga-page-btn' + (actual ? ' active' : '');
                b.textContent = texto;
                b.disabled = deshabilitado;
                if (actual) b.setAttribute('aria-current', 'page');
                b.addEventListener('click', function () { pagina = destino; pintar(); });
                controles.appendChild(b);
            }
            function pintar() {
                var texto = entrada ? entrada.value.toLocaleLowerCase().trim() : '';
                var filtradas = filas.filter(function (fila) {
                    return !texto || fila.textContent.toLocaleLowerCase().indexOf(texto) !== -1;
                });
                var total = filtradas.length;
                var paginas = Math.max(1, Math.ceil(total / porPagina));
                pagina = Math.min(Math.max(1, pagina), paginas);
                filas.forEach(function (fila) { fila.style.display = 'none'; });
                filtradas.slice((pagina - 1) * porPagina, pagina * porPagina).forEach(function (fila) {
                    fila.style.display = '';
                });
                var inicio = total ? (pagina - 1) * porPagina + 1 : 0;
                var fin = Math.min(pagina * porPagina, total);
                resumen.textContent = 'Mostrando ' + inicio + '–' + fin + ' de ' + total + ' registros';
                controles.textContent = '';
                if (paginas <= 1) return;
                boton('Anterior', pagina - 1, pagina === 1, false);
                var desde = Math.max(1, pagina - 2), hasta = Math.min(paginas, desde + 4);
                desde = Math.max(1, hasta - 4);
                for (var n = desde; n <= hasta; n++) boton(String(n), n, false, n === pagina);
                boton('Siguiente', pagina + 1, pagina === paginas, false);
            }
            if (entrada) entrada.addEventListener('input', function () { pagina = 1; pintar(); });
            pintar();
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciarPaginacion);
    else iniciarPaginacion();
})();
</script>

@section scripts {
    <script>
                // Object(...) devuelve el mismo elemento sin tipo, así Visual Studio no marca avisos de TypeScript
                function campo(id) {
                    return Object(document.getElementById(id));
                }

                campo('modalAula').addEventListener('show.bs.modal', function (ev) {
                    var boton = Object(ev).relatedTarget;
                    var d = (boton && boton.dataset) || {};
                    var nuevo = !d.id;

                    campo('aulaTitulo').textContent = nuevo ? 'Registrar aula' : 'Editar ' + d.nombre;
                    campo('aulaId').value = nuevo ? 0 : d.id;
                    campo('aulaNombre').value = nuevo ? '' : d.nombre;
                    campo('aulaCapacidad').value = nuevo ? '' : d.capacidad;
                    campo('aulaUbicacion').value = nuevo ? '' : d.ubicacion;
                    campo('aulaEstado').value = nuevo ? 'true' : d.estado;
                });

                var buscar = campo('buscarAula');
                if (buscar) {
                    buscar.addEventListener('input', function () {
                        var texto = buscar.value.toLowerCase();
                        document.querySelectorAll('#tablaAulas tbody tr').forEach(function (f) {
                            var fila = Object(f);
                            fila.style.display = fila.textContent.toLowerCase().indexOf(texto) >= 0 ? '' : 'none';
                        });
                    });
                }
    </script>
}

@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .search-box {
            position: relative;
            width: 260px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
                border-color: #edf0f3;
            }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-danger {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .status-off {
            background: #f1f3f5;
            color: #6c757d;
        }
    
        /* Diseño institucional uniforme: Usuarios / Roles / Estudiantes */
        .academic-header {
            background: transparent;
            border-bottom: 0;
            padding: 0;
            margin: 14px 0 24px;
        }
        .academic-header > .container {
            background: #fff;
            border-bottom: 1px solid #e2e8ef;
            padding: 22px 24px 24px;
        }
        .academic-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 14px;
        }
        .academic-topbar .academic-breadcrumb {
            margin: 0;
            flex-wrap: wrap;
        }
        .academic-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #fff;
            color: #386FA4;
            border: 1px solid #8795a4;
            border-radius: 7px;
            padding: 8px 14px;
            text-decoration: none;
            font-size: .88rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .academic-back-btn:hover, .academic-back-btn:focus {
            background: #f4f7fa;
            border-color: #133C55;
            color: #133C55;
        }
        .academic-header .academic-title {
            color: #133C55;
            font-size: 1.55rem;
            line-height: 1.3;
            margin-bottom: 5px;
        }
        .academic-header .academic-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
        }
        .academic-header .btn-cop-primary { border-radius: 6px; }
        .academic-card, .summary-card, .form-card, .filters-card, .import-card,
        .distribution-card { border-radius: 9px; }
        @@media (max-width: 575px) {
            .academic-header > .container { padding: 18px 16px; }
            .academic-header .academic-title { font-size: 1.32rem; }
            .academic-back-btn { padding: 7px 12px; }
        }

    </style>

}

