@model EscuelaCopalchi.UI.Models.GestionAcademica.BitacoraViewModel
@using EscuelaCopalchi.UI.Models.GestionAcademica
@{
    ViewBag.Title = "Bitácora de cambios";
}

<main>

    <section class="academic-header">

        <div class="container">

            <div class="academic-breadcrumb">
                <a href="@Url.Action("Index", "GestionAcademica")">Gestión académica</a>
                <i class="bi bi-chevron-right"></i>
                <span>Bitácora</span>
            </div>

            <h1 class="academic-title">
                <i class="bi bi-clock-history me-2"></i>
                Bitácora de cambios
            </h1>

            <p class="academic-subtitle">
                Historial de asignaciones, traslados, retiros, cambios de aula, horario y docente.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        @Html.Partial("_BarraUsuario")

        <form method="get" action="@Url.Action("Bitacora")" class="filters-card mb-4">

            <div>
                <label class="form-label">Desde</label>
                <input type="date" name="desde" value="@Model.Desde" class="form-control" />
            </div>

            <div>
                <label class="form-label">Hasta</label>
                <input type="date" name="hasta" value="@Model.Hasta" class="form-control" />
            </div>

            <div>
                <label class="form-label">Tipo de cambio</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var t in BitacoraViewModel.TiposCambio)
                    {
                        <option value="@t" @(Model.Tipo == t ? "selected" : "")>@t</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-cop-primary">
                <i class="bi bi-funnel me-1"></i>
                Filtrar
            </button>

        </form>


        <div class="academic-card mb-4">

            <div class="toolbar">
                <div>
                    <h2>Historial</h2>
                    <p>Se guarda en la tabla de auditoría del sistema. Se muestran los últimos 500 registros según los filtros.</p>
                </div>
            </div>

            @if (!Model.Registros.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-journal"></i>
                    <strong>No hay cambios registrados</strong>
                    Los cambios de asignación aparecerán aquí automáticamente.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table academic-table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Detalle</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Registros)
                            {
                                <tr>
                                    <td class="text-nowrap small">@b.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="tipo">@b.TipoCambio</span></td>
                                    <td class="small">@b.Detalle</td>
                                    <td class="small">@b.Responsable</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>


        <div class="academic-card">

            <div class="toolbar">
                <div>
                    <h2><i class="bi bi-exclamation-octagon me-2"></i>Incidentes de notificación</h2>
                    <p>Errores al enviar notificaciones por correo. La notificación sigue visible dentro del sistema.</p>
                </div>

                @if (Model.Incidentes.Any())
                {
                    using (Html.BeginForm("ReintentarNotificaciones", "GestionAcademica", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            Reintentar envíos con error
                        </button>
                    }
                }
            </div>

            @if (!Model.Incidentes.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-check2-circle"></i>
                    <strong>Sin incidentes</strong>
                    Todas las notificaciones se entregaron correctamente.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table academic-table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Detalle del error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Incidentes)
                            {
                                <tr>
                                    <td class="text-nowrap small">@i.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-danger">@i.Detalle</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.05rem;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .83rem;
                margin: 0;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .filters-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px 22px;
            display: grid;
            grid-template-columns: 1fr 1fr 1.4fr auto;
            gap: 14px;
            align-items: end;
        }

        .tipo {
            background: #e6f1fb;
            color: var(--cop-primary);
            padding: 3px 9px;
            border-radius: 20px;
            font-size: .74rem;
            font-weight: 600;
            white-space: nowrap;
        }

        @@media(max-width:768px) {
            .filters-card {
                grid-template-columns: 1fr;
            }
        }
    </style>

}