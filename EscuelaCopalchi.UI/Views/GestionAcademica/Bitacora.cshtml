@model EscuelaCopalchi.UI.Models.GestionAcademica.BitacoraViewModel
@using EscuelaCopalchi.UI.Models.GestionAcademica
@{
    ViewBag.Title = "Bitácora de cambios";
}

<main>

    <section class="academic-header">
    <div class="container">
        <div class="academic-heading-row">
            <div>
                <h1 class="academic-title">
                <i class="bi bi-clock-history me-2"></i>
                Bitácora de cambios
            </h1>
                <p class="academic-subtitle">
                Historial de asignaciones, traslados, retiros, cambios de aula, horario y docente.
            </p>
            </div>
            <div class="academic-heading-actions">
                <a href="@Url.Action("Index", "GestionAcademica")" class="academic-back-btn" aria-label="Regresar a Gestión académica"><i class="bi bi-arrow-left"></i> Atrás</a>
                
            </div>
        </div>
    </div>
</section>


    <section class="container pb-5">

  
        <form method="get" action="@Url.Action("Bitacora")" class="filters-card mb-4">

            <div>
                <label class="form-label">Desde</label>
                <input type="date" name="desde" value="@Model.Desde" class="form-control" />
            </div>

            <div>
                <label class="form-label">Hasta</label>
                <input type="date" name="hasta" value="@Model.Hasta" class="form-control" />
            </div>

            <div>
                <label class="form-label">Tipo de cambio</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var t in BitacoraViewModel.TiposCambio)
                    {
                        <option value="@t" @(Model.Tipo == t ? "selected" : "")>@t</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-cop-primary">
                <i class="bi bi-funnel me-1"></i>
                Filtrar
            </button>

        </form>


        <div class="academic-card mb-4">

            <div class="toolbar">
                <div>
                    <h2>Historial</h2>
                    <p>Se guarda en la tabla de auditoría del sistema. Se muestran los últimos 500 registros según los filtros.</p>
                </div>
            </div>

            @if (!Model.Registros.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-journal"></i>
                    <strong>No hay cambios registrados</strong>
                    Los cambios de asignación aparecerán aquí automáticamente.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table academic-table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Detalle</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Registros)
                            {
                                <tr>
                                    <td class="text-nowrap small">@b.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="tipo">@b.TipoCambio</span></td>
                                    <td class="small">@b.Detalle</td>
                                    <td class="small">@b.Responsable</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>


        <div class="academic-card">

            <div class="toolbar">
                <div>
                    <h2><i class="bi bi-exclamation-octagon me-2"></i>Incidentes de notificación</h2>
                    <p>Errores al enviar notificaciones por correo. La notificación sigue visible dentro del sistema.</p>
                </div>

                @if (Model.Incidentes.Any())
                {
                    using (Html.BeginForm("ReintentarNotificaciones", "GestionAcademica", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            Reintentar envíos con error
                        </button>
                    }
                }
            </div>

            @if (!Model.Incidentes.Any())
            {
                <div class="ga-empty">
                    <i class="bi bi-check2-circle"></i>
                    <strong>Sin incidentes</strong>
                    Todas las notificaciones se entregaron correctamente.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table academic-table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Detalle del error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Incidentes)
                            {
                                <tr>
                                    <td class="text-nowrap small">@i.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small text-danger">@i.Detalle</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </section>

</main>


<style>
.ga-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:15px 16px;background:#fff;border:1px solid #dce5ef;border-top:0;border-radius:0 0 9px 9px}
.ga-pagination-summary{color:#65768a;font-size:.82rem}
.ga-pagination-controls{display:flex;gap:5px;flex-wrap:wrap}
.ga-page-btn{border:1px solid #d6e1ed;background:#fff;color:#133c55;border-radius:6px;padding:6px 11px;font-size:.82rem;min-width:34px}
.ga-page-btn:hover:not(:disabled){background:#eaf2fa}
.ga-page-btn.active{background:#133c55;color:white;border-color:#133c55}
.ga-page-btn:disabled{opacity:.45;cursor:not-allowed}
</style>

<script>
(function () {
    'use strict';
    function iniciarPaginacion() {
        var tablas = document.querySelectorAll('table.academic-table, table.preview-table');
        Array.prototype.forEach.call(tablas, function (tabla, indice) {
            var cuerpo = tabla.tBodies.length ? tabla.tBodies[0] : null;
            if (!cuerpo) return;
            var filas = Array.prototype.slice.call(cuerpo.rows);
            // No paginar filas informativas, por ejemplo "Sin registros".
            if (!filas.length || (filas.length === 1 && filas[0].querySelector('td[colspan]'))) return;
            var porPagina = 10;
            var pagina = 1;
            var entrada = null;
            if (tabla.id === 'tablaAulas') entrada = document.getElementById('buscarAula');
            if (tabla.id === 'tablaEstudiantes') entrada = document.getElementById('buscarEstudiante');
            var panel = document.createElement('div');
            panel.className = 'ga-pagination';
            panel.setAttribute('aria-label', 'Paginación de registros');
            var resumen = document.createElement('span');
            resumen.className = 'ga-pagination-summary';
            var controles = document.createElement('div');
            controles.className = 'ga-pagination-controls';
            panel.appendChild(resumen);
            panel.appendChild(controles);
            var contenedor = tabla.closest('.table-responsive') || tabla;
            contenedor.parentNode.insertBefore(panel, contenedor.nextSibling);
            function boton(texto, destino, deshabilitado, actual) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'ga-page-btn' + (actual ? ' active' : '');
                b.textContent = texto;
                b.disabled = deshabilitado;
                if (actual) b.setAttribute('aria-current', 'page');
                b.addEventListener('click', function () { pagina = destino; pintar(); });
                controles.appendChild(b);
            }
            function pintar() {
                var texto = entrada ? entrada.value.toLocaleLowerCase().trim() : '';
                var filtradas = filas.filter(function (fila) {
                    return !texto || fila.textContent.toLocaleLowerCase().indexOf(texto) !== -1;
                });
                var total = filtradas.length;
                var paginas = Math.max(1, Math.ceil(total / porPagina));
                pagina = Math.min(Math.max(1, pagina), paginas);
                filas.forEach(function (fila) { fila.style.display = 'none'; });
                filtradas.slice((pagina - 1) * porPagina, pagina * porPagina).forEach(function (fila) {
                    fila.style.display = '';
                });
                var inicio = total ? (pagina - 1) * porPagina + 1 : 0;
                var fin = Math.min(pagina * porPagina, total);
                resumen.textContent = 'Mostrando ' + inicio + '–' + fin + ' de ' + total + ' registros';
                controles.textContent = '';
                if (paginas <= 1) return;
                boton('Anterior', pagina - 1, pagina === 1, false);
                var desde = Math.max(1, pagina - 2), hasta = Math.min(paginas, desde + 4);
                desde = Math.max(1, hasta - 4);
                for (var n = desde; n <= hasta; n++) boton(String(n), n, false, n === pagina);
                boton('Siguiente', pagina + 1, pagina === paginas, false);
            }
            if (entrada) entrada.addEventListener('input', function () { pagina = 1; pintar(); });
            pintar();
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciarPaginacion);
    else iniciarPaginacion();
})();
</script>

@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .academic-header {
            background: white;
            padding: 30px 0;
            border-bottom: 1px solid #e3e8ee;
            margin-bottom: 28px;
        }

        .academic-breadcrumb {
            display: flex;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .academic-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .academic-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .academic-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .academic-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

            .toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.05rem;
            }

            .toolbar p {
                color: var(--cop-muted);
                font-size: .83rem;
                margin: 0;
            }

        .academic-table {
            margin: 0;
        }

            .academic-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .academic-table td {
                padding: 15px 17px;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .filters-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px 22px;
            display: grid;
            grid-template-columns: 1fr 1fr 1.4fr auto;
            gap: 14px;
            align-items: end;
        }

        .tipo {
            background: #e6f1fb;
            color: var(--cop-primary);
            padding: 3px 9px;
            border-radius: 20px;
            font-size: .74rem;
            font-weight: 600;
            white-space: nowrap;
        }

        @@media(max-width:768px) {
            .filters-card {
                grid-template-columns: 1fr;
            }
        }
    
        /* Diseño institucional uniforme: Usuarios / Roles / Estudiantes */
        .academic-header {
            background: transparent;
            border-bottom: 0;
            padding: 0;
            margin: 14px 0 24px;
        }
        .academic-header > .container {
            background: #fff;
            border-bottom: 1px solid #e2e8ef;
            padding: 22px 24px 24px;
        }
        .academic-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 14px;
        }
        .academic-topbar .academic-breadcrumb {
            margin: 0;
            flex-wrap: wrap;
        }
        .academic-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #fff;
            color: #386FA4;
            border: 1px solid #8795a4;
            border-radius: 7px;
            padding: 8px 14px;
            text-decoration: none;
            font-size: .88rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .academic-back-btn:hover, .academic-back-btn:focus {
            background: #f4f7fa;
            border-color: #133C55;
            color: #133C55;
        }
        .academic-header .academic-title {
            color: #133C55;
            font-size: 1.55rem;
            line-height: 1.3;
            margin-bottom: 5px;
        }
        .academic-header .academic-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
        }
        .academic-header .btn-cop-primary { border-radius: 6px; }
        .academic-card, .summary-card, .form-card, .filters-card, .import-card,
        .distribution-card { border-radius: 9px; }
        @@media (max-width: 575px) {
            .academic-header > .container { padding: 18px 16px; }
            .academic-header .academic-title { font-size: 1.32rem; }
            .academic-back-btn { padding: 7px 12px; }
        }

    </style>

}

<style>
