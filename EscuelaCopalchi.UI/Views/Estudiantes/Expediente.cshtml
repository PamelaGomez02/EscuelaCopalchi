                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Tipo de adecuación
                            </label>

                            <select class="form-select"
                                    id="editTipoAdecuacion"
                                    name="TipoAdecuacion">

                                @foreach (var tipo in ViewBag.TiposAdecuacion)
                                {
                                    <option value="@tipo.IdTipo">
                                        @tipo.NombreAdecuacion
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Estado
                            </label>

                            <select class="form-select"
                                    id="editEstado"
                                    name="Estado">

                                <option value="Activa">
                                    Activa
                                </option>

                                <option value="Finalizada">
                                    Finalizada
                                </option>

                                <option value="Suspendida">
                                    Suspendida
                                </option>

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Fecha inicio
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="editFechaInicio"
                                   name="FechaInicio" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Fecha fin
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="editFechaFin"
                                   name="FechaFin" />

                        </div>

                        <div class="col-12">

                            <label class="form-label">
                                Descripción
                            </label>

                            <textarea class="form-control"
                                      id="editDescripcion"
                                      name="Descripcion"
                                      rows="4"></textarea>

                        </div>

                        <div class="col-12">

                            <label class="form-label">
                                Medidas
                            </label>

                            <textarea class="form-control"
                                      id="editMedidas"
                                      name="Medidas"
                                      rows="4"></textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        <i class="bi bi-save me-1"></i>
                        Actualizar

                    </button>

                </div>

            </div>
        }

    </div>

</div>

<!-- MODAL OBSERVACIÓN -->
<div class="modal fade"
     id="modalObservacion"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        @using (Html.BeginForm(
            "RegistrarObservacion",
            "EstudiantesAdd",
            FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Nueva observación médica
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="IdEstudiante"
                           value="@Model.IdEstudiante" />

                    <label class="form-label">
                        Título
                    </label>

                    <input type="text"
                           class="form-control mb-3"
                           name="Titulo"
                           required />

                    <label class="form-label">
                        Observación
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              name="Observacion"
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">
                        Guardar
                    </button>

                </div>

            </div>
        }

    </div>

</div>

<div class="modal fade"
     id="modalEditarObservacion"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        @using (Html.BeginForm(
            "EditarObservacion",
            "EstudiantesAdd",
            FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Editar observación médica
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="editIdObservacion"
                           name="IdObservacion" />

                    <input type="hidden"
                           name="IdEstudiante"
                           value="@Model.IdEstudiante" />

                    <label class="form-label">
                        Título
                    </label>

                    <input type="text"
                           class="form-control mb-3"
                           id="editTituloObservacion"
                           name="Titulo"
                           required />

                    <label class="form-label">
                        Observación
                    </label>

                    <textarea class="form-control"
                              rows="4"
                              id="editObservacion"
                              name="Observacion"
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        Actualizar

                    </button>

                </div>

            </div>
        }

    </div>

</div>




<script>
    function cargarAdecuacion(
        id,
        tipo,
        descripcion,
        medidas,
        fechaInicio,
        fechaFin,
        estado) {
        document.getElementById(
            "editIdAdecuacion").value = id;

        document.getElementById(
            "editTipoAdecuacion").value = tipo;

        document.getElementById(
            "editDescripcion").value = descripcion;

        document.getElementById(
            "editMedidas").value = medidas;

        document.getElementById(
            "editFechaInicio").value = fechaInicio;

        document.getElementById(
            "editFechaFin").value = fechaFin;

        document.getElementById(
            "editEstado").value = estado;
    }

    function cargarAlergia(
        id,
        alergia,
        descripcion) {
        document.getElementById(
            "editIdAlergia").value = id;

        document.getElementById(
            "editNombreAlergia").value = alergia;

        document.getElementById(
            "editDescripcionAlergia").value = descripcion;
    }

        function cargarObservacion(
        id,
        titulo,
        observacion)
        {
            document.getElementById(
                "editIdObservacion").value = id;

        document.getElementById(
        "editTituloObservacion").value = titulo;

        document.getElementById(
        "editObservacion").value = observacion;
}
</script>



@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
