@model EscuelaCopalchi.UI.Models.Estudiantes.Estudiante

@{
    ViewBag.Title = "Expediente del estudiante";
}





<main>

    <section class="record-header">

        <div class="container">

            <div class="record-breadcrumb">

                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "EstudiantesAdd")">
                    Estudiantes
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Expediente de @Model.Nombre  @Model.Apellido1</span>

            </div>

            <h4>
                Cantidad de alergias:
                @ViewBag.Alergias.Count
            </h4>

            <h1 class="record-title">
                <i class="bi bi-heart-pulse me-2"></i>
                Expediente del estudiante
            </h1>


            <p class="record-subtitle">
                Información de apoyo, adecuaciones y observaciones registradas.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <!-- ALERTA -->
        <div class="privacy-alert">

            <i class="bi bi-shield-lock"></i>

            <div>
                <strong>Información de acceso restringido</strong>

                <p>
                    Esta información debe ser consultada únicamente por personal autorizado.
                </p>
            </div>

        </div>


        <!-- ESTUDIANTE -->
        <div class="student-card">

            <div class="student-avatar">
                AR
            </div>

            <div>
                <span>Estudiante</span>
                <h2> @Model.Nombre  @Model.Apellido1  @Model.Apellido2</h2>
                <p>Identificación @Model.Identificacion</p>
            </div>

        </div>

        <br>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                <i class="bi bi-exclamation-triangle me-2"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }



        <div class="row g-4 mt-1">

            <!-- ALERGIAS -->
            <div class="col-lg-6">

                <div class="record-card">

                    <div class="record-card-header">

                        <div>

                            <h2>
                                <i class="bi bi-exclamation-circle me-2"></i>
                                Alergias
                            </h2>

                            <p>
                                Alergias registradas para el estudiante.
                            </p>

                        </div>


                        <button type="button"
                                class="btn btn-sm btn-outline-cop"
                                data-bs-toggle="modal"
                                data-bs-target="#modalAlergia">

                            <i class="bi bi-plus-lg"></i>
                            Agregar

                        </button>

                    </div>


                    @if (ViewBag.Alergias != null)
                    {
                        foreach (
                            EscuelaCopalchi.UI.Models.Estudiantes.Alergia alergia
                            in ViewBag.Alergias)
                        {
                            <div class="record-item allergy">

                                <div>

                                    <strong>
                                        @alergia.NombreAlergia
                                    </strong>

                                    <p>
                                        @alergia.Descripcion
                                    </p>

                                    <small>
                                        Registrada:
                                        @alergia.FechaRegistro.ToString("dd/MM/yyyy")
                                    </small>

                                </div>

                                <div class="d-flex flex-column align-items-center">

                                    <button class="btn btn-icon mb-2"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarAlergia"
                                            onclick="cargarAlergia(
                                            '@alergia.IdAlergia',
                                            '@alergia.NombreAlergia',
                                            '@alergia.Descripcion')">

                                        <i class="bi bi-pencil"></i>

                                    </button>

                                    @using (Html.BeginForm(
                                        "EliminarAlergia",
                                        "EstudiantesAdd",
                                        FormMethod.Post,
                                        new { style = "display:inline;" }))
                                    {
                                        <input type="hidden"
                                               name="idAlergia"
                                               value="@alergia.IdAlergia" />

                                        <input type="hidden"
                                               name="idEstudiante"
                                               value="@Model.IdEstudiante" />

                                        <button type="submit"
                                                class="btn btn-icon text-danger"
                                                onclick="return confirm('¿Desea eliminar esta alergia?');">

                                            <i class="bi bi-trash"></i>

                                        </button>
                                    }

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="record-item allergy">

                            <div>

                                <strong>
                                    No hay alergias registradas
                                </strong>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ADECUACIONES -->
            <div class="col-lg-6">

                <div class="record-card">

                    <div class="record-card-header">

                        <div>

                            <h2>
                                <i class="bi bi-journal-check me-2"></i>
                                Adecuaciones
                            </h2>

                            <p>
                                Adecuaciones curriculares registradas.
                            </p>

                        </div>


                        <button type="button"
                                class="btn btn-sm btn-outline-cop"
                                data-bs-toggle="modal"
                                data-bs-target="#modalAdecuacion">

                            <i class="bi bi-plus-lg"></i>
                            Agregar

                        </button>

                    </div>


                    @if (ViewBag.Adecuaciones != null)
                    {
                        foreach (var adecuacion in ViewBag.Adecuaciones)
                        {
                            <div class="record-item accommodation">

                                <div>

                                    <strong>
                                        @adecuacion.NombreTipoAdecuacion
                                    </strong>

                                    <p>
                                        @adecuacion.Descripcion
                                    </p>

                                    <small>
                                        Registrada:
                                        @(Convert.ToDateTime(adecuacion.FechaRegistro).ToString("dd/MM/yyyy"))
                                    </small>

                                </div>

                                <button class="btn btn-icon"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEditarAdecuacion"
                                        onclick="cargarAdecuacion(
            '@adecuacion.IdAdecuacion',
            '@adecuacion.TipoAdecuacion',
            '@adecuacion.Descripcion',
            '@adecuacion.Medidas',
            '@adecuacion.FechaInicio.ToString("yyyy-MM-dd")',
            '@(adecuacion.FechaFin == null? "": Convert.ToDateTime(adecuacion.FechaFin).ToString("yyyy-MM-dd"))',
            '@adecuacion.Estado')">

                                    <i class="bi bi-pencil"></i>

                                </button>

                            </div>
                        }
                    }

                </div>

            </div>


            <!-- OBSERVACIONES -->
            <div class="col-12">

                <div class="record-card">

                    <div class="record-card-header">

                        <div>

                            <h2>
                                <i class="bi bi-clipboard2-pulse me-2"></i>
                                Observaciones médicas
                            </h2>

                            <p>
                                Historial de observaciones médicas registradas.
                            </p>

                        </div>


                        <button type="button"
                                class="btn btn-sm btn-outline-cop"
                                data-bs-toggle="modal"
                                data-bs-target="#modalObservacion">

                            <i class="bi bi-plus-lg"></i>
                            Nueva observación

                        </button>

                    </div>


                    @if (ViewBag.Observaciones != null)
                    {
                        foreach (EscuelaCopalchi.UI.Models.Estudiantes.Observaciones observacion
                            in ViewBag.Observaciones)
                        {
                            <div class="medical-record d-flex">

                                <div class="flex-grow-1">

                                    <div class="record-date">

                                        @observacion.FechaRegistro.ToString("dd/MM/yyyy")

                                    </div>

                                    <div class="record-content">

                                        <strong>
                                            @observacion.Titulo
                                        </strong>

                                        <p>
                                            @observacion.Observacion
                                        </p>

                                    </div>
                                </div>

                                <div class="d-flex flex-column gap-2 ms-auto">

                                    <button class="btn btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarObservacion"
                                            onclick="cargarObservacion(
                                                '@observacion.IdObservacion',
                                                '@observacion.Titulo',
                                                '@observacion.Observacion')">

                                        <i class="bi bi-pencil"></i>

                                    </button>

                                    @using (Html.BeginForm(
                                        "EliminarObservacion",
                                        "EstudiantesAdd",
                                        FormMethod.Post))
                                    {
                                        <input type="hidden"
                                               name="idObservacion"
                                               value="@observacion.IdObservacion" />

                                        <input type="hidden"
                                               name="idEstudiante"
                                               value="@Model.IdEstudiante" />

                                        <button type="submit"
                                                class="btn btn-icon text-danger"
                                                onclick="return confirm('¿Desea eliminar esta observación?');">

                                            <i class="bi bi-trash"></i>

                                        </button>
                                    }

                                </div>

                                </div>
                                }
                                }

                            </div>

            </div>

        </div>


        <div class="mt-4">

            <a href="@Url.Action("Detalle", "EstudiantesAdd", new { id = Model.IdEstudiante })"
               class="btn btn-light">

                <i class="bi bi-arrow-left me-1"></i>
                Volver al estudiante

            </a>

        </div>

    </section>

</main>


<!-- MODAL ALERGIA -->
<div class="modal fade"
     id="modalAlergia"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        @using (Html.BeginForm(
            "RegistrarAlergia",
            "EstudiantesAdd",
            FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Registrar alergia
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="IdEstudiante"
                           value="@Model.IdEstudiante" />

                    <label class="form-label">
                        Alergia
                    </label>

                    <input type="text"
                           class="form-control mb-3"
                           name="NombreAlergia"
                           placeholder="Ej. Penicilina"
                           required />

                    <label class="form-label">
                        Descripción
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              name="Descripcion"
                              placeholder="Ingrese información adicional..."
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        Guardar

                    </button>

                </div>

            </div>
        }

    </div>

</div>
<div class="modal fade"
     id="modalEditarAlergia"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        @using (Html.BeginForm(
            "EditarAlergia",
            "EstudiantesAdd",
            FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Editar alergia
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="editIdAlergia"
                           name="IdAlergia" />

                    <input type="hidden"
                           name="IdEstudiante"
                           value="@Model.IdEstudiante" />

                    <label class="form-label">
                        Alergia
                    </label>

                    <input type="text"
                           class="form-control mb-3"
                           id="editNombreAlergia"
                           name="NombreAlergia"
                           required />

                    <label class="form-label">
                        Descripción
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              id="editDescripcionAlergia"
                              name="Descripcion"
                              required></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        <i class="bi bi-save me-1"></i>
                        Actualizar

                    </button>

                </div>

            </div>
        }

    </div>

</div>

<!-- MODAL ADECUACIÓN -->
<div class="modal fade"
     id="modalAdecuacion"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        @using (Html.BeginForm(
        "RegistrarAdecuacion",
        "EstudiantesAdd",
        FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Registrar adecuación académica
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">
                    <input type="hidden"
                           name="IdEstudiante"
                           value="@Model.IdEstudiante" />

                    <input type="hidden"
                           name="IdUsuarioRegistro"
                           value="1" />

                    <div class="row g-3">

                        <!-- Tipo -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tipo de adecuación
                                <span class="required">*</span>
                            </label>

                            <select class="form-select"
                                    name="TipoAdecuacion"
                                    required>

                                <option selected disabled>
                                    Seleccione
                                </option>

                                @foreach (var tipo in ViewBag.TiposAdecuacion)
                                {
                                    <option value="@tipo.IdTipo">
                                        @tipo.NombreAdecuacion
                                    </option>
                                }

                            </select>


                        </div>

                        <!-- Estado -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Estado
                            </label>

                            <select class="form-select"
                                    name="estado">

                                <option value="Activa" selected>
                                    Activa
                                </option>

                                <option value="Finalizada">
                                    Finalizada
                                </option>

                                <option value="Suspendida">
                                    Suspendida
                                </option>


                            </select>

                        </div>

                        <!-- Fecha inicio -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Fecha inicio
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="FechaInicio"
                                   required />

                        </div>

                        <!-- Fecha fin -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Fecha fin
                            </label>

                            <input type="date"
                                   class="form-control"
                                   name="FechaFin" />

                        </div>

                        <!-- Descripción -->
                        <div class="col-12">

                            <label class="form-label">
                                Descripción
                                <span class="required">*</span>
                            </label>

                            <textarea class="form-control"
                                      rows="4"
                                      name="Descripcion"
                                      placeholder="Describa la adecuación..."
                                      required></textarea>

                        </div>

                        <!-- Medidas -->
                        <div class="col-12">

                            <label class="form-label">
                                Medidas de apoyo
                            </label>

                            <textarea class="form-control"
                                      rows="4"
                                      name="Medidas"
                                      placeholder="Indique las medidas, estrategias o apoyos pedagógicos..."></textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar

                    </button>

                </div>

            </div>

        }

    </div>

</div>

<!-- Modal de Actualizar -->

<div class="modal fade"
     id="modalEditarAdecuacion"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        @using (Html.BeginForm(
            "EditarAdecuacion",
            "EstudiantesAdd",
            FormMethod.Post))
        {
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Editar adecuación académica
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="IdAdecuacion"
