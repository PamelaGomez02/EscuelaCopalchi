@{
    ViewBag.Title = "Editar estudiante";
}

@model EscuelaCopalchi.UI.Models.Estudiantes.Estudiante
<main>

    <!-- ENCABEZADO -->
    <section class="students-header">
        <div class="container">

            <div class="students-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "EstudiantesAdd")">
                    Estudiantes
                </a>

                <i class="bi bi-chevron-right"></i>
                <span>Editar estudiante</span>
            </div>

            <h1 class="students-title">
                <i class="bi bi-pencil-square me-2"></i>
                Editar estudiante
            </h1>

            <p class="students-subtitle">
                Actualiza la información personal, académica y de contacto del estudiante.
            </p>

        </div>
    </section>


    <section class="container pb-5">

        <div class="form-card">

            <!-- ESTUDIANTE -->
            <!-- ESTUDIANTE -->
            <div class="student-summary">

                <div class="student-avatar">

                    @(string.IsNullOrEmpty(Model.Nombre)
            ? ""
            : Model.Nombre.Substring(0, 1))
                    @(string.IsNullOrEmpty(Model.Apellido1)
            ? ""
            : Model.Apellido1.Substring(0, 1))

                </div>

                <div>

                    <span>Estudiante</span>

                    <h2>
                        @Model.Nombre
                        @Model.Apellido1
                    </h2>

                    <p>

                        @if (Model.Estado)
                        {
                            <span>Activo</span>
                        }
                        else
                        {
                            <span>Inactivo</span>
                        }

                    </p>

                </div>

            </div>


            @using (Html.BeginForm(
         "Editar",
         "EstudiantesAdd",
         FormMethod.Post,
         new { id = "formEditarEstudiante" }))
            {
                @Html.HiddenFor(x => x.IdEstudiante)

                @Html.HiddenFor(x => x.IdEstudiante)

                <!-- DATOS PERSONALES -->
                <h2 class="section-title">
                    <i class="bi bi-person me-2"></i>
                    Datos del estudiante
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombre
                            <span class="required">*</span>
                        </label>

                        @Html.TextBoxFor(
                             x => x.Nombre,
                             new
                             {
                                 @class = "form-control",
                                 required = "required"
                             })

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Identificación
                            <span class="required">*</span>
                        </label>

                        @Html.TextBoxFor(
                             x => x.Identificacion,
                             new
                             {
                                 @class = "form-control",
                                 required = "required"
                             })

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Apellido 1
                            <span class="required">*</span>
                        </label>

                        @Html.TextBoxFor(
                             x => x.Apellido1,
                             new
                             {
                                 @class = "form-control",
                                 required = "required"
                             })

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Fecha de nacimiento
                            <span class="required">*</span>
                        </label>

                        @Html.TextBoxFor(
                             x => x.FechaNacimiento,
                             "{0:yyyy-MM-dd}",
                             new
                             {
                                 type = "date",
                                 @class = "form-control",
                                 required = "required"
                             })

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Apellido 2
                            <span class="required">*</span>
                        </label>

                        @Html.TextBoxFor(
                         x => x.Apellido2,
                         new
                         {
                             @class = "form-control",
                             required = "required"
                         })
                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Correo electrónico
                        </label>

                        @Html.TextBoxFor(
                             x => x.CorreoEncargado,
                             new
                             {
                                 @class = "form-control",
                                 type = "email"
                             })

                    </div>


                </div>


                <!-- ENCARGADO -->
                <div class="form-section">

                    <h2 class="section-title">
                        <i class="bi bi-people me-2"></i>
                        Datos del encargado
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Nombre completo
                                <span class="required">*</span>
                            </label>

                            @Html.TextBoxFor(
                             x => x.NombreEncargado,
                             new
                             {
                                 @class = "form-control",
                                 required = "required"
                             })

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Parentesco
                            </label>
                            @Html.DropDownListFor(
                             x => x.Parentesco,
                             new List<SelectListItem>
                             {
                                    new SelectListItem
                                    {
                                        Text = "Madre",
                                        Value = "Madre"
                                    },
                                    new SelectListItem
                                    {
                                        Text = "Padre",
                                        Value = "Padre"
                                    },
                                    new SelectListItem
                                    {
                                        Text = "Encargado legal",
                                        Value = "Encargado legal"
                                    },
                                    new SelectListItem
                                    {
                                        Text = "Otro",
                                        Value = "Otro"
                                    }
                             },
                             new { @class = "form-select" }
                         )
                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Teléfono
                                <span class="required">*</span>
                            </label>

                            @Html.TextBoxFor(
                             x => x.TelefonoEncargado,
                             new
                             {
                                 @class = "form-control",
                                 type = "tel",
                                 required = "required"
                             })

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Correo electrónico
                            </label>

                            @Html.TextBoxFor(
                             x => x.CorreoEncargado,
                             new
                             {
                                 @class = "form-control",
                                 type = "email"
                             })

                        </div>


                    </div>

                </div>


                <!-- INFORMACIÓN ADICIONAL -->
                <div class="form-section">

                    <h2 class="section-title">
                        <i class="bi bi-house me-2"></i>
                        Información adicional
                    </h2>

                    <div class="row g-3">

                        <label class="form-label">
                            Dirección
                        </label>

                        @Html.TextAreaFor(
                             x => x.Direccion,
                             new
                             {
                                 @class = "form-control",
                                 rows = 3
                             })


                    <div class="col-md-6">

                        <label class="form-label">
                            Estado
                        </label>

                        @if (Model.Estado)
                        {
                            @Html.DropDownListFor(
                                x => x.Estado,
                                new List<SelectListItem>
                                {
                                    new SelectListItem
                                    {
                                        Text = "Activo",
                                        Value = "true"
                                    },
                                    new SelectListItem
                                    {
                                        Text = "Inactivo",
                                        Value = "false"
                                    }
                                },
                                new
                                {
                                    @class = "form-select",
                                    disabled = "disabled"
                                })

                            @Html.HiddenFor(x => x.Estado)
                        }
                        else
                        {
                            @Html.DropDownListFor(
                                x => x.Estado,
                                new List<SelectListItem>
                                {
                                    new SelectListItem
                                    {
                                        Text = "Activo",
                                        Value = "true"
                                    },
                                    new SelectListItem
                                    {
                                        Text = "Inactivo",
                                        Value = "false"
                                    }
                                },
                                new
                                {
                                    @class = "form-select"
                                })
                        }

                    </div>

                    </div>

                </div>


                <div class="form-actions">

                    <a href="@Url.Action("Index", "EstudiantesAdd")" class="btn btn-light">

                        Cancelar

                    </a>

                    <button type="button"
                            class="btn btn-cop-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#modalGuardar">

                        <i class="bi bi-save me-1"></i>
                        Guardar cambios

                    </button>

                </div>

                <div class="modal fade"
                     id="modalGuardar"
                     tabindex="-1">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title">
                                    Guardar cambios
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                </button>

                            </div>

                            <div class="modal-body text-center">

                                <div class="modal-icon">
                                    <i class="bi bi-save"></i>
                                </div>

                                <p class="mb-0">
                                    ¿Deseas guardar los cambios realizados en la información del estudiante?
                                </p>

                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-light"
                                        data-bs-dismiss="modal">

                                    Cancelar

                                </button>

                                <button type="button"
                                        class="btn btn-cop-primary"
                                        onclick="document.getElementById('formEditarEstudiante').submit();">

                                    Confirmar

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                }

            </div>

    </section>

</main>



@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .form-card {
            max-width: 950px;
            margin: auto;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .student-summary {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #f8fafc;
            border: 1px solid #edf0f3;
            border-radius: 9px;
            padding: 16px;
            margin-bottom: 25px;
        }

        .student-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 700;
        }

        .student-summary span {
            font-size: .76rem;
            color: var(--cop-muted);
        }

        .student-summary h2 {
            font-size: 1.05rem;
            color: var(--cop-primary);
            margin: 2px 0;
        }

        .student-summary p {
            color: var(--cop-muted);
            margin: 0;
            font-size: .85rem;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .form-section {
            margin-top: 28px;
            padding-top: 22px;
            border-top: 1px solid #edf0f3;
        }

        .form-label {
            font-size: .9rem;
            font-weight: 600;
            color: #344054;
        }

        .required {
            color: #dc3545;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--cop-accent);
            box-shadow: 0 0 0 .2rem rgba(89,165,216,.15);
        }

        .form-actions {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid #edf0f3;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .modal-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 15px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
        }
    </style>

}


@section scripts {

    <script>

        function mostrarConfirmacion() {

            var modal = new bootstrap.Modal(
                document.getElementById("modalGuardar")
            );

            modal.show();
        }

    </script>

}