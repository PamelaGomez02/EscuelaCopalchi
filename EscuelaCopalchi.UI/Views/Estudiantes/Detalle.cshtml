@{
    ViewBag.Title = "Detalle del estudiante";
}

@model EscuelaCopalchi.UI.Models.Estudiantes.Estudiante


<main>

    <section class="students-header"><div class="container">
<div class="cop-student-headline"><div><h1 class="students-title"><i class="bi bi-person-vcard me-2"></i>@Model.Nombre @Model.Apellido1 @Model.Apellido2</h1><p class="students-subtitle">Consulta la información registrada del estudiante.</p></div>
<div class="cop-student-actions"><span class="status @(Model.Estado ? "status-active" : "status-inactive")"><i class="bi @(Model.Estado ? "bi-check-circle" : "bi-x-circle")"></i> @(Model.Estado ? "Activo" : "Inactivo")</span><a href="@Url.Action("Index", "Estudiantes")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a></div></div>
</div></section>


    <section class="container pb-5">

        <div class="row g-4">

            <!-- INFORMACIÓN -->
            <div class="col-lg-8">

                <div class="detail-card">

                    <h2 class="section-title">
                        <i class="bi bi-person me-2"></i>
                        Información personal
                    </h2>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Nombre completo</span>
                            <strong>
                                @Model.Nombre
                                @Model.Apellido1
                                @Model.Apellido2
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Identificación</span>
                            <strong>@Model.Identificacion</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de nacimiento</span>
                            <strong>
                                @Model.FechaNacimiento.ToString("dd/MM/yyyy")
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Correo</span>
                            <strong>@Model.CorreoEncargado</strong>
                        </div>

                    </div>

                </div>


                <!-- ENCARGADO -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-people me-2"></i>
                        Información del encargado
                    </h2>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Nombre</span>
                            <strong>@Model.NombreEncargado</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Parentesco</span>
                            <strong>@Model.Parentesco</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Teléfono</span>
                            <strong>@Model.TelefonoEncargado</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Correo</span>
                            <strong>@Model.CorreoEncargado</strong>
                        </div>

                    </div>

                </div>


                <!-- DIRECCIÓN -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-geo-alt me-2"></i>
                        Dirección
                    </h2>

                    <p class="detail-text">
                        @Model.Direccion
                    </p>

                </div>

            </div>


            <!-- PANEL -->
            <div class="col-lg-4">

                <div class="profile-card">

                    <div class="profile-avatar">

                        @(Model.Nombre.Substring(0,1))
                        @(Model.Apellido1.Substring(0,1))

                    </div>

                    <h2>
                        @Model.Nombre
                        @Model.Apellido1
                    </h2>

                    <p>
                        Estudiante
                    </p>

                    @if (Model.Estado)
                    {
                        <span class="status status-active">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="status status-inactive">
                            Inactivo
                        </span>
                    }
                    

                    <hr />


                    <div class="profile-data">

                        <span>Fecha de ingreso</span>
                        <strong>05/02/2026</strong>

                    </div>


                    <div class="profile-data">

                        <span>Última actualización</span>
                        <strong>08/08/2026</strong>

                    </div>

                </div>


                <div class="action-card mt-3">

                    <a href="@Url.Action("Editar","Estudiantes",new { id = Model.IdEstudiante })"
                       class="btn btn-outline-cop w-100">

                        <i class="bi bi-pencil me-1"></i>
                        Editar información

                    </a>


                    <a href="@Url.Action("Expediente",  "Estudiantes", new { id = Model.IdEstudiante})"
                       class="btn btn-outline-cop w-100 mt-2">

                        <i class="bi bi-heart-pulse me-1"></i>
                        Expediente

                    </a>


                    <button type="button"
                            class="btn btn-outline-danger w-100 mt-2"
                            data-bs-toggle="modal"
                            data-bs-target="#modalBaja">

                        <i class="bi bi-person-dash me-1"></i>
                        Dar de baja

                    </button>


                    <a href="@Url.Action("Index", "Estudiantes")"
                       class="btn btn-light w-100 mt-2">

                        Atrás

                    </a>

                </div>

            </div>

        </div>

    </section>

</main>


<!-- MODAL BAJA -->
<div class="modal fade"
     id="modalBaja"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Dar de baja estudiante
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="warning-box">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        El estudiante dejará de aparecer como matrícula activa.
                    </span>

                </div>


                <label class="form-label">
                    Motivo
                    <span class="text-danger">*</span>
                </label>

                <select id="motivoBaja"
                        class="form-select mb-3">

                    <option value="">
                        Seleccione
                    </option>

                    <option>
                        Traslado de institución
                    </option>

                    <option>
                        Retiro
                    </option>

                    <option>
                        Cambio de residencia
                    </option>

                    <option>
                        Otro
                    </option>

                </select>


                <label class="form-label">
                    Observación
                </label>

                <textarea class="form-control"
                          rows="3"
                          placeholder="Información adicional..."></textarea>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="confirmarBaja()">

                    Confirmar baja

                </button>

            </div>

        </div>

    </div>

</div>


@section styles {

    <style>
        /* Encabezado unificado con Gestión Académica */
        .students-header, .record-header {
            background: transparent !important;
            border: 0 !important;
            padding: 0 !important;
            margin: 0 0 22px !important;
            box-shadow: none !important;
        }
        .students-header > .container, .record-header > .container {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 12px !important;
            max-width: 1140px;
        }
        .cop-student-headline { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; }
        .cop-student-headline .students-title, .cop-student-headline .record-title { margin:0 0 4px !important; font-size:1.65rem; color:#133c55; font-weight:700; }
        .cop-student-headline .students-subtitle, .cop-student-headline .record-subtitle { margin:0 !important; color:#64748b; }
        .cop-student-actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
        .cop-student-actions .btn { border-radius:7px; white-space:nowrap; }
        .cop-student-breadcrumb { display:flex; align-items:center; gap:8px; margin-bottom:14px; font-size:.82rem; color:#64748b; flex-wrap:wrap; }
        .cop-student-breadcrumb a { color:#386fa4; text-decoration:none; }
        .cop-student-breadcrumb i { font-size:.65rem; }
        @@media (max-width: 576px) {
          .students-header > .container, .record-header > .container { padding:0 12px !important; }
          .cop-student-headline { align-items:flex-start; }
          .cop-student-headline .students-title, .cop-student-headline .record-title { font-size:1.35rem; }
        }


        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .detail-card,
        .profile-card,
        .action-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 22px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.08rem;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .detail-label {
            display: block;
            font-size: .78rem;
            color: var(--cop-muted);
            margin-bottom: 3px;
        }

        .detail-text {
            color: #495057;
            margin: 0;
        }

        .profile-card {
            text-align: center;
        }

        .profile-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .profile-card h2 {
            color: var(--cop-primary);
            font-size: 1.1rem;
            margin: 12px 0 3px;
        }

        .profile-card p {
            color: var(--cop-muted);
            font-size: .85rem;
        }

        .profile-data {
            text-align: left;
            margin-top: 12px;
        }

            .profile-data span,
            .profile-data strong {
                display: block;
            }

            .profile-data span {
                color: var(--cop-muted);
                font-size: .76rem;
            }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-active {
            background: #d1e7dd;
            color: #0f5132;
        }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

            .btn-outline-cop:hover {
                background: #e6f1fb;
                color: var(--cop-primary);
            }

        .warning-box {
            display: flex;
            gap: 10px;
            background: #fff3cd;
            color: #856404;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 18px;
        }
    
        /* Estilo compartido Aula Virtual Copalchí */
        .cop-nav-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:14px; }
        .cop-nav-row .students-breadcrumb, .cop-nav-row .record-breadcrumb { margin-bottom:0; }
        .cop-back-btn { border-radius:9px; font-weight:600; padding:.5rem .95rem; white-space:nowrap; background:white; }
        .cop-back-btn:hover { background:#edf3f8; border-color:#386FA4; color:#133C55; }
        .students-header, .record-header { padding-top:22px !important; padding-bottom:22px !important; }
        .students-card, .form-card, .history-card { box-shadow:0 5px 20px rgba(19,60,85,.045); }

        /* Encabezado sin tarjeta ni ruta de navegación */
        .students-header, .record-header {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 20px 0 0 !important;
            margin: 0 0 20px !important;
        }
        .students-header > .container, .record-header > .container {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 12px !important;
        }
        .cop-student-headline { align-items: center; }
    </style>

}


@section scripts {

    <script>

        function confirmarBaja() {

            var motivo =
                document.getElementById("motivoBaja").value;

            if (motivo === "") {

                alert("Debe seleccionar un motivo para dar de baja al estudiante.");

                return;
            }

            alert("La baja del estudiante fue registrada correctamente.");
        }

    </script>

}