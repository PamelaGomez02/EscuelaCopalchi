@{
    ViewBag.Title = "Detalle del estudiante";
}

<main>

    <section class="students-header">

        <div class="container">

            <div class="students-breadcrumb">

                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "Estudiantes")">
                    Estudiantes
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Detalle</span>

            </div>


            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>

                    <h1 class="students-title">
                        Ana Rodríguez Vargas
                    </h1>

                    <p class="students-subtitle">
                        Primer grado A
                    </p>

                </div>

                <span class="status status-active">
                    <i class="bi bi-check-circle"></i>
                    Activo
                </span>

            </div>

        </div>

    </section>


    <section class="container pb-5">

        <div class="row g-4">

            <!-- INFORMACIÓN -->
            <div class="col-lg-8">

                <div class="detail-card">

                    <h2 class="section-title">
                        <i class="bi bi-person me-2"></i>
                        Información personal
                    </h2>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Nombre completo</span>
                            <strong>Ana Rodríguez Vargas</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Identificación</span>
                            <strong>1-2345-6789</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de nacimiento</span>
                            <strong>18/04/2019</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Correo</span>
                            <strong>ana.rodriguez@correo.com</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Grado</span>
                            <strong>Primer grado</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Sección</span>
                            <strong>A</strong>
                        </div>

                    </div>

                </div>


                <!-- ENCARGADO -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-people me-2"></i>
                        Información del encargado
                    </h2>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Nombre</span>
                            <strong>Laura Rodríguez Vargas</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Parentesco</span>
                            <strong>Madre</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Teléfono</span>
                            <strong>8888-1234</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Correo</span>
                            <strong>laura.rodriguez@correo.com</strong>
                        </div>

                    </div>

                </div>


                <!-- DIRECCIÓN -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-geo-alt me-2"></i>
                        Dirección
                    </h2>

                    <p class="detail-text">
                        Copalchí, Cartago, Costa Rica.
                    </p>

                </div>

            </div>


            <!-- PANEL -->
            <div class="col-lg-4">

                <div class="profile-card">

                    <div class="profile-avatar">
                        AR
                    </div>

                    <h2>Ana Rodríguez</h2>

                    <p>
                        Estudiante
                    </p>

                    <span class="status status-active">
                        Activo
                    </span>


                    <hr />


                    <div class="profile-data">

                        <span>Fecha de matrícula</span>
                        <strong>05/02/2026</strong>

                    </div>


                    <div class="profile-data">

                        <span>Última actualización</span>
                        <strong>08/08/2026</strong>

                    </div>

                </div>


                <div class="action-card mt-3">

                    <a href="@Url.Action("Editar", "Estudiantes", new { id = 1 })"
                       class="btn btn-outline-cop w-100">

                        <i class="bi bi-pencil me-1"></i>
                        Editar información

                    </a>


                    <a href="@Url.Action("Expediente", "Estudiantes", new { id = 1 })"
                       class="btn btn-outline-cop w-100 mt-2">

                        <i class="bi bi-heart-pulse me-1"></i>
                        Expediente

                    </a>


                    <button type="button"
                            class="btn btn-outline-danger w-100 mt-2"
                            data-bs-toggle="modal"
                            data-bs-target="#modalBaja">

                        <i class="bi bi-person-dash me-1"></i>
                        Dar de baja

                    </button>


                    <a href="@Url.Action("Index", "Estudiantes")"
                       class="btn btn-light w-100 mt-2">

                        Volver

                    </a>

                </div>

            </div>

        </div>

    </section>

</main>


<!-- MODAL BAJA -->
<div class="modal fade"
     id="modalBaja"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Dar de baja estudiante
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="warning-box">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        El estudiante dejará de aparecer como matrícula activa.
                    </span>

                </div>


                <label class="form-label">
                    Motivo
                    <span class="text-danger">*</span>
                </label>

                <select id="motivoBaja"
                        class="form-select mb-3">

                    <option value="">
                        Seleccione
                    </option>

                    <option>
                        Traslado de institución
                    </option>

                    <option>
                        Retiro
                    </option>

                    <option>
                        Cambio de residencia
                    </option>

                    <option>
                        Otro
                    </option>

                </select>


                <label class="form-label">
                    Observación
                </label>

                <textarea class="form-control"
                          rows="3"
                          placeholder="Información adicional..."></textarea>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="confirmarBaja()">

                    Confirmar baja

                </button>

            </div>

        </div>

    </div>

</div>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .detail-card,
        .profile-card,
        .action-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 22px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.08rem;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .detail-label {
            display: block;
            font-size: .78rem;
            color: var(--cop-muted);
            margin-bottom: 3px;
        }

        .detail-text {
            color: #495057;
            margin: 0;
        }

        .profile-card {
            text-align: center;
        }

        .profile-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .profile-card h2 {
            color: var(--cop-primary);
            font-size: 1.1rem;
            margin: 12px 0 3px;
        }

        .profile-card p {
            color: var(--cop-muted);
            font-size: .85rem;
        }

        .profile-data {
            text-align: left;
            margin-top: 12px;
        }

            .profile-data span,
            .profile-data strong {
                display: block;
            }

            .profile-data span {
                color: var(--cop-muted);
                font-size: .76rem;
            }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-active {
            background: #d1e7dd;
            color: #0f5132;
        }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

            .btn-outline-cop:hover {
                background: #e6f1fb;
                color: var(--cop-primary);
            }

        .warning-box {
            display: flex;
            gap: 10px;
            background: #fff3cd;
            color: #856404;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 18px;
        }
    </style>

}


@section scripts {

    <script>

    function confirmarBaja() {

        var motivo =
            document.getElementById("motivoBaja").value;

        if (motivo === "") {

            alert("Debe seleccionar un motivo para dar de baja al estudiante.");

            return;
        }

        alert("La baja del estudiante fue registrada correctamente.");
    }

    </script>

}