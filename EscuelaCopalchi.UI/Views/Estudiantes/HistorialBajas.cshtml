<style>
    .auditoria-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 22px;
        margin-top: 12px;
        border-top: 1px solid #edf1f5;
    }

    .auditoria-pagination-info {
        font-size: .87rem;
        color: #718092;
    }

        .auditoria-pagination-info strong {
            color: #34495e;
        }

    .auditoria-pages {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .auditoria-page-btn {
        min-width: 37px;
        height: 37px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dce5ed;
        border-radius: 8px;
        background: #fff;
        color: #4b6479;
        text-decoration: none;
        font-size: .86rem;
        font-weight: 650;
    }

        .auditoria-page-btn:hover {
            background: #edf4f9;
            border-color: #b7d0e0;
            color: #173b53;
            text-decoration: none;
        }

        .auditoria-page-btn.active {
            background: #173b53;
            border-color: #173b53;
            color: #fff;
            pointer-events: none;
        }


    .auditoria-page-btn {
        cursor: pointer;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
        const filas = Array.from(document.querySelectorAll("#filasHistorial tr"));
        const buscador = document.getElementById("buscarHistorial");
        const resumen = document.getElementById("resumenHistorial");
        const paginas = document.getElementById("paginasHistorial");
        const porPagina = 10;
        let pagina = 1;
        function boton(texto, destino, activo, titulo) {
            const a = document.createElement("button");
            a.type = "button";
            a.className = "auditoria-page-btn" + (activo ? " active" : "");
            a.title = titulo;
            a.textContent = texto;
            if (activo) a.setAttribute("aria-current", "page");
            a.addEventListener("click", function () { pagina = destino; render(); });
            paginas.appendChild(a);
        }
        function render() {
            const filtro = (buscador.value || "").toLocaleLowerCase().trim();
            const encontrados = filas.filter(f => f.textContent.toLocaleLowerCase().includes(filtro));
            const total = encontrados.length;
            const totalPaginas = Math.max(1, Math.ceil(total / porPagina));
            pagina = Math.max(1, Math.min(pagina, totalPaginas));
            const inicio = (pagina - 1) * porPagina;
            filas.forEach(f => f.style.display = "none");
            encontrados.slice(inicio, inicio + porPagina).forEach(f => f.style.display = "");
            resumen.textContent = `Mostrando ${total ? inicio + 1 : 0}–${Math.min(inicio + porPagina, total)} de ${total} estudiantes · Página ${pagina} de ${totalPaginas}`;
            paginas.innerHTML = "";
            if (totalPaginas <= 1) return;
            if (pagina > 1) { boton("«", 1, false, "Primera página"); boton("‹", pagina - 1, false, "Página anterior"); }
            let desde = Math.max(1, pagina - 2);
            let hasta = Math.min(totalPaginas, desde + 4);
            desde = Math.max(1, hasta - 4);
            for (let n = desde; n <= hasta; n++) boton(String(n), n, n === pagina, "Página " + n);
            if (pagina < totalPaginas) { boton("›", pagina + 1, false, "Página siguiente"); boton("»", totalPaginas, false, "Última página"); }
        }
        buscador.addEventListener("input", function () { pagina = 1; render(); });
        render();
});
</script>
