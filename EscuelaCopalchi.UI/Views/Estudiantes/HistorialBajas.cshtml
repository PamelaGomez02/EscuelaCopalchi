@{
    ViewBag.Title = "Historial de bajas";
}

<main>

    <section class="students-header">
        <div class="container">
            <div class="cop-student-headline">
                <div><h1 class="students-title"><i class="bi bi-clock-history me-2"></i>Historial de bajas</h1><p class="students-subtitle">Consulta los estudiantes retirados o trasladados de la institución.</p></div>
                <div class="cop-student-actions"><a href="@Url.Action("Index", "Estudiantes")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a></div>
            </div>
        </div>
    </section>


    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-person-dash"></i>
                    </div>

                    <div>
                        <span>Total de bajas</span>
                        <h2>@ViewBag.TotalBajas</h2>
                    </div>

                </div>

            </div>


        </div>


        <div class="history-card">

            <!-- BUSCADOR -->
            <div class="history-toolbar">

                <div>

                    <h2>Estudiantes inactivos</h2>

                    <p>
                        Busca y consulta el historial de bajas de matrícula.
                    </p>

                </div>


                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar estudiante..." id="buscarHistorial" />

                </div>

            </div>


            <!-- TABLA -->
            <div class="table-responsive">

                <table class="table history-table align-middle">

                    <thead>

                        <tr>
                            <th>Estudiante</th>
                            <th>Identificación</th>
                            <th>Nombre Encargado</th>
                            <th>Fecha de baja</th>
                            <th>Motivo</th>
                            <th class="text-end">Detalle</th>
                        </tr>

                    </thead>


                    <tbody id="filasHistorial">

                        @foreach (EscuelaCopalchi.UI.Models.Estudiantes.Estudiante estudiante in ViewBag.HistorialBajas)
                        {
                            <tr>

                                <td>

                                    <div class="student-info">

                                        <div class="student-avatar">

                                            @(
                                                (!string.IsNullOrEmpty(estudiante.Nombre)
                                                    ? estudiante.Nombre.Substring(0,1)
                                                    : "") +
                                                (!string.IsNullOrEmpty(estudiante.Apellido1)
                                                    ? estudiante.Apellido1.Substring(0,1)
                                                    : "")
                                            )

                                        </div>

                                        <div>

                                            <strong>
                                                @estudiante.Nombre
                                                @estudiante.Apellido1
                                            </strong>

                                            <small>
                                                Inactivo
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @estudiante.Identificacion
                                </td>

                                <td>
                                    @estudiante.NombreEncargado
                                </td>

                                <td>
                                    @(estudiante.FechaBaja.HasValue
                                        ? estudiante.FechaBaja.Value.ToString("dd/MM/yyyy")
                                        : "")
                                </td>

                                <td>
                                    @estudiante.ObservacionBaja
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-action"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDetalle"
                                            onclick="cargarDetalleBaja(
                                                '@(estudiante.Nombre + " " + estudiante.Apellido1 + " " + estudiante.Apellido2)',
                                                '@estudiante.Identificacion',
                                                '@estudiante.NombreEncargado',
                                                '@(estudiante.FechaBaja.HasValue
                                                    ? estudiante.FechaBaja.Value.ToString("dd/MM/yyyy")
                                                    : "")',

                                                '@estudiante.ObservacionBaja')">

                                        <i class="bi bi-eye"></i>

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="history-footer">
                <div class="auditoria-pagination">
                    <div class="auditoria-pagination-info" id="resumenHistorial"></div>
                    <nav aria-label="Paginación del historial de bajas"><div class="auditoria-pages" id="paginasHistorial"></div></nav>
                </div>
            </div>
        </div>

        </div>

    </section>

</main>


<!-- MODAL DETALLE BAJA -->
<div class="modal fade"
     id="modalDetalle"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Detalle de la baja
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="detail-row">

                    <span>Estudiante</span>

                    <strong id="detalleEstudiante"></strong>

                </div>

                <div class="detail-row">

                    <span>Identificación</span>

                    <strong id="detalleIdentificacion"></strong>

                </div>

                <div class="detail-row">

                    <span>Encargado</span>

                    <strong id="detalleEncargado"></strong>

                </div>

                <div class="detail-row">

                    <span>Fecha de baja</span>

                    <strong id="detalleFechaBaja"></strong>

                </div>

                <div class="observation-box">

                    <span>
                        Observación
                    </span>

                    <p id="detalleObservacion"></p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-cop-primary"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>


<script>

        function cargarDetalleBaja(
            estudiante,
            identificacion,
            encargado,
            fechaBaja,
            observacion) {
            document.getElementById(
                "detalleEstudiante").innerText =
                estudiante;

            document.getElementById(
                "detalleIdentificacion").innerText =
                identificacion;

            document.getElementById(
                "detalleEncargado").innerText =
                encargado;

            document.getElementById(
                "detalleFechaBaja").innerText =
                fechaBaja;

            document.getElementById(
                "detalleObservacion").innerText =
                observacion;
        }

</script>



