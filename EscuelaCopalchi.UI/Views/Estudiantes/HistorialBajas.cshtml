@{
    ViewBag.Title = "Historial de bajas";
}

<main>

    <section class="students-header">

        <div class="container">

            <div class="students-breadcrumb">

                <a href="@Url.Action("Index", "Home")">
                    Inicio
                </a>

                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "EstudiantesAdd")">
                    Estudiantes
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Historial de bajas</span>

            </div>


            <h1 class="students-title">
                <i class="bi bi-clock-history me-2"></i>
                Historial de bajas
            </h1>

            <p class="students-subtitle">
                Consulta los estudiantes retirados o trasladados de la institución.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-person-dash"></i>
                    </div>

                    <div>
                        <span>Total de bajas</span>
                        <h2>@ViewBag.TotalBajas</h2>
                    </div>

                </div>

            </div>


        </div>


        <div class="history-card">

            <!-- BUSCADOR -->
            <div class="history-toolbar">

                <div>

                    <h2>Estudiantes inactivos</h2>

                    <p>
                        Busca y consulta el historial de bajas de matrícula.
                    </p>

                </div>


                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="form-control"
                           placeholder="Buscar estudiante..." />

                </div>

            </div>


            <!-- TABLA -->
            <div class="table-responsive">

                <table class="table history-table align-middle">

                    <thead>

                        <tr>
                            <th>Estudiante</th>
                            <th>Identificación</th>
                            <th>Nombre Encargado</th>
                            <th>Fecha de baja</th>
                            <th>Motivo</th>
                            <th class="text-end">Detalle</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (EscuelaCopalchi.UI.Models.Estudiantes.Estudiante estudiante in ViewBag.HistorialBajas)
                        {
                            <tr>

                                <td>

                                    <div class="student-info">

                                        <div class="student-avatar">

                                            @(
                                                (!string.IsNullOrEmpty(estudiante.Nombre)
                                                    ? estudiante.Nombre.Substring(0,1)
                                                    : "") +
                                                (!string.IsNullOrEmpty(estudiante.Apellido1)
                                                    ? estudiante.Apellido1.Substring(0,1)
                                                    : "")
                                            )

                                        </div>

                                        <div>

                                            <strong>
                                                @estudiante.Nombre
                                                @estudiante.Apellido1
                                            </strong>

                                            <small>
                                                Inactivo
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @estudiante.Identificacion
                                </td>

                                <td>
                                    @estudiante.NombreEncargado
                                </td>

                                <td>
                                    @(estudiante.FechaBaja.HasValue
                                        ? estudiante.FechaBaja.Value.ToString("dd/MM/yyyy")
                                        : "")
                                </td>

                                <td>
                                    @estudiante.ObservacionBaja
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-action"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDetalle"
                                            onclick="cargarDetalleBaja(
                                                '@(estudiante.Nombre + " " + estudiante.Apellido1 + " " + estudiante.Apellido2)',
                                                '@estudiante.Identificacion',
                                                '@estudiante.NombreEncargado',
                                                '@(estudiante.FechaBaja.HasValue
                                                    ? estudiante.FechaBaja.Value.ToString("dd/MM/yyyy")
                                                    : "")',

                                                '@estudiante.ObservacionBaja')">

                                        <i class="bi bi-eye"></i>

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="history-footer">

                <a href="@Url.Action("Index", "EstudiantesAdd")"
                   class="btn btn-light">

                    <i class="bi bi-arrow-left me-1"></i>
                    Volver

                </a>

            </div>

        </div>

    </section>

</main>


<!-- MODAL DETALLE BAJA -->
<div class="modal fade"
     id="modalDetalle"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Detalle de la baja
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="detail-row">

                    <span>Estudiante</span>

                    <strong id="detalleEstudiante"></strong>

                </div>

                <div class="detail-row">

                    <span>Identificación</span>

                    <strong id="detalleIdentificacion"></strong>

                </div>

                <div class="detail-row">

                    <span>Encargado</span>

                    <strong id="detalleEncargado"></strong>

                </div>

                <div class="detail-row">

                    <span>Fecha de baja</span>

                    <strong id="detalleFechaBaja"></strong>

                </div>

                <div class="observation-box">

                    <span>
                        Observación
                    </span>

                    <p id="detalleObservacion"></p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-cop-primary"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>


<script>

    function cargarDetalleBaja(
        estudiante,
        identificacion,
        encargado,
        fechaBaja,
        observacion) {
        document.getElementById(
            "detalleEstudiante").innerText =
            estudiante;

        document.getElementById(
            "detalleIdentificacion").innerText =
            identificacion;

        document.getElementById(
            "detalleEncargado").innerText =
            encargado;

        document.getElementById(
            "detalleFechaBaja").innerText =
            fechaBaja;

        document.getElementById(
            "detalleObservacion").innerText =
            observacion;
    }

</script>



@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: #f8d7da;
            color: #842029;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            color: var(--cop-primary);
            margin: 0;
            font-size: 1.4rem;
        }

        .history-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .history-toolbar {
            padding: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

            .history-toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin: 0 0 4px;
            }

            .history-toolbar p {
                color: var(--cop-muted);
                margin: 0;
                font-size: .85rem;
            }

        .search-box {
            position: relative;
            width: 270px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .filters {
            padding: 15px 22px;
            display: flex;
            gap: 12px;
            background: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select,
            .filters .form-control {
                max-width: 220px;
            }

        .history-table {
            margin: 0;
        }

            .history-table th {
                background: #f8fafc;
                color: #53616d;
                text-transform: uppercase;
                font-size: .78rem;
                padding: 13px 17px;
            }

            .history-table td {
                padding: 15px 17px;
                font-size: .88rem;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: .8rem;
            font-weight: 600;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .reason {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .reason-transfer {
            background: #e6f1fb;
            color: var(--cop-secondary);
        }

        .reason-retirement {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            border: 1px solid #dce2e7;
            background: white;
            color: var(--cop-secondary);
            padding: 5px 9px;
        }

        .history-footer {
            padding: 16px 22px;
            border-top: 1px solid #edf0f3;
        }

        .detail-row {
            padding: 10px 0;
            border-bottom: 1px solid #edf0f3;
        }

            .detail-row span,
            .detail-row strong {
                display: block;
            }

            .detail-row span {
                color: var(--cop-muted);
                font-size: .78rem;
            }

        .observation-box {
            margin-top: 16px;
            padding: 13px;
            border-radius: 8px;
            background: #f8fafc;
        }

            .observation-box span {
                color: var(--cop-muted);
                font-size: .78rem;
            }

            .observation-box p {
                margin: 4px 0 0;
                font-size: .88rem;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

        @@media(max-width:768px) {

            .history-toolbar,
            .filters {
                flex-direction: column;
                align-items: stretch;
            }

                .search-box,
                .filters .form-select,
                .filters .form-control {
                    width: 100%;
                    max-width: none;
                }
        }
    </style>

}