@model EscuelaCopalchi.UI.Models.Estudiantes.Estudiante

@{
    ViewBag.Title = "Registrar estudiante";
}

<main>

    <section class="students-header">
        <div class="container">
            <div class="cop-student-headline">
                <div><h1 class="students-title"><i class="bi bi-person-plus me-2"></i>Registrar estudiante</h1><p class="students-subtitle">Ingresa la información necesaria para matricular un nuevo estudiante.</p></div>
                <div class="cop-student-actions"><a href="@Url.Action("Index", "Estudiantes")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a></div>
            </div>
        </div>
    </section>

    <section class="container pb-5">

        <div class="form-card">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    Estudiantes
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Registrar", "Estudiantes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <h2 class="section-title">
                    <i class="bi bi-person me-2"></i>
                    Datos del estudiante
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombre
                            <span class="required">*</span>
                        </label>

                        <input type="text"
                               name="Nombre"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Primer Apellido
                            <span class="required">*</span>
                        </label>

                        <input type="text"
                               name="Apellido1"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Segundo Apellido
                        </label>

                        <input type="text"
                               name="Apellido2"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Identificación
                            <span class="required">*</span>
                        </label>

                        <input type="text"
                               name="Identificacion"
                               class="form-control"
                               placeholder="Ej. 1-1234-5678"
                               required />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Fecha de nacimiento
                            <span class="required">*</span>
                        </label>

                        <input type="date"
                               name="FechaNacimiento"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="correo@ejemplo.com" />
                    </div>

                </div>

                <div class="form-section">

                    <h2 class="section-title">
                        <i class="bi bi-people me-2"></i>
                        Datos del encargado
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Nombre completo
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   name="NombreEncargado"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Parentesco
                                <span class="required">*</span>
                            </label>
                            <select name="Parentesco"
                                    class="form-select"
                                    required>
                                <option value="">Seleccione</option>
                                <option value="Madre">Madre</option>
                                <option value="Padre">Padre</option>
                                <option value="Encargado legal">Encargado legal</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Teléfono
                                <span class="required">*</span>
                            </label>

                            <input type="tel"
                                   name="TelefonoEncargado"
                                   class="form-control"
                                   placeholder="8888-8888"
                                   required />

                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Correo
                                <span class="required">*</span>

                            </label>
                            <input type="email"
                                   name="CorreoEncargado"
                                   class="form-control"
                                   placeholder="correo@ejemplo.com"
                                   required />
                        </div>

                    </div>

                </div>


                <div class="form-section">

                    <h2 class="section-title">
                        <i class="bi bi-house me-2"></i>
                        Información adicional
                    </h2>

                    <div class="row g-3">

                        <div class="col-12">

                            <label class="form-label">
                                Dirección
                            </label>

                            <textarea name="Direccion"
                                      class="form-control"
                                      rows="3"></textarea>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Estado
                            </label>

                            <select name="Estado"
                                    class="form-select">

                                <option value="true" selected>
                                    Activo
                                </option>

                                <option value="false">
                                    Inactivo
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="form-actions">

                    <a href="@Url.Action("Index", "Estudiantes")"
                       class="btn btn-light">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-cop-primary">

                        <i class="bi bi-save me-1"></i>
                        Registrar estudiante

                    </button>

                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>
        /* Encabezado unificado con Gestión Académica */
        .students-header, .record-header {
            background: transparent !important;
            border: 0 !important;
            padding: 0 !important;
            margin: 0 0 22px !important;
            box-shadow: none !important;
        }

            .students-header > .container, .record-header > .container {
                background: transparent !important;
                border: 0 !important;
                box-shadow: none !important;
                padding: 0 12px !important;
                max-width: 1140px;
            }

        .cop-student-headline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

            .cop-student-headline .students-title, .cop-student-headline .record-title {
                margin: 0 0 4px !important;
                font-size: 1.65rem;
                color: #133c55;
                font-weight: 700;
            }

            .cop-student-headline .students-subtitle, .cop-student-headline .record-subtitle {
                margin: 0 !important;
                color: #64748b;
            }

        .cop-student-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

            .cop-student-actions .btn {
                border-radius: 7px;
                white-space: nowrap;
            }

        .cop-student-breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            font-size: .82rem;
            color: #64748b;
            flex-wrap: wrap;
        }

            .cop-student-breadcrumb a {
                color: #386fa4;
                text-decoration: none;
            }

            .cop-student-breadcrumb i {
                font-size: .65rem;
            }

        @@media (max-width: 576px) {
            .students-header > .container, .record-header > .container {
                padding: 0 12px !important;
            }

            .cop-student-headline {
                align-items: flex-start;
            }

                .cop-student-headline .students-title, .cop-student-headline .record-title {
                    font-size: 1.35rem;
                }
        }


        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .form-card {
            max-width: 100%;
            width: 100%;
            margin: 0;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .form-section {
            border-top: 1px solid #edf0f3;
            margin-top: 28px;
            padding-top: 22px;
        }

        .form-label {
            color: #344054;
            font-size: .9rem;
            font-weight: 600;
        }

        .required {
            color: #dc3545;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--cop-accent);
            box-shadow: 0 0 0 .2rem rgba(89,165,216,.15);
        }

        .form-actions {
            border-top: 1px solid #edf0f3;
            margin-top: 28px;
            padding-top: 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        /* Estilo compartido Aula Virtual Copalchí */
        .cop-nav-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

            .cop-nav-row .students-breadcrumb, .cop-nav-row .record-breadcrumb {
                margin-bottom: 0;
            }

        .cop-back-btn {
            border-radius: 9px;
            font-weight: 600;
            padding: .5rem .95rem;
            white-space: nowrap;
            background: white;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        .students-header, .record-header {
            padding-top: 22px !important;
            padding-bottom: 22px !important;
        }

        .students-card, .form-card, .history-card {
            box-shadow: 0 5px 20px rgba(19,60,85,.045);
        }

        /* Encabezado sin tarjeta ni ruta de navegación */
        .students-header, .record-header {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 20px 0 0 !important;
            margin: 0 0 20px !important;
        }

            .students-header > .container, .record-header > .container {
                background: transparent !important;
                border: none !important;
                box-shadow: none !important;
                padding: 0 12px !important;
            }

        .cop-student-headline {
            align-items: center;
        }
    </style>

}