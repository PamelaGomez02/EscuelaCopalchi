@using System.Linq

@model List<EscuelaCopalchi.UI.Models.Estudiantes.Estudiante>


@{
    ViewBag.Title = "Estudiantes";
}

<main>

    <section class="students-header">
        <div class="container">


            <div class="cop-nav-row">
<div class="students-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Estudiantes</span>
            </div>
<a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>
</div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>
                    <h1 class="students-title">
                        <i class="bi bi-mortarboard me-2"></i>
                        Gestión de estudiantes
                    </h1>

                    <p class="students-subtitle">
                        Registra, consulta y administra la matrícula institucional.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (ViewBag.PuedeImportar == true)
                    {
                        <a href="@Url.Action("ImportarExcel", "Estudiantes")"
                           class="btn btn-outline-cop">
                            <i class="bi bi-file-earmark-excel me-1"></i>
                            Importar Excel
                        </a>
                    }

                    @if (ViewBag.PuedeCrear == true)
                    {
                        <a href="@Url.Action("Registrar", "Estudiantes")"
                           class="btn btn-cop-primary">
                            <i class="bi bi-person-plus me-1"></i>
                            Registrar estudiante
                        </a>
                    }

                </div>

            </div>

        </div>
    </section>


    <section class="container pb-5">

        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <span>Total estudiantes</span>
                        <h2>@ViewBag.TotalEstudiantes</h2>
                    </div>

                </div>
            </div>


            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon active">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>
                        <span>Activos</span>
                        <h2>@ViewBag.TotalActivos</h2>
                    </div>

                </div>
            </div>


            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon inactive">
                        <i class="bi bi-person-x"></i>
                    </div>

                    <div>
                        <span>Inactivos</span>
                        <h2>@ViewBag.TotalInactivos</h2>
                    </div>

                </div>
            </div>

        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <div class="students-card">

            <div class="student-quick-filters" aria-label="Filtrar estudiantes">
                <a class="student-filter-tab @(ViewBag.FiltroEstado == "Todos" ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = "Todos", busqueda = ViewBag.Busqueda })"><i class="bi bi-people me-1"></i>Todos</a>
                <a class="student-filter-tab @(ViewBag.FiltroEstado == "Activos" ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = "Activos", busqueda = ViewBag.Busqueda })"><i class="bi bi-person-check me-1"></i>Activos</a>
                <a class="student-filter-tab @(ViewBag.FiltroEstado == "Inactivos" ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = "Inactivos", busqueda = ViewBag.Busqueda })"><i class="bi bi-person-dash me-1"></i>Inactivos</a>
                @if (ViewBag.PuedeExpediente == true)
                {
                    <a class="student-filter-tab @(ViewBag.FiltroEstado == "Adecuaciones" ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = "Adecuaciones", busqueda = ViewBag.Busqueda })"><i class="bi bi-clipboard2-pulse me-1"></i>Con adecuaciones</a>
                    <a class="student-filter-tab @(ViewBag.FiltroEstado == "Alergias" ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = "Alergias", busqueda = ViewBag.Busqueda })"><i class="bi bi-heart-pulse me-1"></i>Con alergias</a>
                }
            </div>
            <div class="students-toolbar">

                <div>
                    <h2>Estudiantes registrados</h2>
                    <p>Consulta y administra la información estudiantil.</p>
                </div>

                @using (Html.BeginForm(
                    "Index",
                    "Estudiantes",
                    FormMethod.Get))
                {
                    <div class="toolbar-actions">

                        <input type="hidden" name="filtroEstado" value="@ViewBag.FiltroEstado" />
                        <div class="search-box">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   name="busqueda"
                                   class="form-control"
                                   value="@ViewBag.Busqueda"
                                   placeholder="Buscar estudiante..." />

                        </div>

                        <button type="submit"
                                class="btn btn-cop-primary">

                            Buscar

                        </button>

                    </div>
                }


            </div>


            <div class="table-responsive">

                <table class="table students-table align-middle">

                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Identificación</th>
                            <th>Encargado</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var estudiante in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="student-info">

                                            <div class="student-avatar">
                                                @(estudiante.Nombre.Length > 0 ? estudiante.Nombre.Substring(0, 1) : "")
                                                @(estudiante.Apellido1.Length > 0 ? estudiante.Apellido1.Substring(0, 1) : "")
                                            </div>

                                            <div>
                                                <strong>
                                                    @estudiante.Nombre
                                                    @estudiante.Apellido1
                                                    @estudiante.Apellido2
                                                </strong>
                                                <small>Estudiante</small>
                                            </div>

                                        </div>

                                    </td>

                                    <td>@estudiante.Identificacion</td>

                                    <td>@estudiante.NombreEncargado</td>

                                    <td>
                                        @if (estudiante.Estado)
                                        {
                                            <span class="status status-active">
                                                <i class="bi bi-check-circle"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status status-inactive">
                                                <i class="bi bi-x-circle"></i>
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a href="@Url.Action("Detalle","Estudiantes", new { id = estudiante.IdEstudiante})"
                                           class="btn btn-action"
                                           title="Detalle">
                                            <i class="bi bi-eye"></i>

                                        </a>


                                        @if (ViewBag.PuedeEditar == true)
                                        {
                                            <a href="@Url.Action("Editar", "Estudiantes", new { id = estudiante.IdEstudiante})"
                                               class="btn btn-action"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        @if (ViewBag.PuedeExpediente == true)
                                        {
                                            <a href="@Url.Action("Expediente",  "Estudiantes", new { id = estudiante.IdEstudiante})"
                                               class="btn btn-action"
                                               title="Expediente">
                                                <i class="bi bi-heart-pulse"></i>
                                            </a>
                                        }

                                        @if (ViewBag.PuedeBajas == true && estudiante.Estado)
                                        {
                                            <button type="button"
                                                    class="btn btn-action-danger"
                                                    title="Dar de baja"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalBaja"
                                                    onclick="seleccionarEstudiante(@estudiante.IdEstudiante)">

                                                <i class="bi bi-person-dash"></i>

                                            </button>
                                        }
                                        else if (ViewBag.PuedeBajas == true)
                                        {
                                            <button type="button"
                                                    class="btn btn-action-reactivar"
                                                    title="Reactivar estudiante"
                                                    aria-label="Reactivar estudiante"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalReactivar"
                                                    data-id="@estudiante.IdEstudiante"
                                                    data-nombre="@((estudiante.Nombre + " " + estudiante.Apellido1 + " " + estudiante.Apellido2).Trim())">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }

                                    </td>

                                </tr>



                            }
                        }

                    </tbody>

                </table>

            </div>

            @if ((int)ViewBag.TotalPaginas > 1)
            {
                <nav class="student-pagination" aria-label="Páginas de estudiantes">
                    <span>Mostrando @Model.Count de @ViewBag.TotalFiltrados estudiantes · Página @ViewBag.Pagina de @ViewBag.TotalPaginas</span>
                    <div class="student-pages">
                        @for (int numero = 1; numero <= (int)ViewBag.TotalPaginas; numero++)
                        {
                            <a class="student-page-link @(numero == (int)ViewBag.Pagina ? "active" : "")" href="@Url.Action("Index", "Estudiantes", new { filtroEstado = ViewBag.FiltroEstado, busqueda = ViewBag.Busqueda, pagina = numero })">@numero</a>
                        }
                    </div>
                </nav>
            }
            else
            {
                <div class="student-page-summary">Mostrando @Model.Count de @ViewBag.TotalFiltrados estudiantes</div>
            }

            <div class="history-link">

                @if (ViewBag.PuedeBajas == true)
                {
                    <a href="@Url.Action("HistorialBajas", "Estudiantes")"
                       class="btn btn-light">

                        <i class="bi bi-clock-history me-1"></i>
                        Ver historial de bajas

                    </a>
                }

            </div>

        </div>

    </section>

</main>


@if (ViewBag.PuedeBajas == true)
{
    <!-- MODAL REACTIVAR -->
    <div class="modal fade" id="modalReactivar" tabindex="-1" aria-labelledby="tituloModalReactivar" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("Reactivar", "Estudiantes", FormMethod.Post, new { id = "formReactivar" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idEstudianteReactivar" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalReactivar"><i class="bi bi-person-check text-success me-2"></i>Reactivar estudiante</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Deseas reactivar a <strong id="nombreEstudianteReactivar"></strong>?</p>
                        <div class="alert alert-info mb-0"><i class="bi bi-info-circle me-2"></i>El estudiante volverá a Activos. Su expediente y el historial de bajas se conservarán.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnConfirmarReactivar" class="btn btn-success"><i class="bi bi-person-check me-1"></i>Confirmar reactivación</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- MODAL BAJA -->

    <div class="modal fade"
         id="modalBaja"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                @using (Html.BeginForm("DarBaja",
                                       "Estudiantes",
                                       FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           id="idEstudianteBaja"
                           name="id" />

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Dar de baja estudiante
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="warning-box">

                            <i class="bi bi-exclamation-triangle"></i>

                            <p>
                                El estudiante cambiará al estado Inactivo.
                            </p>

                        </div>

                        <label class="form-label">
                            Observación de baja
                        </label>

                        <textarea class="form-control"
                                  rows="4"
                                  name="observacionBaja"
                                  placeholder="Agregue el motivo por el que se da de baja al estudiante."></textarea>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit" id="btnConfirmarBaja"
                                class="btn btn-danger">

                            <i class="bi bi-person-dash me-1"></i>
                            Confirmar baja

                        </button>

                    </div>
                }

            </div>

        </div>

    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modalReactivar = document.getElementById('modalReactivar');
        if (!modalReactivar) return;
        modalReactivar.addEventListener('show.bs.modal', function (event) {
            var boton = event.relatedTarget;
            if (!boton) return;
            document.getElementById('idEstudianteReactivar').value = boton.getAttribute('data-id');
            document.getElementById('nombreEstudianteReactivar').textContent = boton.getAttribute('data-nombre') || 'este estudiante';
        });
        var formulario = document.getElementById('formReactivar');
        var confirmar = document.getElementById('btnConfirmarReactivar');
        if (formulario && confirmar) {
            formulario.addEventListener('submit', function (event) {
                if (formulario.dataset.enviado === '1') { event.preventDefault(); return; }
                formulario.dataset.enviado = '1';
                confirmar.disabled = true;
                confirmar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Reactivando...';
            });
        }
    });
    function seleccionarEstudiante(id) {
        document.getElementById("idEstudianteBaja").value = id;
    }
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('modalBaja');
        if (!modal) return;
        var form = modal.querySelector('form');
        var button = document.getElementById('btnConfirmarBaja');
        if (form && button) {
            form.addEventListener('submit', function () {
                if (form.dataset.enviado === '1') return;
                form.dataset.enviado = '1';
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Guardando...';
            });
        }
    });
</script>


@section styles {

    <style>
        .btn-action-reactivar { color: #16734a; background: #f0faf5; border: 1px solid #9bd5b7; border-radius: 5px; padding: 6px 10px; }
        .btn-action-reactivar:hover { background: #d8f2e5; color: #105a39; }

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .students-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .students-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .students-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .students-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .students-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }

            .summary-icon.active {
                background: #d1e7dd;
                color: #0f5132;
            }

            .summary-icon.inactive {
                background: #f8d7da;
                color: #842029;
            }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            color: var(--cop-primary);
            margin: 0;
            font-size: 1.4rem;
        }

        .students-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .students-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 22px;
        }

            .students-toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .students-toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .toolbar-actions {
            display: flex;
            gap: 10px;
        }

            .toolbar-actions .form-select {
                width: 130px;
            }

        .search-box {
            position: relative;
            width: 250px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .students-table {
            margin: 0;
        }

            .students-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .78rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .students-table td {
                padding: 15px 17px;
                font-size: .88rem;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            font-size: .8rem;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-active {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-inactive {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action,
        .btn-action-danger {
            border: 1px solid #dce2e7;
            background: white;
            padding: 5px 9px;
        }

        .btn-action {
            color: var(--cop-secondary);
        }

        .btn-action-danger {
            color: #dc3545;
        }

        .history-link {
            padding: 16px 22px;
            border-top: 1px solid #edf0f3;
            text-align: right;
        }

        .warning-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff3cd;
            color: #856404;
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 18px;
        }

            .warning-box p {
                margin: 0;
                font-size: .88rem;
            }

        .required {
            color: #dc3545;
        }

        @@media(max-width:768px) {

            .students-toolbar,
            .toolbar-actions {
                flex-direction: column;
                align-items: stretch;
            }

                .search-box,
                .toolbar-actions .form-select {
                    width: 100%;
                }
        }
    
        /* Estilo compartido Aula Virtual Copalchí */
        .cop-nav-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:14px; }
        .cop-nav-row .students-breadcrumb, .cop-nav-row .record-breadcrumb { margin-bottom:0; }
        .cop-back-btn { border-radius:9px; font-weight:600; padding:.5rem .95rem; white-space:nowrap; background:white; }
        .cop-back-btn:hover { background:#edf3f8; border-color:#386FA4; color:#133C55; }
        .students-header, .record-header { padding-top:22px !important; padding-bottom:22px !important; }
        .students-card, .form-card, .history-card { box-shadow:0 5px 20px rgba(19,60,85,.045); }

    </style>

}
<style>
.student-quick-filters { display:flex; flex-wrap:wrap; gap:8px; padding:16px 20px; background:#fff; border-bottom:1px solid #e5ebf1; }
.student-filter-tab { display:inline-flex; align-items:center; padding:9px 14px; border:1px solid #dbe5ee; border-radius:9px; color:#386fa4; text-decoration:none; font-size:13px; font-weight:600; }
.student-filter-tab:hover { background:#eef5fb; color:#133c55; }
.student-filter-tab.active { background:#133c55; border-color:#133c55; color:white; }
.student-pagination { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:17px 20px; border-top:1px solid #e5ebf1; color:#52677a; font-size:13px; }
.student-pages { display:flex; flex-wrap:wrap; gap:5px; }
.student-page-link { display:inline-flex; align-items:center; justify-content:center; min-width:35px; height:35px; padding:0 9px; border:1px solid #dbe5ee; border-radius:8px; color:#386fa4; text-decoration:none; }
.student-page-link.active { background:#133c55; color:#fff; border-color:#133c55; }
.student-page-summary { padding:13px 20px; font-size:13px; color:#64748b; }
</style>
