@{
    ViewBag.Title = "Registrar asistencia";
}

<main>

    <section class="attendance-header">

        <div class="container">

            <div class="attendance-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "Asistencia")">
                    Asistencia
                </a>

                <i class="bi bi-chevron-right"></i>
                <span>Registrar</span>
            </div>

            <h1 class="attendance-title">
                <i class="bi bi-clipboard-check me-2"></i>
                Registrar asistencia
            </h1>

            <p class="attendance-subtitle">
                Registra el estado de asistencia de los estudiantes del grupo seleccionado.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <div class="attendance-card">

            <div class="filters">

                <div class="filter-field">
                    <label class="form-label">Grupo</label>

                    <select class="form-select">
                        <option selected>Primer grado A</option>
                        <option>Segundo grado A</option>
                        <option>Tercer grado A</option>
                    </select>
                </div>


                <div class="filter-field">
                    <label class="form-label">Fecha</label>

                    <input type="date"
                           class="form-control"
                           value="2026-08-10" />
                </div>

            </div>


            <div class="quick-actions">

                <span>
                    Acciones rápidas:
                </span>

                <button type="button"
                        class="btn btn-sm btn-outline-success">
                    <i class="bi bi-check-all me-1"></i>
                    Marcar todos presentes
                </button>

            </div>


            <div class="table-responsive">

                <table class="table attendance-table align-middle">

                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Estado</th>
                            <th>Hora de llegada</th>
                            <th>Observación</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>

                            <td>
                                <div class="student-info">

                                    <div class="student-avatar">
                                        MG
                                    </div>

                                    <div>
                                        <strong>María González</strong>
                                        <small>ID: EST-001</small>
                                    </div>

                                </div>
                            </td>


                            <td>

                                <select class="form-select status-select">
                                    <option selected>Presente</option>
                                    <option>Ausente</option>
                                    <option>Justificado</option>
                                    <option>Tardanza</option>
                                </select>

                            </td>


                            <td>

                                <input type="time"
                                       class="form-control"
                                       value="07:00" />

                            </td>


                            <td>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Observación opcional" />

                            </td>

                        </tr>


                        <tr>

                            <td>
                                <div class="student-info">

                                    <div class="student-avatar">
                                        JP
                                    </div>

                                    <div>
                                        <strong>Juan Pérez</strong>
                                        <small>ID: EST-002</small>
                                    </div>

                                </div>
                            </td>


                            <td>

                                <select class="form-select status-select">
                                    <option>Presente</option>
                                    <option selected>Ausente</option>
                                    <option>Justificado</option>
                                    <option>Tardanza</option>
                                </select>

                            </td>


                            <td>

                                <input type="time"
                                       class="form-control" />

                            </td>


                            <td>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Motivo u observación" />

                            </td>

                        </tr>


                        <tr>

                            <td>
                                <div class="student-info">

                                    <div class="student-avatar">
                                        AS
                                    </div>

                                    <div>
                                        <strong>Andrea Solano</strong>
                                        <small>ID: EST-003</small>
                                    </div>

                                </div>
                            </td>


                            <td>

                                <select class="form-select status-select">
                                    <option>Presente</option>
                                    <option>Ausente</option>
                                    <option>Justificado</option>
                                    <option selected>Tardanza</option>
                                </select>

                            </td>


                            <td>

                                <input type="time"
                                       class="form-control"
                                       value="07:18" />

                            </td>


                            <td>

                                <input type="text"
                                       class="form-control"
                                       value="Transporte" />

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <div class="form-actions">

                <a href="@Url.Action("Index", "Asistencia")"
                   class="btn btn-light">
                    Cancelar
                </a>

                <button type="button"
                        class="btn btn-cop-primary">

                    <i class="bi bi-save me-1"></i>
                    Guardar asistencia

                </button>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .attendance-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .attendance-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .attendance-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .attendance-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .attendance-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .attendance-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            display: flex;
            gap: 20px;
            padding: 20px 22px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

        .filter-field {
            width: 230px;
        }

        .form-label {
            color: #344054;
            font-weight: 600;
            font-size: .85rem;
        }

        .quick-actions {
            padding: 14px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #edf0f3;
            font-size: .85rem;
            color: var(--cop-muted);
        }

        .attendance-table {
            margin: 0;
        }

            .attendance-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .attendance-table td {
                padding: 14px 17px;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: .8rem;
            font-weight: 600;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .status-select {
            min-width: 145px;
        }

        .form-actions {
            padding: 20px 22px;
            border-top: 1px solid #edf0f3;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        @@media(max-width:768px) {

            .filters {
                flex-direction: column;
            }

            .filter-field {
                width: 100%;
            }
        }
    </style>

}