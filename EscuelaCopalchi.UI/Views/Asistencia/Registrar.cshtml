        }

        .cop-back-btn {
            font-weight: 600;
            padding: .55rem 1rem;
            white-space: nowrap;
            background: #fff;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        /* RESPONSIVO */

        @@media (max-width: 575px) {
            .attendance-title {
