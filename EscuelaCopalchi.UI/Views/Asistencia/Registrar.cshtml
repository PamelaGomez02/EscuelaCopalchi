@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaRegistrarVM
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Registrar asistencia";
}
@functions {
    static string Iniciales(string nombre)
    {
        var p = (nombre ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        return p.Length == 1 ? p[0].Substring(0, 1).ToUpper()
                             : (p[0].Substring(0, 1) + p[1].Substring(0, 1)).ToUpper();
    }
}

<main>

    <section class="attendance-header">
        <div class="container">

            <div class="attendance-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "Asistencia")">Asistencia</a>
                <i class="bi bi-chevron-right"></i>
                <span>Registrar</span>
            </div>

            <h1 class="attendance-title">
                <i class="bi bi-clipboard-check me-2"></i>
                Registrar asistencia
            </h1>

            <p class="attendance-subtitle">
                Registra el estado de asistencia de los estudiantes del grupo seleccionado.
            </p>

        </div>
    </section>


    <section class="container pb-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }

        <div class="attendance-card">

            <!-- 1) Elegir grupo y fecha (carga la lista de estudiantes) -->
            <form method="get" action="@Url.Action("Registrar", "Asistencia")" class="filters">

                <div class="filter-field">
                    <label class="form-label">Grupo</label>
                    <select name="grupo" class="form-select">
                        <option value="">Seleccione un grupo</option>
                        @foreach (var g in Model.Grupos)
                        {
                            <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo ? "selected" : null)">
                                @g.Grupo (@g.Anio)
                            </option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label class="form-label">Fecha</label>
                    <input type="date" name="fecha" class="form-control"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-field d-flex align-items-end">
                    <button type="submit" class="btn btn-cop-primary">
                        <i class="bi bi-people me-1"></i>
                        Cargar estudiantes
                    </button>
                </div>

            </form>


            @if (Model.Cargada && Model.YaRegistrada)
            {
                <div class="alert alert-warning m-3 p-3" role="status">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-calendar-check fs-4"></i>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-2">Asistencia ya registrada</h5>
                            <p class="mb-3">El grupo seleccionado ya tiene asistencia registrada para el <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong>. Puedes consultar los registros y editarlos desde la lista de asistencia.</p>
                            <a class="btn btn-cop-primary" href="@Url.Action("Index", "Asistencia", new { grupo = Model.IdGrupo, fecha = Model.Fecha.ToString("yyyy-MM-dd") })">
                                <i class="bi bi-pencil-square me-1"></i> Ver y modificar asistencia
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Cargada && !Model.Filas.Any())
            {
                <div class="alert alert-info m-3">Este grupo no tiene estudiantes activos.</div>
            }
            else if (Model.Cargada)
            {
                <!-- 2) Marcar estados y guardar -->
                using (Html.BeginForm("Registrar", "Asistencia", FormMethod.Post, new { id = "formAsistencia" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="grupo" value="@Model.IdGrupo" />
                    <input type="hidden" name="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" />

                    <div class="quick-actions">
                        <span>Acciones rápidas:</span>
                        <button type="button" id="btnTodosPresentes" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-check-all me-1"></i>
                            Marcar todos presentes
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table attendance-table align-middle">

                            <thead>
                                <tr>
                                    <th>Estudiante</th>
                                    <th>Estado</th>
                                    <th>Hora de llegada</th>
                                    <th>Observación</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (int i = 0; i < Model.Filas.Count; i++)
                                {
                                    var f = Model.Filas[i];
                                    var actual = string.IsNullOrEmpty(f.Estado) ? EstadosAsistencia.Presente : f.Estado;

                                    <tr data-fila>
                                        <td>
                                            <div class="student-info">
                                                <div class="student-avatar">@Iniciales(f.Estudiante)</div>
                                                <div><strong>@f.Estudiante</strong></div>
                                            </div>
                                            <input type="hidden" name="filas[@i].IdEstudiante" value="@f.IdEstudiante" />
                                        </td>

                                        <td>
                                            <select name="filas[@i].Estado" class="form-select status-select js-estado">
                                                @foreach (var e in EstadosAsistencia.Todos)
                                                {
                                                    <option value="@e" selected="@(e == actual ? "selected" : null)">@e</option>
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <input type="time" name="filas[@i].HoraLlegada"
                                                   class="form-control js-hora" value="@f.HoraLlegada" />
                                        </td>

                                        <td>
                                            <input type="text" name="filas[@i].Observacion" maxlength="500"
                                                   class="form-control js-obs" value="@f.Observacion"
                                                   placeholder="Observación opcional" />
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Asistencia")" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-cop-primary">
                            <i class="bi bi-save me-1"></i>
                            Guardar asistencia
                        </button>
                    </div>
                }
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .attendance-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .attendance-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .attendance-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .attendance-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .attendance-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .attendance-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            display: flex;
            gap: 20px;
            padding: 20px 22px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

        .filter-field {
            width: 230px;
        }

        .form-label {
            color: #344054;
            font-weight: 600;
            font-size: .85rem;
        }

        .quick-actions {
            padding: 14px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #edf0f3;
            font-size: .85rem;
            color: var(--cop-muted);
        }

        .attendance-table {
            margin: 0;
        }

            .attendance-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .attendance-table td {
                padding: 14px 17px;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: .8rem;
            font-weight: 600;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .status-select {
            min-width: 145px;
        }

        .form-actions {
            padding: 20px 22px;
            border-top: 1px solid #edf0f3;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        @@media(max-width:768px) {

            .filters {
                flex-direction: column;
            }

            .filter-field {
                width: 100%;
            }
        }
    </style>
}

@section scripts {
    <script>
                                    (function () {
                                        // Ausente y Justificado no llevan hora; Tardanza la necesita; Justificado pide observación.
                                        function ajustar(fila) {
                                            var estado = fila.querySelector('.js-estado').value;
                                            var hora = fila.querySelector('.js-hora');
                                            var obs = fila.querySelector('.js-obs');
                                            var sinHora = (estado === 'Ausente' || estado === 'Justificado');

                                            hora.disabled = sinHora;
                                            if (sinHora) hora.value = '';

                                            obs.placeholder = (estado === 'Justificado')
                                                ? 'Motivo de la justificación (obligatorio)'
                                                : 'Observación opcional';
                                        }

                                        document.querySelectorAll('tr[data-fila]').forEach(function (fila) {
                                            ajustar(fila);
                                            fila.querySelector('.js-estado').addEventListener('change', function () { ajustar(fila); });
                                        });

                                        var btn = document.getElementById('btnTodosPresentes');
                                        if (btn) {
                                            btn.addEventListener('click', function () {
                                                document.querySelectorAll('.js-estado').forEach(function (s) {
                                                    s.value = 'Presente';
                                                    s.dispatchEvent(new Event('change'));
                                                });
                                            });
                                        }
                                    })();
    </script>
}


