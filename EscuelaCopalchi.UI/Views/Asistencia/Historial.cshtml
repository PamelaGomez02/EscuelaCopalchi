@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaHistorialVM
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Historial de asistencia";
    var r = Model.Resumen ?? new ResumenAsistencia();
    bool unEstudiante = Model.IdEstudiante > 0;
}
@functions {
    static string Clase(string estado)
    {
        switch (estado)
        {
            case "Presente": return "status-present";
            case "Ausente": return "status-absent";
            case "Tardanza": return "status-late";
            default: return "status-justified";
        }
    }
}

<main>


    <section class="attendance-header">
        <div class="container">

            <div class="d-flex justify-content-between
                    align-items-center gap-3 flex-wrap">

                <div>
                    <h1 class="attendance-title mb-1">
                        <i class="bi bi-clock-history me-2"></i>
                        Historial de asistencia
                    </h1>

                    <p class="attendance-subtitle mb-0">
                        Consulta registros históricos y porcentajes de asistencia.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <a href="@Url.Action("Index", "Asistencia")"
                       class="btn btn-outline-secondary cop-back-btn">
                        <i class="bi bi-arrow-left me-1"></i>Atrás
                    </a>

                </div>

            </div>

        </div>
    </section>



    <section class="container pb-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }

        <div class="history-card">

            <div class="av-section-heading"><span class="av-heading-icon"><i class="bi bi-funnel"></i></span><div><h2>Filtros del historial</h2><p>Consulta los registros por grupo, estudiante o período.</p></div></div>
            <!-- FILTROS -->
            <form method="get" action="@Url.Action("Historial", "Asistencia")" class="filters">

                <div>
                    <small class="text-muted d-block">Grupo</small>
                    <select name="grupo" id="grupo" class="form-select">
                        <option value="">Seleccione un grupo</option>
                        @foreach (var g in Model.Grupos)
                        {
                            <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo ? "selected" : null)">
                                @g.Grupo (@g.Anio)
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <small class="text-muted d-block">Estudiante</small>
                    <select name="estudiante" id="estudiante" class="form-select">
                        <option value="">Todos los estudiantes</option>
                        @foreach (var e in Model.Estudiantes)
                        {
                            <option value="@e.IdEstudiante" selected="@(e.IdEstudiante == Model.IdEstudiante ? "selected" : null)">
                                @e.Estudiante
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <small class="text-muted d-block">Desde</small>
                    <input type="date" name="desde" class="form-control"
                           value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div>
                    <small class="text-muted d-block">Hasta</small>
                    <input type="date" name="hasta" class="form-control"
                           value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="d-flex align-items-end">
                    <button type="submit" class="btn btn-cop-primary">
                        <i class="bi bi-search me-1"></i>
                        Consultar
                    </button>
                </div>

            </form>


            @if (!Model.Consultado)
            {
                <p class="text-muted p-4 mb-0">
                    Seleccione un grupo (y, si desea, un estudiante y un rango de fechas) para ver el historial.
                </p>
            }
            else
            {
                <!-- RESUMEN -->
                <div class="student-summary">
                    <div>
                        <span>@(unEstudiante ? "Estudiante" : "Grupo")</span>
                        <strong>@(unEstudiante ? Model.NombreEstudiante : Model.NombreGrupo)</strong>
                    </div>
                    <div>
                        <span>Presentes</span>
                        <strong>@r.Presentes</strong>
                    </div>
                    <div>
                        <span>Ausencias</span>
                        <strong>@r.Ausentes</strong>
                    </div>
                    <div>
                        <span>Justificadas</span>
                        <strong>@r.Justificados</strong>
                    </div>
                    <div>
                        <span>Tardanzas</span>
                        <strong>@r.Tardanzas</strong>
                    </div>
                    <div class="percentage-box">
                        <span>Porcentaje</span>
                        <strong>@(r.Porcentaje.HasValue ? r.Porcentaje.Value.ToString("0.##") + "%" : "—")</strong>
                    </div>
                </div>

                if (Model.Truncado)
                {
                    <div class="alert alert-warning m-3 mb-0">
                        Se muestran los primeros @AsistenciaHistorialVM.MaxFilas de @Model.TotalFilas registros.
                        El resumen y el porcentaje consideran todos. Acote el rango de fechas para ver el resto.
                    </div>
                }

                if (!Model.Filas.Any())
                {
                    <p class="text-muted p-4 mb-0">No hay registros de asistencia con los filtros seleccionados.</p>
                }
                else
                {
                    <!-- TABLA -->
                    <div class="table-responsive">
                        <table class="table history-table align-middle">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    @if (!unEstudiante)
                                    {
                                        <th>Estudiante</th>
                                    }
                                    <th>Estado</th>
                                    <th>Hora</th>
                                    <th>Observación</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var f in Model.Filas)
                                {
                                    <tr>
                                        <td>@(f.Fecha.HasValue ? f.Fecha.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        @if (!unEstudiante)
                                        {
                                            <td>@f.Estudiante</td>
                                        }
                                        <td>
                                            <span class="status @Clase(f.Estado)">@f.Estado</span>
                                        </td>
                                        <td>@(string.IsNullOrEmpty(f.HoraLlegada) ? "—" : f.HoraLlegada)</td>
                                        <td>@(string.IsNullOrEmpty(f.Observacion) ? "—" : f.Observacion)</td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }


        /* ENCABEZADO IGUAL A GESTIÓN DE USUARIOS */

        .attendance-header {
            background: transparent;
            border: 0;
            box-shadow: none;
            padding: 0;
            margin: 14px 0 24px;
        }

            .attendance-header > .container {
                background: transparent;
                padding: 0 12px;
            }

        .attendance-title {
            font-size: 1.55rem;
            line-height: 1.3;
            margin: 0;
            color: #133C55;
            font-weight: 700;
        }

            .attendance-title i {
                color: #386FA4;
            }

        .attendance-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
            margin: 0;
        }

        /* BOTÓN ATRÁS */

        .attendance-header .btn {
            border-radius: 6px;
        }

        .cop-back-btn {
            font-weight: 600;
            padding: .55rem 1rem;
            white-space: nowrap;
            background: #fff;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        /* RESPONSIVO */

        @@media (max-width: 575px) {
            .attendance-title {
                font-size: 1.32rem;
            }
        }

        .history-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            padding: 18px;
            background: #f8fafc;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select,
            .filters .form-control {
                max-width: 200px;
            }

        .student-summary {
            padding: 20px;
            display: grid;
            grid-template-columns: 2fr repeat(5, 1fr);
            gap: 15px;
            border-bottom: 1px solid #edf0f3;
        }

            .student-summary span {
                display: block;
                color: var(--cop-muted);
                font-size: .77rem;
            }

            .student-summary strong {
                color: var(--cop-primary);
            }

        .percentage-box strong {
            font-size: 1.3rem;
            color: #198754;
        }

        .history-table {
            margin: 0;
        }

            .history-table th {
                background: #f8fafc;
                font-size: .8rem;
                text-transform: uppercase;
                color: #53616d;
                padding: 13px 17px;
            }

            .history-table td {
                padding: 15px 17px;
            }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-present {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-absent {
            background: #f8d7da;
            color: #842029;
        }

        .status-late {
            background: #fff3cd;
            color: #856404;
        }

        .status-justified {
            background: #cfe2ff;
            color: #084298;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

        @@media(max-width:992px) {

            .filters {
                flex-wrap: wrap;
            }

            .student-summary {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .attendance-card, .history-card, .edit-card, .summary-card {
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 3px 14px rgba(19,60,85,.04);
        }

        .btn-cop-primary {
            background: #133c55;
            border-color: #133c55;
            color: #fff;
            border-radius: 7px;
            font-weight: 600;
        }

            .btn-cop-primary:hover, .btn-cop-primary:focus {
                background: #386fa4;
                border-color: #386fa4;
                color: #fff;
            }

        .cop-back-button {
            border: 1px solid #ced4da;
            color: #475569;
            background: #fff;
            border-radius: 7px;
            font-weight: 500;
            padding: 9px 15px;
            text-decoration: none;
            white-space: nowrap;
        }

            .cop-back-button:hover {
                background: #f1f5f9;
                color: #133c55;
                border-color: #94a3b8;
            }

        .attendance-header-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #59a5d8;
            box-shadow: 0 0 0 .2rem rgba(56,111,164,.13);
        }

        @@media (max-width: 767px) {
            .attendance-header-actions {
                width: 100%;
            }

                .attendance-header-actions .btn, .attendance-header-actions .cop-back-button {
                    flex: 1;
                    text-align: center;
                }
        }


        /* ===== AULA VIRTUAL COPALCHÍ · SISTEMA VISUAL ASISTENCIA ===== */
        body {
            background: #f4f7fa;
        }

        .attendance-header {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 18px 0 25px !important;
        }

            .attendance-header > .container {
                background: transparent !important;
                padding-left: 12px;
                padding-right: 12px;
            }

        .attendance-title {
            font-size: 1.55rem !important;
            line-height: 1.3;
            color: #133c55 !important;
            font-weight: 750;
            margin: 0 0 5px !important;
            letter-spacing: -.025em;
        }

            .attendance-title i {
                color: #386fa4;
            }

        .attendance-subtitle {
            color: #64748b !important;
            font-size: .9rem !important;
            line-height: 1.6 !important;
            margin: 0 !important;
        }

        .attendance-header .btn {
            border-radius: 8px;
        }

        .cop-back-btn {
            background: #fff;
            border: 1px solid #cbd5e1;
            color: #475569;
            padding: .58rem 1rem;
            font-weight: 600;
            box-shadow: 0 1px 2px rgba(15,23,42,.03);
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386fa4;
                color: #133c55;
            }

        .btn-cop-primary {
            background: #133c55 !important;
            border: 1px solid #133c55 !important;
            color: #fff !important;
            border-radius: 8px !important;
            padding: .62rem 1rem;
            font-weight: 650 !important;
            box-shadow: 0 2px 5px rgba(19,60,85,.10);
        }

            .btn-cop-primary:hover, .btn-cop-primary:focus {
                background: #285b7c !important;
                border-color: #285b7c !important;
                color: #fff !important;
            }

        .attendance-card, .history-card, .edit-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 13px;
            box-shadow: 0 4px 18px rgba(19,60,85,.045);
            overflow: hidden;
        }

        .form-control, .form-select {
            min-height: 41px;
            border: 1px solid #d5dee8;
            border-radius: 8px;
            color: #334155;
            font-size: .9rem;
            background-color: #fff;
        }

            .form-control:focus, .form-select:focus {
                border-color: #386fa4;
                box-shadow: 0 0 0 .2rem rgba(56,111,164,.12);
            }

        .form-label, .filters label, .filters small {
            color: #475569 !important;
            font-size: .8rem !important;
            font-weight: 650;
            margin-bottom: 6px;
        }

        .filters {
            background: #fff !important;
            border-bottom: 1px solid #edf1f5 !important;
            padding: 22px 24px !important;
            gap: 16px !important;
            display: flex;
            flex-wrap: wrap;
            align-items: end;
        }

            .filters > div {
                min-width: 155px;
                flex: 1 1 165px;
            }

            .filters .form-control, .filters .form-select {
                max-width: none !important;
                width: 100%;
            }

            .filters .btn {
                white-space: nowrap;
            }

        .attendance-table, .history-table {
            margin: 0;
        }

            .attendance-table thead th, .history-table thead th {
                background: #f8fafc;
                color: #536579;
                font-size: .75rem;
                font-weight: 700;
                letter-spacing: .045em;
                text-transform: uppercase;
                border-bottom: 1px solid #e2e8f0;
                padding: 15px 17px;
                white-space: nowrap;
            }

            .attendance-table tbody td, .history-table tbody td {
                border-color: #edf1f5;
                padding: 15px 17px;
                vertical-align: middle;
            }

            .attendance-table tbody tr:hover, .history-table tbody tr:hover {
                background: #f8fbfe;
            }

        .summary-card {
            border: 1px solid #e2e8f0 !important;
            border-radius: 12px !important;
            background: #fff !important;
            box-shadow: 0 3px 12px rgba(19,60,85,.035) !important;
            min-height: 100px;
        }

            .summary-card h2 {
                font-weight: 750;
                letter-spacing: -.03em;
            }

        .student-avatar {
            flex-shrink: 0;
        }

        .status {
            white-space: nowrap;
        }

        .form-actions {
            background: #fff;
        }

        .av-section-heading {
            padding: 19px 24px 0;
            display: flex;
            align-items: flex-start;
            gap: 11px;
        }

            .av-section-heading .av-heading-icon {
                width: 35px;
                height: 35px;
                flex: 0 0 35px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                color: #386fa4;
                background: #eaf2f9;
                font-size: 1.05rem;
            }

            .av-section-heading h2 {
                font-size: 1rem;
                font-weight: 700;
                color: #133c55;
                margin: 0 0 3px;
            }

            .av-section-heading p {
                color: #64748b;
                font-size: .83rem;
                margin: 0;
                line-height: 1.5;
            }

        .av-empty-state {
            padding: 38px 22px;
            text-align: center;
            background: #fff;
        }

            .av-empty-state .av-empty-icon {
                width: 58px;
                height: 58px;
                border-radius: 16px;
                background: #edf4fa;
                color: #386fa4;
                display: grid;
                place-items: center;
                font-size: 1.6rem;
                margin: 0 auto 14px;
            }

            .av-empty-state h3 {
                color: #133c55;
                font-size: 1rem;
                font-weight: 700;
                margin: 0 0 6px;
            }

            .av-empty-state p {
                color: #64748b;
