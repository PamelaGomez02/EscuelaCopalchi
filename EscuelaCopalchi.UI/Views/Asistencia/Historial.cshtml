@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaHistorialVM
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Historial de asistencia";
    var r = Model.Resumen ?? new ResumenAsistencia();
    bool unEstudiante = Model.IdEstudiante > 0;
}
@functions {
    static string Clase(string estado)
    {
        switch (estado)
        {
            case "Presente": return "status-present";
            case "Ausente": return "status-absent";
            case "Tardanza": return "status-late";
            default: return "status-justified";
        }
    }
}

<main>

    <section class="attendance-header">
        <div class="container">

            <div class="attendance-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "Asistencia")">Asistencia</a>
                <i class="bi bi-chevron-right"></i>
                <span>Historial</span>
            </div>

            <h1 class="attendance-title">
                <i class="bi bi-clock-history me-2"></i>
                Historial de asistencia
            </h1>

            <p class="attendance-subtitle">
                Consulta registros históricos y porcentajes de asistencia.
            </p>
            <div class="attendance-header-actions mt-3">
                <a href="@Url.Action("Index", "Asistencia")" class="btn cop-back-button"><i class="bi bi-arrow-left me-1"></i> Atrás</a>
            </div>

        </div>
    </section>


    <section class="container pb-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }

        <div class="history-card">

            <!-- FILTROS -->
            <form method="get" action="@Url.Action("Historial", "Asistencia")" class="filters">

                <div>
                    <small class="text-muted d-block">Grupo</small>
                    <select name="grupo" id="grupo" class="form-select">
                        <option value="">Seleccione un grupo</option>
                        @foreach (var g in Model.Grupos)
                        {
                            <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo ? "selected" : null)">
                                @g.Grupo (@g.Anio)
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <small class="text-muted d-block">Estudiante</small>
                    <select name="estudiante" id="estudiante" class="form-select">
                        <option value="">Todos los estudiantes</option>
                        @foreach (var e in Model.Estudiantes)
                        {
                            <option value="@e.IdEstudiante" selected="@(e.IdEstudiante == Model.IdEstudiante ? "selected" : null)">
                                @e.Estudiante
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <small class="text-muted d-block">Desde</small>
                    <input type="date" name="desde" class="form-control"
                           value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div>
                    <small class="text-muted d-block">Hasta</small>
                    <input type="date" name="hasta" class="form-control"
                           value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="d-flex align-items-end">
                    <button type="submit" class="btn btn-cop-primary">
                        <i class="bi bi-search me-1"></i>
                        Consultar
                    </button>
                </div>

            </form>


            @if (!Model.Consultado)
            {
                <p class="text-muted p-4 mb-0">
                    Seleccione un grupo (y, si desea, un estudiante y un rango de fechas) para ver el historial.
                </p>
            }
            else
            {
                <!-- RESUMEN -->
                <div class="student-summary">
                    <div>
                        <span>@(unEstudiante ? "Estudiante" : "Grupo")</span>
                        <strong>@(unEstudiante ? Model.NombreEstudiante : Model.NombreGrupo)</strong>
                    </div>
                    <div>
                        <span>Presentes</span>
                        <strong>@r.Presentes</strong>
                    </div>
                    <div>
                        <span>Ausencias</span>
                        <strong>@r.Ausentes</strong>
                    </div>
                    <div>
                        <span>Justificadas</span>
                        <strong>@r.Justificados</strong>
                    </div>
                    <div>
                        <span>Tardanzas</span>
                        <strong>@r.Tardanzas</strong>
                    </div>
                    <div class="percentage-box">
                        <span>Porcentaje</span>
                        <strong>@(r.Porcentaje.HasValue ? r.Porcentaje.Value.ToString("0.##") + "%" : "—")</strong>
                    </div>
                </div>

                if (Model.Truncado)
                {
                    <div class="alert alert-warning m-3 mb-0">
                        Se muestran los primeros @AsistenciaHistorialVM.MaxFilas de @Model.TotalFilas registros.
                        El resumen y el porcentaje consideran todos. Acote el rango de fechas para ver el resto.
                    </div>
                }

                if (!Model.Filas.Any())
                {
                    <p class="text-muted p-4 mb-0">No hay registros de asistencia con los filtros seleccionados.</p>
                }
                else
                {
                    <!-- TABLA -->
                    <div class="table-responsive">
                        <table class="table history-table align-middle">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    @if (!unEstudiante)
                                    {
                                        <th>Estudiante</th>
                                    }
                                    <th>Estado</th>
                                    <th>Hora</th>
                                    <th>Observación</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var f in Model.Filas)
                                {
                                    <tr>
                                        <td>@(f.Fecha.HasValue ? f.Fecha.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        @if (!unEstudiante)
                                        {
                                            <td>@f.Estudiante</td>
                                        }
                                        <td>
                                            <span class="status @Clase(f.Estado)">@f.Estado</span>
                                        </td>
                                        <td>@(string.IsNullOrEmpty(f.HoraLlegada) ? "—" : f.HoraLlegada)</td>
                                        <td>@(string.IsNullOrEmpty(f.Observacion) ? "—" : f.Observacion)</td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .attendance-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .attendance-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--cop-muted);
            font-size: .85rem;
            margin-bottom: 12px;
        }

            .attendance-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .attendance-title {
            color: var(--cop-primary);
            font-weight: 700;
            font-size: 1.8rem;
        }

        .attendance-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .history-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            padding: 18px;
            background: #f8fafc;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select,
            .filters .form-control {
                max-width: 200px;
            }

        .student-summary {
            padding: 20px;
            display: grid;
            grid-template-columns: 2fr repeat(5, 1fr);
            gap: 15px;
            border-bottom: 1px solid #edf0f3;
        }

            .student-summary span {
                display: block;
                color: var(--cop-muted);
                font-size: .77rem;
            }

            .student-summary strong {
                color: var(--cop-primary);
            }

        .percentage-box strong {
            font-size: 1.3rem;
            color: #198754;
        }

        .history-table {
            margin: 0;
        }

            .history-table th {
                background: #f8fafc;
                font-size: .8rem;
                text-transform: uppercase;
                color: #53616d;
                padding: 13px 17px;
            }

            .history-table td {
                padding: 15px 17px;
            }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-present {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-absent {
            background: #f8d7da;
            color: #842029;
        }

        .status-late {
            background: #fff3cd;
            color: #856404;
        }
        .status-justified {
            background: #cfe2ff;
            color: #084298;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

        @@media(max-width:992px) {

            .filters {
                flex-wrap: wrap;
            }

            .student-summary {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Estilo unificado con Repositorio de Materiales */
        .attendance-header { background:#fff; border-bottom:1px solid #e3e8ee; padding:26px 0; margin-bottom:28px; }
        .attendance-title { color:#133c55; font-size:1.75rem; font-weight:700; margin-bottom:8px; }
        .attendance-subtitle { color:#64748b; line-height:1.55; }
        .attendance-card, .history-card, .edit-card, .summary-card { border:1px solid #e3e8ee; border-radius:10px; background:#fff; box-shadow:0 3px 14px rgba(19,60,85,.04); }
        .btn-cop-primary { background:#133c55; border-color:#133c55; color:#fff; border-radius:7px; font-weight:600; }
        .btn-cop-primary:hover, .btn-cop-primary:focus { background:#386fa4; border-color:#386fa4; color:#fff; }
        .cop-back-button { border:1px solid #ced4da; color:#475569; background:#fff; border-radius:7px; font-weight:500; padding:9px 15px; text-decoration:none; white-space:nowrap; }
        .cop-back-button:hover { background:#f1f5f9; color:#133c55; border-color:#94a3b8; }
        .attendance-header-actions { display:flex; align-items:center; flex-wrap:wrap; gap:10px; }
        .form-control:focus, .form-select:focus { border-color:#59a5d8; box-shadow:0 0 0 .2rem rgba(56,111,164,.13); }
        @@media (max-width: 767px) { .attendance-header-actions { width:100%; } .attendance-header-actions .btn, .attendance-header-actions .cop-back-button { flex:1; text-align:center; } }

    </style>

}