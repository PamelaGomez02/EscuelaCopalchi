                line-height: 1.6;
            }

        @@media (max-width: 767px) {
            .filters {
                padding: 17px !important;
                gap: 12px !important;
            }

                .filters > div {
                    flex: 1 1 100%;
                }

                .filters button {
                    width: 100%;
                }

            .av-section-heading {
                padding: 17px 17px 0;
            }

            .attendance-title {
                font-size: 1.32rem !important;
            }
        }

        .student-summary {
            background: #fff;
            gap: 12px !important;
            padding: 20px 24px !important;
        }

            .student-summary > div {
                background: #f8fafc;
                border: 1px solid #edf1f5;
                border-radius: 9px;
                padding: 12px;
                min-width: 0;
            }

            .student-summary strong {
                display: block;
                overflow-wrap: anywhere;
                font-size: 1.06rem;
            }

        .percentage-box {
            background: #eef6fd !important;
            border-color: #d8e8f7 !important;
        }

        @@media(max-width:992px) {
            .student-summary {
                grid-template-columns: repeat(2,minmax(0,1fr)) !important;
            }
        }
    </style>

}