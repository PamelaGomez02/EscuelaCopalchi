}

 .edit-card { max-width:830px!important; margin:0 auto; padding:27px!important; overflow:visible; } .student-card { background:#f4f8fc!important; border-color:#e1ebf3!important; border-radius:11px!important; padding:19px!important; } .student-card h2 { font-size:1.12rem!important; } .edit-card .form-label { font-size:.83rem; } .edit-card textarea { min-height:110px; } .form-actions { padding-top:22px; } @media(max-width:575px) { .edit-card { padding:18px!important; } .form-actions { flex-wrap:wrap; } }
    </style>

}
@section scripts {
    <script>
        (function () {
            var estado = document.getElementById('estado');
            var hora = document.getElementById('hora');
            var obs = document.getElementById('observacion');

            // Ausente y Justificado no llevan hora; Justificado exige el motivo.
            function ajustar() {
                var sinHora = (estado.value === 'Ausente' || estado.value === 'Justificado');
                hora.disabled = sinHora;
                if (sinHora) hora.value = '';

                obs.placeholder = (estado.value === 'Justificado')
                    ? 'Motivo de la justificación (obligatorio)'
                    : 'Ingrese una observación...';
            }

            estado.addEventListener('change', ajustar);
            ajustar();
        })();
    </script>
}