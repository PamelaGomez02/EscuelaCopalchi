@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaItem
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Editar asistencia";
    string fechaIso = Model.Fecha.HasValue ? Model.Fecha.Value.ToString("yyyy-MM-dd") : "";
}
@functions {
    static string Iniciales(string nombre)
    {
        var p = (nombre ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        return p.Length == 1 ? p[0].Substring(0, 1).ToUpper()
                             : (p[0].Substring(0, 1) + p[1].Substring(0, 1)).ToUpper();
    }
}

<main>


    <section class="attendance-header">
        <div class="container">

            <div class="d-flex justify-content-between
                    align-items-center gap-3 flex-wrap">

                <div>
                    <h1 class="attendance-title mb-1">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar asistencia
                    </h1>

                    <p class="attendance-subtitle mb-0">
                        Modifica el registro de asistencia seleccionado.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <a href="@Url.Action("Index", "Asistencia")"
                       class="btn btn-outline-secondary cop-back-btn">
                        <i class="bi bi-arrow-left me-1"></i>Atrás
                    </a>

                </div>

            </div>

        </div>
    </section>


    <section class="container pb-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }

        <div class="edit-card">

            <div class="student-card">

                <div class="student-avatar">@Iniciales(Model.Estudiante)</div>

                <div>
                    <span class="label">Estudiante</span>
                    <h2>@Model.Estudiante</h2>
                    <p>@Model.Grupo</p>
                </div>

            </div>


            @using (Html.BeginForm("Editar", "Asistencia", new { id = Model.IdAsistencia }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" value="@fechaIso" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="estado" id="estado" class="form-select">
                            @foreach (var e in EstadosAsistencia.Todos)
                            {
                                <option value="@e" selected="@(e == Model.Estado ? "selected" : null)">@e</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hora de llegada</label>
                        <input type="time" name="hora" id="hora" class="form-control"
                               value="@Model.HoraLlegada" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Observación</label>
                        <textarea name="observacion" id="observacion" class="form-control" rows="4"
                                  maxlength="500"
                                  placeholder="Ingrese una observación...">@Model.Observacion</textarea>
                    </div>

                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Index", "Asistencia", new { grupo = Model.IdGrupo, fecha = fechaIso })"
                       class="btn btn-light">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-cop-primary">
                        <i class="bi bi-save me-1"></i>
                        Guardar cambios
                    </button>
                </div>
            }

        </div>

    </section>

</main>

@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }


        /* ENCABEZADO IGUAL A GESTIÓN DE USUARIOS */

        .attendance-header {
            background: transparent;
            border: 0;
            box-shadow: none;
            padding: 0;
            margin: 14px 0 24px;
        }

            .attendance-header > .container {
                padding: 0 12px;
            }

        .attendance-title {
            font-size: 1.55rem;
            line-height: 1.3;
            margin: 0;
            color: #133C55;
            font-weight: 700;
        }

            .attendance-title i {
                color: #386FA4;
            }

        .attendance-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
            margin: 0;
        }

        /* BOTÓN ATRÁS */

        .attendance-header .btn {
            border-radius: 6px;
        }

        .cop-back-btn {
            font-weight: 600;
            padding: .55rem 1rem;
            white-space: nowrap;
            background: #fff;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        /* RESPONSIVO */

        @@media (max-width: 575px) {
            .attendance-title {
                font-size: 1.32rem;
            }
        }


        .attendance-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .attendance-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }



        .edit-card {
            max-width: 800px;
            margin: auto;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 25px;
        }

        .student-card {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #f8fafc;
            border: 1px solid #edf0f3;
            border-radius: 9px;
            padding: 16px;
            margin-bottom: 24px;
        }

        .student-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
        }

        .student-card .label {
            color: var(--cop-muted);
            font-size: .75rem;
        }

        .student-card h2 {
            font-size: 1rem;
            color: var(--cop-primary);
            margin: 2px 0;
        }

        .student-card p {
            margin: 0;
            color: var(--cop-muted);
            font-size: .85rem;
        }

        .form-label {
            font-size: .9rem;
            font-weight: 600;
            color: #344054;
        }

        .form-actions {
            border-top: 1px solid #edf0f3;
            margin-top: 24px;
            padding-top: 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

        /* Estilo unificado con Repositorio de Materiales */

        .attendance-card, .history-card, .edit-card, .summary-card { border:1px solid #e3e8ee; border-radius:10px; background:#fff; box-shadow:0 3px 14px rgba(19,60,85,.04); }
        .btn-cop-primary { background:#133c55; border-color:#133c55; color:#fff; border-radius:7px; font-weight:600; }
        .btn-cop-primary:hover, .btn-cop-primary:focus { background:#386fa4; border-color:#386fa4; color:#fff; }
        .cop-back-button { border:1px solid #ced4da; color:#475569; background:#fff; border-radius:7px; font-weight:500; padding:9px 15px; text-decoration:none; white-space:nowrap; }
        .cop-back-button:hover { background:#f1f5f9; color:#133c55; border-color:#94a3b8; }
        .attendance-header-actions { display:flex; align-items:center; flex-wrap:wrap; gap:10px; }
        .form-control:focus, .form-select:focus { border-color:#59a5d8; box-shadow:0 0 0 .2rem rgba(56,111,164,.13); }
        @@media (max-width: 767px) { .attendance-header-actions { width:100%; } .attendance-header-actions .btn, .attendance-header-actions .cop-back-button { flex:1; text-align:center; } }


