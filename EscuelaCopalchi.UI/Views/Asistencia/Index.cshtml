@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaIndexVM
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Asistencia";
    var r = Model.Resumen ?? new ResumenAsistencia();
}
@functions {
    static string Iniciales(string nombre)
    {
        var p = (nombre ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        return p.Length == 1 ? p[0].Substring(0, 1).ToUpper()
                             : (p[0].Substring(0, 1) + p[1].Substring(0, 1)).ToUpper();
    }
    static string Clase(string estado)
    {
        switch (estado)
        {
            case "Presente": return "status-present";
            case "Ausente": return "status-absent";
            case "Tardanza": return "status-late";
            default: return "status-justified";
        }
    }
    static string Icono(string estado)
    {
        switch (estado)
        {
            case "Presente": return "bi-check-circle";
            case "Ausente": return "bi-x-circle";
            case "Tardanza": return "bi-clock";
            default: return "bi-file-earmark-check";
        }
    }
}

<main>



    <section class="attendance-header">
        <div class="container">

            <div class="d-flex justify-content-between
                    align-items-center gap-3 flex-wrap">

                <div>
                    <h1 class="attendance-title mb-1">
                        <i class="bi bi-calendar-check me-2"></i>
                        Asistencia de alumnos
                    </h1>

                    <p class="attendance-subtitle mb-0">
                        Registra, consulta y administra la asistencia
                        de los estudiantes.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-outline-secondary cop-back-btn">
                        <i class="bi bi-arrow-left me-1"></i>Atrás
                    </a>

                    @if (ViewBag.PuedeRegistrarAsistencia == true)
                    {
                        <a href="@Url.Action("Registrar", "Asistencia")"
                           class="btn btn-cop-primary">
                            <i class="bi bi-plus-lg me-1"></i>
                            Registrar asistencia
                        </a>
                    }

                </div>

            </div>

        </div>
    </section>





    <section class="container pb-5">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-1"></i> @TempData["Exito"]
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            </div>
        }

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon present"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <span>Presentes</span>
                        <h2>@r.Presentes</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon absent"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <span>Ausentes</span>
                        <h2>@r.Ausentes</h2>
                        <small class="text-muted">@r.Justificados justificados</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon late"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <span>Tardanzas</span>
                        <h2>@r.Tardanzas</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon percentage"><i class="bi bi-percent"></i></div>
                    <div>
                        <span>Asistencia</span>
                        <h2>@(r.Porcentaje.HasValue ? r.Porcentaje.Value.ToString("0.##") + "%" : "—")</h2>
                    </div>
                </div>
            </div>

        </div>


        <div class="attendance-card">

            <div class="av-section-heading"><span class="av-heading-icon"><i class="bi bi-list-check"></i></span><div><h2>Consulta de asistencia</h2><p>Selecciona un grupo y una fecha para revisar los registros.</p></div></div>
            <div class="attendance-toolbar">
                <div class="d-flex gap-2">
                    @if (ViewBag.PuedeVerPorcentajeAsistencia == true)
                    {
                        <a href="@Url.Action("Porcentaje", "Asistencia")" class="btn btn-outline-cop">
                            <i class="bi bi-percent me-1"></i>
                            Ver porcentajes
                        </a>
                    }

                    @if (ViewBag.PuedeVerHistorialAsistencia == true)
                    {
                        <a href="@Url.Action("Historial", "Asistencia")" class="btn btn-outline-cop">
                            <i class="bi bi-clock-history me-1"></i>
                            Ver historial
                        </a>
                    }
                </div>
            </div>


            <!-- FILTROS -->
            <form method="get" action="@Url.Action("Index", "Asistencia")" class="filters">

                <select name="grupo" class="form-select">
                    <option value="">Seleccione un grupo</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo ? "selected" : null)">
                            @g.Grupo (@g.Anio)
                        </option>
                    }
                </select>

                <input type="date" name="fecha" class="form-control"
                       value="@Model.Fecha.ToString("yyyy-MM-dd")" />

                <button type="submit" class="btn btn-cop-primary">
                    <i class="bi bi-search me-1"></i>
                    Consultar
                </button>

            </form>


            <!-- TABLA -->
            @if (!Model.Consultado)
            {
                <div class="av-empty-state" role="status"><div class="av-empty-icon"><i class="bi bi-calendar2-check"></i></div><h3>Consulta la asistencia del grupo</h3><p>Selecciona un grupo y una fecha en los filtros para visualizar los registros de estudiantes.</p></div>
            }
            else if (!Model.Filas.Any())
            {
                <p class="text-muted p-4 mb-0">
                    No hay asistencia registrada para este grupo en esa fecha.
                    @if (ViewBag.PuedeRegistrarAsistencia == true)
                    {
                        <a href="@Url.Action("Registrar", "Asistencia", new { grupo = Model.IdGrupo, fecha = Model.Fecha.ToString("yyyy-MM-dd") })">Registrarla ahora</a>
                    }
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table attendance-table align-middle">

                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Estado</th>
                                <th>Hora</th>
                                <th>Observación</th>
                                @if (Model.PuedeEditar)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var f in Model.Filas)
                            {
                                <tr>
                                    <td>
                                        <div class="student-info">
                                            <div class="student-avatar">@Iniciales(f.Estudiante)</div>
                                            <div>
                                                <strong>@f.Estudiante</strong>
                                                <small>@Model.NombreGrupo</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status @Clase(f.Estado)">
                                            <i class="bi @Icono(f.Estado)"></i>
                                            @f.Estado
                                        </span>
                                    </td>

                                    <td>@(string.IsNullOrEmpty(f.HoraLlegada) ? "—" : f.HoraLlegada)</td>

                                    <td>
                                        @if (string.IsNullOrEmpty(f.Observacion))
                                        {
                                            <span class="text-muted">Sin observaciones</span>
                                        }
                                        else
                                        {
                                            @f.Observacion
                                        }
                                    </td>

                                    @if (Model.PuedeEditar)
                                    {
                                        <td class="text-end">
                                            <a href="@Url.Action("Editar", "Asistencia", new { id = f.IdAsistencia })"
                                               class="btn btn-action" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }



        /* ENCABEZADO IGUAL A GESTIÓN DE USUARIOS */

        .attendance-header {
            background: transparent;
            border: 0;
            box-shadow: none;
            padding: 0;
            margin: 14px 0 24px;
        }

            .attendance-header > .container {
                padding: 0 12px;
            }

        .attendance-title {
            font-size: 1.55rem;
            line-height: 1.3;
            margin: 0;
            color: #133C55;
            font-weight: 700;
        }

            .attendance-title i {
                color: #386FA4;
            }

        .attendance-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
            margin: 0;
        }

        /* BOTONES IGUALES A USUARIOS */

        .attendance-header .btn {
            border-radius: 6px;
        }

        .cop-back-btn {
            border-radius: 9px;
            font-weight: 600;
            padding: .55rem 1rem;
            white-space: nowrap;
            background: #fff;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        .attendance-header .btn-cop-primary {
            background: #133C55;
            border-color: #133C55;
            color: #fff;
        }

            .attendance-header .btn-cop-primary:hover {
                background: #386FA4;
                border-color: #386FA4;
                color: #fff;
            }

        /* RESPONSIVO IGUAL A USUARIOS */

        @@media (max-width: 575px) {
            .attendance-title {
                font-size: 1.32rem;
            }
        }


        .cop-back-button {
            border: 1px solid #ced4da;
            color: #475569;
            background: white;
            border-radius: 6px;
            padding: 7px 14px;
            font-size: .88rem;
            font-weight: 500;
            text-decoration: none;
            white-space: nowrap;
        }

            .cop-back-button:hover {
                background: #edf3f8;
                color: #133C55;
                border-color: #386FA4;
            }

       

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }

        /* Separación entre botones del encabezado */
        .attendance-header-actions {
            display: flex;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }

            /* Botón Atrás */
            .attendance-header-actions .cop-back-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #ced4da;
                color: #475569;
                background: white;
                border-radius: 7px;
                padding: 8px 15px;
                font-size: .88rem;
                font-weight: 500;
                white-space: nowrap;
            }

                /* Efecto del botón Atrás */
                .attendance-header-actions .cop-back-button:hover {
                    background: #edf3f8;
                    color: #133C55;
                    border-color: #386FA4;
                }

            /* Botón Registrar asistencia destacado */
            .attendance-header-actions .btn-cop-primary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                background: #133C55;
                color: white;
                border: 1px solid #133C55;
                border-radius: 8px;
                padding: 9px 18px;
                font-size: .9rem;
                font-weight: 700;
                letter-spacing: .2px;
                white-space: nowrap;
            }

                /* Efecto del botón Registrar asistencia */
                .attendance-header-actions .btn-cop-primary:hover {
                    background: #386FA4;
                    border-color: #386FA4;
                    color: white;
                }

        /* Adaptación a pantallas pequeñas */
        @@media (max-width: 576px) {
            .attendance-header-actions {
                gap: 16px;
            }

                .attendance-header-actions .btn-cop-primary {
                    padding: 8px 14px;
                    font-size: .85rem;
                }

                .attendance-header-actions .cop-back-button {
                    padding: 8px 15px;
                    font-size: .85rem;
                }
        }

            .summary-icon.present {
                background: #d1e7dd;
                color: #0f5132;
            }

            .summary-icon.absent {
                background: #f8d7da;
                color: #842029;
            }

            .summary-icon.late {
                background: #fff3cd;
                color: #856404;
            }

            .summary-icon.percentage {
                background: #e6f1fb;
                color: var(--cop-secondary);
            }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.4rem;
        }

        .attendance-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .attendance-toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .attendance-toolbar h2 {
                font-size: 1.15rem;
                color: var(--cop-primary);
                margin-bottom: 4px;
            }

            .attendance-toolbar p {
                margin: 0;
                color: var(--cop-muted);
                font-size: .85rem;
            }

        .filters {
            display: flex;
            gap: 12px;
            padding: 15px 22px;
            background: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select,
            .filters .form-control {
                max-width: 230px;
            }

        .attendance-table {
            margin-bottom: 0;
        }

            .attendance-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .attendance-table td {
                padding: 16px 17px;
                font-size: .9rem;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            font-size: .8rem;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-present {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-absent {
            background: #f8d7da;
            color: #842029;
        }

        .status-late {
            background: #fff3cd;
            color: #856404;
        }
        .status-justified {
            background: #cfe2ff;
            color: #084298;
        }

        .btn-action {
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            background: white;
            padding: 5px 9px;
        }

        @@media(max-width:768px) {

            .filters,
            .attendance-toolbar {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

                .filters .form-select,
                .filters .form-control {
                    max-width: none;
                }
        }

        

        .attendance-card, .history-card, .edit-card, .summary-card { border:1px solid #e3e8ee; border-radius:10px; background:#fff; box-shadow:0 3px 14px rgba(19,60,85,.04); }
        .btn-cop-primary { background:#133c55; border-color:#133c55; color:#fff; border-radius:7px; font-weight:600; }
        .btn-cop-primary:hover, .btn-cop-primary:focus { background:#386fa4; border-color:#386fa4; color:#fff; }
        .cop-back-button { border:1px solid #ced4da; color:#475569; background:#fff; border-radius:7px; font-weight:500; padding:9px 15px; text-decoration:none; white-space:nowrap; }
        .cop-back-button:hover { background:#f1f5f9; color:#133c55; border-color:#94a3b8; }
        .attendance-header-actions { display:flex; align-items:center; flex-wrap:wrap; gap:10px; }
        .form-control:focus, .form-select:focus { border-color:#59a5d8; box-shadow:0 0 0 .2rem rgba(56,111,164,.13); }
        @@media (max-width: 767px) { .attendance-header-actions { width:100%; } .attendance-header-actions .btn, .attendance-header-actions .cop-back-button { flex:1; text-align:center; } }

    
/* ===== AULA VIRTUAL COPALCHÍ · SISTEMA VISUAL ASISTENCIA ===== */
body { background:#f4f7fa; }
.attendance-header { background:transparent!important; border:0!important; box-shadow:none!important; padding:0!important; margin:18px 0 25px!important; }
.attendance-header > .container { background:transparent!important; padding-left:12px; padding-right:12px; }
.attendance-title { font-size:1.55rem!important; line-height:1.3; color:#133c55!important; font-weight:750; margin:0 0 5px!important; letter-spacing:-.025em; }
.attendance-title i { color:#386fa4; }
.attendance-subtitle { color:#64748b!important; font-size:.9rem!important; line-height:1.6!important; margin:0!important; }
.attendance-header .btn { border-radius:8px; }
.cop-back-btn { background:#fff; border:1px solid #cbd5e1; color:#475569; padding:.58rem 1rem; font-weight:600; box-shadow:0 1px 2px rgba(15,23,42,.03); }
.cop-back-btn:hover { background:#edf3f8; border-color:#386fa4; color:#133c55; }
.btn-cop-primary { background:#133c55!important; border:1px solid #133c55!important; color:#fff!important; border-radius:8px!important; padding:.62rem 1rem; font-weight:650!important; box-shadow:0 2px 5px rgba(19,60,85,.10); }
.btn-cop-primary:hover,.btn-cop-primary:focus { background:#285b7c!important; border-color:#285b7c!important; color:#fff!important; }
.attendance-card,.history-card,.edit-card { background:#fff; border:1px solid #e2e8f0; border-radius:13px; box-shadow:0 4px 18px rgba(19,60,85,.045); overflow:hidden; }
.form-control,.form-select { min-height:41px; border:1px solid #d5dee8; border-radius:8px; color:#334155; font-size:.9rem; background-color:#fff; }
.form-control:focus,.form-select:focus { border-color:#386fa4; box-shadow:0 0 0 .2rem rgba(56,111,164,.12); }
.form-label,.filters label,.filters small { color:#475569!important; font-size:.8rem!important; font-weight:650; margin-bottom:6px; }
.filters { background:#fff!important; border-bottom:1px solid #edf1f5!important; padding:22px 24px!important; gap:16px!important; display:flex; flex-wrap:wrap; align-items:end; }
.filters > div { min-width:155px; flex:1 1 165px; }
.filters .form-control,.filters .form-select { max-width:none!important; width:100%; }
.filters .btn { white-space:nowrap; }
.attendance-table,.history-table { margin:0; }
.attendance-table thead th,.history-table thead th { background:#f8fafc; color:#536579; font-size:.75rem; font-weight:700; letter-spacing:.045em; text-transform:uppercase; border-bottom:1px solid #e2e8f0; padding:15px 17px; white-space:nowrap; }
.attendance-table tbody td,.history-table tbody td { border-color:#edf1f5; padding:15px 17px; vertical-align:middle; }
.attendance-table tbody tr:hover,.history-table tbody tr:hover { background:#f8fbfe; }
.summary-card { border:1px solid #e2e8f0!important; border-radius:12px!important; background:#fff!important; box-shadow:0 3px 12px rgba(19,60,85,.035)!important; min-height:100px; }
.summary-card h2 { font-weight:750; letter-spacing:-.03em; }
.student-avatar { flex-shrink:0; }
.status { white-space:nowrap; }
.form-actions { background:#fff; }
.av-section-heading { padding:19px 24px 0; display:flex; align-items:flex-start; gap:11px; }
.av-section-heading .av-heading-icon { width:35px; height:35px; flex:0 0 35px; display:grid; place-items:center; border-radius:9px; color:#386fa4; background:#eaf2f9; font-size:1.05rem; }
.av-section-heading h2 { font-size:1rem; font-weight:700; color:#133c55; margin:0 0 3px; }
.av-section-heading p { color:#64748b; font-size:.83rem; margin:0; line-height:1.5; }
.av-empty-state { padding:38px 22px; text-align:center; background:#fff; }
.av-empty-state .av-empty-icon { width:58px; height:58px; border-radius:16px; background:#edf4fa; color:#386fa4; display:grid; place-items:center; font-size:1.6rem; margin:0 auto 14px; }
.av-empty-state h3 { color:#133c55; font-size:1rem; font-weight:700; margin:0 0 6px; }
.av-empty-state p { color:#64748b; font-size:.88rem; max-width:480px; margin:0 auto; line-height:1.6; }
        @@media (max-width: 767px) {
            .filters {
                padding: 17px !important;
                gap: 12px !important;
            }

                .filters > div {
                    flex: 1 1 100%;
                }

                .filters button {
                    width: 100%;
                }

            .av-section-heading {
                padding: 17px 17px 0;
            }

            .attendance-title {
                font-size: 1.32rem !important;
            }
        }

 .attendance-toolbar { padding:18px 22px!important; background:#fff; } .attendance-toolbar .btn { border-radius:8px; font-weight:600; } .attendance-card .filters { background:#f8fafc!important; } .summary-card .summary-icon { flex-shrink:0; } .btn-action { border-radius:7px; } 
</style>

}