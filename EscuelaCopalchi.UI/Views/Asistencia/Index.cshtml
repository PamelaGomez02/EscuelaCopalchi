@model EscuelaCopalchi.UI.Models.GestionAsistencia.AsistenciaIndexVM
@using EscuelaCopalchi.UI.Models.GestionAsistencia
@{
    ViewBag.Title = "Asistencia";
    var r = Model.Resumen ?? new ResumenAsistencia();
}
@functions {
    static string Iniciales(string nombre)
    {
        var p = (nombre ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        return p.Length == 1 ? p[0].Substring(0, 1).ToUpper()
                             : (p[0].Substring(0, 1) + p[1].Substring(0, 1)).ToUpper();
    }
    static string Clase(string estado)
    {
        switch (estado)
        {
            case "Presente": return "status-present";
            case "Ausente": return "status-absent";
            case "Tardanza": return "status-late";
            default: return "status-justified";
        }
    }
    static string Icono(string estado)
    {
        switch (estado)
        {
            case "Presente": return "bi-check-circle";
            case "Ausente": return "bi-x-circle";
            case "Tardanza": return "bi-clock";
            default: return "bi-file-earmark-check";
        }
    }
}

<main>

    <section class="attendance-header">
        <div class="container">

            <div class="attendance-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Asistencia</span>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="attendance-title">
                        <i class="bi bi-calendar-check me-2"></i>
                        Asistencia de alumnos
                    </h1>
                    <p class="attendance-subtitle">
                        Registra, consulta y administra la asistencia de los estudiantes.
                    </p>
                </div>

                @if (ViewBag.PuedeRegistrarAsistencia == true)
                {
                    <a href="@Url.Action("Registrar", "Asistencia")" class="btn btn-cop-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Registrar asistencia
                    </a>
                }
            </div>

        </div>
    </section>


    <section class="container pb-5">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-1"></i> @TempData["Exito"]
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            </div>
        }

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon present"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <span>Presentes</span>
                        <h2>@r.Presentes</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon absent"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <span>Ausentes</span>
                        <h2>@r.Ausentes</h2>
                        <small class="text-muted">@r.Justificados justificados</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon late"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <span>Tardanzas</span>
                        <h2>@r.Tardanzas</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon percentage"><i class="bi bi-percent"></i></div>
                    <div>
                        <span>Asistencia</span>
                        <h2>@(r.Porcentaje.HasValue ? r.Porcentaje.Value.ToString("0.##") + "%" : "—")</h2>
                    </div>
                </div>
            </div>

        </div>


        <div class="attendance-card">

            <div class="attendance-toolbar">
                <div class="d-flex gap-2">
                    @if (ViewBag.PuedeVerPorcentajeAsistencia == true)
                    {
                    <a href="@Url.Action("Porcentaje", "Asistencia")" class="btn btn-outline-cop">
                        <i class="bi bi-percent me-1"></i>
                        Ver porcentajes
                    </a>
                    }

                    @if (ViewBag.PuedeVerHistorialAsistencia == true)
                    {
                    <a href="@Url.Action("Historial", "Asistencia")" class="btn btn-outline-cop">
                        <i class="bi bi-clock-history me-1"></i>
                        Ver historial
                    </a>
                    }
                </div>
            </div>


            <!-- FILTROS -->
            <form method="get" action="@Url.Action("Index", "Asistencia")" class="filters">

                <select name="grupo" class="form-select">
                    <option value="">Seleccione un grupo</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo ? "selected" : null)">
                            @g.Grupo (@g.Anio)
                        </option>
                    }
                </select>

                <input type="date" name="fecha" class="form-control"
                       value="@Model.Fecha.ToString("yyyy-MM-dd")" />

                <button type="submit" class="btn btn-cop-primary">
                    <i class="bi bi-search me-1"></i>
                    Consultar
                </button>

            </form>


            <!-- TABLA -->
            @if (!Model.Consultado)
            {
                <p class="text-muted p-4 mb-0">Seleccione un grupo y una fecha para consultar la asistencia.</p>
            }
            else if (!Model.Filas.Any())
            {
                <p class="text-muted p-4 mb-0">
                    No hay asistencia registrada para este grupo en esa fecha.
                    @if (ViewBag.PuedeRegistrarAsistencia == true)
                    {
                        <a href="@Url.Action("Registrar", "Asistencia", new { grupo = Model.IdGrupo, fecha = Model.Fecha.ToString("yyyy-MM-dd") })">Registrarla ahora</a>
                    }
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table attendance-table align-middle">

                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Estado</th>
                                <th>Hora</th>
                                <th>Observación</th>
                                @if (Model.PuedeEditar)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var f in Model.Filas)
                            {
                                <tr>
                                    <td>
                                        <div class="student-info">
                                            <div class="student-avatar">@Iniciales(f.Estudiante)</div>
                                            <div>
                                                <strong>@f.Estudiante</strong>
                                                <small>@Model.NombreGrupo</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status @Clase(f.Estado)">
                                            <i class="bi @Icono(f.Estado)"></i>
                                            @f.Estado
                                        </span>
                                    </td>

                                    <td>@(string.IsNullOrEmpty(f.HoraLlegada) ? "—" : f.HoraLlegada)</td>

                                    <td>
                                        @if (string.IsNullOrEmpty(f.Observacion))
                                        {
                                            <span class="text-muted">Sin observaciones</span>
                                        }
                                        else
                                        {
                                            @f.Observacion
                                        }
                                    </td>

                                    @if (Model.PuedeEditar)
                                    {
                                        <td class="text-end">
                                            <a href="@Url.Action("Editar", "Asistencia", new { id = f.IdAsistencia })"
                                               class="btn btn-action" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .attendance-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .attendance-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 12px;
            font-size: .85rem;
            color: var(--cop-muted);
        }

            .attendance-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .attendance-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .attendance-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
        }

            .summary-icon.present {
                background: #d1e7dd;
                color: #0f5132;
            }

            .summary-icon.absent {
                background: #f8d7da;
                color: #842029;
            }

            .summary-icon.late {
                background: #fff3cd;
                color: #856404;
            }

            .summary-icon.percentage {
                background: #e6f1fb;
                color: var(--cop-secondary);
            }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.4rem;
        }

        .attendance-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .attendance-toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .attendance-toolbar h2 {
                font-size: 1.15rem;
                color: var(--cop-primary);
                margin-bottom: 4px;
            }

            .attendance-toolbar p {
                margin: 0;
                color: var(--cop-muted);
                font-size: .85rem;
            }

        .filters {
            display: flex;
            gap: 12px;
            padding: 15px 22px;
            background: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select,
            .filters .form-control {
                max-width: 230px;
            }

        .attendance-table {
            margin-bottom: 0;
        }

            .attendance-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .attendance-table td {
                padding: 16px 17px;
                font-size: .9rem;
            }

        .student-info {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #e6f1fb;
            color: var(--cop-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            font-size: .8rem;
        }

        .student-info strong,
        .student-info small {
            display: block;
        }

        .student-info small {
            color: var(--cop-muted);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }

        .status-present {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-absent {
            background: #f8d7da;
            color: #842029;
        }

        .status-late {
            background: #fff3cd;
            color: #856404;
        }
        .status-justified {
            background: #cfe2ff;
            color: #084298;
        }

        .btn-action {
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            background: white;
            padding: 5px 9px;
        }

        @@media(max-width:768px) {

            .filters,
            .attendance-toolbar {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

                .filters .form-select,
                .filters .form-control {
                    max-width: none;
                }
        }
    </style>

}