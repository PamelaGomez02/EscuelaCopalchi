@model EscuelaCopalchi.UI.Models.Usuarios.Usuario
@{
    ViewBag.Title = "Editar usuario";
}

<main>
    <div class="cop-page-header">
        <div>
            <h2 class="cop-page-title">Editar usuario</h2>
            <p class="cop-page-subtitle">Actualiza la información de @Model.Nombre @Model.Apellido1.</p>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@Html.Raw(ViewBag.Error)</div>
    }

    <div class="cop-form-card">
        @using (Html.BeginForm("Editar", "Usuarios", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.IdUsuario)

            <div class="d-flex justify-content-between align-items-center mb-4 cop-status-row">
                <div>
                    <span class="fw-semibold">Estado de la cuenta</span>
                    <p class="cop-page-subtitle mb-0">Este cambio también se puede hacer desde el listado.</p>
                </div>
                <span class="status @(Model.Estado ? "status-ok" : "status-inactive")">
                    @(Model.Estado ? "Activo" : "Inactivo")
                </span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input type="text" name="Nombre" class="form-control" value="@Model.Nombre">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Primer apellido</label>
                    <input type="text" name="Apellido1" class="form-control" value="@Model.Apellido1">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Segundo apellido</label>
                    <input type="text" name="Apellido2" class="form-control" value="@Model.Apellido2">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Identificación</label>
                    <input type="text" name="Identificacion" class="form-control" value="@Model.Identificacion">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Correo institucional</label>
                    <input type="email" name="Correo" class="form-control" value="@Model.Correo">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input type="tel" name="Telefono" class="form-control" value="@Model.Telefono">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Rol</label>
                    <select name="IdRol" class="form-select">
                        @foreach (var rol in ViewBag.Roles as List<EscuelaCopalchi.UI.Models.Usuarios.RolDropdownItem>)
                        {
                            if (rol.IdRol == Model.IdRol)
                            {
                                <option value="@rol.IdRol" selected>@rol.Nombre</option>
                            }
                            else
                            {
                                <option value="@rol.IdRol">@rol.Nombre</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn cop-btn-primary">Guardar cambios</button>
            </div>
        }
    </div>
</main>

@section styles {
    <style>
        .cop-page-header {
            margin: 28px 0 20px;
        }

        .cop-page-title {
            font-weight: 700;
            color: #133C55;
            margin-bottom: 2px;
        }

        .cop-page-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }

        .cop-form-card {
            background-color: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 28px 26px;
            margin-bottom: 40px;
        }

            .cop-form-card .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #133C55;
            }

            .cop-form-card .form-control, .cop-form-card .form-select {
                border-radius: 8px;
                border: 1px solid #dfe4ea;
            }

                .cop-form-card .form-control:focus, .cop-form-card .form-select:focus {
                    border-color: #59A5D8;
                    box-shadow: 0 0 0 3px rgba(89, 165, 216, 0.2);
                }

        .cop-status-row {
            background-color: #F4F7FA;
            border-radius: 8px;
            padding: 14px 18px;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-inactive {
            background: #f8d7da;
            color: #842029;
        }

        .cop-btn-primary {
            background-color: #133C55;
            border-color: #133C55;
            color: #fff;
            font-weight: 600;
        }

            .cop-btn-primary:hover {
                background-color: #386FA4;
                border-color: #386FA4;
                color: #fff;
            }
    </style>
}
