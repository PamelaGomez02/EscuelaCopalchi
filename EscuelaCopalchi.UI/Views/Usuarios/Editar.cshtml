@{
    ViewBag.Title = "Editar usuario";
}

<main>
    <div class="cop-page-header">
        <div>
            <h2 class="cop-page-title">Editar usuario</h2>
            <p class="cop-page-subtitle">Actualiza la información de María Rodríguez.</p>
        </div>
    </div>

    <div class="cop-form-card">
        <form method="post">
            <div class="d-flex justify-content-between align-items-center mb-4 cop-status-row">
                <div>
                    <span class="fw-semibold">Estado de la cuenta</span>
                    <p class="cop-page-subtitle mb-0">Los usuarios inactivos no pueden iniciar sesión.</p>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="EstadoActivo" checked>
                    <label class="form-check-label" for="EstadoActivo">Activo</label>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombres</label>
                    <input type="text" class="form-control" value="María Fernanda">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <input type="text" class="form-control" value="Rodríguez Solano">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Identificación</label>
                    <input type="text" class="form-control" value="1-1111-1111">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Correo institucional</label>
                    <input type="email" class="form-control" value="maria.rodriguez@copalchi.edu">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input type="tel" class="form-control" value="8888-8888">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Rol</label>
                    <select class="form-select">
                        <option selected>Docente</option>
                        <option>Director</option>
                        <option>Administrador</option>
                        <option>Administrativo</option>
                        <option>Comité de apoyo</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Área académica / especialidad</label>
                    <input type="text" class="form-control" value="Matemática">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de ingreso</label>
                    <input type="date" class="form-control" value="2022-02-01">
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-end gap-2">
                <a href="#" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn cop-btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</main>

@section styles {
    <style>
        .cop-page-header {
            margin: 28px 0 20px;
        }

        .cop-page-title {
            font-weight: 700;
            color: #133C55;
            margin-bottom: 2px;
        }

        .cop-page-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }

        .cop-form-card {
            background-color: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 28px 26px;
            margin-bottom: 40px;
        }

            .cop-form-card .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #133C55;
            }

            .cop-form-card .form-control, .cop-form-card .form-select {
                border-radius: 8px;
                border: 1px solid #dfe4ea;
            }

                .cop-form-card .form-control:focus, .cop-form-card .form-select:focus {
                    border-color: #59A5D8;
                    box-shadow: 0 0 0 3px rgba(89, 165, 216, 0.2);
                }

        .cop-status-row {
            background-color: #F4F7FA;
            border-radius: 8px;
            padding: 14px 18px;
        }

        .cop-btn-primary {
            background-color: #133C55;
            border-color: #133C55;
            color: #fff;
            font-weight: 600;
        }

            .cop-btn-primary:hover {
                background-color: #386FA4;
                border-color: #386FA4;
                color: #fff;
            }
    </style>
}