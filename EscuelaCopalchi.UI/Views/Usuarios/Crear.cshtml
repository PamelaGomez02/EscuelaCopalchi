@model EscuelaCopalchi.UI.Models.Usuarios.Usuario
@{
    ViewBag.Title = "Nuevo usuario";
}

<main>
    <div class="cop-page-header">
        <div>
            <h2 class="cop-page-title">Nuevo usuario</h2>
            <p class="cop-page-subtitle">Registra los datos personales y de acceso del docente o personal.</p>
        </div>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@Html.Raw(ViewBag.Error)</div>
    }

<div class="cop-form-card">
    @using (Html.BeginForm("Registrar", "Usuarios", FormMethod.Post))
    {

        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" class="form-control" placeholder="Ej. María Fernanda"
                       value="@(Model?.Nombre)" data-solo-letras required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Primer apellido</label>
                <input type="text" name="Apellido1" class="form-control" placeholder="Ej. Rodríguez"
                       value="@(Model?.Apellido1)" data-solo-letras required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Segundo apellido</label>
                <input type="text" name="Apellido2" class="form-control" placeholder="Ej. Solano"
                       value="@(Model?.Apellido2)" data-solo-letras>
            </div>

            <div class="col-md-4">
                <label class="form-label">Identificación</label>
                <input type="text" name="Identificacion" class="form-control" placeholder="1-1111-1111"
                       value="@(Model?.Identificacion)" data-formato="cedula" maxlength="11" inputmode="numeric" required>
                <div class="form-text" id="ayudaIdentificacion">Solo números. Formato: 1-1111-1111</div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="EsExtranjero">
                    <label class="form-check-label" for="EsExtranjero">Es extranjero (DIMEX)</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <input type="text" name="Telefono" class="form-control" placeholder="8888-8888"
                       value="@(Model?.Telefono)" data-formato="telefono" maxlength="9" inputmode="numeric">
                <div class="form-text">Solo números. Formato: 8888-8888</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Correo institucional</label>
                <input type="email" name="Correo" class="form-control" placeholder="nombre@copalchi.edu"
                       value="@(Model?.Correo)" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Contraseña</label>
                <div class="input-group">
                    <input type="password" id="Contrasena" name="Contrasena" class="form-control"
                           placeholder="Mínimo 8 caracteres" minlength="8" required>
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="Contrasena" title="Mostrar u ocultar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Rol</label>
                <select name="IdRol" class="form-select" required>
                    <option value="" disabled @(Model == null || Model.IdRol == 0 ? "selected" : "")>Selecciona un rol</option>
                    @foreach (var rol in ViewBag.Roles as List<EscuelaCopalchi.UI.Models.Usuarios.RolDropdownItem>)
                    {
                        <option value="@rol.IdRol" @(Model != null && Model.IdRol == rol.IdRol ? "selected" : "")>@rol.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Confirmar contraseña</label>
                <div class="input-group">
                    <input type="password" id="ConfirmarContrasena" name="ConfirmarContrasena" class="form-control"
                           placeholder="Repite la contraseña" required>
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="ConfirmarContrasena" title="Mostrar u ocultar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div id="avisoConfirmacion" class="text-danger small mt-1" style="display:none;">Las contraseñas no coinciden.</div>
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="Estado" value="true" @(Model == null || Model.Estado ? "checked" : "")>
                    <label class="form-check-label">Usuario activo</label>
                </div>
            </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end gap-2">
            <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn cop-btn-primary">Guardar usuario</button>
        </div>
    }
</div>
</main>

@section scripts {
    <script src="~/Scripts/usuarios-validaciones.js"></script>
}

@section styles {
    <style>
        .cop-page-header {
            margin: 28px 0 20px;
        }

        .cop-page-title {
            font-weight: 700;
            color: #133C55;
            margin-bottom: 2px;
        }

        .cop-page-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }

        .cop-form-card {
            background-color: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 28px 26px;
            margin-bottom: 40px;
        }

            .cop-form-card .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #133C55;
            }

            .cop-form-card .form-control,
            .cop-form-card .form-select {
                border-radius: 8px;
                border: 1px solid #dfe4ea;
            }

                .cop-form-card .form-control:focus,
                .cop-form-card .form-select:focus {
                    border-color: #59A5D8;
                    box-shadow: 0 0 0 3px rgba(89, 165, 216, 0.2);
                }

            .cop-form-card .input-group .btn {
                border: 1px solid #dfe4ea;
                border-radius: 0 8px 8px 0;
                color: #386FA4;
            }

        .cop-btn-primary {
            background-color: #133C55;
            border-color: #133C55;
            color: #fff;
            font-weight: 600;
        }

            .cop-btn-primary:hover {
                background-color: #386FA4;
                border-color: #386FA4;
                color: #fff;
            }
    </style>
}
