@model List<EscuelaCopalchi.UI.Models.Usuarios.Usuario>
@using System
@using System.Linq
@{
    ViewBag.Title = "Usuarios";
    const int tamanoPagina = 10;
    int paginaSolicitada;
    if (!int.TryParse(Request.QueryString["pagina"], out paginaSolicitada))
    {
        paginaSolicitada = 1;
    }
    int totalUsuarios = Model.Count;
    int totalPaginas = Math.Max(1, (int)Math.Ceiling(totalUsuarios / (double)tamanoPagina));
    int pagina = Math.Min(Math.Max(1, paginaSolicitada), totalPaginas);
    int inicio = totalUsuarios == 0 ? 0 : (pagina - 1) * tamanoPagina + 1;
    int fin = Math.Min(pagina * tamanoPagina, totalUsuarios);
    var usuariosPagina = Model.Skip((pagina - 1) * tamanoPagina).Take(tamanoPagina).ToList();
    int paginaInicial = Math.Max(1, pagina - 2);
    int paginaFinal = Math.Min(totalPaginas, paginaInicial + 4);
    paginaInicial = Math.Max(1, paginaFinal - 4);
    string busqueda = Convert.ToString(ViewBag.Busqueda ?? Request.QueryString["busqueda"] ?? "");
}

<main>
    <section class="usuarios-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <h1 class="usuarios-title mb-1">
                        <i class="bi bi-people me-2"></i>Gestión de usuarios
                    </h1>
                    <p class="usuarios-subtitle mb-0">
                        Administra los usuarios, roles y estados de acceso al sistema.
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn">
                        <i class="bi bi-arrow-left me-1"></i>Atrás
                    </a>
                    <a href="@Url.Action("Registrar", "Usuarios")" class="btn btn-cop-primary">
                        <i class="bi bi-person-plus me-1"></i>Nuevo usuario
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon"><i class="bi bi-people"></i></div>
                    <div><span>Usuarios registrados</span><h2>@Model.Count</h2></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon summary-icon-success"><i class="bi bi-person-check"></i></div>
                    <div><span>Usuarios activos</span><h2>@Model.Count(x => x.Estado)</h2></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-card">
                    <div class="summary-icon summary-icon-warning"><i class="bi bi-person-x"></i></div>
                    <div><span>Usuarios inactivos</span><h2>@Model.Count(x => !x.Estado)</h2></div>
                </div>
            </div>
        </div>

        <div class="usuarios-card">
            <div class="usuarios-toolbar">
                <div>
                    <h2>Usuarios del sistema</h2>
                    <p>Consulta y administra los usuarios registrados.</p>
                </div>
                @using (Html.BeginForm("Index", "Usuarios", FormMethod.Get))
                {
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar usuario...">
                    </div>
                }
            </div>


            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }


            <div class="table-responsive">
                <table class="table usuarios-table align-middle">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Correo electrónico</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in usuariosPagina)
                        {
                            <tr>
                                <td>
                                    <div class="usuario-info">
                                        <div class="usuario-avatar"><i class="bi bi-person"></i></div>
                                        <div>
                                            <strong>@u.Nombre @u.Apellido1</strong>
                                            <small>@u.Identificacion</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@u.Correo</td>
                                <td><span class="role-badge">@u.NombreRol</span></td>
                                <td>
                                    @if (u.Estado)
                                    {
                                        <span class="status status-ok">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="status status-inactive">Inactivo</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">

                                        <!-- Ver usuario -->
                                        <a href="@Url.Action("Detalle", "Usuarios", new { id = u.IdUsuario })"
                                           class="btn btn-action"
                                           title="Ver usuario">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Editar usuario -->
                                        <a href="@Url.Action("Editar", "Usuarios", new { id = u.IdUsuario })"
                                           class="btn btn-action"
                                           title="Editar usuario">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Activar o desactivar usuario -->
                                        @using (Html.BeginForm("CambiarEstado", "Usuarios",
                                            new { id = u.IdUsuario }, FormMethod.Post,
                                            new { @class = "d-inline m-0" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-action"
                                                    title="@(u.Estado ? "Desactivar usuario" : "Activar usuario")"
                                                    onclick="return confirm('@(u.Estado ? "¿Desea desactivar este usuario?" : "¿Desea activar este usuario?")');">

                                                <i class="bi bi-power"></i>
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                        @if (!usuariosPagina.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No se encontraron usuarios.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="usuarios-pagination">
                <div class="usuarios-pagination-info">
                    Mostrando <strong>@inicio–@fin</strong> de
                    <strong>@totalUsuarios</strong> usuarios ·
                    Página <strong>@pagina</strong> de <strong>@totalPaginas</strong>
                </div>

                @if (totalPaginas > 1)
                {
                    <nav class="usuarios-pages" aria-label="Paginación de usuarios">
                        @if (pagina > 1)
                        {
                            <a class="usuarios-page-btn" title="Primera página"
                               href="@Url.Action("Index", "Usuarios", new { busqueda = busqueda, pagina = 1 })">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                            <a class="usuarios-page-btn" title="Página anterior"
                               href="@Url.Action("Index", "Usuarios", new { busqueda = busqueda, pagina = pagina - 1 })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }

                        @for (int numero = paginaInicial; numero <= paginaFinal; numero++)
                        {
                            <a class="usuarios-page-btn @(numero == pagina ? "active" : "")"
                               aria-current="@(numero == pagina ? "page" : null)"
                               href="@Url.Action("Index", "Usuarios", new { busqueda = busqueda, pagina = numero })">
                                @numero
                            </a>
                        }

                        @if (pagina < totalPaginas)
                        {
                            <a class="usuarios-page-btn" title="Página siguiente"
                               href="@Url.Action("Index", "Usuarios", new { busqueda = busqueda, pagina = pagina + 1 })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                            <a class="usuarios-page-btn" title="Última página"
                               href="@Url.Action("Index", "Usuarios", new { busqueda = busqueda, pagina = totalPaginas })">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        }
                    </nav>
                }
            </div>
        </div>
    </section>
</main>

@section styles {
    <style>
        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .usuarios-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .usuarios-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .usuarios-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .usuarios-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .usuarios-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            border-color: var(--cop-primary);
            color: white;
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: white;
            }

        .summary-card {
            height: 100%;
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 17px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .summary-icon-success {
            background: #d1e7dd;
            color: #0f5132;
        }

        .summary-icon-warning {
            background: #fff3cd;
            color: #856404;
        }

        .summary-card span {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .summary-card h2 {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.4rem;
        }

        .usuarios-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .usuarios-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 22px;
        }

            .usuarios-toolbar h2 {
                color: var(--cop-primary);
                font-size: 1.15rem;
                margin-bottom: 4px;
            }

            .usuarios-toolbar p {
                color: var(--cop-muted);
                font-size: .85rem;
                margin: 0;
            }

        .search-box {
            position: relative;
            width: 260px;
        }

            .search-box i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
            }

            .search-box input {
                padding-left: 34px;
            }

        .usuarios-table {
            margin: 0;
        }

            .usuarios-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .usuarios-table td {
                padding: 15px 17px;
                font-size: .9rem;
                border-color: #edf0f3;
            }

        .usuario-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .usuario-info small {
                display: block;
                color: var(--cop-muted);
                font-size: .78rem;
                margin-top: 2px;
            }

        .usuario-avatar {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .role-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            background: #e6f1fb;
            color: var(--cop-primary);
            font-size: .77rem;
            font-weight: 600;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .77rem;
            font-weight: 600;
        }

        .status-ok {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-inactive {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            padding: 5px 9px;
        }

            .btn-action:hover {
                background: #e6f1fb;
                color: var(--cop-primary);
            }

        @@media (max-width: 768px) {
            .usuarios-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                width: 100%;
            }
        }

        /* Identidad visual compartida con Repositorio de Materiales */
        .cop-back-btn {
            border-radius: 9px;
            font-weight: 600;
            padding: .55rem 1rem;
            white-space: nowrap;
            background: #fff;
        }

            .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386FA4;
                color: #133C55;
            }

        .cop-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .cop-form-card, .cop-detail-wrapper {
            box-shadow: 0 5px 20px rgba(19,60,85,.055);
        }

        .cop-page-title i {
            color: #386FA4;
        }

        @@media (max-width: 576px) {
            .cop-page-header {
                align-items: flex-start;
            }

            .cop-back-btn {
                width: auto;
            }
        }

        /* Encabezado alineado con Gestión académica */
        .usuarios-header {
            background: transparent;
            border: 0;
            padding: 0;
            margin: 14px 0 24px;
        }

            .usuarios-header > .container {
                padding: 0 12px;
            }

        .usuarios-title {
            font-size: 1.55rem;
            line-height: 1.3;
            margin: 0;
            color: #133C55;
            font-weight: 700;
        }

        .usuarios-subtitle {
            color: #6c7888;
            font-size: .9rem;
            line-height: 1.55;
        }

        .usuarios-header .btn {
            border-radius: 6px;
        }

        @@media (max-width: 575px) {
            .usuarios-title {
                font-size: 1.32rem;
            }
        }

        /* Paginación de usuarios: misma estructura visual que Auditoría */
        .usuarios-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin: 12px 24px 0;
            padding: 20px 0;
            border-top: 1px solid #edf1f5;
        }

        .usuarios-pagination-info {
            font-size: .87rem;
            color: #718092;
        }

            .usuarios-pagination-info strong {
                color: #34495e;
            }

        .usuarios-pages {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
        }

        .usuarios-page-btn {
            min-width: 37px;
            height: 37px;
            padding: 0 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dce5ed;
            border-radius: 8px;
            background: #fff;
            color: #4b6479;
            text-decoration: none;
            font-size: .86rem;
            font-weight: 650;
        }

            .usuarios-page-btn:hover {
                background: #edf4f9;
                border-color: #b7d0e0;
                color: #173b53;
                text-decoration: none;
            }

            .usuarios-page-btn.active {
                background: #173b53;
                border-color: #173b53;
                color: #fff;
                pointer-events: none;
            }

        @@media (max-width: 768px) {
            .usuarios-pagination {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}
