@{
    ViewBag.Title = "Gestión académica";
}

<main>
    <a href="@Url.Action("Index", "Home")" class="cop-back-link">
        <i class="bi bi-arrow-left"></i> Volver al inicio
    </a>

    <div class="cop-page-header">
        <div>
            <h2 class="cop-page-title">Gestión académica</h2>
            <p class="cop-page-subtitle">
                Administración de aulas, grupos, estudiantes y docentes.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-sm-3">
            <div class="cop-stat-card">
                <span class="cop-stat-label">Aulas registradas</span>
                <span class="cop-stat-value">12</span>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="cop-stat-card">
                <span class="cop-stat-label">Grupos activos</span>
                <span class="cop-stat-value">14</span>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="cop-stat-card">
                <span class="cop-stat-label">Estudiantes asignados</span>
                <span class="cop-stat-value">412</span>
            </div>
        </div>

        <div class="col-sm-3">
            <div class="cop-stat-card">
                <span class="cop-stat-label">Docentes asignados</span>
                <span class="cop-stat-value">28</span>
            </div>
        </div>

    </div>

    <p class="cop-section-label">Administración académica</p>

    <div class="cop-quick-grid">

        <a href="@Url.Action("Aulas", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-door-open"></i>
            <div>
                <span class="cop-quick-title">Aulas y horarios</span>
                <span class="cop-quick-desc">Capacidad y horarios de las aulas.</span>
            </div>
        </a>

        <a href="@Url.Action("Asignaciones", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-person-plus"></i>
            <div>
                <span class="cop-quick-title">Asignar estudiantes</span>
                <span class="cop-quick-desc">Asignación y traslado entre grupos.</span>
            </div>
        </a>

        <a href="@Url.Action("Distribucion", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-diagram-3"></i>
            <div>
                <span class="cop-quick-title">Distribución automática</span>
                <span class="cop-quick-desc">Distribución según capacidad disponible.</span>
            </div>
        </a>

        <a href="@Url.Action("Docentes", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-person-badge"></i>
            <div>
                <span class="cop-quick-title">Asignar docentes</span>
                <span class="cop-quick-desc">Docentes responsables de cada grupo.</span>
            </div>
        </a>

        <a href="@Url.Action("MiGrupo", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-people"></i>
            <div>
                <span class="cop-quick-title">Mi grupo</span>
                <span class="cop-quick-desc">Estudiantes, aula y horario asignado.</span>
            </div>
        </a>

        <a href="@Url.Action("Reportes", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-file-earmark-bar-graph"></i>
            <div>
                <span class="cop-quick-title">Reportes</span>
                <span class="cop-quick-desc">Distribución por aula, grupo o docente.</span>
            </div>
        </a>

        <a href="@Url.Action("ImportarExcel", "GestionAcademica")" class="cop-quick-link">
            <i class="bi bi-file-earmark-excel"></i>
            <div>
                <span class="cop-quick-title">Importar Excel</span>
                <span class="cop-quick-desc">Carga masiva de asignaciones.</span>
            </div>
        </a>

    </div>
</main>

@section styles {
    <style>
        .cop-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin: 28px 0 20px;
        }

        .cop-page-title {
            font-weight: 700;
            color: #133C55;
            margin-bottom: 2px;
        }

        .cop-page-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }

        .cop-stat-card {
            background: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .cop-stat-label {
            font-size: 0.8rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 6px;
        }

        .cop-stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #133C55;
        }

        .cop-section-label {
            font-size: 0.8rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .cop-quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 40px;
        }

        .cop-quick-link {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            color: #133C55;
            text-decoration: none;
            min-height: 90px;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

            .cop-quick-link:hover {
                background-color: #E6F1FB;
                border-color: #cbddec;
                color: #133C55;
            }

            .cop-quick-link > i {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background-color: #E6F1FB;
                color: #386FA4;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 1.2rem;
            }

        .cop-quick-title {
            display: block;
            font-weight: 600;
            color: #133C55;
            margin-bottom: 2px;
        }

        .cop-quick-desc {
            display: block;
            color: #6c757d;
            font-size: 0.82rem;
            font-weight: 400;
        }

        @@media (max-width: 992px) {
            .cop-quick-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .cop-quick-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}