@model EscuelaCopalchi.UI.Models.Reportes.ReportesViewModel
@{
    ViewBag.Title = "Reportes";
    var ci = System.Globalization.CultureInfo.InvariantCulture;

    var est = Model.Estudiantes;
    int totalClases = est.Sum(e => e.Clases);
    int sinNotas = est.Count(e => !e.Promedio.HasValue);
    int bajoAsistencia = est.Count(e => e.BajaAsistencia);
    int bajoRendimiento = est.Count(e => e.BajoRendimiento);
    int sinAlertas = est.Count(e => !e.EnRiesgo);
    int r90 = est.Count(e => e.Promedio >= 90);
    int r80 = est.Count(e => e.Promedio >= 80 && e.Promedio < 90);
    int r70 = est.Count(e => e.Promedio >= 70 && e.Promedio < 80);
    int rBajo = est.Count(e => e.Promedio < 70);
    int rSin = est.Count(e => !e.Promedio.HasValue);

    string jsAsig = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Asignaturas.Select(a => new { a.Asignatura, a.Promedio }));
    string jsDist = Newtonsoft.Json.JsonConvert.SerializeObject(new[] { r90, r80, r70, rBajo, rSin });
    string jsAsis = Newtonsoft.Json.JsonConvert.SerializeObject(new[]
    {
        est.Sum(e => e.Presentes), est.Sum(e => e.Tardanzas), est.Sum(e => e.Justificados), est.Sum(e => e.Ausentes)
    });
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
    <style>
                body { background:#f4f7fa; }
                .rp-shell { max-width:1320px; margin:0 auto; padding:18px 16px 36px; }
                .rp-hero { background:linear-gradient(110deg,#133c55,#397fa7); color:#fff; border-radius:12px; padding:24px 28px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
                .rp-eyebrow { font-size:.68rem; letter-spacing:.14em; font-weight:700; opacity:.8; margin-bottom:6px; }
                .rp-hero h1 { color:#fff; font-size:1.65rem; font-weight:750; margin:0 0 5px; }
                .rp-hero p { margin:0; color:#e5f1f8; font-size:.9rem; }
                .rp-hero .rp-hero-action { background:#fff; color:#133c55; border-radius:7px; padding:9px 14px; text-decoration:none; font-weight:650; font-size:.86rem; }
                .rp-hero .rp-hero-action:hover { background:#e9f4fb; }
                .rp-section-label { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:18px 0 12px; color:#133c55; font-size:1rem; font-weight:750; }
                .rp-card { position:relative; overflow:hidden; border-color:#dce6ef!important; box-shadow:0 3px 12px rgba(19,60,85,.04)!important; padding:18px 20px!important; min-height:104px; }
                .rp-card::before { content:""; position:absolute; top:0; left:0; bottom:0; width:3px; background:#4a96c0; }
                .rp-card h3 { font-size:1.75rem!important; margin-top:9px!important; }
                .rp-chart { border-color:#dce6ef!important; box-shadow:0 3px 12px rgba(19,60,85,.04); }
                .gn-filters { background:#fff; border:1px solid #dce6ef; border-radius:10px; padding:18px 20px; margin-bottom:18px; }
                .gn-filters .form-label { font-size:.82rem; font-weight:650; color:#133c55; }
                .rp-shell .form-select, .rp-shell .form-control { border-color:#d5e1eb; border-radius:7px; }
                .rp-shell .btn { border-radius:7px; }
                @@media (max-width: 600px) {
            .rp-hero {
                padding: 20px;
            }

            .rp-hero h1 {
                font-size: 1.35rem;
            }
        }
                .rp-header-note {color:#64748b;font-size:.9rem;margin:0}
                .rp-card {box-shadow:0 4px 18px rgba(19,60,85,.035); transition:transform .15s ease;}
                .rp-card:hover {transform:translateY(-2px)}
                .rp-toolbar {display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin:14px 0}
                .rp-toolbar select {max-width:130px}
                .rp-pager {display:flex;gap:6px;align-items:center;flex-wrap:wrap}
                .rp-pager button {border:1px solid #dce4ed;border-radius:7px;background:#fff;color:#133c55;padding:5px 11px}
                .rp-pager button.active {background:#133c55;color:#fff}
                .rp-pager button:disabled {opacity:.4;cursor:not-allowed}
                .rp-export {display:flex;align-items:end;gap:8px;flex-wrap:wrap}
                .rp-export .form-select {min-width:170px}
                .rp-card { background:#fff; border:1px solid #e3e8ee; border-radius:10px; padding:16px 18px; height:100%; }
                .rp-card span { display:block; color:#6c757d; font-size:.8rem; }
                .rp-card h3 { margin:2px 0 0; color:#133C55; font-size:1.6rem; font-weight:700; }
                .rp-chart { background:#fff; border:1px solid #e3e8ee; border-radius:10px; padding:16px 18px; height:100%; }
                .rp-chart h5 { color:#133C55; font-size:.95rem; font-weight:700; margin-bottom:10px; }
                .rp-chart .rp-box { position:relative; height:240px; }
                .rp-tag { display:inline-block; padding:3px 9px; border-radius:20px; font-size:.74rem; font-weight:600; margin-right:4px; }
                .rp-tag-nota { background:#f8d7da; color:#842029; }
                .rp-tag-asis { background:#fff3cd; color:#664d03; }
                .rp-tag-ok { background:#d1e7dd; color:#0f5132; }
                .rp-vacio { color:#6c757d; font-size:.85rem; text-align:center; padding:80px 0; }

        /* Encabezado idéntico al patrón de Planes de estudio */
        .rp-shell.planes-page { max-width:none; margin:0; padding:0 0 36px; background:#f4f7fa; }
        .rp-shell.planes-page > :not(.planes-header) { max-width:1296px; margin-left:auto; margin-right:auto; }
        .rp-shell .planes-header { background:transparent; padding:16px 0 24px; margin:0; }
        .rp-shell .planes-header .container { max-width:1320px; }
        .rp-shell .planes-header-layout { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
        .rp-shell .planes-title { font-size:1.55rem; line-height:1.3; font-weight:700; color:#133c55; margin:0 0 5px; }
        .rp-shell .planes-title i { color:#386fa4; }
        .rp-shell .planes-subtitle { color:#64748b; font-size:.9rem; line-height:1.55; margin:0; }
        .rp-shell .planes-header-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
        .rp-shell .cop-back-btn { background:#fff; border:1px solid #cbd5e1; color:#475569; font-weight:600; border-radius:7px; padding:.55rem 1rem; text-decoration:none; }
        .rp-shell .cop-back-btn:hover { background:#edf3f8; border-color:#386fa4; color:#133c55; }
        .rp-shell .btn-cop-primary { background:#133c55; border:1px solid #133c55; color:#fff; font-weight:600; border-radius:7px; padding:.55rem 1rem; text-decoration:none; }
        .rp-shell .btn-cop-primary:hover { background:#245b7b; color:#fff; }
        .rp-shell .rp-pager button { min-width:35px; }
        @@media (max-width:575px) { .rp-shell .planes-title { font-size:1.32rem; } }
    </style>
}
<main class="rp-shell planes-page">
    <section class="planes-header">
        <div class="container">
            <div class="planes-header-layout">
                <div>
                    <h1 class="planes-title"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reportes académicos</h1>
                    <p class="planes-subtitle">Consulta el rendimiento, la asistencia y las alertas académicas de los estudiantes.</p>
                </div>
                <div class="planes-header-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>
                  
                </div>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}
    @if (ViewBag.Error != null)
    {<div class="alert alert-danger">@ViewBag.Error</div>}

    <form method="get" class="gn-filters">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Grupo</label>
                <select name="grupo" class="form-select" onchange="this.form.submit()">
                    <option value="0">Todos los grupos</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" @(g.IdGrupo == Model.Grupo ? "selected" : "")>@g.Grupo (@g.Anio)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Mostrar</label>
                <select id="rpFiltro" class="form-select">
                    <option value="todos">Todos los estudiantes</option>
                    <option value="riesgo">Solo con alerta (seguimiento)</option>
                    <option value="nota">Bajo rendimiento</option>
                    <option value="asis">Problemas de asistencia</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Buscar estudiante</label>
                <div class="input-group">
                    <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre o identificación">
                    <button type="submit" class="btn btn-outline-secondary" title="Buscar"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Buscar))
        {
            <div class="mt-2 small text-muted">
                Mostrando resultados para "<strong>@Model.Buscar</strong>" -
                <a href="@Url.Action("Index", new { grupo = Model.Grupo })" class="gn-link">Quitar búsqueda</a>
            </div>
        }
    </form>

    <div class="alert alert-light border small mb-3"><i class="bi bi-info-circle me-1"></i>Los promedios consideran únicamente evaluaciones activas y estudiantes activos. Las evaluaciones inactivas no se incluyen en estadísticas ni exportaciones.</div>
    <div class="rp-section-label"><span><i class="bi bi-speedometer2 me-2"></i>Resumen académico</span><small class="text-muted fw-normal">Según los filtros seleccionados</small></div>
    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3"><div class="rp-card"><span>Estudiantes</span><h3>@est.Count</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Promedio general</span><h3>@(Model.PromedioGeneral.HasValue ? Model.PromedioGeneral.Value.ToString("0.#", ci) : "-")</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Asistencia general</span><h3>@(Model.AsistenciaGeneral.HasValue ? Model.AsistenciaGeneral.Value.ToString("0.#", ci) + "%" : "-")</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Requieren seguimiento</span><h3>@Model.EnRiesgo</h3></div></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Rendimiento bajo</span><h3>@bajoRendimiento</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Asistencia baja</span><h3>@bajoAsistencia</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Sin alertas</span><h3>@sinAlertas</h3></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Sin calificaciones</span><h3>@sinNotas</h3></div></div>
    </div>

    <div class="rp-section-label"><span><i class="bi bi-activity me-2"></i>Indicadores complementarios</span><small class="text-muted fw-normal">Calculados con los registros visibles en el reporte</small></div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Con calificaciones activas</span><h3>@est.Count(e => e.Promedio.HasValue)</h3><small class="text-muted">Estudiantes con promedio calculado</small></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Asistencias registradas</span><h3>@totalClases</h3><small class="text-muted">Registros individuales de asistencia</small></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Ausencias injustificadas</span><h3>@est.Sum(e => e.Ausentes)</h3><small class="text-muted">Ausencias de estudiantes activos</small></div></div>
        <div class="col-6 col-lg-3"><div class="rp-card"><span>Asignaturas con resultados</span><h3>@Model.Asignaturas.Count</h3><small class="text-muted">Solo evaluaciones activas</small></div></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="rp-chart">
                <h5>Promedio por asignatura</h5>
                <div class="rp-box">
                    @if (Model.Asignaturas.Count == 0)
                    {<div class="rp-vacio">No hay calificaciones de evaluaciones activas para los filtros seleccionados.</div> }
                    else
                    { <canvas id="chAsig"></canvas>}
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="rp-chart">
                <h5>Distribución de promedios</h5>
                <div class="rp-box">
                    @if (est.Count == 0)
                    {<div class="rp-vacio">Sin datos.</div> }
                    else
                    { <canvas id="chDist"></canvas>}
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="rp-chart">
                <h5>Asistencia</h5>
                <div class="rp-box">
                    @if (est.Sum(e => e.Clases) == 0)
                    {<div class="rp-vacio">Aún no hay asistencia registrada.</div> }
                    else
                    { <canvas id="chAsis"></canvas>}
                </div>
            </div>
        </div>
    </div>

    @* Comparación de grupos: solo estudiantes activos y evaluaciones activas, según el procedimiento existente. *@
    <section class="mb-4" aria-label="Comparación de grupos">
        <div class="rp-section-label"><span><i class="bi bi-bar-chart-line me-1"></i> Comparación entre grupos</span></div>
        <div class="rp-chart">
            <p class="text-muted small mb-3">Resultados de todos los grupos a los que se tiene acceso. Los estudiantes sin notas no se consideran promedio cero.</p>
            @{
                var comparacion = Model.ComparacionGrupos
                    .GroupBy(e => new { e.IdGrupo, e.Grupo })
                    .Select(g => new {
                        Grupo = g.Key.Grupo,
                        Estudiantes = g.Count(),
                        ConNotas = g.Count(x => x.Promedio.HasValue),
                        Promedio = g.Any(x => x.Promedio.HasValue) ? (decimal?)g.Where(x => x.Promedio.HasValue).Average(x => x.Promedio.Value) : null,
                        Clases = g.Sum(x => x.Clases),
                        Ausencias = g.Sum(x => x.Ausentes),
                        Riesgo = g.Count(x => x.EnRiesgo)
                    }).OrderBy(x => x.Grupo).ToList();
            }
            @if (!comparacion.Any())
            {
                <p class="text-muted mb-0">No hay grupos con estudiantes activos para comparar.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Grupo</th><th class="text-center">Estudiantes</th><th class="text-center">Con notas</th><th class="text-center">Promedio</th><th class="text-center">Asistencia</th><th class="text-center">En riesgo</th></tr></thead>
                        <tbody>
                            @foreach (var g in comparacion)
                            {
                                <tr>
                                    <td><strong>@g.Grupo</strong></td>
                                    <td class="text-center">@g.Estudiantes</td>
                                    <td class="text-center">@g.ConNotas</td>
                                    <td class="text-center">@(g.Promedio.HasValue ? g.Promedio.Value.ToString("0.0", ci) : "Sin notas")</td>
                                    <td class="text-center">@(g.Clases > 0 ? (100m * (g.Clases - g.Ausencias) / g.Clases).ToString("0.0", ci) + "%" : "Sin registros")</td>
                                    <td class="text-center">@g.Riesgo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="height:240px"><canvas id="rpCompararChart" aria-label="Promedio académico por grupo"></canvas></div>
            }
        </div>
    </section>

    <div class="rp-toolbar">
        <div>
            <h5 class="mb-1" style="color:#133c55;font-weight:700">Detalle de estudiantes</h5>
            <small id="rpContador" class="text-muted" aria-live="polite">@est.Count estudiantes</small>
        </div>
        <div class="rp-export">
            <button type="button" class="btn btn-outline-danger btn-sm" id="rpPdf"><i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF</button>
            <button type="button" class="btn btn-outline-success btn-sm" id="rpExcel"><i class="bi bi-file-earmark-excel me-1"></i> Exportar Excel</button>
        </div>
    </div>
    <div class="table-responsive gn-table-wrap mb-2">
        <table class="table align-middle gn-table" id="rpTabla">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Grupo</th>
                    <th class="text-center">Promedio</th>
                    <th class="text-center">Asistencia</th>
                    <th class="text-center">Ausencias</th>
                    <th>Seguimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in est)
                {
                    <tr data-riesgo="@(e.EnRiesgo ? 1 : 0)" data-nota="@(e.BajoRendimiento ? 1 : 0)" data-asis="@(e.BajaAsistencia ? 1 : 0)">
                        <td><strong>@e.Estudiante</strong><div class="text-muted small">@e.Identificacion</div></td>
                        <td>@e.Grupo</td>
                        <td class="text-center">
                            @if (e.Promedio.HasValue)
                            {<span class="gn-final @(e.BajoRendimiento ? "bad" : "ok")">@e.Promedio.Value.ToString("0.#", ci)</span> }
                        else
                        { <span class="gn-final none" title="Sin calificaciones de evaluaciones activas">Sin notas</span>}
                        </td>
                        <td class="text-center">@(e.PctAsistencia.HasValue ? e.PctAsistencia.Value.ToString("0.#", ci) + "%" : "-")</td>
                        <td class="text-center">@(e.Clases > 0 ? e.Ausentes.ToString() : "-")</td>
                        <td>
                            @if (e.BajoRendimiento)
                            {<span class="rp-tag rp-tag-nota">Bajo rendimiento</span>}
                            @if (e.BajaAsistencia)
                            {<span class="rp-tag rp-tag-asis">Asistencia baja</span>}
                            @if (!e.EnRiesgo)
                            {<span class="rp-tag rp-tag-ok">Sin alertas</span>}
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="gn-link" target="_blank" href="@Url.Action("Ficha", new { estudiante = e.IdEstudiante })"><i class="bi bi-file-earmark-pdf me-1"></i>Ver</a>
                            <a class="gn-link ms-2" href="@Url.Action("Ficha", new { estudiante = e.IdEstudiante, descargar = true })" title="Descargar"><i class="bi bi-download"></i></a>
                            <a class="gn-link ms-2" href="@Url.Action("Registrar", "GestionNotas", new { grupo = e.IdGrupo })" title="Modificar calificaciones desde Gestión de Notas (según permisos del rol)"><i class="bi bi-pencil-square me-1"></i>Editar notas</a>
                        </td>
                    </tr>
                }
                @if (est.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay estudiantes matriculados para los filtros seleccionados.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="rp-toolbar mb-4"><span id="rpRango" class="small text-muted"></span><div id="rpPaginas" class="rp-pager"></div></div>
    <p class="text-muted small">
        Alerta por rendimiento: promedio menor a 70. Alerta por asistencia: menos de 80% (se descuentan solo las ausencias injustificadas).
    </p>

    <div class="d-flex justify-content-end mb-5">
        <a href="@Url.Action("Index", "Home")" class="btn gn-btn-out"><i class="bi bi-house me-1"></i> Volver al inicio</a>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var gruposComparados = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(comparacion.Select(g => new { g.Grupo, g.Promedio })));
            var compararCanvas = document.getElementById('rpCompararChart');
            if (compararCanvas && window.Chart) {
                new Chart(compararCanvas, {
                    type: 'bar',
                    data: {
                        labels: gruposComparados.map(function(x) { return x.Grupo; }),
                        datasets: [{ label: 'Promedio', data: gruposComparados.map(function(x) { return x.Promedio; }), backgroundColor: '#397fa7' }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100 } }, plugins: { legend: { display: false } } }
                });
            }

            var asig = @Html.Raw(jsAsig);
            var dist = @Html.Raw(jsDist);
            var asis = @Html.Raw(jsAsis);

            if (window.Chart) {
                var c = document.getElementById('chAsig');
                if (c) new Chart(c, {
                    type: 'bar',
                    data: { labels: asig.map(function (a) { return a.Asignatura; }),
                            datasets: [{ data: asig.map(function (a) { return a.Promedio; }), backgroundColor: '#386FA4', borderRadius: 4 }] },
                    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 100 } } }
                });

                c = document.getElementById('chDist');
                if (c) new Chart(c, {
                    type: 'doughnut',
                    data: { labels: ['90-100', '80-89', '70-79', 'Menos de 70', 'Sin notas'],
                            datasets: [{ data: dist, backgroundColor: ['#198754', '#59A5D8', '#ffc107', '#dc3545', '#adb5bd'] }] },
                    options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
                });

                c = document.getElementById('chAsis');
                if (c) new Chart(c, {
                    type: 'doughnut',
                    data: { labels: ['Presentes', 'Tardanzas', 'Justificadas', 'Ausentes'],
                            datasets: [{ data: asis, backgroundColor: ['#198754', '#ffc107', '#59A5D8', '#dc3545'] }] },
                    options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
                });
            }

            var filtro = document.getElementById('rpFiltro');
            var filas = Array.prototype.slice.call(document.querySelectorAll('#rpTabla tbody tr[data-riesgo]'));
            var pagina = 1;
            function visibles() {
                var f = filtro.value;
                return filas.filter(function (tr) {
                    return f === 'todos' || (f === 'riesgo' && tr.dataset.riesgo === '1') ||
                        (f === 'nota' && tr.dataset.nota === '1') || (f === 'asis' && tr.dataset.asis === '1');
                });
            }
            function dibujar() {
                var v = visibles(), n = 10, paginas = Math.max(1, Math.ceil(v.length / n));
                pagina = Math.min(pagina, paginas);
                filas.forEach(function (tr) { tr.style.display = 'none'; });
                v.slice((pagina-1)*n,pagina*n).forEach(function(tr){tr.style.display='';});
                document.getElementById('rpContador').textContent = v.length + ' de ' + filas.length + ' estudiantes';
                document.getElementById('rpRango').textContent = v.length ? 'Mostrando '+((pagina-1)*n+1)+'–'+Math.min(pagina*n,v.length)+' de '+v.length : 'Sin resultados';
                var nav = document.getElementById('rpPaginas'); nav.innerHTML='';
                function boton(txt,num,disabled,activo) {
                    var b=document.createElement('button');b.type='button';b.textContent=txt;b.disabled=disabled;
                    if(activo)b.className='active';
                    b.addEventListener('click',function(){pagina=num;dibujar();});nav.appendChild(b);
                }
                boton('‹',pagina-1,pagina===1,false);
                var desde=Math.max(1,pagina-2),hasta=Math.min(paginas,desde+4);
                for(var i=desde;i<=hasta;i++)boton(String(i),i,false,i===pagina);
                boton('›',pagina+1,pagina===paginas,false);
            }
            filtro.addEventListener('change',function(){pagina=1;dibujar();});
            dibujar();
            function exportar(formato) {
                var url = '@Url.Action("ExportarSeleccion", "Reportes")';
                var q = '?grupo=' + encodeURIComponent('@Model.Grupo') +
                    '&buscar=' + encodeURIComponent(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Buscar ?? ""))) +
                    '&filtro=' + encodeURIComponent(filtro.value) + '&formato=' + encodeURIComponent(formato);
                window.location.href = url + q;
            }
            document.getElementById('rpPdf').addEventListener('click',function(){exportar('pdf');});
            document.getElementById('rpExcel').addEventListener('click',function(){exportar('excel');});
        })();
    </script>
}
