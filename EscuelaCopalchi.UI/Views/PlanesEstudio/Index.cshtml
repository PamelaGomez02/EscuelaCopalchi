@using System.Linq

@model List<EscuelaCopalchi.UI.Models.PlanesEstudio.PlanEstudio>

@{
    ViewBag.Title = "Planes de estudio";
}

<main class="planes-page">

    <!-- ENCABEZADO -->
    <section class="planes-header">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>

                    <div class="planes-breadcrumb">
                        <a href="@Url.Action("Index", "Home")">Inicio</a>
                        <i class="bi bi-chevron-right"></i>
                        <span>Planes de estudio</span>
                    </div>

                    <h1 class="planes-title">
                        <i class="bi bi-journal-text me-2"></i>
                        Planes de estudio
                    </h1>

                    <p class="planes-subtitle">
                        Administra la planificación académica mensual,
                        revisa su estado y consulta las observaciones realizadas.
                    </p>

                </div>

                <div>
                    @if ((bool)(ViewBag.PuedeCrear ?? false)) {
                    <a href="@Url.Action("Crear", "PlanesEstudio")"
                       class="btn btn-cop-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Nuevo plan

                    </a>
                    }
                </div>

            </div>
        </div>
    </section>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <!-- CONTENIDO -->
    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <!-- PENDIENTES -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon pending">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>
                        <span class="summary-label">Pendientes</span>
                        <h2 class="summary-number">
                            @ViewBag.Pendientes
                        </h2>
                    </div>

                </div>
            </div>


            <!-- APROBADOS -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon approved">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <span class="summary-label">Aprobados</span>
                        <h2 class="summary-number">
                            @ViewBag.Aprobados
                        </h2>
                    </div>

                </div>
            </div>


            <!-- RECHAZADOS -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon rejected">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    <div>
                        <span class="summary-label">Rechazados</span>
                        <h2 class="summary-number">
                            @ViewBag.Rechazados
                        </h2>
                    </div>

                </div>
            </div>

        </div>


        <!-- CONTENEDOR PRINCIPAL -->
        <div class="plans-container">

            <!-- CABECERA -->
            <div class="plans-toolbar">

                <div>

                    <h2 class="plans-section-title">
                        Mis planes
                    </h2>

                    <p class="plans-section-subtitle">
                        Consulta las planificaciones registradas en el sistema.
                    </p>

                </div>


                <!-- BUSCADOR -->
                <div class="plans-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="buscarPlan"
                           class="form-control"
                           placeholder="Buscar plan..." />

                </div>

            </div>


            <!-- FILTROS -->
            @using (Html.BeginForm(
                "Index",
                "PlanesEstudio",
                FormMethod.Get))
            {
                <div class="plans-filters">

                    <select id="filtroEstado"
                            class="form-select">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="Pendiente">
                            Pendiente
                        </option>

                        <option value="Aprobado">
                            Aprobado
                        </option>

                        <option value="Denegado">
                            Rechazado
                        </option>

                    </select>


                    <select id="filtroPeriodo" class="form-select"><option value="">Todos los meses</option>@for(int m=1;m<=12;m++){<option value="@(new DateTime(2000,m,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))">@(new DateTime(2000,m,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))</option>}</select>

                </div>
            }

        </div>


        <!-- TABLA -->
        <div class="table-responsive">

            <table id="tablaPlanes"
                   class="table plans-table align-middle">

                <thead>

                    <tr>
                        <th>Asignatura / Nivel</th>
                        <th>Periodo</th>
                        <th>Fecha de registro</th>
                        <th>Estado</th>
                        <th>Archivo</th>
                        <th class="text-end">Acciones</th>
                    </tr>

                </thead>


                <tbody>

                    @if (Model != null)
                    {
                        foreach (var plan in Model)
                        {
                            <tr>

                                <td>
                                    <div class="plan-name">

                                        <div class="plan-file-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                @plan.Asignatura
                                            </strong>

                                            <small>
                                                @plan.Nivel
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @plan.Periodo @plan.Anio
                                </td>

                                <td>
                                    @plan.FechaCarga.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @if (plan.Estado == "Pendiente")
                                    {
                                        <span class="status status-pending">
                                            <i class="bi bi-clock"></i>
                                            Pendiente
                                        </span>
                                    }
                                    else if (plan.Estado == "Aprobado")
                                    {
                                        <span class="status status-approved">
                                            <i class="bi bi-check-circle"></i>
                                            Aprobado
                                        </span>
                                    }
                                    else if (plan.Estado == "Denegado")
                                    {
                                        <span class="status status-rejected">
                                            <i class="bi bi-x-circle"></i>
                                            Denegado
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrEmpty(plan.Archivo))
                                    {
                                        <span class="teams-status teams-ok">
                                            Archivo cargado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="teams-status">
                                            Sin archivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end">


                                    @if ((bool)(ViewBag.PuedeRevisar ?? false) && plan.Estado == "Pendiente") {
                                    <a href="@Url.Action("Revisar", "PlanesEstudio", new { id = plan.IdPlan})"
                                       class="btn btn-action"
                                       title="Ver plan">

                                        <i class="bi bi-check-circle"></i>

                                    </a>
                                    }

                                    <a href="@Url.Action("Detalle", "PlanesEstudio", new { id = plan.IdPlan})"
                                       class="btn btn-action"
                                       title="Ver plan">

                                        <i class="bi bi-eye"></i>

                                    </a>



                                    @if (plan.Estado == "Pendiente" && ((bool)(ViewBag.PuedeAdministrar ?? false) || ((bool)(ViewBag.PuedeEditar ?? false) && plan.IdDocente == (int)(ViewBag.IdDocenteActual ?? 0)))) {
                                    <a href="@Url.Action("Editar", "PlanesEstudio", new { id = plan.IdPlan})"
                                       class="btn btn-action"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    }


                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
            <div class="d-flex justify-content-center mt-4">

                <ul id="paginacionPlanes"
                    class="pagination">
                </ul>

            </div>

        </div>

        </div>

    </section>

</main>



<script>

    document.addEventListener("DOMContentLoaded", function () {

        const buscador =
            document.getElementById("buscarPlan");

        buscador.addEventListener("keyup", function () {

            const texto =
                this.value.toLowerCase();

            const filas =
                document.querySelectorAll(
                    "#tablaPlanes tbody tr");

            filas.forEach(function (fila) {

                const contenido =
                    fila.innerText.toLowerCase();

                if (contenido.includes(texto)) {
                    fila.style.display = "";
                }
                else {
                    fila.style.display = "none";
                }

            });

        });

    });

        document.addEventListener("DOMContentLoaded", function () {

    const buscador =
        document.getElementById("buscarPlan");

        const filtroEstado =
        document.getElementById("filtroEstado");

        const filtroPeriodo =
        document.getElementById("filtroPeriodo");

        function aplicarFiltros() {

        const texto =
        buscador.value.toLowerCase();

        const estado =
        filtroEstado.value.toLowerCase();

        const periodo =
        filtroPeriodo.value.toLowerCase();

        const filas =
        document.querySelectorAll(
        "#tablaPlanes tbody tr");

        filas.forEach(function (fila) {

            const contenido =
        fila.innerText.toLowerCase();

        const coincideTexto =
        contenido.includes(texto);

        const coincideEstado =
        estado === "" ||
        contenido.includes(estado);

        const coincidePeriodo =
        periodo === "" ||
        contenido.includes(periodo);

        if (
        coincideTexto &&
        coincideEstado &&
        coincidePeriodo
        )
        {
            fila.style.display = "";
            }
        else
        {
            fila.style.display = "none";
            }

        });
    }

        buscador.addEventListener(
        "keyup",
        aplicarFiltros);

        filtroEstado.addEventListener(
        "change",
        aplicarFiltros);

        filtroPeriodo.addEventListener(
        "change",
        aplicarFiltros);

        });

    document.addEventListener("DOMContentLoaded", () => {

        const filas =
            document.querySelectorAll(
                "#tablaPlanes tbody tr");

        const filasPorPagina = 10;

        const totalPaginas =
            Math.ceil(
                filas.length /
                filasPorPagina);

        const paginacion =
            document.getElementById(
                "paginacionPlanes");

        function mostrarPagina(pagina) {
            filas.forEach((fila, index) => {

                fila.style.display =
                    index >=
                        (pagina - 1) *
                        filasPorPagina

                        &&

                        index <
                        pagina *
                        filasPorPagina

                        ? ""

                        : "none";

            });
        }

        function crearPaginacion() {
            paginacion.innerHTML = "";

            for (
                let i = 1;
                i <= totalPaginas;
                i++) {
                let li =
                    document.createElement(
                        "li");

                li.className =
                    "page-item";

                let a =
                    document.createElement(
                        "a");

                a.className =
                    "page-link";

                a.href = "#";

                a.innerText = i;

                a.addEventListener(
                    "click",
                    function (e) {
                        e.preventDefault();

                        mostrarPagina(i);
                    });

                li.appendChild(a);

                paginacion.appendChild(li);
            }
        }

        crearPaginacion();

        mostrarPagina(1);

    });


</script>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-soft: #84D2F6;
            --cop-light: #91E5F6;
            --cop-text: #212529;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }


        body {
            background-color: var(--cop-page-bg);
        }

        /* ==============================
           HEADER
        ============================== */

        .planes-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e3e8ee;
            padding: 32px 0;
            margin-bottom: 28px;
        }


        .planes-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            margin-bottom: 12px;
            color: var(--cop-muted);
        }


            .planes-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }


                .planes-breadcrumb a:hover {
                    text-decoration: underline;
                }


        .planes-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 7px;
        }


        .planes-subtitle {
            color: var(--cop-muted);
            margin-bottom: 0;
        }


        /* ==============================
           BOTÓN PRINCIPAL
        ============================== */

        .btn-cop-primary {
            background-color: var(--cop-primary);
            color: #ffffff;
            border: 1px solid var(--cop-primary);
            padding: 9px 18px;
            border-radius: 7px;
            font-weight: 500;
        }


            .btn-cop-primary:hover {
                background-color: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: #ffffff;
            }


        /* ==============================
           CARDS RESUMEN
        ============================== */

        .summary-card {
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            height: 100%;
        }


        .summary-icon {
            width: 46px;
            height: 46px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }


            .summary-icon.pending {
                background-color: #fff3cd;
                color: #856404;
            }


            .summary-icon.approved {
                background-color: #d1e7dd;
                color: #0f5132;
            }


            .summary-icon.rejected {
                background-color: #f8d7da;
                color: #842029;
            }


        .summary-label {
            display: block;
            color: var(--cop-muted);
            font-size: .85rem;
        }


        .summary-number {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.6rem;
            font-weight: 700;
        }


        /* ==============================
           CONTENEDOR
        ============================== */

        .plans-container {
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 40px;
        }


        /* ==============================
           TOOLBAR
        ============================== */

        .plans-toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }


        .plans-section-title {
            margin: 0 0 4px;
            font-size: 1.2rem;
            color: var(--cop-primary);
            font-weight: 600;
        }


        .plans-section-subtitle {
            margin: 0;
            color: var(--cop-muted);
            font-size: .88rem;
        }


        /* ==============================
           BUSCADOR
        ============================== */

        .plans-search {
            position: relative;
            width: 260px;
        }


            .plans-search i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
                pointer-events: none;
            }


            .plans-search input {
                padding-left: 34px;
            }


        /* ==============================
           FILTROS
        ============================== */

        .plans-filters {
            display: flex;
            gap: 12px;
            padding: 15px 22px;
            background-color: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }


            .plans-filters .form-select {
                width: 190px;
                font-size: .9rem;
            }


        /* ==============================
           FORMULARIOS
        ============================== */

        .form-control,
        .form-select {
            border: 1px solid #dce2e7;
            border-radius: 7px;
            font-size: .9rem;
        }


            .form-control:focus,
            .form-select:focus {
                border-color: var(--cop-accent);
                box-shadow: 0 0 0 .2rem rgba(89, 165, 216, .15);
            }


        /* ==============================
           TABLA
        ============================== */

        .plans-table {
            margin-bottom: 0;
        }


            .plans-table thead th {
                background-color: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                font-weight: 600;
                text-transform: uppercase;
                padding: 13px 17px;
                border-bottom: 1px solid #e3e8ee;
                white-space: nowrap;
            }


            .plans-table tbody td {
                padding: 16px 17px;
                border-color: #edf0f3;
                font-size: .9rem;
                vertical-align: middle;
            }


            .plans-table tbody tr:hover {
                background-color: #fafcfd;
            }


        /* ==============================
           PLAN
        ============================== */

        .plan-name {
            display: flex;
            align-items: center;
            gap: 11px;
        }


            .plan-name strong {
                display: block;
                color: var(--cop-text);
                font-weight: 600;
            }


            .plan-name small {
                display: block;
                color: var(--cop-muted);
                margin-top: 2px;
            }


        .plan-file-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            background-color: #e6f1fb;
            color: var(--cop-secondary);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }


        /* ==============================
           ESTADOS
        ============================== */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
            white-space: nowrap;
        }


        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }


        .status-approved {
            background-color: #d1e7dd;
            color: #0f5132;
        }


        .status-rejected {
            background-color: #f8d7da;
            color: #842029;
        }


        /* ==============================
           TEAMS
        ============================== */

        .teams-status {
            color: var(--cop-muted);
            font-size: .83rem;
            white-space: nowrap;
        }


        .teams-ok {
            color: #198754;
        }


        /* ==============================
           ACCIONES
        ============================== */

        .btn-action {
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            background-color: #ffffff;
            padding: 5px 9px;
            margin-left: 3px;
        }


            .btn-action:hover {
                background-color: #e6f1fb;
                color: var(--cop-primary);
                border-color: var(--cop-accent);
            }


        /* ==============================
           RESPONSIVE
        ============================== */

        @@media (max-width: 768px) {

            .planes-header {
                padding: 24px 0;
            }


            .planes-title {
                font-size: 1.5rem;
            }


            .planes-toolbar {
                flex-direction: column;
                align-items: stretch;
            }


            .plans-search {
                width: 100%;
            }


            .plans-filters {
                flex-direction: column;
            }


                .plans-filters .form-select {
                    width: 100%;
                }
        }
    </style>

}