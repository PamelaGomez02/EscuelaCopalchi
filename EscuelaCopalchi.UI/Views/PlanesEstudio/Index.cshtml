@using System.Linq

@model List<EscuelaCopalchi.UI.Models.PlanesEstudio.PlanEstudio>

@{
    ViewBag.Title = "Planes de estudio";
}

<main class="planes-page">

    <!-- ENCABEZADO -->
    <section class="planes-header">
        <div class="container">
            <div class="planes-header-layout">
                <div>
                    <h1 class="planes-title">
                        <i class="bi bi-journal-text me-2"></i>
                        Planes de estudio
                    </h1><p class="planes-subtitle">
                        Administra la planificación académica mensual,
                        revisa su estado y consulta las observaciones realizadas.
                    </p>
                </div><div class="planes-header-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>@if ((bool)(ViewBag.PuedeCrear ?? false))
                    {
                        <a href="@Url.Action("Crear", "PlanesEstudio")"
                           class="btn btn-cop-primary">

                            <i class="bi bi-plus-lg me-1"></i>
                            Nuevo plan

                        </a>
                    }
                </div>
            </div>
        </div>
    </section>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}
    <!-- CONTENIDO -->
    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <!-- PENDIENTES -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon pending">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>
                        <span class="summary-label">Pendientes</span>
                        <h2 class="summary-number">
                            @ViewBag.Pendientes
                        </h2>
                    </div>

                </div>
            </div>


            <!-- APROBADOS -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon approved">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <span class="summary-label">Aprobados</span>
                        <h2 class="summary-number">
                            @ViewBag.Aprobados
                        </h2>
                    </div>

                </div>
            </div>


            <!-- RECHAZADOS -->
            <div class="col-md-4">
                <div class="summary-card">

                    <div class="summary-icon rejected">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    <div>
                        <span class="summary-label">Rechazados</span>
                        <h2 class="summary-number">
                            @ViewBag.Rechazados
                        </h2>
                    </div>

                </div>
            </div>

        </div>


        <!-- CONTENEDOR PRINCIPAL -->
        <div class="plans-container">

            <!-- CABECERA -->
            <div class="plans-toolbar">

                <div>

                    <h2 class="plans-section-title">
                        Mis planes
                    </h2>

                    <p class="plans-section-subtitle">
                        Consulta las planificaciones registradas en el sistema.
                    </p>

                </div>


                <!-- BUSCADOR -->
                <div class="plans-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="buscarPlan"
                           class="form-control"
                           placeholder="Buscar plan..." />

                </div>

            </div>


            <!-- FILTROS -->
            @using (Html.BeginForm(
                "Index",
                "PlanesEstudio",
                FormMethod.Get))
            {
                <div class="plans-filters">

                    <select id="filtroEstado"
                            class="form-select">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="Pendiente">
                            Pendiente
                        </option>

                        <option value="Aprobado">
                            Aprobado
                        </option>

                        <option value="Denegado">
                            Rechazado
                        </option>

                    </select>


                    <select id="filtroPeriodo" class="form-select">
                        <option value="">Todos los meses</option>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@(new DateTime(2000,m,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))">@(new DateTime(2000,m,1).ToString("MMMM",new System.Globalization.CultureInfo("es-CR")))</option>
}
                    </select>

                </div>
            }

        </div>


        <!-- TABLA -->
        <div class="table-responsive">

            <table id="tablaPlanes"
                   class="table plans-table align-middle">

                <thead>

                    <tr>
                        <th>Asignatura / Nivel</th>
                        <th>Periodo</th>
                        <th>Fecha de registro</th>
                        <th>Estado</th>
                        <th>Archivo</th>
                        <th class="text-end">Acciones</th>
                    </tr>

                </thead>


                <tbody>

                    @if (Model != null)
                    {
                        foreach (var plan in Model)
                        {
                            <tr data-estado="@plan.Estado" data-periodo="@plan.Periodo">

                                <td>
                                    <div class="plan-name">

                                        <div class="plan-file-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                @plan.Asignatura
                                            </strong>

                                            <small>
                                                @plan.Nivel
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @plan.Periodo @plan.Anio
                                </td>

                                <td>
                                    @plan.FechaCarga.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @if (plan.Estado == "Pendiente")
                                    {
                                        <span class="status status-pending">
                                            <i class="bi bi-clock"></i>
                                            Pendiente
                                        </span>
                                    }
                                    else if (plan.Estado == "Aprobado")
                                    {
                                        <span class="status status-approved">
                                            <i class="bi bi-check-circle"></i>
                                            Aprobado
                                        </span>
                                    }
                                    else if (plan.Estado == "Denegado")
                                    {
                                        <span class="status status-rejected">
                                            <i class="bi bi-x-circle"></i>
                                            Denegado
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrEmpty(plan.Archivo))
                                    {
                                        <span class="teams-status teams-ok">
                                            Archivo cargado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="teams-status">
                                            Sin archivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end">


                                    @if ((bool)(ViewBag.PuedeRevisar ?? false) && plan.Estado == "Pendiente")
                                    {
                                        <a href="@Url.Action("Revisar", "PlanesEstudio", new { id = plan.IdPlan})"
                                           class="btn btn-action"
                                           title="Ver plan">

                                            <i class="bi bi-check-circle"></i>

                                        </a>
                                    }

                                    <a href="@Url.Action("Detalle", "PlanesEstudio", new { id = plan.IdPlan})"
                                       class="btn btn-action"
                                       title="Ver plan">

                                        <i class="bi bi-eye"></i>

                                    </a>



                                    @if (plan.Estado == "Pendiente" && ((bool)(ViewBag.PuedeAdministrar ?? false) || ((bool)(ViewBag.PuedeEditar ?? false) && plan.IdDocente == (int)(ViewBag.IdDocenteActual ?? 0))))
                                    {
                                        <a href="@Url.Action("Editar", "PlanesEstudio", new { id = plan.IdPlan})"
                                           class="btn btn-action"
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }


                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
            <div id="sinResultadosPlanes" class="text-center p-4 text-muted" hidden><i class="bi bi-search fs-3 d-block mb-2"></i>No se encontraron planes con los filtros seleccionados.</div>
            <div class="planes-pagination-bar" id="barraPaginacionPlanes">
                <div id="infoPaginaPlanes" class="planes-pagination-info" aria-live="polite"></div>
                <nav id="paginacionPlanes" class="planes-pages" aria-label="Paginación de planes"></nav>
            </div>

        </div>

        </div>

    </section>

</main>



<script>
document.addEventListener('DOMContentLoaded', function () {
            var tabla=document.getElementById('tablaPlanes');
            if(!tabla) return;
            var filas=Array.prototype.slice.call(tabla.querySelectorAll('tbody tr'));
            var buscar=document.getElementById('buscarPlan');
            var estado=document.getElementById('filtroEstado');
            var periodo=document.getElementById('filtroPeriodo');
            var paginas=document.getElementById('paginacionPlanes');
            var info=document.getElementById('infoPaginaPlanes');
            var vacio=document.getElementById('sinResultadosPlanes');
            var actual=1;
            function normalizar(t){return (t||'').toString().toLocaleLowerCase().trim();}
            function filtrar(){
                var q=normalizar(buscar&&buscar.value), e=normalizar(estado&&estado.value), p=normalizar(periodo&&periodo.value);
                return filas.filter(function(f){
                    var texto=normalizar(f.textContent);
                    var estadoFila=normalizar(f.getAttribute('data-estado'));
                    var periodoFila=normalizar(f.getAttribute('data-periodo'));
                    return (!q||texto.indexOf(q)!==-1)&&(!e||estadoFila===e)&&(!p||periodoFila.indexOf(p)!==-1);
                });
            }
            function boton(etiqueta,pagina,deshabilitado,activo,titulo){
                var btn=document.createElement('button');
                btn.type='button';
                btn.className='planes-page-btn'+(activo?' active':'');
                btn.textContent=etiqueta;
                btn.disabled=deshabilitado;
                btn.setAttribute('aria-label',titulo||('Página '+pagina));
                if(activo)btn.setAttribute('aria-current','page');
                btn.addEventListener('click',function(){actual=pagina;render();});
                paginas.appendChild(btn);
            }
            function render(){
                var lista=filtrar(), porPagina=10, total=Math.max(1,Math.ceil(lista.length/porPagina));
                actual=Math.max(1,Math.min(actual,total));
                filas.forEach(function(f){f.style.display='none';});
                lista.slice((actual-1)*porPagina,actual*porPagina).forEach(function(f){f.style.display='';});
                paginas.innerHTML='';
                if(total>1){
                    boton('«',1,actual===1,false,'Primera página');
                    boton('‹',actual-1,actual===1,false,'Página anterior');
                    var inicio=Math.max(1,actual-2),fin=Math.min(total,inicio+4);inicio=Math.max(1,fin-4);
                    for(var n=inicio;n<=fin;n++)boton(String(n),n,false,n===actual,'Página '+n);
                    boton('›',actual+1,actual===total,false,'Página siguiente');
                    boton('»',total,actual===total,false,'Última página');
                }
                var primero=lista.length?(actual-1)*porPagina+1:0, ultimo=Math.min(actual*porPagina,lista.length);
                info.textContent='Mostrando '+primero+'–'+ultimo+' de '+lista.length+' planes · Página '+actual+' de '+total;
                vacio.hidden=lista.length!==0;
            }
            [buscar,estado,periodo].forEach(function(el){if(el){el.addEventListener('input',function(){actual=1;render();});el.addEventListener('change',function(){actual=1;render();});}});
            render();
});
</script>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-soft: #84D2F6;
            --cop-light: #91E5F6;
            --cop-text: #212529;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }


        body {
            background-color: var(--cop-page-bg);
        }

        /* ==============================
           HEADER
        ============================== */

        .planes-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e3e8ee;
            padding: 32px 0;
            margin-bottom: 28px;
        }


        .planes-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            margin-bottom: 12px;
            color: var(--cop-muted);
        }


            .planes-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }


                .planes-breadcrumb a:hover {
                    text-decoration: underline;
                }


        .planes-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 7px;
        }


        .planes-subtitle {
            color: var(--cop-muted);
            margin-bottom: 0;
        }


        /* ==============================
           BOTÓN PRINCIPAL
        ============================== */

        .btn-cop-primary {
            background-color: var(--cop-primary);
            color: #ffffff;
            border: 1px solid var(--cop-primary);
            padding: 9px 18px;
            border-radius: 7px;
            font-weight: 500;
        }


            .btn-cop-primary:hover {
                background-color: var(--cop-secondary);
                border-color: var(--cop-secondary);
                color: #ffffff;
            }


        /* ==============================
           CARDS RESUMEN
        ============================== */

        .summary-card {
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            height: 100%;
        }


        .summary-icon {
            width: 46px;
            height: 46px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }


            .summary-icon.pending {
                background-color: #fff3cd;
                color: #856404;
            }


            .summary-icon.approved {
                background-color: #d1e7dd;
                color: #0f5132;
            }


            .summary-icon.rejected {
                background-color: #f8d7da;
                color: #842029;
            }


        .summary-label {
            display: block;
            color: var(--cop-muted);
            font-size: .85rem;
        }


        .summary-number {
            margin: 0;
            color: var(--cop-primary);
            font-size: 1.6rem;
            font-weight: 700;
        }


        /* ==============================
           CONTENEDOR
        ============================== */

        .plans-container {
            background: #ffffff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 40px;
        }


        /* ==============================
           TOOLBAR
        ============================== */

        .plans-toolbar {
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }


        .plans-section-title {
            margin: 0 0 4px;
            font-size: 1.2rem;
            color: var(--cop-primary);
            font-weight: 600;
        }


        .plans-section-subtitle {
            margin: 0;
            color: var(--cop-muted);
            font-size: .88rem;
        }


        /* ==============================
           BUSCADOR
        ============================== */

        .plans-search {
            position: relative;
            width: 260px;
        }


            .plans-search i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--cop-muted);
                pointer-events: none;
            }


            .plans-search input {
                padding-left: 34px;
            }


        /* ==============================
           FILTROS
        ============================== */

        .plans-filters {
            display: flex;
            gap: 12px;
            padding: 15px 22px;
            background-color: #f8fafc;
            border-top: 1px solid #edf0f3;
            border-bottom: 1px solid #edf0f3;
        }


            .plans-filters .form-select {
                width: 190px;
                font-size: .9rem;
            }


        /* ==============================
           FORMULARIOS
        ============================== */

        .form-control,
        .form-select {
            border: 1px solid #dce2e7;
            border-radius: 7px;
            font-size: .9rem;
        }


            .form-control:focus,
            .form-select:focus {
                border-color: var(--cop-accent);
                box-shadow: 0 0 0 .2rem rgba(89, 165, 216, .15);
            }


        /* ==============================
           TABLA
        ============================== */

        .plans-table {
            margin-bottom: 0;
        }


            .plans-table thead th {
                background-color: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                font-weight: 600;
                text-transform: uppercase;
                padding: 13px 17px;
                border-bottom: 1px solid #e3e8ee;
                white-space: nowrap;
            }


            .plans-table tbody td {
                padding: 16px 17px;
                border-color: #edf0f3;
                font-size: .9rem;
                vertical-align: middle;
            }


            .plans-table tbody tr:hover {
                background-color: #fafcfd;
            }


        /* ==============================
           PLAN
        ============================== */

        .plan-name {
            display: flex;
            align-items: center;
            gap: 11px;
        }


            .plan-name strong {
                display: block;
                color: var(--cop-text);
                font-weight: 600;
            }


            .plan-name small {
                display: block;
                color: var(--cop-muted);
                margin-top: 2px;
            }


        .plan-file-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            background-color: #e6f1fb;
            color: var(--cop-secondary);
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }


        /* ==============================
           ESTADOS
        ============================== */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
            white-space: nowrap;
        }


        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }


        .status-approved {
            background-color: #d1e7dd;
            color: #0f5132;
        }


        .status-rejected {
            background-color: #f8d7da;
            color: #842029;
        }


        /* ==============================
           TEAMS
        ============================== */

        .teams-status {
            color: var(--cop-muted);
            font-size: .83rem;
            white-space: nowrap;
        }


        .teams-ok {
            color: #198754;
        }


        /* ==============================
           ACCIONES
        ============================== */

        .btn-action {
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            background-color: #ffffff;
            padding: 5px 9px;
            margin-left: 3px;
        }


            .btn-action:hover {
                background-color: #e6f1fb;
                color: var(--cop-primary);
                border-color: var(--cop-accent);
            }


        /* ==============================
           RESPONSIVE
        ============================== */

        @@media (max-width: 768px) {

            .planes-header {
                padding: 24px 0;
            }


            .planes-title {
                font-size: 1.5rem;
            }


            .planes-toolbar {
                flex-direction: column;
                align-items: stretch;
            }


            .plans-search {
                width: 100%;
            }


            .plans-filters {
                flex-direction: column;
            }


                .plans-filters .form-select {
                    width: 100%;
                }
        }

        /* Contenedor principal: misma estructura y anchura que Index de Asistencia */
        .planes-page > .planes-header > .container,
        .planes-page > section.container.pb-5 {
            width: 100%;
            margin-left: auto;
            margin-right: auto;
        }

        .planes-page .plans-container {
            width: 100%;
            max-width: none;
        }
        /* Diseño unificado de encabezados - Planes de Estudio */
        .planes-page, body {
            background: #f4f7fa;
        }

        .planes-header {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 16px 0 24px !important;
        }

            .planes-header > .container {
                background: transparent !important;
                padding-left: 12px;
                padding-right: 12px;
            }

        .planes-breadcrumb {
            display: none !important;
        }

        .planes-header .planes-title {
            font-size: 1.55rem !important;
            line-height: 1.3;
            font-weight: 700 !important;
            color: #133c55 !important;
            margin: 0 0 5px !important;
        }

            .planes-header .planes-title i {
                color: #386fa4;
            }

        .planes-header .planes-subtitle {
            color: #64748b !important;
            font-size: .9rem !important;
            line-height: 1.55;
            margin: 0 !important;
        }

        .planes-header .planes-header-layout {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .planes-header .planes-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .planes-header .cop-back-btn {
            background: #fff;
            border: 1px solid #cbd5e1;
            color: #475569;
            font-weight: 600;
            border-radius: 7px;
            padding: .55rem 1rem;
            text-decoration: none;
            white-space: nowrap;
        }

            .planes-header .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386fa4;
                color: #133c55;
            }

        .planes-header .btn {
            border-radius: 7px;
        }

        .plans-container, .creation-card, .edit-card, .review-card, .detail-card {
            border-radius: 12px;
        }

        @@media(max-width:575px) {
            .planes-header .planes-title {
                font-size: 1.32rem !important;
            }
        }

        /* Paginación visual igual al Index de Auditoría */
        .planes-pagination-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 22px 20px 17px;
            margin-top: 12px;
            border-top: 1px solid #edf1f5;
            background: #fff;
        }

        .planes-pagination-info {
            font-size: .87rem;
            color: #718092;
        }

        .planes-pages {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
        }

        .planes-page-btn {
            min-width: 37px;
            height: 37px;
            padding: 0 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dce5ed;
            border-radius: 8px;
            background: #fff;
            color: #4b6479;
            font-size: .86rem;
            font-weight: 650;
            cursor: pointer;
        }

            .planes-page-btn:hover:not(:disabled) {
                background: #edf4f9;
                border-color: #b7d0e0;
                color: #173b53;
            }

            .planes-page-btn.active {
                background: #173b53;
                border-color: #173b53;
                color: #fff;
            }

            .planes-page-btn:disabled:not(.active) {
                opacity: .45;
                cursor: not-allowed;
            }

        @@media(max-width:768px) {
            .planes-pagination-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>

}