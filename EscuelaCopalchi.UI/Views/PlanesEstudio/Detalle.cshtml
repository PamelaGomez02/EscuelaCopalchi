@model EscuelaCopalchi.UI.Models.PlanesEstudio.PlanEstudio
@{
    ViewBag.Title = "Detalle del plan";
}

<main>

    <section class="planes-header">
        <div class="container">
            <div class="planes-header-layout">
                <div><h1 class="planes-title">Plan de estudio de @Model.Asignatura</h1><p class="planes-subtitle">@Model.Periodo · @Model.Anio</p></div><div class="planes-header-actions">
                    <a href="@Url.Action("Index", "PlanesEstudio")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>@if (Model.Estado == "Pendiente")
                    {
                        <span class="status status-pending plan-state-badge">
                            <i class="bi bi-clock"></i>
                            Pendiente
                        </span>
                    }
                    else if (Model.Estado == "Aprobado")
                    {
                        <span class="status status-approved plan-state-badge">
                            <i class="bi bi-check-circle"></i>
                            Aprobado
                        </span>
                    }
                    else if (Model.Estado == "Denegado")
                    {
                        <span class="status status-rejected plan-state-badge">
                            <i class="bi bi-x-circle"></i>
                            Denegado
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>


    <section class="container pb-5">

        <div class="row g-4">

            <!-- INFORMACIÓN PRINCIPAL -->
            <div class="col-lg-8">

                <div class="detail-card">

                    <h2 class="section-title">
                        <i class="bi bi-info-circle me-2"></i>
                        Información del plan
                    </h2>

                    <div class="row g-4 mt-1">

                        <div class="col-md-6">
                            <span class="detail-label">Docente</span>
                            <strong>@Model.NombreDocente</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Asignatura</span>
                            <strong>@Model.Asignatura</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Grado</span>
                            <strong>@Model.Nivel</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Periodo</span>
                            <strong>@Model.Periodo @Model.Anio</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de registro</span>
                            <strong>@Model.FechaCarga.ToString("dd/MM/yyyy")</strong>
                        </div>

                    </div>

                </div>


                <!-- ARCHIVO -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-paperclip me-2"></i>
                        Archivo del plan
                    </h2>

                    <div class="file-card">

                        <div class="file-icon">
                            <i class="bi bi-file-earmark-excel"></i>
                        </div>

                        <div class="flex-grow-1">
                            <strong>@System.IO.Path.GetFileName(Model.Archivo)</strong>
                            <small>Archivo de planificación mensual</small>
                        </div>

                        <a href="@Url.Action("Descargar", "PlanesEstudio", new { id = Model.IdPlan })"
                           target="_blank"
                           class="btn btn-outline-cop">

                            <i class="bi bi-download me-1"></i>
                            Descargar

                        </a>

                    </div>

                </div>


                <!-- OBSERVACIONES -->
                <div class="detail-card mt-4">

                    <h2 class="section-title">
                        <i class="bi bi-chat-left-text me-2"></i>
                        Observaciones
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="observation-box">

                            <p>
                                @Model.Observaciones
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="empty-observation">

                            <i class="bi bi-chat-square"></i>

                            <p>
                                El director aún no ha registrado observaciones.
                            </p>

                        </div>
                    }

                </div>

            </div>


            <!-- PANEL LATERAL -->
            <div class="col-lg-4">

                <div class="detail-card">

                    <h2 class="section-title">
                        Estado del plan
                    </h2>

                    <div class="timeline">

                        <div class="timeline-item completed">

                            <div class="timeline-dot">
                                <i class="bi bi-check"></i>
                            </div>

                            <div>
                                <strong>Plan registrado</strong>
                                <small> @Model.FechaCarga.ToString("dd/MM/yyyy")</small>
                            </div>

                        </div>


                        <div class="timeline-item active">

                            <div class="timeline-dot">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div>
                                <strong>En revisión</strong>
                                <small>Pendiente de resolución</small>
                            </div>

                        </div>

                        <div class="timeline-item">

                            @if (Model.Estado == "Pendiente")
                            {
                                <div class="timeline-dot">
                                    <i class="bi bi-clock"></i>
                                </div>
                            }
                            else if (Model.Estado == "Aprobado")
                            {
                                <div class="timeline-dot success">
                                    <i class="bi bi-check"></i>
                                </div>
                            }
                            else if (Model.Estado == "Denegado")
                            {
                                <div class="timeline-dot danger">
                                    <i class="bi bi-x"></i>
                                </div>
                            }

                            <div>

                                <strong>
                                    Resolución
                                </strong>

                                @if (Model.Estado == "Pendiente")
                                {
                                    <small>
                                        Aún no disponible
                                    </small>
                                }
                                else
                                {
                                    <small>
                                        @Model.Estado
                                    </small>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- AGREGAR UNA ACTIVIDAD A OUTLOOK (SIN MICROSOFT GRAPH) -->
                    <div class="detail-card mt-4 teams-panel">
                        <h2 class="section-title"><i class="bi bi-calendar-event me-2"></i>Calendario de actividades</h2>
                        @if (Model.Estado == "Aprobado")
                        {
                            <p class="text-muted mb-3">Completa los datos de una actividad para abrirla en el calendario de Outlook.</p>
                            <form id="formActividadOutlook">
                                <div class="mb-3">
                                    <label for="actividadNombre" class="form-label">Nombre de la actividad</label>
                                    <input id="actividadNombre" type="text" class="form-control" maxlength="150" required placeholder="Ej. Evaluación de Ciencias" />
                                </div>
                                <div class="mb-3">
                                    <label for="actividadFecha" class="form-label">Fecha</label>
                                    <input id="actividadFecha" type="date" class="form-control" required />
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label for="actividadInicio" class="form-label">Hora de inicio</label>
                                        <input id="actividadInicio" type="time" class="form-control" required />
                                    </div>
                                    <div class="col-6">
                                        <label for="actividadFin" class="form-label">Hora de finalización</label>
                                        <input id="actividadFin" type="time" class="form-control" required />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="actividadDescripcion" class="form-label">Descripción (opcional)</label>
                                    <textarea id="actividadDescripcion" class="form-control" rows="2" maxlength="1000" placeholder="Detalles de la actividad"></textarea>
                                </div>
                                <div id="actividadError" class="text-danger small mb-2" role="alert" style="display:none"></div>
                                <button type="submit" class="btn btn-cop-primary w-100">
                                    <i class="bi bi-calendar-plus me-1"></i>Agregar a Outlook
                                </button>
                            </form>
                            <small class="teams-hint">Outlook se abrirá con los datos precargados. Debes iniciar sesión si es necesario y guardar el evento.</small>
                        }
                        else
                        {
                            <div class="teams-box">
                                <i class="bi bi-lock"></i>
                                <div>
                                    <strong>Disponible únicamente para planes aprobados</strong>
                                    <p>Cuando el director apruebe este plan, podrás agregar actividades a Outlook.</p>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                <i class="bi bi-calendar-plus me-1"></i>Agregar a Outlook
                            </button>
                        }
                    </div>

                    <div class="mt-3 d-grid gap-2">


                    </div>

                </div>

            </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .planes-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .planes-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .planes-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .planes-title {
            color: var(--cop-primary);
            font-weight: 700;
            font-size: 1.8rem;
        }

        .planes-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .detail-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 22px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .detail-label {
            display: block;
            font-size: .8rem;
            color: var(--cop-muted);
            margin-bottom: 3px;
        }

        .file-card {
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid #e3e8ee;
            border-radius: 8px;
            padding: 14px;
        }

        .file-icon {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            background: #d1e7dd;
            color: #146c43;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .file-card small {
            display: block;
            color: var(--cop-muted);
        }

        .empty-observation {
            text-align: center;
            padding: 25px;
            color: var(--cop-muted);
        }

            .empty-observation i {
                font-size: 1.7rem;
            }

        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .timeline-item {
            display: flex;
            gap: 13px;
            position: relative;
            padding-bottom: 26px;
        }

            .timeline-item::after {
                content: "";
                position: absolute;
                left: 14px;
                top: 30px;
                bottom: 0;
                width: 2px;
                background: #e3e8ee;
            }

            .timeline-item:last-child::after {
                display: none;
            }

        .timeline-dot {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid #cbd5df;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
        }

        .timeline-item.completed .timeline-dot {
            background: #198754;
            border-color: #198754;
            color: white;
        }

        .timeline-item.active .timeline-dot {
            background: #fff3cd;
            border-color: #ffc107;
            color: #856404;
        }

        .timeline-item strong,
        .timeline-item small {
            display: block;
        }

        .timeline-item small {
            color: var(--cop-muted);
            margin-top: 2px;
        }

        .teams-box {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

            .teams-box > i {
                color: #6264A7;
                font-size: 1.5rem;
            }

            .teams-box p {
                font-size: .85rem;
                color: var(--cop-muted);
                margin: 4px 0 0;
            }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }


        .btn-outline-edit {
            border: 1px solid var(--cop-secondary);
            color: forestgreen;
        }


        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }


            .btn-outline-cop:hover {
                background: #e6f1fb;
                color: var(--cop-primary);
            }


        .timeline-dot.success {
            background: #198754;
            border-color: #198754;
            color: white;
        }

        .timeline-dot.danger {
            background: #dc3545;
            border-color: #dc3545;
            color: white;
        }

        .status-approved {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-rejected {
            background: #f8d7da;
            color: #842029;
        }

        /* Diseño unificado de encabezados - Planes de Estudio */
        .planes-page, body {
            background: #f4f7fa;
        }

        .planes-header {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 16px 0 24px !important;
        }

            .planes-header > .container {
                background: transparent !important;
                padding-left: 12px;
                padding-right: 12px;
            }

        .planes-breadcrumb {
            display: none !important;
        }

        .planes-header .planes-title {
            font-size: 1.55rem !important;
            line-height: 1.3;
            font-weight: 700 !important;
            color: #133c55 !important;
            margin: 0 0 5px !important;
        }

            .planes-header .planes-title i {
                color: #386fa4;
            }

        .planes-header .planes-subtitle {
            color: #64748b !important;
            font-size: .9rem !important;
            line-height: 1.55;
            margin: 0 !important;
        }

        .planes-header .planes-header-layout {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .planes-header .planes-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .planes-header .cop-back-btn {
            background: #fff;
            border: 1px solid #cbd5e1;
            color: #475569;
            font-weight: 600;
            border-radius: 7px;
            padding: .55rem 1rem;
            text-decoration: none;
            white-space: nowrap;
        }

            .planes-header .cop-back-btn:hover {
                background: #edf3f8;
                border-color: #386fa4;
                color: #133c55;
            }

        .planes-header .btn {
            border-radius: 7px;
        }

        .plans-container, .creation-card, .edit-card, .review-card, .detail-card {
            border-radius: 12px;
        }

        @@media(max-width:575px) {
            .planes-header .planes-title {
                font-size: 1.32rem !important;
            }
        }

        .planes-header .planes-header-actions {
            gap: 0 !important;
        }

        .planes-header .plan-state-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-left: 22px;
            padding: 10px 16px;
            border-radius: 9px;
            font-size: .86rem;
            font-weight: 750;
            line-height: 1.2;
            border: 1px solid transparent;
            box-shadow: 0 2px 8px rgba(15,23,42,.05);
        }

            .planes-header .plan-state-badge i {
                font-size: 1rem;
            }

        .planes-header .status-approved {
            background: #e4f5eb;
            color: #12663c;
            border-color: #b7e2c9;
        }

        .planes-header .status-rejected {
            background: #fde8e9;
            color: #a32635;
            border-color: #f3bfc5;
        }

        .planes-header .status-pending {
            background: #fff4d7;
            color: #8a6008;
            border-color: #f2d58a;
        }

        .teams-panel .section-title i {
            color: #6264a7;
        }

        .teams-panel .teams-box {
            background: #f8f9fd;
            padding: 14px;
            border: 1px solid #e7e8f3;
            border-radius: 9px;
        }

        .teams-panel .teams-hint {
            display: block;
            margin-top: 10px;
            color: #64748b;
            font-size: .76rem;
            line-height: 1.5;
        }

        @@media(max-width:575px) {
            .planes-header .planes-header-actions {
                width: 100%;
                justify-content: space-between;
                gap: 12px !important;
            }

            .planes-header .plan-state-badge {
                margin-left: 0;
            }
        }
    </style>

}
<script>
    (function () {
        var form = document.getElementById('formActividadOutlook');
        if (!form) return;

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var nombre = document.getElementById('actividadNombre').value.trim();
            var fecha = document.getElementById('actividadFecha').value;
            var inicio = document.getElementById('actividadInicio').value;
            var fin = document.getElementById('actividadFin').value;
            var descripcion = document.getElementById('actividadDescripcion').value.trim();
            var error = document.getElementById('actividadError');
            error.style.display = 'none';

            if (!nombre || !fecha || !inicio || !fin || fin <= inicio) {
                error.textContent = 'Completa los datos e indica una hora de finalización posterior a la de inicio.';
                error.style.display = 'block';
                return;
            }

            // Zona horaria de Costa Rica (UTC-06:00, sin horario de verano).
            var fechaInicio = new Date(fecha + 'T' + inicio + ':00-06:00');
            var fechaFin = new Date(fecha + 'T' + fin + ':00-06:00');
            if (isNaN(fechaInicio.getTime()) || isNaN(fechaFin.getTime())) {
                error.textContent = 'La fecha o las horas no son válidas.';
                error.style.display = 'block';
                return;
            }

            var parametros = [
                'path=%2Fcalendar%2Faction%2Fcompose',
                'rru=addevent',
                'subject=' + encodeURIComponent(nombre),
                'startdt=' + encodeURIComponent(fechaInicio.toISOString()),
                'enddt=' + encodeURIComponent(fechaFin.toISOString()),
                'body=' + encodeURIComponent(descripcion || 'Actividad del plan de estudio - Aula Virtual Copalchí')
            ];
            window.open('https://outlook.office.com/calendar/deeplink/compose?' + parametros.join('&'), '_blank', 'noopener,noreferrer');
        });
    })();
</script>
