@using System.Linq
@model EscuelaCopalchi.UI.Models.PlanesEstudio.PlanEstudio

@{
    ViewBag.Title = "Nuevo plan de estudio";
}

<main>

    <section class="planes-header">
        <div class="container">

            <div class="planes-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <a href="@Url.Action("Index", "PlanesEstudio")">Planes de estudio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Nuevo plan</span>
            </div>

            <h1 class="planes-title">
                <i class="bi bi-file-earmark-plus me-2"></i>
                Nuevo plan de estudio
            </h1>

            <p class="planes-subtitle">
                Registra la planificación académica mensual mediante un archivo Excel
                o ingresando la información manualmente.
            </p>

        </div>
    </section>


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <section class="container pb-5">

        <div class="creation-card">


            @using (Html.BeginForm(
                "Crear",
                "PlanesEstudio",
                FormMethod.Post,
                new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <!-- FORMULARIO EXCEL -->
                <div id="formExcel">

                    <div class="form-section">

                        <div class="section-heading">
                            <i class="bi bi-file-earmark-excel"></i>
                            <div>
                                <h3>Carga el Plan de Estudio Aquí</h3>
                                <p>Selecciona el periodo y el archivo correspondiente.</p>
                            </div>
                        </div>


                        <div class="row g-3">
<div class="col-md-6">
<label class="form-label">Docente</label>
@if ((bool)(ViewBag.DocenteVinculado ?? false))
{
    <input class="form-control" value="@ViewBag.NombreDocente" readonly />
}
else
{
    @Html.DropDownListFor(x => x.IdDocente, (IEnumerable<SelectListItem>)ViewBag.Docentes,
        "Seleccione un docente", new { @class = "form-select", required = "required" })
}
</div>
<div class="col-md-6"><label class="form-label">Grupo</label>@Html.DropDownListFor(x=>x.IdGrupo,(IEnumerable<SelectListItem>)ViewBag.Grupos,"Seleccione un grupo",new {@class="form-select",required="required"})</div>
<div class="col-12"><label class="form-label">Título del plan</label>@Html.TextBoxFor(x=>x.Titulo,new {@class="form-control",required="required",maxlength="200",placeholder="Ej. Plan mensual de Matemáticas"})</div>


                            <div class="col-md-6"><label class="form-label">Mes</label>@Html.DropDownListFor(x => x.Mes, Enumerable.Range(1, 12).Select(m => new SelectListItem { Value = m.ToString(), Text = new DateTime(2000, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("es-CR")), Selected = Model != null && Model.Mes == m }), "Seleccione el mes", new { @class = "form-select", required = "required", id = "Periodo" })</div>


                            <div class="col-md-6">
                                <label class="form-label">Año</label>

                                <select id="Anio" class="form-select"
                                        name="Anio"
                                        required>

                                    @{
                                        int anioActual = DateTime.Now.Year;
                                    }

                                    @for (int anio = anioActual; anio <= anioActual + 5; anio++)
                                    {
                                        <option value="@anio">
                                            @anio
                                        </option>
                                    }

                                </select>
                            </div>


                            <div class="col-md-6">
                                <label class="form-label">Grado</label>
                                <select id="Nivel" class="form-select"
                                        name="Nivel"
                                        required>

                                    <option selected disabled>
                                        Seleccione una opción
                                    </option>

                                    <option value="Preescolar">Preescolar</option>
                                    <option value="Primer grado">Primer grado</option>
                                    <option value="Segundo grado">Segundo grado</option>
                                    <option value="Tercer grado">Tercer grado</option>
                                    <option value="Cuarto grado">Cuarto grado</option>
                                    <option value="Quinto grado">Quinto grado</option>
                                    <option value="Sexto grado">Sexto grado</option>

                                </select>
                            </div>


                            <div class="col-md-6">
                                <label class="form-label">Asignatura</label>

                                <select id="Asignatura" class="form-select"
                                        name="Asignatura"
                                        required>

                                    <option selected disabled>
                                        Seleccione una opción
                                    </option>

                                    <option value="Español">Español</option>
                                    <option value="Matemáticas">Matemáticas</option>
                                    <option value="Ciencias">Ciencias</option>
                                    <option value="Estudios Sociales">Estudios Sociales</option>
                                    <option value="Inglés">Inglés</option>

                                </select>
                            </div>


                            <div class="col-12">

                                <label class="form-label">Archivo Excel o PDF</label>

                                <div class="upload-box">

                                    <i class="bi bi-cloud-arrow-up upload-icon"></i>

                                    <h4>Selecciona tu archivo</h4>

                                    <p>
                                        Formato permitido: .xlsx,  .xls o .pdf
                                    </p>

                                    <input type="file"
                                           name="archivo"
                                           class="form-control"
                                           accept=".xlsx,.xls,.pdf"
                                           required />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- BOTONES -->
                <div class="form-actions">

                    <a href="@Url.Action("Index", "PlanesEstudio")"
                       class="btn btn-cancel">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-cop-primary"
                            onclick="return validarPlan();">
                        <i class="bi bi-save me-1"></i>
                        Guardar plan
                    </button>

                </div>
            }
        </div>

    </section>


</main>


<script>

    function validarPlan() {

        var periodo =
            document.getElementById(
                "Periodo").value;

        var anio =
            document.getElementById(
                "Anio").value;

        var nivel =
            document.getElementById(
                "Nivel").value;

        var asignatura =
            document.getElementById(
                "Asignatura").value;

        if (!periodo) {
            alert(
                "Debe seleccionar un período.");

            return false;
        }

        if (anio === "Seleccione una opción") {
            alert(
                "Debe seleccionar un año.");

            return false;
        }

        if (nivel === "Seleccione una opción") {
            alert(
                "Debe seleccionar un nivel.");

            return false;
        }

        if (asignatura === "Seleccione una opción") {
            alert(
                "Debe seleccionar una asignatura.");

            return false;
        }

        return true;
    }

</script>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-accent: #59A5D8;
            --cop-light: #91E5F6;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background-color: var(--cop-page-bg);
        }

        .planes-header {
            background: #fff;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .planes-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .planes-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .planes-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .planes-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .creation-card {
            background: #fff;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 26px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.25rem;
            font-weight: 600;
        }

        .section-subtitle {
            color: var(--cop-muted);
            margin-bottom: 20px;
        }

        .option-card {
            border: 2px solid #e3e8ee;
            border-radius: 10px;
            padding: 20px;
            display: flex;
            gap: 15px;
            cursor: pointer;
            height: 100%;
            transition: .2s;
        }

            .option-card:hover,
            .option-card.active {
                border-color: var(--cop-accent);
                background: #f3f9fd;
            }

        .option-icon {
            width: 50px;
            height: 50px;
            flex-shrink: 0;
            border-radius: 9px;
            background: #e6f1fb;
            color: var(--cop-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.4rem;
        }

        .option-card h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--cop-primary);
        }

        .option-card p {
            font-size: .88rem;
            color: var(--cop-muted);
            margin: 0;
        }

        .form-section {
            border-top: 1px solid #edf0f3;
            padding-top: 25px;
        }

        .section-heading {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 22px;
        }

            .section-heading > i {
                font-size: 1.4rem;
                color: var(--cop-secondary);
            }

            .section-heading h3 {
                margin: 0;
                color: var(--cop-primary);
                font-size: 1.1rem;
            }

            .section-heading p {
                margin: 3px 0 0;
                color: var(--cop-muted);
                font-size: .85rem;
            }

        .form-label {
            font-size: .9rem;
            font-weight: 600;
            color: #344054;
        }

        .upload-box {
            border: 2px dashed #cad5df;
            border-radius: 10px;
            padding: 28px;
            text-align: center;
            background: #fafcfd;
        }

        .upload-icon {
            font-size: 2rem;
            color: var(--cop-secondary);
        }

        .upload-box h4 {
            font-size: 1rem;
            color: var(--cop-primary);
            margin-top: 10px;
        }

        .upload-box p {
            color: var(--cop-muted);
            font-size: .85rem;
        }

        .form-actions {
            border-top: 1px solid #edf0f3;
            padding-top: 20px;
            margin-top: 25px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border: 1px solid var(--cop-primary);
        }

            .btn-cop-primary:hover {
                background: var(--cop-secondary);
                color: white;
            }

        .btn-cancel {
            border: 1px solid #ced4da;
            background: white;
            color: #495057;
        }
    </style>

}

