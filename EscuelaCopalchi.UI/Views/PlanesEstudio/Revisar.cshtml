@{
    ViewBag.Title = "Revisar plan";
}

<main>

    <section class="planes-header">

        <div class="container">

            <div class="planes-breadcrumb">

                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "PlanesEstudio")">
                    Planes de estudio
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Revisión</span>

            </div>


            <h1 class="planes-title">
                <i class="bi bi-clipboard-check me-2"></i>
                Revisión de plan
            </h1>

            <p class="planes-subtitle">
                Revisa la planificación enviada por el docente
                y registra la resolución correspondiente.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <div class="row g-4">

            <!-- PLAN -->
            <div class="col-lg-8">

                <div class="review-card">

                    <div class="plan-header">

                        <div>

                            <span class="small-label">
                                Plan de estudio
                            </span>

                            <h2>
                                Plan mensual de Matemáticas
                            </h2>

                            <p>
                                Primer grado · Agosto 2026
                            </p>

                        </div>


                        <span class="status-pending">
                            <i class="bi bi-clock me-1"></i>
                            Pendiente
                        </span>

                    </div>


                    <hr />


                    <div class="row g-4">

                        <div class="col-md-6">
                            <span class="detail-label">Docente</span>
                            <strong>María González</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Fecha de envío</span>
                            <strong>05/08/2026</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Asignatura</span>
                            <strong>Matemáticas</strong>
                        </div>

                        <div class="col-md-6">
                            <span class="detail-label">Tipo de registro</span>
                            <strong>Archivo Excel</strong>
                        </div>

                    </div>

                </div>


                <!-- ARCHIVO -->
                <div class="review-card mt-4">

                    <h3 class="section-title">
                        Documento adjunto
                    </h3>


                    <div class="file-card">

                        <div class="file-icon">
                            <i class="bi bi-file-earmark-excel"></i>
                        </div>


                        <div class="flex-grow-1">

                            <strong>
                                Plan_Matematicas_Agosto.xlsx
                            </strong>

                            <small>
                                Archivo enviado por el docente
                            </small>

                        </div>


                        <button class="btn btn-outline-cop">

                            <i class="bi bi-download me-1"></i>
                            Descargar

                        </button>

                    </div>

                </div>

            </div>


            <!-- RESOLUCIÓN -->
            <div class="col-lg-4">

                <div class="review-card sticky-lg-top review-panel">

                    <h3 class="section-title">
                        Resolución
                    </h3>


                    <p class="review-description">

                        Selecciona la decisión correspondiente
                        después de revisar el plan.

                    </p>


                    <label class="form-label">
                        Observaciones
                    </label>


                    <textarea id="observacion"
                              class="form-control"
                              rows="6"
                              placeholder="Ingrese las observaciones para el docente..."></textarea>


                    <small class="text-muted d-block mt-2">
                        La observación es obligatoria si rechazas el plan.
                    </small>


                    <hr />


                    <button type="button"
                            class="btn btn-approve w-100 mb-2"
                            onclick="aprobarPlan()">

                        <i class="bi bi-check-circle me-1"></i>
                        Aprobar plan

                    </button>


                    <button type="button"
                            class="btn btn-reject w-100"
                            onclick="rechazarPlan()">

                        <i class="bi bi-x-circle me-1"></i>
                        Rechazar plan

                    </button>


                    <a href="@Url.Action("Index", "PlanesEstudio")"
                       class="btn btn-light w-100 mt-2">

                        Cancelar

                    </a>

                </div>

            </div>

        </div>

    </section>

</main>


<!-- MODAL APROBAR -->
<div class="modal fade"
     id="modalAprobar"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Aprobar plan
                </h5>
            </div>

            <div class="modal-body">

                <div class="modal-icon success">
                    <i class="bi bi-check-circle"></i>
                </div>

                <p class="text-center">
                    ¿Deseas aprobar este plan de estudio?
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-approve">
                    Confirmar aprobación
                </button>

            </div>

        </div>

    </div>

</div>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .planes-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .planes-breadcrumb {
            display: flex;
            gap: 7px;
            align-items: center;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .planes-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .planes-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .planes-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .review-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            padding: 22px;
        }

        .plan-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .small-label {
            color: var(--cop-muted);
            font-size: .8rem;
        }

        .plan-header h2 {
            color: var(--cop-primary);
            font-size: 1.35rem;
            margin: 3px 0;
        }

        .plan-header p {
            color: var(--cop-muted);
            margin: 0;
        }

        .status-pending {
            white-space: nowrap;
            background: #fff3cd;
            color: #856404;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: 600;
        }

        .detail-label {
            display: block;
            color: var(--cop-muted);
            font-size: .8rem;
            margin-bottom: 3px;
        }

        .section-title {
            color: var(--cop-primary);
            font-size: 1.1rem;
            font-weight: 600;
        }

        .file-card {
            display: flex;
            align-items: center;
            gap: 13px;
            border: 1px solid #e3e8ee;
            padding: 14px;
            border-radius: 8px;
        }

            .file-card small {
                display: block;
                color: var(--cop-muted);
            }

        .file-icon {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            background: #d1e7dd;
            color: #146c43;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .review-description {
            color: var(--cop-muted);
            font-size: .9rem;
        }

        .review-panel {
            top: 20px;
        }

        .form-label {
            font-size: .9rem;
            font-weight: 600;
            color: #344054;
        }

        .btn-approve {
            background: #198754;
            color: white;
            border: 1px solid #198754;
        }

            .btn-approve:hover {
                background: #157347;
                color: white;
            }

        .btn-reject {
            background: white;
            color: #dc3545;
            border: 1px solid #dc3545;
        }

            .btn-reject:hover {
                background: #dc3545;
                color: white;
            }

        .btn-outline-cop {
            border: 1px solid var(--cop-secondary);
            color: var(--cop-secondary);
        }

        .modal-icon {
            font-size: 3rem;
            text-align: center;
        }

            .modal-icon.success {
                color: #198754;
            }
    </style>

}


@section scripts {

    <script>

    function aprobarPlan() {

        var modal = new bootstrap.Modal(
            document.getElementById('modalAprobar')
        );

        modal.show();

    }


    function rechazarPlan() {

        var observacion =
            document.getElementById("observacion").value.trim();

        if (observacion === "") {

            alert("Debe ingresar una observación para rechazar el plan.");

            document
                .getElementById("observacion")
                .focus();

            return;

        }

        if (confirm("¿Desea rechazar este plan?")) {

            alert("El plan ha sido rechazado.");

        }

    }

    </script>

}