@model EscuelaCopalchi.UI.Models.Traslados.TrasladoViewModel
@{
    ViewBag.Title = "Gestión de Traslados";
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
    <style>
        .traslado-planes {
            background: #f4f7fa;
            min-width: 0;
            padding-bottom: 35px;
        }

            .traslado-planes .planes-header {
                padding: 0 0 24px;
            }

                .traslado-planes .planes-header > .container {
                    max-width: none;
                    padding: 0;
                }

            .traslado-planes .planes-header-layout {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                flex-wrap: wrap;
            }

            .traslado-planes .planes-title {
                font-size: 1.55rem;
                line-height: 1.3;
                font-weight: 700;
                color: #133c55;
                margin: 0 0 5px;
            }

                .traslado-planes .planes-title i {
                    color: #386fa4;
                }

            .traslado-planes .planes-subtitle {
                color: #64748b;
                font-size: .9rem;
                margin: 0;
            }

            .traslado-planes .cop-back-btn {
                background: #fff;
                border: 1px solid #cbd5e1;
                color: #475569;
                font-weight: 600;
                border-radius: 7px;
                padding: .55rem 1rem;
            }

                .traslado-planes .cop-back-btn:hover {
                    background: #edf3f8;
                    border-color: #386fa4;
                    color: #133c55;
                }

        .auditoria-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding-top: 22px;
            margin-top: 12px;
            border-top: 1px solid #edf1f5;
        }

        .auditoria-pagination-info {
            font-size: .87rem;
            color: #718092;
        }

            .auditoria-pagination-info strong {
                color: #34495e;
            }

        .auditoria-pages {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
        }

        .auditoria-page-btn {
            min-width: 37px;
            height: 37px;
            padding: 0 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dce5ed;
            border-radius: 8px;
            background: #fff;
            color: #4b6479;
            text-decoration: none;
            font-size: .86rem;
            font-weight: 650;
            cursor: pointer;
        }

            .auditoria-page-btn:hover:not(:disabled) {
                background: #edf4f9;
                border-color: #b7d0e0;
                color: #173b53;
            }

            .auditoria-page-btn.active {
                background: #173b53;
                border-color: #173b53;
                color: #fff;
            }

            .auditoria-page-btn:disabled {
                opacity: .45;
                cursor: not-allowed;
            }

        @@media (max-width:768px) {
            .traslado-planes {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
    </style>

}
<main class="container auditoria-page traslado-planes py-4">

    <section class="planes-header">
        <div class="container">
            <div class="planes-header-layout">
                <div>
                    <h1 class="planes-title"><i class="bi bi-envelope-paper me-2"></i>Gestión de Traslados</h1>
                    <p class="planes-subtitle">Genera cartas oficiales con el historial académico o consulta documentos registrados.</p>
                </div>
                <div class="planes-header-actions"><a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a></div>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="p-3 bg-white border rounded-3"><small class="text-muted">Estudiantes disponibles</small><h3 class="mb-0" style="color:#133C55">@Model.Estudiantes.Count</h3></div></div>
        <div class="col-md-4"><div class="p-3 bg-white border rounded-3"><small class="text-muted">Cartas registradas</small><h3 class="mb-0" style="color:#133C55">@Model.Cartas.Count</h3></div></div>
        <div class="col-md-4"><div class="p-3 bg-white border rounded-3"><small class="text-muted">Cartas generadas</small><h3 class="mb-0" style="color:#133C55">@Model.Cartas.Count(c => c.Tipo == "Generada")</h3></div></div>
    </div>
    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}
    @if (ViewBag.Error != null)
    {<div class="alert alert-danger">@ViewBag.Error</div>}

    <form method="get" class="gn-filters">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Buscar estudiante</label>
                <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Nombre o identificación">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn gn-btn w-100"><i class="bi bi-search me-1"></i> Buscar</button>
            </div>
        </div>
    </form>

    <div class="table-responsive gn-table-wrap mb-4">
        <table class="table align-middle gn-table" id="rpEstudiantesTraslado">
            <thead>
                <tr><th>Estudiante</th><th>Grupo</th><th class="text-end">Carta</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Estudiantes)
                {
                    <tr>
                        <td><strong>@e.Estudiante</strong><div class="text-muted small">@e.Identificacion</div></td>
                        <td>@e.Grupo</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm gn-btn" data-bs-toggle="modal" data-bs-target="#mdGenerar"
                                    data-id="@e.IdEstudiante" data-nombre="@e.Estudiante">
                                <i class="bi bi-file-earmark-word me-1"></i> Generar
                            </button>
                            <button type="button" class="btn btn-sm gn-btn-out" data-bs-toggle="modal" data-bs-target="#mdCargar"
                                    data-id="@e.IdEstudiante" data-nombre="@e.Estudiante">
                                <i class="bi bi-upload me-1"></i> Cargar
                            </button>
                        </td>
                    </tr>
                }
                @if (Model.Estudiantes.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No se encontraron estudiantes matriculados.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="auditoria-pagination mb-4"><div id="rpTrasladoRango" class="auditoria-pagination-info"></div><nav id="rpTrasladoPaginas" class="auditoria-pages" aria-label="Paginación de estudiantes"></nav></div>
    <h5 class="mb-3" style="color:#133C55;font-weight:700">Cartas registradas</h5>
    <div class="table-responsive gn-table-wrap mb-4">
        <table class="table align-middle gn-table" id="rpCartasTraslado">
            <thead>
                <tr><th>Fecha</th><th>Estudiante</th><th>Tipo</th><th>Destino</th><th>Registrada por</th><th class="text-end">Archivo</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cartas)
                {
                    <tr>
                        <td>@c.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@c.Estudiante</td>
                        <td><span class="badge gn-badge @(c.Tipo == "Generada" ? "gn-badge-ext" : "")">@c.Tipo</span></td>
                        <td>@(string.IsNullOrEmpty(c.Destino) ? "-" : c.Destino)</td>
                        <td>@c.Usuario</td>
                        <td class="text-end">
                            <a class="gn-link" href="@Url.Action("DescargarCarta", new { id = c.IdCarta })"><i class="bi bi-download me-1"></i>@c.Archivo</a>
                        </td>
                    </tr>
                }
                @if (Model.Cartas.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Aún no hay cartas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="auditoria-pagination mb-4"><div id="rpCartasRango" class="auditoria-pagination-info"></div><nav id="rpCartasPaginas" class="auditoria-pages" aria-label="Paginación de cartas"></nav></div>
</main>

<!-- Generar carta -->
<div class="modal fade" id="mdGenerar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("GenerarCarta", "Traslados", FormMethod.Post, new { @class = "modal-content", id = "fGenerar" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="idEstudiante" id="gId" />
            <div class="modal-header">
                <h5 class="modal-title">Generar carta de traslado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Estudiante: <strong id="gNombre"></strong></p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Escuela o institución de destino</label>
                    <input type="text" name="destino" class="form-control" maxlength="150" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Motivo del traslado <span class="text-muted fw-normal">(opcional)</span></label>
                    <textarea name="motivo" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">Lugar de emisión</label>
                    <input type="text" name="lugar" class="form-control" value="Cartago" maxlength="60" />
                </div>
                <div class="form-text">La carta se descarga en Word e incluye el historial académico. Queda guardada en "Cartas registradas".</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn gn-btn-out" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn gn-btn"><i class="bi bi-file-earmark-word me-1"></i> Generar y descargar</button>
            </div>
        }
    </div>
</div>

<!-- Cargar carta -->
<div class="modal fade" id="mdCargar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("CargarCarta", "Traslados", FormMethod.Post, new { @class = "modal-content", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="idEstudiante" id="cId" />
            <div class="modal-header">
                <h5 class="modal-title">Cargar carta de traslado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Estudiante: <strong id="cNombre"></strong></p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Escuela o institución de destino <span class="text-muted fw-normal">(opcional)</span></label>
                    <input type="text" name="destino" class="form-control" maxlength="150" />
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">Archivo de la carta</label>
                    <input type="file" name="archivo" class="form-control" accept=".docx,.doc,.pdf" required />
                </div>
                <div class="form-text">Word (.docx, .doc) o PDF, máximo 4 MB.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn gn-btn-out" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn gn-btn"><i class="bi bi-upload me-1"></i> Cargar carta</button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
                                (function () {
                                    function enlazar(idModal, idCampo, idNombre) {
                                        document.getElementById(idModal).addEventListener('show.bs.modal', function (ev) {
                                            var b = ev.relatedTarget;
                                            document.getElementById(idCampo).value = b.getAttribute('data-id');
                                            document.getElementById(idNombre).textContent = b.getAttribute('data-nombre');
                                        });
                                    }
                                    function paginar(tablaId, rangoId, navId, porPagina) {
                                        var tabla = document.getElementById(tablaId);
                                        var rango = document.getElementById(rangoId);
                                        var nav = document.getElementById(navId);
                                        if (!tabla || !rango || !nav) return;
                                        var filas = Array.prototype.slice.call(tabla.querySelectorAll('tbody tr')).filter(function (tr) {
                                            return !tr.querySelector('td[colspan]');
                                        });
                                        var pagina = 1;
                                        function pintar() {
                                            var totalRegistros = filas.length;
                                            var totalPaginas = Math.max(1, Math.ceil(totalRegistros / porPagina));
                                            pagina = Math.max(1, Math.min(pagina, totalPaginas));
                                            var inicio = (pagina - 1) * porPagina;
                                            filas.forEach(function (tr, i) {
                                                tr.style.display = i >= inicio && i < inicio + porPagina ? '' : 'none';
                                            });
                                            rango.innerHTML = 'Mostrando <strong>' + (totalRegistros ? inicio + 1 : 0) +
                                                '–' + (totalRegistros ? Math.min(inicio + porPagina, totalRegistros) : 0) +
                                                '</strong> de <strong>' + totalRegistros + '</strong> registros · Página <strong>' +
                                                pagina + '</strong> de <strong>' + totalPaginas + '</strong>';
                                            nav.innerHTML = '';
                                            if (totalPaginas <= 1) return;
                                            function boton(texto, destino, deshabilitado, activo, etiqueta) {
                                                var b = document.createElement('button');
                                                b.type = 'button';
                                                b.className = 'auditoria-page-btn' + (activo ? ' active' : '');
                                                b.textContent = texto;
                                                b.disabled = deshabilitado;
                                                b.setAttribute('aria-label', etiqueta);
                                                if (activo) b.setAttribute('aria-current', 'page');
                                                b.addEventListener('click', function () { pagina = destino; pintar(); });
                                                nav.appendChild(b);
                                            }
                                            boton('«', 1, pagina === 1, false, 'Primera página');
                                            boton('‹', pagina - 1, pagina === 1, false, 'Página anterior');
                                            var desde = Math.max(1, pagina - 2);
                                            var hasta = Math.min(totalPaginas, desde + 4);
                                            desde = Math.max(1, hasta - 4);
                                            for (var n = desde; n <= hasta; n++) {
                                                boton(String(n), n, false, n === pagina, 'Página ' + n);
                                            }
                                            boton('›', pagina + 1, pagina === totalPaginas, false, 'Página siguiente');
                                            boton('»', totalPaginas, pagina === totalPaginas, false, 'Última página');
                                        }
                                        pintar();
                                    }
                                    paginar('rpEstudiantesTraslado','rpTrasladoRango','rpTrasladoPaginas',10);
                                    paginar('rpCartasTraslado','rpCartasRango','rpCartasPaginas',10);
                                    enlazar('mdGenerar', 'gId', 'gNombre');
                                    enlazar('mdCargar', 'cId', 'cNombre');

                                    // la carta generada se descarga; luego se recarga la página para ver el registro
                                    document.getElementById('fGenerar').addEventListener('submit', function () {
                                        setTimeout(function () { window.location.reload(); }, 2500);
                                    });
                                })();
    </script>
}
