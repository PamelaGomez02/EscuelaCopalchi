@model EscuelaCopalchi.UI.Models.Monitoreo.MonitoreoIndexVM
@using EscuelaCopalchi.UI.Models.Monitoreo
@{
    ViewBag.Title = "Monitoreo académico";
    var r = Model.Resumen ?? new ResumenRendimiento();
    var u = Model.Umbrales ?? UmbralesRendimiento.Actual();
}

<main>

    @* ENCABEZADO *@
    <section class="monitor-header">
        <div class="container">

            <div class="monitor-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Monitoreo académico</span>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="monitor-title">
                        <i class="bi bi-graph-up me-2"></i>
                        Monitoreo académico
                    </h1>
                    <p class="monitor-subtitle">
                        Seguimiento del rendimiento de sus estudiantes durante el período lectivo.
                    </p>
                </div>

                @if (!Model.SinInformacion)
                {
                    <a href="@Url.Action("Reporte", "Monitoreo", new { anio = Model.Anio, grupo = (Model.IdGrupo > 0 ? (int?)Model.IdGrupo : null), materia = Model.Materia, trimestre = Model.Trimestre, generar = true })"
                       class="btn btn-cop-primary">
                        <i class="bi bi-file-earmark-bar-graph me-1"></i>
                        Generar reporte
                    </a>
                }
            </div>

        </div>
    </section>

    @* CONTENIDO *@
    <section class="container pb-5">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-1"></i> @TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @Model.Error
            </div>
        }

        @if (Model.SinInformacion)
        {
            <div class="monitor-card">
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h3>@EstadosRendimiento.MensajeSinInformacion</h3>
                    <p class="mb-0">Todavía no tiene grupos asignados con estudiantes para monitorear.</p>
                </div>
            </div>
        }
        else
        {
            @* RESUMEN *@
            <div class="row g-3 mb-4">

                <div class="col-6 col-lg-3">
                    <div class="summary-card">
                        <div class="summary-icon"><i class="bi bi-bar-chart"></i></div>
                        <div>
                            <span>Promedio general</span>
                            <h2>@MonitoreoUI.Fmt(r.Promedio)</h2>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="summary-card">
                        <div class="summary-icon summary-icon-success"><i class="bi bi-check-circle"></i></div>
                        <div>
                            <span>Aprobados</span>
                            <h2 class="success-value">@r.Aprobados</h2>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="summary-card">
                        <div class="summary-icon summary-icon-warning"><i class="bi bi-exclamation-triangle"></i></div>
                        <div>
                            <span>En riesgo</span>
                            <h2 class="warning-value">@r.EnRiesgo</h2>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="summary-card">
                        <div class="summary-icon summary-icon-danger"><i class="bi bi-x-circle"></i></div>
                        <div>
                            <span>Reprobados</span>
                            <h2 class="text-danger">@r.Reprobados</h2>
                        </div>
                    </div>
                </div>

            </div>

            if (r.SinNotas > 0)
            {
                <div class="alert alert-secondary py-2">
                    <i class="bi bi-info-circle me-1"></i>
                    @r.SinNotas @(r.SinNotas == 1
                        ? "estudiante aún no tiene calificaciones registradas y no se incluye"
                        : "estudiantes aún no tienen calificaciones registradas y no se incluyen") en el promedio general.
                </div>
            }

            @* CONTENEDOR PRINCIPAL *@
            <div class="monitor-card">

                @using (Html.BeginForm("Index", "Monitoreo", FormMethod.Get))
                {
                    @* TOOLBAR *@
                    <div class="monitor-toolbar">
                        <div>
                            <h2>Rendimiento estudiantil</h2>
                            <p>Promedio y estado académico de cada estudiante.</p>
                        </div>

                        <div class="search-box">
                            <i class="bi bi-search"></i>
                            <input type="text" name="q" value="@Model.Buscar" class="form-control" placeholder="Buscar estudiante..." />
                        </div>
                    </div>

                    @* FILTROS *@
                    <div class="monitor-filters">

                        <div>
                            <label class="filter-label">Año</label>
                            <select name="anio" class="form-select" onchange="this.form.submit()">
                                @foreach (var a in Model.Anios)
                                {
                                    <option value="@a" selected="@(a == Model.Anio)">@a</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="filter-label">Grupo</label>
                            <select name="grupo" class="form-select" onchange="this.form.submit()">
                                <option value="">Todos mis grupos</option>
                                @foreach (var g in Model.Grupos)
                                {
                                    <option value="@g.IdGrupo" selected="@(g.IdGrupo == Model.IdGrupo)">@g.Grupo</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="filter-label">Materia</label>
                            <select name="materia" class="form-select" onchange="this.form.submit()">
                                <option value="">Todas las materias</option>
                                @foreach (var m in Model.Materias)
                                {
                                    <option value="@m" selected="@(m == Model.Materia)">@m</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="filter-label">Período</label>
                            <select name="trimestre" class="form-select" onchange="this.form.submit()">
                                <option value="0" selected="@(Model.Trimestre == 0)">Todos los trimestres</option>
                                <option value="1" selected="@(Model.Trimestre == 1)">I Trimestre</option>
                                <option value="2" selected="@(Model.Trimestre == 2)">II Trimestre</option>
                                <option value="3" selected="@(Model.Trimestre == 3)">III Trimestre</option>
                            </select>
                        </div>

                        <div>
                            <label class="filter-label">Estado</label>
                            <select name="estado" class="form-select" onchange="this.form.submit()">
                                <option value="">Todos los estados</option>
                                <option value="@EstadosRendimiento.Aprobado" selected="@(Model.Estado == EstadosRendimiento.Aprobado)">Aprobado</option>
                                <option value="@EstadosRendimiento.EnRiesgo" selected="@(Model.Estado == EstadosRendimiento.EnRiesgo)">En Riesgo</option>
                                <option value="@EstadosRendimiento.Reprobado" selected="@(Model.Estado == EstadosRendimiento.Reprobado)">Reprobado</option>
                                <option value="@EstadosRendimiento.SinNotas" selected="@(Model.Estado == EstadosRendimiento.SinNotas)">Sin calificaciones</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-cop-primary btn-sm">Buscar</button>
                            <a href="@Url.Action("Index", "Monitoreo")" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                        </div>

                    </div>
                }

                @* LEYENDA *@
                <div class="legend">
                    <span><span class="dot dot-ok"></span>Aprobado: promedio de @MonitoreoUI.Fmt(u.NotaAprobado) o más</span>
                    <span><span class="dot dot-warning"></span>En Riesgo: de @MonitoreoUI.Fmt(u.NotaMinima) a menos de @MonitoreoUI.Fmt(u.NotaAprobado)</span>
                    <span><span class="dot dot-danger"></span>Reprobado: menos de @MonitoreoUI.Fmt(u.NotaMinima)</span>
                </div>

                @* TABLA *@
                @if (Model.Estudiantes.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <h3>@(r.Total == 0 ? EstadosRendimiento.MensajeSinInformacion : "Ningún estudiante coincide con los filtros.")</h3>
                        <p class="mb-0">@(r.Total == 0 ? "No hay estudiantes registrados para esta selección." : "Pruebe con otro estado o limpie la búsqueda.")</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table monitor-table align-middle">
                            <thead>
                                <tr>
                                    <th>Estudiante</th>
                                    <th>Grupo</th>
                                    <th>Promedio</th>
                                    <th>Estado</th>
                                    <th class="text-end">Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.Estudiantes)
                                {
                                    var detalle = MonitoreoCalculo.PorAsignatura(e.Detalle);

                                    <tr>
                                        <td>
                                            <div class="student-info">
                                                <div class="student-avatar">@e.Iniciales</div>
                                                <div>
                                                    <strong>@e.Estudiante</strong>
                                                    <small>@e.Identificacion</small>
                                                </div>
                                            </div>
                                        </td>

                                        <td>@e.Grupo</td>

                                        <td>
                                            @if (e.TieneNotas)
                                            {
                                                <span class="grade-value @MonitoreoUI.ClaseNota(e.Estado)">@MonitoreoUI.Fmt(e.Promedio)</span>
                                            }
                                            else
                                            {
                                                <span class="no-grades"><i class="bi bi-info-circle me-1"></i>@e.Mensaje</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="status @MonitoreoUI.ClaseEstado(e.Estado)">
                                                <i class="bi @MonitoreoUI.IconoEstado(e.Estado)"></i>
                                                @e.Estado
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <button type="button" class="btn btn-action" title="Ver detalle por materia" onclick="monDetalle(this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr class="detail-row d-none">
                                        <td colspan="5">
                                            @if (!e.TieneNotas)
                                            {
                                                <span class="text-muted"><i class="bi bi-info-circle me-1"></i>@e.Mensaje</span>
                                            }
                                            else
                                            {
                                                <div class="detail-box">
                                                    <table class="table table-sm">
                                                        <thead>
                                                            <tr>
                                                                <th>Materia</th>
                                                                <th class="text-center">I Trim.</th>
                                                                <th class="text-center">II Trim.</th>
                                                                <th class="text-center">III Trim.</th>
                                                                <th class="text-center">Promedio</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var d in detalle)
                                                            {
                                                                <tr>
                                                                    <td>@d.Asignatura</td>
                                                                    <td class="text-center">@MonitoreoUI.Fmt(d.T1)</td>
                                                                    <td class="text-center">@MonitoreoUI.Fmt(d.T2)</td>
                                                                    <td class="text-center">@MonitoreoUI.Fmt(d.T3)</td>
                                                                    <td class="text-center"><strong>@MonitoreoUI.Fmt(d.Promedio)</strong></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        }

    </section>

</main>

@section styles {
    @Html.Partial("_EstilosMonitoreo")
}

@section scripts {
    <script>
        // Muestra u oculta la fila de detalle de un estudiante
        function monDetalle(boton) {
            var fila = boton.closest('tr').nextElementSibling;
            if (fila) { fila.classList.toggle('d-none'); }
        }
    </script>
}