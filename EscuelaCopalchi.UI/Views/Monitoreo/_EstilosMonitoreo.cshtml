<style>

    :root {
        --cop-primary: #133C55;
        --cop-secondary: #386FA4;
        --cop-accent: #59A5D8;
        --cop-muted: #6c757d;
        --cop-page-bg: #f4f7fa;
    }

    body {
        background: var(--cop-page-bg);
    }

    /* ENCABEZADO */
    .monitor-header {
        background: white;
        border-bottom: 1px solid #e3e8ee;
        padding: 30px 0;
        margin-bottom: 28px;
    }

    .monitor-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .85rem;
        color: var(--cop-muted);
        margin-bottom: 12px;
    }

        .monitor-breadcrumb a {
            color: var(--cop-secondary);
            text-decoration: none;
        }

            .monitor-breadcrumb a:hover {
                text-decoration: underline;
            }

    .monitor-title {
        color: var(--cop-primary);
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .monitor-subtitle {
        color: var(--cop-muted);
        margin: 0;
    }

    /* BOTONES */
    .btn-cop-primary {
        background: var(--cop-primary);
        border-color: var(--cop-primary);
        color: white;
        font-weight: 500;
    }

        .btn-cop-primary:hover {
            background: var(--cop-secondary);
            border-color: var(--cop-secondary);
            color: white;
        }

    .btn-cop-outline {
        background: white;
        border: 1px solid var(--cop-primary);
        color: var(--cop-primary);
        font-weight: 500;
    }

        .btn-cop-outline:hover {
            background: #e6f1fb;
            color: var(--cop-primary);
            border-color: var(--cop-secondary);
        }

    /* RESUMEN */
    .summary-card {
        height: 100%;
        background: white;
        border: 1px solid #e3e8ee;
        border-radius: 10px;
        padding: 17px;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .summary-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 9px;
        background: #e6f1fb;
        color: var(--cop-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .summary-icon-success {
        background: #d1e7dd;
        color: #0f5132;
    }

    .summary-icon-warning {
        background: #fff3cd;
        color: #664d03;
    }

    .summary-icon-danger {
        background: #f8d7da;
        color: #842029;
    }

    .summary-card span {
        display: block;
        color: var(--cop-muted);
        font-size: .8rem;
    }

    .summary-card h2 {
        color: var(--cop-primary);
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
    }

    .success-value {
        color: #198754 !important;
    }

    .warning-value {
        color: #946200 !important;
    }

    /* CONTENEDOR */
    .monitor-card {
        background: white;
        border: 1px solid #e3e8ee;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .monitor-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px;
    }

        .monitor-toolbar h2 {
            color: var(--cop-primary);
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .monitor-toolbar p {
            color: var(--cop-muted);
            font-size: .85rem;
            margin: 0;
        }

    /* BUSCADOR */
    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--cop-muted);
        }

        .search-box input {
            padding-left: 34px;
        }

    /* FILTROS */
    .monitor-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        align-items: end;
        padding: 15px 22px;
        background: #f8fafc;
        border-top: 1px solid #edf0f3;
        border-bottom: 1px solid #edf0f3;
    }

    .filter-label {
        display: block;
        color: #53616d;
        font-size: .78rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .filter-actions {
        display: flex;
        gap: 8px;
    }

    /* LEYENDA DE UMBRALES */
    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        padding: 12px 22px;
        font-size: .78rem;
        color: var(--cop-muted);
        border-bottom: 1px solid #edf0f3;
    }

        .legend .dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-right: 5px;
        }

    .dot-ok {
        background: #198754;
    }

    .dot-warning {
        background: #d99100;
    }

    .dot-danger {
        background: #dc3545;
    }

    /* TABLA */
    .monitor-table {
        margin: 0;
    }

        .monitor-table th {
            background: #f8fafc;
            color: #53616d;
            font-size: .8rem;
            text-transform: uppercase;
            padding: 13px 17px;
            font-weight: 600;
            white-space: nowrap;
        }

        .monitor-table td {
            padding: 15px 17px;
            font-size: .9rem;
            border-color: #edf0f3;
        }

        .monitor-table tbody tr:hover {
            background: #fafcfd;
        }

    /* ESTUDIANTE */
    .student-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .student-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e6f1fb;
        color: var(--cop-primary);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: .78rem;
        font-weight: 700;
    }

    .student-info strong {
        display: block;
        color: #212529;
        font-size: .88rem;
    }

    .student-info small {
        display: block;
        color: var(--cop-muted);
        font-size: .75rem;
    }

    /* NOTA */
    .grade-value {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 46px;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: .88rem;
        font-weight: 700;
    }

    .grade-danger {
        background: #f8d7da;
        color: #842029;
    }

    .grade-warning {
        background: #fff3cd;
        color: #664d03;
    }

    .grade-success {
        background: #d1e7dd;
        color: #0f5132;
    }

    .grade-muted {
        background: #edf0f3;
        color: #6c757d;
    }

    .no-grades {
        color: var(--cop-muted);
        font-size: .8rem;
        display: inline-block;
        max-width: 230px;
        line-height: 1.3;
    }

    /* ESTADOS */
    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: .77rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-danger {
        background: #f8d7da;
        color: #842029;
    }

    .status-warning {
        background: #fff3cd;
        color: #664d03;
    }

    .status-ok {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-muted {
        background: #edf0f3;
        color: #53616d;
    }

    /* DETALLE DESPLEGABLE */
    .detail-row > td {
        background: #f8fafc;
        padding: 16px 22px !important;
    }

    .detail-box {
        max-width: 620px;
    }

        .detail-box table {
            font-size: .83rem;
            margin: 0;
        }

        .detail-box th {
            color: #53616d;
            font-weight: 600;
        }

    /* ACCIONES */
    .btn-action {
        background: white;
        border: 1px solid #dce2e7;
        color: var(--cop-secondary);
        padding: 5px 9px;
    }

        .btn-action:hover {
            background: #e6f1fb;
            border-color: var(--cop-accent);
            color: var(--cop-primary);
        }

    /* ESTADO VACÍO */
    .empty-state {
        text-align: center;
        padding: 48px 20px;
        color: var(--cop-muted);
    }

        .empty-state i {
            font-size: 2.4rem;
            color: #9fb3c4;
        }

        .empty-state h3 {
            color: var(--cop-primary);
            font-size: 1.1rem;
            margin-top: 12px;
        }

    /* REPORTE */
    .report-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 14px;
        padding: 18px 22px;
    }

        .report-meta span {
            display: block;
            font-size: .74rem;
            color: var(--cop-muted);
            text-transform: uppercase;
            font-weight: 600;
        }

        .report-meta strong {
            color: var(--cop-primary);
            font-size: .95rem;
        }

    .dist-bar {
        display: flex;
        height: 12px;
        border-radius: 6px;
        overflow: hidden;
        background: #edf0f3;
        margin: 0 22px 8px;
    }

        .dist-bar div {
            height: 100%;
        }

    .bar-ok {
        background: #198754;
    }

    .bar-warning {
        background: #d99100;
    }

    .bar-danger {
        background: #dc3545;
    }

    .bar-muted {
        background: #b6c0c8;
    }

    .report-foot {
        padding: 14px 22px;
        font-size: .78rem;
        color: var(--cop-muted);
        border-top: 1px solid #edf0f3;
    }

    /* INPUTS */
    .form-control, .form-select {
        border-color: #dfe4e8;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--cop-accent);
            box-shadow: 0 0 0 .2rem rgba(89, 165, 216, .15);
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .monitor-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }
    }

    /* IMPRESIÓN: solo el reporte */
    @@media print {
        nav, footer, .no-print, .monitor-header .btn, .monitor-filters, .monitor-breadcrumb {
            display: none !important;
        }

        body {
            background: white;
        }

        .monitor-card, .summary-card {
            border: 1px solid #ccc;
            box-shadow: none;
        }

        .monitor-header {
            padding: 0 0 10px;
            margin: 0;
            border: 0;
        }
    }
</style>