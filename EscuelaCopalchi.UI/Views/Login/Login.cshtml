
@model EscuelaCopalchi.UI.Models.LoginViewModel

@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Iniciar sesión - Aula Virtual Copalchí</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            background: #f4f7fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 14px;
            padding: 38px;
            width: 100%;
            max-width: 430px;
            box-shadow: 0 8px 30px rgba(19,60,85,.08);
        }

        .login-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            background: #e6f1fb;
            color: #133C55;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 28px;
        }

        .login-title {
            color: #133C55;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 14px;
            text-align: center;
            margin-bottom: 28px;
        }

        .form-label {
            color: #133C55;
            font-weight: 600;
            font-size: 14px;
        }

        .form-control {
            border-radius: 8px;
            padding: 11px;
        }

        .btn-login {
            background: #133C55;
            border: 1px solid #133C55;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }

            .btn-login:hover {
                background: #386FA4;
                color: white;
            }

        .login-footer {
            color: #6c757d;
            font-size: 12px;
            text-align: center;
            margin-top: 25px;
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="login-icon">
            <i class="bi bi-mortarboard"></i>
        </div>

        <h1 class="login-title">Escuela Copalchí</h1>

        <p class="login-subtitle">
            Aula Virtual para Docentes
            <br />
            Ingrese sus credenciales para continuar
        </p>

        @using (Html.BeginForm(
            "Login", "Account",
            new { returnUrl = ViewBag.ReturnUrl },
            FormMethod.Post,
            new { autocomplete = "on" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true, "",
                new { @class = "alert alert-danger" })

            <div class="mb-3">
                <label class="form-label"
                       for="Correo">
                    Correo institucional
                </label>

                @Html.TextBoxFor(m => m.Correo,
                    new
                         {
                        @class = "form-control",
                        type = "email",
                        placeholder = "usuario@copalchi.ed.cr",
                        autocomplete = "username",
                        required = "required"
                    })

                @Html.ValidationMessageFor(
                    m => m.Correo, "",
                    new { @class = "text-danger small" })
            </div>

            <div class="mb-4">
                <label class="form-label"
                       for="Contrasena">
                    Contraseña
                </label>

                <div class="input-group">
                    @Html.PasswordFor(m => m.Contrasena,
                        new
                             {
                            @class = "form-control",
                            placeholder = "Ingrese su contraseña",
                            autocomplete = "current-password",
                            required = "required"
                        })

                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="mostrarClave"
                            aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit"
                    class="btn btn-login w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Iniciar sesión
            </button>
        }

        <div class="login-footer">
            © 2026 - Aula Virtual Copalchí
        </div>
    </div>

    <script>
        document.getElementById("mostrarClave")
            .addEventListener("click", function () {

                const campo =
                    document.getElementById("Contrasena");

                const visible = campo.type === "text";

                campo.type = visible ? "password" : "text";

                this.querySelector("i").className =
                    visible ? "bi bi-eye" : "bi bi-eye-slash";
            });
    </script>
</body>
</html>
