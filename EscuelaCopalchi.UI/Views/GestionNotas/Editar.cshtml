@model EscuelaCopalchi.UI.Models.GestionNotas.CalificacionDetalle
@{
    ViewBag.Title = "Modificar calificación";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
}
<main>
    @Html.Partial("_BarraNotas")
    <div class="gn-header">
        <div>
            <h2 class="gn-title">Modificar calificación</h2>
            <p class="gn-sub">@Model.Estudiante · @Model.Grupo · @Model.Asignatura (Trimestre @Model.Trimestre)</p>
        </div>
    </div>
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

    <div class="gn-card" style="max-width:560px">
        @using (Html.BeginForm("Editar", "GestionNotas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="idCalificacion" value="@Model.IdCalificacion" />
            <p class="mb-3"><strong>@Model.Evaluacion</strong> <span class="text-muted">· @Model.Porcentaje.ToString("0.##", ci)% de la nota</span></p>
            <div class="mb-3">
                <label class="form-label">Nota (0 a @Model.NotaMaxima.ToString("0.##", ci))</label>
                <input name="nota" class="form-control" style="max-width:140px" value="@Model.Nota.ToString("0.##", ci)" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Observación</label>
                <textarea name="observacion" class="form-control" rows="3" maxlength="300">@Model.Observacion</textarea>
            </div>
            <div class="d-flex gap-2">
                <button class="btn gn-btn">Guardar cambios</button>
                <a class="btn gn-btn-out" href="@Url.Action("Historial", new { grupo = Model.IdGrupo })">Cancelar</a>
            </div>
        }
    </div>
</main>
