@{
    var ses = ViewBag.NotasSesion as EscuelaCopalchi.UI.Models.GestionNotas.NotasSesion;
}
@if (ses != null)
{
    <div class="gn-bar">
        <span><i class="bi bi-person-circle me-1"></i> <strong>@ses.Nombre</strong> <span class="badge gn-badge gn-badge-ext ms-1">@ses.Rol</span></span>
        <a href="@Url.Action("Salir", "GestionNotas")" class="gn-link"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a>
    </div>
}
