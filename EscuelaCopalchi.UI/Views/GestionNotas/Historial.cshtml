@model EscuelaCopalchi.UI.Models.GestionNotas.HistorialViewModel
@{
    ViewBag.Title = "Historial de notas";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
    <style>

    /* Encabezado compacto y consistente en todo Gestión de Notas */
    body { background:#f4f7fa; }
    .gn-header.cop-notes-header { background:transparent!important; border:0!important; box-shadow:none!important; padding:0!important; margin:14px 0 20px!important; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
    .cop-notes-header .gn-title { font-size:1.55rem!important; line-height:1.3; font-weight:700; color:#133c55; margin:0 0 4px; }
    .cop-notes-header .gn-title i { color:#386fa4; }
    .cop-notes-header .gn-sub { font-size:.9rem; color:#6c7888; line-height:1.5; margin:0; }
    .cop-notes-header .cop-header-actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
    .cop-notes-header .cop-back-btn { background:#fff; border:1px solid #cbd5e1; border-radius:6px; color:#475569; padding:.55rem 1rem; font-weight:600; white-space:nowrap; }
    .cop-notes-header .cop-back-btn:hover { background:#edf3f8; border-color:#386fa4; color:#133c55; }
    .cop-notes-header .btn { border-radius:6px; }
    @@media (max-width:575px) { .cop-notes-header .gn-title { font-size:1.32rem!important; } }
    </style>
}
<main>

    <div class="gn-header cop-notes-header">
        <div>
            <h1 class="gn-title"><i class="bi bi-clock-history me-2"></i>Historial de notas</h1>
            <p class="gn-sub">Calificaciones de la escuela y de escuelas anteriores.</p>
        </div>
        <div class="cop-header-actions">
            <a href="@Url.Action("Index", "GestionNotas")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

    <form method="get" class="gn-filters">
        <div class="row g-2">
            <div class="col-md-3">
                <select name="grupo" class="form-select" onchange="this.form.estudiante.value=0;this.form.submit()">
                    <option value="0">Todos los grupos</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" @(g.IdGrupo == Model.Grupo ? "selected" : "")>@g.Grupo (@g.Anio)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="estudiante" class="form-select" onchange="this.form.submit()">
                    <option value="0">Todos los estudiantes</option>
                    @foreach (var s in Model.Estudiantes)
                    {
                        <option value="@s.IdEstudiante" @(s.IdEstudiante == Model.Estudiante ? "selected" : "")>@s.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input name="asignatura" class="form-control" placeholder="Asignatura" value="@Model.Asignatura" /></div>
            <div class="col-md-2">
                <select name="trimestre" class="form-select" onchange="this.form.submit()">
                    <option value="0">Todos</option>
                    @for (int t = 1; t <= 3; t++)
                    {
                        <option value="@t" @(t == Model.Trimestre ? "selected" : "")>Trimestre @t</option>
                    }
                </select>
            </div>
            <div class="col-md-1"><button class="btn gn-btn w-100"><i class="bi bi-search"></i></button></div>
        </div>
    </form>

    @if (Model.Grupo > 0)
    {
        <div class="d-flex justify-content-end flex-wrap gap-2 mb-3">
            <a class="btn gn-btn-accent" href="@Url.Action("ExportarGrupo", new { grupo = Model.Grupo })">
                <i class="bi bi-file-earmark-excel me-1"></i> Exportar grupo a Excel
            </a>
            @if (Model.Estudiante > 0)
            {
                <a class="btn gn-btn-accent" href="@Url.Action("ExportarEstudiante", new { grupo = Model.Grupo, estudiante = Model.Estudiante })">
                    <i class="bi bi-file-earmark-person me-1"></i> Exportar estudiante a Excel
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-muted small">Seleccione un grupo para poder exportar sus notas a Excel.</p>
    }

    @{
        var porEstudiante = Model.Items
            .GroupBy(h => h.IdEstudiante)
            .Select(g => g.ToList())
            .OrderBy(l => l[0].Estudiante)
            .ToList();
        bool abierto = Model.Estudiante > 0;
    }

    <div class="gn-filters">
        <input type="text" id="gnBuscarEst" class="form-control" placeholder="Buscar estudiante...">
    </div>

    <div class="table-responsive gn-table-wrap">
        <table class="table align-middle gn-table" id="gnTablaEst">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th class="text-center">Evaluaciones</th>
                    <th class="text-center">Escuela anterior</th>
                    <th class="text-center">Promedio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lista in porEstudiante)
                {
                    var propias = lista.Where(h => h.Origen == "Escuela").ToList();
                    var externas = lista.Where(h => h.Origen != "Escuela").ToList();
                    decimal? prom = propias.Count == 0 ? (decimal?)null : Math.Round(propias.Average(h => h.Porcentaje), 1);
                    string idc = "est" + lista[0].IdEstudiante;

                    <tr class="gn-est-fila">
                        <td><strong>@lista[0].Estudiante</strong></td>
                        <td class="text-center">@propias.Count</td>
                        <td class="text-center">@(externas.Count == 0 ? "-" : externas.Count.ToString())</td>
                        <td class="text-center">
                            @if (prom.HasValue)
                            {
                                <span class="gn-final @(prom >= 70 ? "ok" : "bad")">@prom.Value.ToString("0.#", ci)</span>
                            }
                            else
                            {
                                <span class="gn-final none">-</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="gn-link" data-bs-toggle="collapse" href="#@idc" role="button"><i class="bi bi-chevron-down me-1"></i>Ver notas</a>
                            @if (Model.Grupo > 0)
                            {
                                <a class="gn-link ms-3" href="@Url.Action("ExportarEstudiante", new { grupo = Model.Grupo, estudiante = lista[0].IdEstudiante })"><i class="bi bi-file-earmark-excel"></i> Exportar</a>
                            }
                        </td>
                    </tr>
                    <tr class="gn-est-detalle">
                        <td colspan="5" class="p-0 border-0">
                            <div class="collapse @(abierto ? "show" : "")" id="@idc">
                                <div class="gn-detalle">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr><th>Asignatura</th><th>Periodo</th><th>Evaluación</th><th>Nota</th><th>Fecha</th><th></th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in lista)
                                            {
                                                bool ext = h.Origen != "Escuela";
                                                <tr>
                                                    <td>@h.Asignatura</td>
                                                    <td>@h.Periodo @h.Anio</td>
                                                    <td>
                                                        @if (ext)
                                                        {
                                                            <span class="badge gn-badge gn-badge-ext">Escuela anterior</span> <span class="text-muted small">@h.EscuelaProcedencia</span>
                                                        }
                                                        else
                                                        {
                                                            @h.Evaluacion
                                                        }
                                                    </td>
                                                    <td><span class="gn-final @(h.Porcentaje >= 70 ? "ok" : "bad")">@h.Nota.ToString("0.##", ci)@(ext ? "" : " / " + h.NotaMaxima.ToString("0.##", ci))</span></td>
                                                    <td>@h.Fecha.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        @if (!ext && Model.PuedeEditar && h.IdCalificacion.HasValue && (Model.IdDocenteActual == 0 || h.IdDocente == Model.IdDocenteActual))
                                                        {
                                                            <a class="gn-link" href="@Url.Action("Editar", new { id = h.IdCalificacion })">Editar</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (porEstudiante.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay calificaciones para los filtros seleccionados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</main>
@section scripts {
    <script>
        document.getElementById('gnBuscarEst').addEventListener('input', function () {
            var q = this.value.toLowerCase();
            document.querySelectorAll('#gnTablaEst tbody tr.gn-est-fila').forEach(function (tr) {
                var visible = tr.innerText.toLowerCase().indexOf(q) > -1;
                tr.style.display = visible ? '' : 'none';
                var det = tr.nextElementSibling;
                if (det && det.classList.contains('gn-est-detalle')) det.style.display = visible ? '' : 'none';
            });
        });
    </script>
}

