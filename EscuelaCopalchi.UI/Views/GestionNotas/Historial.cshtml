@{
    ViewBag.Title = "Historial de calificaciones";
}

<main>

    <section class="grades-header">

        <div class="container">

            <div class="grades-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "GestionNotas")">
                    Gestión de notas
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Historial</span>
            </div>

            <h1 class="grades-title">
                <i class="bi bi-clock-history me-2"></i>
                Historial de calificaciones
            </h1>

            <p class="grades-subtitle">
                Consulta las calificaciones registradas y sus modificaciones.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <div class="history-card">

            <div class="filters">

                <select class="form-select">
                    <option>Primer grado A</option>
                    <option>Segundo grado A</option>
                </select>

                <select class="form-select">
                    <option>Todos los estudiantes</option>
                    <option>María González</option>
                    <option>Juan Pérez</option>
                </select>

                <select class="form-select">
                    <option>Matemáticas</option>
                    <option>Español</option>
                    <option>Ciencias</option>
                </select>

                <select class="form-select">
                    <option>I Trimestre</option>
                    <option>II Trimestre</option>
                    <option>III Trimestre</option>
                </select>

                <button class="btn btn-cop-primary">
                    <i class="bi bi-search me-1"></i>
                    Consultar
                </button>

            </div>


            <div class="table-responsive">

                <table class="table history-table align-middle">

                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Periodo</th>
                            <th>Asignatura</th>
                            <th>Nota</th>
                            <th>Fecha</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>

                            <td>María González</td>

                            <td>I Trimestre</td>

                            <td>Matemáticas</td>

                            <td>
                                <span class="grade grade-approved">
                                    89
                                </span>
                            </td>

                            <td>08/08/2026</td>

                            <td class="text-end">

                                <a href="@Url.Action("Editar", "GestionNotas", new { id = 1 })"
                                   class="btn btn-action">

                                    <i class="bi bi-pencil"></i>

                                </a>

                            </td>

                        </tr>


                        <tr>

                            <td>Juan Pérez</td>

                            <td>I Trimestre</td>

                            <td>Matemáticas</td>

                            <td>
                                <span class="grade grade-failed">
                                    60
                                </span>
                            </td>

                            <td>08/08/2026</td>

                            <td class="text-end">

                                <a href="@Url.Action("Editar", "GestionNotas", new { id = 2 })"
                                   class="btn btn-action">

                                    <i class="bi bi-pencil"></i>

                                </a>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .grades-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .grades-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .grades-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .grades-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .grades-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .history-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            display: flex;
            gap: 10px;
            padding: 18px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

            .filters .form-select {
                max-width: 200px;
            }

        .history-table {
            margin: 0;
        }

            .history-table th {
                background: #f8fafc;
                color: #53616d;
                font-size: .8rem;
                text-transform: uppercase;
                padding: 13px 17px;
            }

            .history-table td {
                padding: 15px 17px;
            }

        .grade {
            display: inline-block;
            min-width: 40px;
            text-align: center;
            padding: 5px 8px;
            border-radius: 7px;
            font-weight: 600;
        }

        .grade-approved {
            background: #d1e7dd;
            color: #0f5132;
        }

        .grade-failed {
            background: #f8d7da;
            color: #842029;
        }

        .btn-action {
            background: white;
            border: 1px solid #dce2e7;
            color: var(--cop-secondary);
            padding: 5px 9px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

        @@media(max-width:992px) {

            .filters {
                flex-wrap: wrap;
            }
        }
    </style>

}