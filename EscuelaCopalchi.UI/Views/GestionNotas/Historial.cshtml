@model EscuelaCopalchi.UI.Models.GestionNotas.HistorialViewModel
@{
    ViewBag.Title = "Historial de notas";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
}
<main>
    <a href="@Url.Action("Index")" class="cop-back-link"><i class="bi bi-arrow-left"></i> Volver a mis grupos</a>
    <div class="gn-header">
        <div>
            <h2 class="gn-title">Historial de notas</h2>
            <p class="gn-sub">Calificaciones de la escuela y de escuelas anteriores.</p>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

    <form method="get" class="gn-filters">
        <div class="row g-2">
            <div class="col-md-3">
                <select name="grupo" class="form-select" onchange="this.form.estudiante.value=0;this.form.submit()">
                    <option value="0">Todos los grupos</option>
                    @foreach (var g in Model.Grupos)
                    {
                        <option value="@g.IdGrupo" @(g.IdGrupo == Model.Grupo ? "selected" : "")>@g.Grupo (@g.Anio)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="estudiante" class="form-select" onchange="this.form.submit()">
                    <option value="0">Todos los estudiantes</option>
                    @foreach (var s in Model.Estudiantes)
                    {
                        <option value="@s.IdEstudiante" @(s.IdEstudiante == Model.Estudiante ? "selected" : "")>@s.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input name="asignatura" class="form-control" placeholder="Asignatura" value="@Model.Asignatura" /></div>
            <div class="col-md-2">
                <select name="trimestre" class="form-select" onchange="this.form.submit()">
                    <option value="0">Todos</option>
                    @for (int t = 1; t <= 3; t++)
                    {
                        <option value="@t" @(t == Model.Trimestre ? "selected" : "")>Trimestre @t</option>
                    }
                </select>
            </div>
            <div class="col-md-1"><button class="btn gn-btn w-100"><i class="bi bi-search"></i></button></div>
        </div>
    </form>

    <div class="table-responsive gn-table-wrap">
        <table class="table align-middle gn-table">
            <thead>
                <tr><th>Estudiante</th><th>Grupo / Escuela</th><th>Asignatura</th><th>Periodo</th><th>Evaluación</th><th>Nota</th><th>Fecha</th><th>Origen</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Items)
                {
                    bool ext = h.Origen != "Escuela";
                    <tr>
                        <td>@h.Estudiante</td>
                        <td>@(ext ? h.EscuelaProcedencia : h.Grupo)</td>
                        <td>@h.Asignatura</td>
                        <td>@h.Periodo @h.Anio</td>
                        <td>@(ext ? "—" : h.Evaluacion)</td>
                        <td><span class="gn-final @(h.Porcentaje >= 70 ? "ok" : "bad")">@h.Nota.ToString("0.##", ci)@(ext ? "" : " / " + h.NotaMaxima.ToString("0.##", ci))</span></td>
                        <td>@h.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge gn-badge @(ext ? "gn-badge-ext" : "gn-badge-ok")">@h.Origen</span></td>
                        <td>
                            @if (!ext && Model.PuedeEditar && h.IdCalificacion.HasValue && h.IdDocente == Model.IdDocenteActual)
                            {
                                <a class="gn-link" href="@Url.Action("Editar", new { id = h.IdCalificacion })">Editar</a>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No hay calificaciones para los filtros seleccionados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</main>
