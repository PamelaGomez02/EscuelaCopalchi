@{
    ViewBag.Title = "Gestión de notas";
}

<main>

    <section class="grades-header">

        <div class="container">

            <div class="grades-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>
                <span>Gestión de notas</span>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>
                    <h1 class="grades-title">
                        <i class="bi bi-clipboard-data me-2"></i>
                        Gestión de notas
                    </h1>

                    <p class="grades-subtitle">
                        Registra, importa y consulta las calificaciones de los grupos asignados.
                    </p>
                </div>

                <div class="d-flex gap-2">

                    <a href="@Url.Action("ImportarExcel", "GestionNotas")"
                       class="btn btn-outline-cop">

                        <i class="bi bi-file-earmark-excel me-1"></i>
                        Importar Excel

                    </a>

                    <a href="@Url.Action("Registrar", "GestionNotas")"
                       class="btn btn-cop-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Registrar notas

                    </a>

                </div>

            </div>

        </div>

    </section>


    <section class="container pb-5">

        <!-- RESUMEN -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <span>Grupos asignados</span>
                        <h2>4</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    <div>
                        <span>Estudiantes</span>
                        <h2>86</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <span>Notas registradas</span>
                        <h2>72</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <span>Pendientes</span>
                        <h2>14</h2>
                    </div>
                </div>
            </div>

        </div>


        <div class="grades-card">

            <div class="grades-toolbar">

                <div>
                    <h2>Mis grupos</h2>
                    <p>Se muestran únicamente los grupos asignados al docente.</p>
                </div>

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           class="form-control"
                           placeholder="Buscar grupo..." />
                </div>

            </div>


            <div class="table-responsive">

                <table class="table grades-table align-middle">

                    <thead>
                        <tr>
                            <th>Grupo</th>
                            <th>Asignatura</th>
                            <th>Estudiantes</th>
                            <th>Periodo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>

                            <td>
                                <strong>Primer grado A</strong>
                            </td>

                            <td>Matemáticas</td>

                            <td>22</td>

                            <td>I Trimestre</td>

                            <td>
                                <span class="status status-progress">
                                    En proceso
                                </span>
                            </td>

                            <td class="text-end">

                                <a href="@Url.Action("Registrar", "GestionNotas", new { grupo = 1 })"
                                   class="btn btn-action"
                                   title="Registrar">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <a href="@Url.Action("Historial", "GestionNotas", new { grupo = 1 })"
                                   class="btn btn-action"
                                   title="Historial">

                                    <i class="bi bi-clock-history"></i>

                                </a>

                            </td>

                        </tr>


                        <tr>

                            <td>
                                <strong>Segundo grado A</strong>
                            </td>

                            <td>Matemáticas</td>

                            <td>21</td>

                            <td>I Trimestre</td>

                            <td>
                                <span class="status status-complete">
                                    Completo
                                </span>
                            </td>

                            <td class="text-end">

                                <a href="@Url.Action("Registrar", "GestionNotas", new { grupo = 2 })"
                                   class="btn btn-action">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a href="@Url.Action("Historial", "GestionNotas", new { grupo = 2 })"
                                   class="btn btn-action">
                                    <i class="bi bi-clock-history"></i>
                                </a>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


@@section styles {

<style>

    :root {
        --cop-primary: #133C55;
        --cop-secondary: #386FA4;
        --cop-accent: #59A5D8;
        --cop-muted: #6c757d;
        --cop-page-bg: #f4f7fa;
    }

    body {
        background: var(--cop-page-bg);
    }

    .grades-header {
        background: white;
        border-bottom: 1px solid #e3e8ee;
        padding: 30px 0;
        margin-bottom: 28px;
    }

    .grades-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .85rem;
        color: var(--cop-muted);
        margin-bottom: 12px;
    }

        .grades-breadcrumb a {
            color: var(--cop-secondary);
            text-decoration: none;
        }

    .grades-title {
        color: var(--cop-primary);
        font-size: 1.8rem;
        font-weight: 700;
    }

    .grades-subtitle {
        color: var(--cop-muted);
        margin: 0;
    }

    .btn-cop-primary {
        background: var(--cop-primary);
        color: white;
        border-color: var(--cop-primary);
    }

        .btn-cop-primary:hover {
            background: var(--cop-secondary);
            color: white;
        }

    .btn-outline-cop {
        border: 1px solid var(--cop-secondary);
        color: var(--cop-secondary);
    }

    .summary-card {
        background: white;
        border: 1px solid #e3e8ee;
        border-radius: 10px;
        padding: 17px;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .summary-icon {
        width: 44px;
        height: 44px;
        border-radius: 9px;
        background: #e6f1fb;
        color: var(--cop-secondary);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
    }

    .summary-card span {
        display: block;
        color: var(--cop-muted);
        font-size: .8rem;
    }

    .summary-card h2 {
        color: var(--cop-primary);
        font-size: 1.4rem;
        margin: 0;
    }

    .grades-card {
        background: white;
        border: 1px solid #e3e8ee;
        border-radius: 10px;
        overflow: hidden;
    }

    .grades-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px;
    }

        .grades-toolbar h2 {
            color: var(--cop-primary);
            font-size: 1.15rem;
            margin-bottom: 4px;
        }

        .grades-toolbar p {
            color: var(--cop-muted);
            font-size: .85rem;
            margin: 0;
        }

    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--cop-muted);
        }

        .search-box input {
            padding-left: 34px;
        }

    .grades-table {
        margin: 0;
    }

        .grades-table th {
            background: #f8fafc;
            color: #53616d;
            font-size: .8rem;
            text-transform: uppercase;
            padding: 13px 17px;
        }

        .grades-table td {
            padding: 15px 17px;
            font-size: .9rem;
        }

    .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 600;
    }

    .status-progress {
        background: #fff3cd;
        color: #856404;
    }

    .status-complete {
        background: #d1e7dd;
        color: #0f5132;
    }

    .btn-action {
        background: white;
        border: 1px solid #dce2e7;
        color: var(--cop-secondary);
        padding: 5px 9px;
    }

    @@media(max-width:768px) {

        .grades-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }
    }
</style>

}