@model List<EscuelaCopalchi.UI.Models.GestionNotas.GrupoNotasItem>
@{
    ViewBag.Title = "Gestión de notas";
    bool veTodo = ViewBag.VeTodo == true;
    bool puedeRegistrar = ViewBag.PuedeRegistrar == true;
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
    <style>

    /* Encabezado compacto y consistente en todo Gestión de Notas */
    body { background:#f4f7fa; }
    .gn-header.cop-notes-header { background:transparent!important; border:0!important; box-shadow:none!important; padding:0!important; margin:14px 0 20px!important; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
    .cop-notes-header .gn-title { font-size:1.55rem!important; line-height:1.3; font-weight:700; color:#133c55; margin:0 0 4px; }
    .cop-notes-header .gn-title i { color:#386fa4; }
    .cop-notes-header .gn-sub { font-size:.9rem; color:#6c7888; line-height:1.5; margin:0; }
    .cop-notes-header .cop-header-actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
    .cop-notes-header .cop-back-btn { background:#fff; border:1px solid #cbd5e1; border-radius:6px; color:#475569; padding:.55rem 1rem; font-weight:600; white-space:nowrap; }
    .cop-notes-header .cop-back-btn:hover { background:#edf3f8; border-color:#386fa4; color:#133c55; }
    .cop-notes-header .btn { border-radius:6px; }
    @@media (max-width:575px) { .cop-notes-header .gn-title { font-size:1.32rem!important; } }
    .gn-index-tools { display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .gn-index-tools #gnBuscar { flex:1 1 250px; min-width:180px; }
    .gn-index-tools .gn-history-link { flex:0 0 auto; white-space:nowrap; }
    @@media (max-width:575px) { .gn-index-tools .gn-history-link { width:100%; } }
    </style>
}
<main>


    <div class="gn-header cop-notes-header">
        <div>
            <h1 class="gn-title"><i class="bi bi-journal-check me-2"></i>Gestión de notas</h1>
            <p class="gn-sub">@(veTodo ? "Consulta de calificaciones de todos los grupos." : "Mis grupos y calificaciones.")</p>
        </div>
        <div class="cop-header-actions">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>
            @if (puedeRegistrar)
            {
                <a href="@Url.Action("ImportarExcel")" class="btn gn-btn-out"><i class="bi bi-file-earmark-excel me-1"></i>Importar Excel</a>
                <a href="@Url.Action("Registrar")" class="btn gn-btn"><i class="bi bi-pencil-square me-1"></i>Registrar notas</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

    <div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="gn-stat"><span class="gn-stat-label">Grupos</span><span class="gn-stat-value">@Model.Count</span></div></div>
        <div class="col-sm-4"><div class="gn-stat"><span class="gn-stat-label">Estudiantes</span><span class="gn-stat-value">@Model.Sum(g => g.TotalEstudiantes)</span></div></div>
        <div class="col-sm-4"><div class="gn-stat"><span class="gn-stat-label">Notas pendientes</span><span class="gn-stat-value gn-stat-alert">@Model.Sum(g => g.Pendientes)</span></div></div>
    </div>

    <div class="gn-filters gn-index-tools">
        <input type="text" id="gnBuscar" class="form-control" placeholder="Buscar grupo@(veTodo ? " o docente" : "")...">
        <a href="@Url.Action("Historial")" class="btn gn-btn-out gn-history-link"><i class="bi bi-clock-history me-1"></i>Ver historial de notas</a>
    </div>

    <div class="table-responsive gn-table-wrap">
        <table class="table align-middle gn-table" id="gnTabla">
            <thead>
                <tr>
                    <th>Grupo</th><th>Nivel</th><th>Año</th>
                    @if (veTodo) { <th>Docente</th> }
                    <th>Estudiantes</th><th>Evaluaciones</th><th>Pendientes</th><th>Estado</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td><strong>@g.Grupo</strong></td>
                        <td>@g.Nivel</td>
                        <td>@g.Anio</td>
                        @if (veTodo) { <td>@g.Docente</td> }
                        <td>@g.TotalEstudiantes</td>
                        <td>@g.TotalEvaluaciones</td>
                        <td>@g.Pendientes</td>
                        <td>
                            <span class="badge gn-badge @(g.Estado == "Completo" ? "gn-badge-ok" : g.Estado == "En proceso" ? "gn-badge-warn" : "gn-badge-off")">@g.Estado</span>
                        </td>
                        <td class="text-nowrap">
                            @if (puedeRegistrar)
                            {
                                <a class="gn-link me-2" href="@Url.Action("Registrar", new { grupo = g.IdGrupo })">Registrar</a>
                            }
                            <a class="gn-link" href="@Url.Action("Historial", new { grupo = g.IdGrupo })">Ver notas</a>
                            <a class="gn-link ms-2" href="@Url.Action("ExportarGrupo", new { grupo = g.IdGrupo })"><i class="bi bi-file-earmark-excel"></i> Exportar</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No hay grupos para mostrar.</td></tr>
                }
            </tbody>
        </table>
    </div>
    
</main>
@section scripts {
    <script>
        document.getElementById('gnBuscar').addEventListener('input', function () {
            var q = this.value.toLowerCase();
            document.querySelectorAll('#gnTabla tbody tr').forEach(function (tr) {
                tr.style.display = tr.innerText.toLowerCase().indexOf(q) > -1 ? '' : 'none';
            });
        });
    </script>
}
