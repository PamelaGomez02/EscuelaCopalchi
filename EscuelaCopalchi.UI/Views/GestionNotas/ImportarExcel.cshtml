@model EscuelaCopalchi.UI.Models.GestionNotas.ImportarViewModel
@{
    ViewBag.Title = "Importar notas desde Excel";
}
@section styles {
    <link rel="stylesheet" href="~/Content/gestion-notas.css" />
    <style>

    /* Encabezado compacto y consistente en todo Gestión de Notas */
    body { background:#f4f7fa; }
    .gn-header.cop-notes-header { background:transparent!important; border:0!important; box-shadow:none!important; padding:0!important; margin:14px 0 20px!important; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
    .cop-notes-header .gn-title { font-size:1.55rem!important; line-height:1.3; font-weight:700; color:#133c55; margin:0 0 4px; }
    .cop-notes-header .gn-title i { color:#386fa4; }
    .cop-notes-header .gn-sub { font-size:.9rem; color:#6c7888; line-height:1.5; margin:0; }
    .cop-notes-header .cop-header-actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
    .cop-notes-header .cop-back-btn { background:#fff; border:1px solid #cbd5e1; border-radius:6px; color:#475569; padding:.55rem 1rem; font-weight:600; white-space:nowrap; }
    .cop-notes-header .cop-back-btn:hover { background:#edf3f8; border-color:#386fa4; color:#133c55; }
    .cop-notes-header .btn { border-radius:6px; }
    @@media (max-width:575px) { .cop-notes-header .gn-title { font-size:1.32rem!important; } }
    </style>
}
<main>

    <div class="gn-header cop-notes-header">
        <div>
            <h1 class="gn-title"><i class="bi bi-file-earmark-excel me-2"></i>Importar notas desde Excel</h1>
            <p class="gn-sub">Archivos .xlsx. Si hay un solo error en el archivo no se guarda nada.</p>
        </div>
        <div class="cop-header-actions">
            <a href="@Url.Action("Index", "GestionNotas")" class="btn btn-outline-secondary cop-back-btn"><i class="bi bi-arrow-left me-1"></i>Atrás</a>
        </div>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
    @if (Model.Errores.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">@foreach (var e in Model.Errores) { <li>@e</li> }</ul>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="gn-card h-100">
                <h5 class="gn-title">Notas de esta escuela</h5>
                <form method="get" class="row g-2 mb-3">
                    <div class="col-12">
                        <select name="grupo" class="form-select" onchange="this.form.submit()">
                            @foreach (var g in Model.Grupos)
                            {
                                <option value="@g.IdGrupo" @(g.IdGrupo == Model.IdGrupo ? "selected" : "")>@g.Grupo (@g.Anio)</option>
                            }
                        </select>
                    </div>
                    <div class="col-8">
                        <select name="asignatura" class="form-select" onchange="this.form.submit()">
                            @foreach (var a in Model.Asignaturas)
                            {
                                <option @(a == Model.Asignatura ? "selected" : "")>@a</option>
                            }
                        </select>
                    </div>
                    <div class="col-4">
                        <select name="trimestre" class="form-select" onchange="this.form.submit()">
                            @for (int t = 1; t <= 3; t++)
                            {
                                <option value="@t" @(t == Model.Trimestre ? "selected" : "")>Trim. @t</option>
                            }
                        </select>
                    </div>
                </form>

                <p class="mb-1"><strong>Columnas del archivo (fila 1):</strong></p>
                <p class="text-muted">
                    <code>Identificacion</code>
                    @foreach (var ev in Model.Evaluaciones) { <text> · <code>@ev.Nombre</code></text> }
                </p>
                @if (Model.Evaluaciones.Count == 0)
                {
                    <div class="alert alert-info">Este grupo aún no tiene evaluaciones para esta asignatura y trimestre. Créelas primero en Registrar notas.</div>
                }
                else
                {
                    using (Html.BeginForm("ImportarEscuela", "GestionNotas", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idGrupo" value="@Model.IdGrupo" />
                        <input type="hidden" name="asignatura" value="@Model.Asignatura" />
                        <input type="hidden" name="trimestre" value="@Model.Trimestre" />
                        <input type="file" name="archivo" accept=".xlsx" class="form-control mb-3" required />
                        <button class="btn gn-btn"><i class="bi bi-upload me-1"></i> Importar notas</button>
                    }
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="gn-card h-100">
                <h5 class="gn-title">Notas de una escuela anterior</h5>
                <p class="text-muted">Para estudiantes que vienen de otra escuela (deben estar registrados en el sistema).</p>
                <p class="mb-1"><strong>Columnas del archivo (fila 1):</strong></p>
                <p class="text-muted"><code>Identificacion</code> · <code>Escuela</code> · <code>Asignatura</code> · <code>Periodo</code> · <code>Anio</code> · <code>Nota</code></p>
                <p class="text-muted small">Periodo: por ejemplo "Trimestre 1" o "Anual". Nota de 0 a 100.</p>
                @using (Html.BeginForm("ImportarExterna", "GestionNotas", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="file" name="archivo" accept=".xlsx" class="form-control mb-3" required />
                    <button class="btn gn-btn"><i class="bi bi-upload me-1"></i> Importar notas externas</button>
                }
            </div>
        </div>
    </div>
 
</main>
