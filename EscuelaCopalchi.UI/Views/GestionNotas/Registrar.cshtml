@{
    ViewBag.Title = "Registrar calificaciones";
}

<main>

    <section class="grades-header">

        <div class="container">

            <div class="grades-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Inicio</a>
                <i class="bi bi-chevron-right"></i>

                <a href="@Url.Action("Index", "GestionNotas")">
                    Gestión de notas
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Registrar</span>
            </div>

            <h1 class="grades-title">
                <i class="bi bi-pencil-square me-2"></i>
                Registrar calificaciones
            </h1>

            <p class="grades-subtitle">
                Ingresa las calificaciones de los estudiantes del grupo seleccionado.
            </p>

        </div>

    </section>


    <section class="container pb-5">

        <div class="grades-card">

            <div class="filters">

                <div>
                    <label class="form-label">Grupo</label>

                    <select class="form-select">
                        <option selected>Primer grado A</option>
                        <option>Segundo grado A</option>
                    </select>
                </div>


                <div>
                    <label class="form-label">Asignatura</label>

                    <select class="form-select">
                        <option selected>Matemáticas</option>
                        <option>Español</option>
                        <option>Ciencias</option>
                    </select>
                </div>


                <div>
                    <label class="form-label">Periodo</label>

                    <select class="form-select">
                        <option selected>I Trimestre</option>
                        <option>II Trimestre</option>
                        <option>III Trimestre</option>
                    </select>
                </div>

            </div>


            <div class="table-responsive">

                <table class="table grades-table align-middle">

                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Tarea 1</th>
                            <th>Trabajo</th>
                            <th>Examen</th>
                            <th>Nota final</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>

                            <td>
                                <strong>María González</strong>
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="90" />
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="85" />
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="92" />
                            </td>

                            <td>
                                <strong class="final-grade approved">
                                    89
                                </strong>
                            </td>

                        </tr>


                        <tr>

                            <td>
                                <strong>Juan Pérez</strong>
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="60" />
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="62" />
                            </td>

                            <td>
                                <input type="number"
                                       class="form-control grade-input"
                                       min="0"
                                       max="100"
                                       value="58" />
                            </td>

                            <td>
                                <strong class="final-grade failed">
                                    60
                                </strong>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <div class="form-actions">

                <a href="@Url.Action("Index", "GestionNotas")"
                   class="btn btn-light">
                    Cancelar
                </a>

                <button type="button"
                        class="btn btn-cop-primary">

                    <i class="bi bi-save me-1"></i>
                    Guardar calificaciones

                </button>

            </div>

        </div>

    </section>

</main>


@section styles {

    <style>

        :root {
            --cop-primary: #133C55;
            --cop-secondary: #386FA4;
            --cop-muted: #6c757d;
            --cop-page-bg: #f4f7fa;
        }

        body {
            background: var(--cop-page-bg);
        }

        .grades-header {
            background: white;
            border-bottom: 1px solid #e3e8ee;
            padding: 30px 0;
            margin-bottom: 28px;
        }

        .grades-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .85rem;
            color: var(--cop-muted);
            margin-bottom: 12px;
        }

            .grades-breadcrumb a {
                color: var(--cop-secondary);
                text-decoration: none;
            }

        .grades-title {
            color: var(--cop-primary);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .grades-subtitle {
            color: var(--cop-muted);
            margin: 0;
        }

        .grades-card {
            background: white;
            border: 1px solid #e3e8ee;
            border-radius: 10px;
            overflow: hidden;
        }

        .filters {
            display: flex;
            gap: 20px;
            padding: 20px 22px;
            background: #f8fafc;
            border-bottom: 1px solid #edf0f3;
        }

            .filters > div {
                width: 220px;
            }

        .form-label {
            font-size: .85rem;
            font-weight: 600;
            color: #344054;
        }

        .grades-table {
            margin: 0;
        }

            .grades-table th {
                background: #f8fafc;
                color: #53616d;
                text-transform: uppercase;
                font-size: .8rem;
                padding: 13px 17px;
            }

            .grades-table td {
                padding: 14px 17px;
            }

        .grade-input {
            max-width: 100px;
        }

        .final-grade {
            display: inline-block;
            min-width: 42px;
            text-align: center;
            padding: 5px 8px;
            border-radius: 7px;
        }

            .final-grade.approved {
                background: #d1e7dd;
                color: #0f5132;
            }

            .final-grade.failed {
                background: #f8d7da;
                color: #842029;
            }

        .form-actions {
            padding: 20px 22px;
            border-top: 1px solid #edf0f3;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cop-primary {
            background: var(--cop-primary);
            color: white;
            border-color: var(--cop-primary);
        }

        @@media(max-width:768px) {

            .filters {
                flex-direction: column;
            }

                .filters > div {
                    width: 100%;
                }
        }
    </style>

}